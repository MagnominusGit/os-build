#!/usr/bin/env python3
# retroforge internal install — WHICH RELEASE THE INSTALLER INSTALLS.
#
#   release-info          resolve <OTA_URL>/<channel>/latest.json and print key=value
#
# IT EMITS key=value AND NO PROSE: the words belong to whatever is drawing the screen, the facts belong
# here. installer/uiflow turns STATE= into a sentence, and the Settings row reads the same line. It
# always exits 0 -- a failure is itself an answer, and STATE is where the answer lives.
#
# THE MANIFEST IS NOT A TRUST BOUNDARY. latest.json says which bundle to fetch and nothing more; it
# cannot select a keyring, a verification mode or an install flag, and the bundle it names still has
# to verify against the baked CA before a single partition is touched. Every field in it is
# attacker-controlled, and the validation below is rootfs/overlay/usr/bin/retroforge-update's, ported: the
# `bundle` field is forced to a BARE FILENAME so a manifest can never aim this device at another
# host. tests/test-ui.sh asserts the two agree, both on the default URL literal and on the shapes
# they reject; that assertion is the only thing keeping the copies together.

import json
import os
import stat
import subprocess
import sys
import urllib.parse

PROG = os.path.basename(sys.argv[0])


def log(msg):
    print("[%s] %s" % (PROG, msg), file=sys.stderr)


def emit(key, value):
    print("%s=%s" % (key, value))


# Test seams, in the spirit of the rest of installer/: tests/test-ui.sh executes THIS file with curl
# stubbed and every path redirected. What runs under test is the artifact that ships.
CONFIG_FILE = os.environ.get("RETROFORGE_OTA_CONFIG", "/etc/retroforge/ota.conf")
# The channel picked in Settings > General > Updates. `player` writes this file and root reads it, so
# only OTA_CHANNEL comes from it, and only if it is a path segment (valid_channel).
USER_CONFIG_FILE = os.environ.get(
    "RETROFORGE_OTA_USER_CONFIG", "/home/player/.config/retroforge/ota.conf"
)
CURL = os.environ.get("RETROFORGE_CURL", "curl")
TIMEOUT = os.environ.get("RETROFORGE_NET_TIMEOUT", "20")
# The server this fetches from, resolved as retroforge-update resolves it. The literals are written a
# second time here because the two files share no code; tests/test-ui.sh asserts they agree.
DEFAULT_URL = "https://ota.retroforge.org"
DEFAULT_CHANNEL = "stable"


def parse_env(text):
    """Parse KEY=VALUE lines. Not a shell: no expansion, no substitution, no execution."""
    values = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip().strip('"').strip("'")
    return values


def read_env_file(path):
    try:
        with open(path, "r") as handle:
            return parse_env(handle.read())
    except (OSError, ValueError):
        return {}


def read_user_file(path):
    """
    USER_CONFIG_FILE, which `player` owns and root reads. A FIFO would hang the pre-flight, /dev/zero
    behind a symlink would eat memory, and a home survives reboots, so either would stop the
    installer for good: a small regular file or nothing.
    """
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return {}
    with os.fdopen(fd, "rb") as handle:
        if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
            return {}
        return parse_env(handle.read(4096).decode("utf-8", "replace"))


def valid_channel(name):
    """retroforge-update's grammar for a channel: it is a URL path segment."""
    return bool(name) and len(name) <= 64 and not name.startswith(".") and all(
        c.isalnum() or c in "._-" for c in name
    )


def config():
    conf = read_env_file(CONFIG_FILE)
    # The host is never read from USER_CONFIG_FILE, for the reason retroforge-update's config() gives.
    url = os.environ.get("RETROFORGE_OTA_URL") or conf.get("OTA_URL") or DEFAULT_URL
    # retroforge-update's channel_setting() order: env, /etc, $HOME, built-in. A dev card's pin in
    # /etc outranks the user's file on purpose.
    for channel in (
        os.environ.get("RETROFORGE_OTA_CHANNEL"),
        conf.get("OTA_CHANNEL"),
        read_user_file(USER_CONFIG_FILE).get("OTA_CHANNEL"),
    ):
        if valid_channel(channel):
            return url.rstrip("/"), channel
        if channel:
            log("ignoring the channel %r: not a path segment" % channel)
    return url.rstrip("/"), DEFAULT_CHANNEL


def fetch(url):
    """(rc, bytes) for a small document. `-f` ON PURPOSE: the HTTP status IS the question, and curl's
    22 for a 4xx is what separates "this channel has no release" from "this network cannot reach
    the server"."""
    try:
        result = subprocess.run(
            [CURL, "-fsSL", "--max-time", str(TIMEOUT), url],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        )
    except OSError as exc:
        log("cannot run %s: %s" % (CURL, exc))
        return 127, b""
    return result.returncode, result.stdout


def manifest(raw):
    """
    (release, complaint) -- the validated manifest, or why it is unusable.

    retroforge-update's manifest() with its download logic removed. Every check here is one of that
    file's, and for the same reason: left unchecked, `bundle` is a redirect primitive -- "../../x",
    "http://elsewhere/x" and "/etc/passwd" all become part of a URL this then fetches and
    hands to rauc. The signature would still reject whatever came back, but a manifest must not be
    able to aim the installer at another host at all.
    """
    try:
        data = json.loads(raw)
    except ValueError as exc:
        return None, "the release manifest is not valid JSON (%s)" % exc
    if not isinstance(data, dict):
        return None, "the release manifest is not an object"

    bundle = str(data.get("bundle", ""))
    parsed = urllib.parse.urlparse(bundle)
    if (
        not bundle
        or parsed.scheme
        or parsed.netloc
        or "/" in bundle
        or "\\" in bundle
        or bundle.startswith(".")
    ):
        return None, "the release manifest names an unusable bundle %r (must be a bare filename)" % bundle

    try:
        size = int(data.get("size", 0))
    except (TypeError, ValueError):
        size = 0
    if size <= 0:
        return None, "the release manifest gives no usable size"

    version = str(data.get("version", ""))
    build = str(data.get("build", ""))
    if not version and not build:
        return None, "the release manifest carries no version to name the release by"

    return {"version": version, "build": build, "bundle": bundle, "size": size}, ""


def gib(n):
    return "%.1f" % (n / float(1 << 30))


def main():
    base, channel = config()

    url = "%s/%s/latest.json" % (base, channel)
    emit("URL", url)
    emit("CHANNEL", channel)
    rc, raw = fetch(url)
    if rc == 22:
        emit("STATE", "no-release")
        emit("DETAIL", "the update server has nothing published in the '%s' channel" % channel)
        return 0
    if rc != 0:
        emit("STATE", "unreachable")
        emit("DETAIL", "the update server did not answer (curl exit %d)" % rc)
        return 0

    release, complaint = manifest(raw)
    if release is None:
        emit("STATE", "malformed")
        emit("DETAIL", complaint)
        return 0

    emit("STATE", "ok")
    emit("VERSION", release["version"])
    if release["build"]:
        emit("BUILD", release["build"])
    emit("SIZE", release["size"])
    emit("BUNDLE", "%s/%s/%s" % (base, channel, urllib.parse.quote(release["bundle"])))
    # ONE LINE, AND IT NAMES THE HOST. This is what the pre-flight screen puts under "To install",
    # and the alternative -- the bundle URL itself -- is long enough to wrap twice on a panel that
    # has already overflowed once (HW 2026-08-25). The host is the part an operator needs: it is
    # the one thing about this install they may have repointed ([[devices-are-operator-reachable]]).
    emit("DETAIL", "RetroForge %s, %s GiB from %s"
         % (release["version"] or release["build"], gib(release["size"]),
            urllib.parse.urlparse(base).netloc or base))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
