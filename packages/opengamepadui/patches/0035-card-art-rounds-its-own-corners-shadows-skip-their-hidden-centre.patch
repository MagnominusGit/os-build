From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: retroforge <retroforge@invalid>
Date: Sat, 24 Oct 2026 14:00:00 -0700
Subject: [PATCH] perf(GameCard): card art rounds its own corners, shadows
 skip their hidden centre

Each card masked its art to its rounded corners with clip_children on its
PanelContainer: a canvas group, an offscreen pass per card every frame.
Its shadow (a StyleBoxFlat with shadow_size 20) also filled the whole card
behind the art twice, with the shadow's interior and the style's
transparent centre, though neither shows.

Measured on a MANGMI Air X (Adreno 610, Library > All Games, 18 cards,
OGUI redrawing continuously, GPU time from the msm submit tracepoint):
under Vulkan the masks cost 3.2 ms of GPU per frame and the hidden fills
2.1 ms, of 14.4. Under OpenGL each group also flushes the frame: the page
drew at 31 fps with the GPU 42% busy, and at 59 fps with the art rounded
by a shader.

The art now rounds its own corners (rounded_texture.gdshader: a rounded
rectangle's distance, anti-aliased over one pixel, sized from the
TextureRect), and the panel masks its children only while something else
is drawn over the art: the progress bar, or the focus effects with
Animated Effects on. The shadow draws its ring only (draw_center = false),
offset 4 px instead of 5 so the ring meets the card's bottom edge where
the hidden interior used to show (the shadow is inset 4 px). Corners
match the old mask's within two pixels.

---
 assets/shaders/rounded_texture.gdshader     | 20 ++++++++++++++++++++
 assets/shaders/rounded_texture.gdshader.uid |  1 +
 core/ui/components/card.gd                  | 25 +++++++++++++++++++++++++
 core/ui/components/card.tscn                | 19 +++++++++++++++----
 4 files changed, 61 insertions(+), 4 deletions(-)

diff --git a/assets/shaders/rounded_texture.gdshader b/assets/shaders/rounded_texture.gdshader
new file mode 100644
index 0000000..5f19db2
--- /dev/null
+++ b/assets/shaders/rounded_texture.gdshader
@@ -0,0 +1,20 @@
+shader_type canvas_item;
+
+// Rounds the corners of whatever the item draws, anti-aliased over one screen pixel. The item's own
+// size goes in rect_size (in its local pixels, as VERTEX is): a TextureRect that crops its texture
+// (keep aspect covered) draws a region, so UV does not span the rect.
+uniform vec2 rect_size = vec2(200.0, 300.0);
+uniform float radius = 26.0;
+
+varying vec2 local_pos;
+
+void vertex() {
+	local_pos = VERTEX;
+}
+
+void fragment() {
+	vec2 half_size = rect_size * 0.5;
+	vec2 q = abs(local_pos - half_size) - (half_size - vec2(radius));
+	float d = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - radius;
+	COLOR.a *= clamp(0.5 - d / max(fwidth(d), 1e-4), 0.0, 1.0);
+}
diff --git a/assets/shaders/rounded_texture.gdshader.uid b/assets/shaders/rounded_texture.gdshader.uid
new file mode 100644
index 0000000..2c51115
--- /dev/null
+++ b/assets/shaders/rounded_texture.gdshader.uid
@@ -0,0 +1 @@
+uid://kpk3su3ll2gj
diff --git a/core/ui/components/card.gd b/core/ui/components/card.gd
index d88887a..b69928d 100644
--- a/core/ui/components/card.gd
+++ b/core/ui/components/card.gd
@@ -33,6 +33,8 @@ signal unhighlighted
 		value = v
 		if progress:
 			progress.value = v
+## The panel's mask, used only while something besides the art is drawn over it (_update_clip).
+@export var art_mask: StyleBox
 
 var library_item: LibraryItem
 var tapped_count := 0
@@ -47,6 +49,8 @@ var _art_gen := 0  # bumped when the art is dropped or the item changes, so a la
 @onready var tap_timer := $%TapTimer as Timer
 @onready var shine_rect := $%ShineShader as ColorRect
 @onready var god_rays_rect := $%GodRaysShader as ColorRect
+@onready var panel := $PanelContainer as PanelContainer
+@onready var no_mask := panel.get_theme_stylebox("panel")
 
 
 # Called when the node enters the scene tree for the first time.
@@ -59,6 +63,11 @@ func _ready() -> void:
 	focus_exited.connect(_on_unfocus)
 	texture.mouse_entered.connect(_on_focus)
 	texture.mouse_exited.connect(_on_unfocus)
+	texture.resized.connect(_update_art_shape)
+	for node in [progress, shine_rect, god_rays_rect]:
+		node.visibility_changed.connect(_update_clip)
+	_update_art_shape()
+	_update_clip()
 
 	# Setup a timer callback to clear number of taps on the card
 	var on_timeout := func():
@@ -76,6 +85,22 @@ func set_texture(new_texture: Texture2D) -> void:
 	texture_rect.texture = new_texture
 
 
+## The art rounds its own corners (rounded_texture.gdshader), sized to the TextureRect.
+func _update_art_shape() -> void:
+	var shape := texture.material as ShaderMaterial
+	if shape:
+		shape.set_shader_parameter("rect_size", texture.size)
+
+
+## The panel masks its children to the rounded card only while the progress bar or a focus effect is
+## drawn over the art. A mask is an offscreen pass per card: on an Adreno 610 a library page of 18
+## cards spent 3.2 ms of every frame on them.
+func _update_clip() -> void:
+	var clip: bool = progress.visible or shine_rect.visible or god_rays_rect.visible
+	panel.clip_children = CLIP_CHILDREN_ONLY if clip else CLIP_CHILDREN_DISABLED
+	panel.add_theme_stylebox_override("panel", art_mask if clip else no_mask)
+
+
 ## Configures the card with the given library item.
 func set_library_item(item: LibraryItem, free_on_remove: bool = true) -> void:
 	# Set the name based on the library item
