From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: retroforge <retroforge@invalid>
Date: Sat, 17 Oct 2026 17:05:00 +0200
Subject: [PATCH] fix(ThreadPool): start the shared pool on first use

Nothing starts the shared ThreadPool (thread_pool.tres) any more: OGUI
itself moved to SharedThread/ThreadGroup, and only its tests reference
the pool. A plugin that still uses it, such as the Steam plugin (v2.0.0,
its library refresh after login), queues its task and awaits
exec_completed from workers that never exist, so the Steam library never
loads. exec() now starts the pool when it is not running. The resource's
`size = null` is dropped, so the size is the processor count it defaults
to.

---
 core/systems/threading/thread_pool.gd   | 7 +++++++
 core/systems/threading/thread_pool.tres | 1 -
 2 files changed, 7 insertions(+), 1 deletion(-)

--- a/core/systems/threading/thread_pool.gd
+++ b/core/systems/threading/thread_pool.gd
@@ -19,6 +19,7 @@
 var threads: Array[Thread] = []
 var semaphore := Semaphore.new()
 var mutex := Mutex.new()
+var start_mutex := Mutex.new()
 var queue: Array[Task] = []
 var logger := Log.get_logger("ThreadPool", Log.LEVEL.INFO)
 
@@ -79,6 +80,12 @@
 func exec(method: Callable, name: String = "") -> Variant:
 	if size == 0:
 		return method.call()
+	# Nothing starts the shared pool (thread_pool.tres) any more, so a caller such as the Steam
+	# plugin would queue its task and await a worker that never exists. Start it on first use.
+	if not is_running():
+		start_mutex.lock()
+		start()
+		start_mutex.unlock()
 	var task := Task.new()
 	if name.is_empty():
 		task.task_name = str(method)
--- a/core/systems/threading/thread_pool.tres
+++ b/core/systems/threading/thread_pool.tres
@@ -5,4 +5,3 @@
 [resource]
 script = ExtResource("1_fb4e5")
 name = "ThreadPool"
-size = null
