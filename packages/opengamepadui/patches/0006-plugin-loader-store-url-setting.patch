From 40020bdece158fb5cc3ca4034ef7098fe61bb29f Mon Sep 17 00:00:00 2001
From: Philippe Simons <simons.philippe@gmail.com>
Date: Mon, 5 Oct 2026 22:12:52 +0200
Subject: [PATCH] feat(PluginLoader): read the plugin store URL from a project
 setting

The plugin store index URL was a constant, so a distribution shipping
OpenGamepadUI could neither point it at its own store nor turn it off,
and a device without network logged a failed store request on every
check. The URL now comes from the OpenGamepadUI/plugin/store_url project
setting, next to plugin/directory; its default is the existing store. An
empty URL turns the plugin store off: no request is made and the store
lists nothing.

Also handle a failed or malformed store response everywhere it is used:
on_update_timeout and the store menu no longer iterate over or emit
null, a non-JSON body (an HTTP error page) is logged instead of being
assigned to a Dictionary, and the HTTPRequest node is freed after a
successful request too.
---
 core/global/plugin_loader.gd                  | 30 ++++++++++++++++---
 core/ui/card_ui/settings/plugin_store_menu.gd |  2 ++
 2 files changed, 28 insertions(+), 4 deletions(-)

diff --git a/core/global/plugin_loader.gd b/core/global/plugin_loader.gd
index 93578ba4..d266d05f 100644
--- a/core/global/plugin_loader.gd
+++ b/core/global/plugin_loader.gd
@@ -17,7 +17,11 @@ class_name PluginLoader
 ## them. If the plugin metadata is valid, the loader loads the zip as a resource 
 ## pack.
 
+## Default plugin store index, used unless the project setting below says otherwise.
 const PLUGIN_STORE_URL = "https://raw.githubusercontent.com/ShadowBlip/OpenGamepadUI-plugins/main/plugins.json"
+## Project setting holding the plugin store index URL. A distribution can point it at its own store,
+## or set it to an empty string to turn the plugin store off.
+const PLUGIN_STORE_URL_SETTING = "OpenGamepadUI/plugin/store_url"
 const PLUGIN_API_VERSION = "2.0.0"
 const PLUGINS_DIR = "user://plugins"
 const LOADED_PLUGINS_DIR = "res://plugins"
@@ -93,16 +97,26 @@ func disable_plugin(plugin_id: String) -> void:
 	SettingsManager.set_value("plugins.enabled", plugin_id, false)
 
 
-## Returns the parsed dictionary of plugin store items. Returns null if there
-## is a failure.
+## Returns the URL of the plugin store index, or an empty string when the
+## plugin store is turned off.
+func get_plugin_store_url() -> String:
+	return str(ProjectSettings.get_setting(PLUGIN_STORE_URL_SETTING, PLUGIN_STORE_URL))
+
+
+## Returns the parsed dictionary of plugin store items. Returns an empty
+## dictionary if the plugin store is turned off, and null if there is a failure.
 func get_plugin_store_items() -> Variant:
 	if not parent:
 		logger.error("Plugin loader has not been initialized!")
 		return
+	var url := get_plugin_store_url()
+	if url.is_empty():
+		logger.debug("Plugin store is turned off")
+		return {}
 	var http: HTTPRequest = HTTPRequest.new()
 	parent.add_child.call_deferred(http)
 	await http.ready
-	if http.request(PLUGIN_STORE_URL) != OK:
+	if http.request(url) != OK:
 		logger.error("Error making http request to plugin store")
 		parent.remove_child(http)
 		http.queue_free()
@@ -121,8 +135,14 @@ func get_plugin_store_items() -> Variant:
 		http.queue_free()
 		return null
 
+	parent.remove_child(http)
+	http.queue_free()
+
 	# Parse the results
-	var items: Dictionary = JSON.parse_string(body.get_string_from_utf8())
+	var items: Variant = JSON.parse_string(body.get_string_from_utf8())
+	if not items is Dictionary:
+		logger.error("Plugin store returned an invalid plugin list")
+		return null
 
 	return items
 
@@ -513,6 +533,8 @@ func _is_compatible_version(version: String, target: String) -> bool:
 # Refreshes the pluign store database and reports if an updated plugin is available
 func on_update_timeout() -> void:
 	var new_store_items: Variant = await get_plugin_store_items()
+	if not new_store_items is Dictionary:
+		return
 
 	# First run, set the database
 	if plugin_store_items == {}:
diff --git a/core/ui/card_ui/settings/plugin_store_menu.gd b/core/ui/card_ui/settings/plugin_store_menu.gd
index 631b49b0..1c086317 100644
--- a/core/ui/card_ui/settings/plugin_store_menu.gd
+++ b/core/ui/card_ui/settings/plugin_store_menu.gd
@@ -25,6 +25,8 @@ func _ready() -> void:
 func load_plugin_store_items():
 	# Fetch available plugins from the plugin store
 	var plugin_items = await plugin_loader.get_plugin_store_items()
+	if not plugin_items is Dictionary:
+		plugin_items = {}
 	plugin_store_loaded.emit(plugin_items)
 
 
-- 
