From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: retroforge <retroforge@invalid>
Date: Sat, 17 Oct 2026 18:20:00 +0200
Subject: [PATCH] fix(RunningApp): a Steam launch is not over while Steam's
 reaper runs

OGUI decides a Steam game has closed when, after one non-Steam window
was seen, only Steam windows remain for 4 seconds, and then SIGTERMs the
Steam client. A first launch under Proton has longer gaps than that:
Steam's D3D driver query and Proton's prefix setup, then the game's
install scripts (DirectX, PhysX, EOS), which run windowless. OGUI killed
Steam in the middle of them every time (HW, Pocket ACE, 2026-10-17,
Trine under Proton 11 arm64).

Steam runs a launch, install scripts included, under its own reaper
("<Steam>/.../reaper SteamLaunch AppId=<id> ..."), which exits exactly
when the launch does. While one runs, the 4-second window is restarted
instead of stopping Steam. OGUI's own reaper takes the same arguments and
is told apart by its path.

---
 core/systems/launcher/running_app.gd | 29 ++++++++++++++++++++++++++++-
 1 file changed, 28 insertions(+), 1 deletion(-)

--- a/core/systems/launcher/running_app.gd
+++ b/core/systems/launcher/running_app.gd
@@ -309,7 +309,12 @@
 		# Handle cases where the game window has been missing
 		if only_steam_running and state_steam == STATE.MISSING_WINDOW:
 			var time_elapsed := Time.get_ticks_msec() - steam_missing_window_timestamp
-			if time_elapsed > 4000:
+			# Steam runs a game, and its install scripts before the first launch, under its own
+			# reaper; while that reaper lives the launch is not over, windowless installers and
+			# Proton's prefix setup included.
+			if time_elapsed > 4000 and _steam_launch_running():
+				steam_missing_window_timestamp = Time.get_ticks_msec()
+			elif time_elapsed > 4000:
 				logger.debug("Steam game missing window for 5 seconds. Assuming game closed.")
 				state_steam = STATE.STOPPING
 
@@ -328,6 +333,28 @@
 			state_steam = STATE.STOPPED
 
 
+## Returns true while Steam's own reaper for a launch ("<Steam>/.../reaper SteamLaunch AppId=...")
+## is running. OGUI's reaper takes the same arguments, so it is told apart by its path.
+func _steam_launch_running() -> bool:
+	for pid in Reaper.get_pids():
+		if Reaper.get_pid_status(pid).get("Name", "") != "reaper":
+			continue
+		# /proc files report a size of 0, so read until EOF as Reaper.get_pid_environment does.
+		var file := FileAccess.open("/proc/%d/cmdline" % pid, FileAccess.READ)
+		if not file:
+			continue
+		var data := PackedByteArray()
+		while not file.eof_reached():
+			data.append_array(file.get_buffer(4096))
+		var argv := data.get_string_from_utf8().split(char(0))
+		if argv.size() < 2 or argv[1] != "SteamLaunch":
+			continue
+		if argv[0].begins_with("/usr/share/opengamepadui/"):
+			continue
+		return true
+	return false
+
+
 ## Pauses/Resumes the running app by running 'kill -STOP' or 'kill -CONT'
 func suspend(enable: bool) -> void:
 	if enable:
