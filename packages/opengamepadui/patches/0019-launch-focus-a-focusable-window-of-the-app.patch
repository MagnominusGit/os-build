From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: retroforge <retroforge@invalid>
Date: Mon, 19 Oct 2026 08:10:00 -0700
Subject: [PATCH] fix(LaunchManager): focus a window gamescope can focus

When a launched app's window list changes, OGUI switches the gamescope
baselayer to the FIRST new window, and RunningApp.window_ids is sorted.
Steam's Big Picture window arrives together with helper windows that
have lower ids and never become focusable (a 200x200 steamwebhelper, a
64x24 one, Chromium's clipboard window), so a helper got the focus. The
focusable-windows handler then dropped that baselayer window as soon as
it was not focusable, and nothing switched to Big Picture: gamescope
stayed on OGUI's own transparent layer, a black screen over a running
Steam (HW, KONKR Pocket FIT, 2026-10-19: setting
GAMESCOPECTRL_BASELAYER_WINDOW to the Big Picture window by hand showed
it at once).

Now a new window gamescope lists as focusable is preferred (the first
new one still, when none is), and when no window is focused and a window
of a running app becomes focusable, it gets the focus.

That switch is deferred. focusable_windows_updated is emitted while
GamescopeInstance is mutably bound, and switch_window calls back into it
(gamescope.get_xwayland): godot-rust refuses that ("Gd<T>::bind()
failed, already bound"), the call returns nil and the switch is lost.
Run synchronously, it left Steam's sign-in behind OGUI's loading screen,
with Steam's sounds playing (HW, KONKR Pocket FIT, 2026-10-19).

A focused window that goes hands the focus on, too. Opening Steam
sometimes still left OpenGamepadUI's loading screen over a running
Steam: gamescope had nothing focused (GAMESCOPE_FOCUSED_WINDOW empty)
while Big Picture was in its focusable windows (KONKR Pocket FIT,
2026-11-01, issue #29). OGUI had focused one of Steam's short-lived
startup windows, and when that one went:
- remove_focus removed the baselayer window and picked no other;
- the focusable-windows handler dropped it too, then looked only for
  windows that had just become focusable, and Big Picture already was.

So when the focused window goes, the app's newest window gamescope can
focus gets the focus, in both places (whichever signal comes first); the
focus is only removed when there is none. remove_focus also leaves a
focused window that is still there alone: it switched to
new_windows[0], the lowest id, which picks a helper window.

---
 core/global/launch_manager.gd | 68 ++++++++++++++++++++++++++++-------
 1 file changed, 56 insertions(+), 12 deletions(-)

diff --git a/core/global/launch_manager.gd b/core/global/launch_manager.gd
index ee7775c..7ffb27d 100644
--- a/core/global/launch_manager.gd
+++ b/core/global/launch_manager.gd
@@ -129,12 +129,43 @@ func _init() -> void:
 		_xwayland_primary.focusable_apps_updated.connect(on_focusable_apps_changed)
 
 		# Listen for when focusable windows change
-		var on_focusable_windows_changed := func(_from: PackedInt64Array, to: PackedInt64Array):
+		var on_focusable_windows_changed := func(from: PackedInt64Array, to: PackedInt64Array):
 			# If focusable windows has changed and the currently focused window no longer exists,
 			# remove the manual focus
 			var baselayer_window := _xwayland_primary.baselayer_window
+			var dropped := false
 			if baselayer_window > 0 and not baselayer_window in to:
 				_xwayland_primary.remove_baselayer_window()
+				baselayer_window = 0
+				dropped = true
+			# With no window focused, a window of a running app that has just become focusable gets
+			# the focus. An app whose first windows never become focusable (Steam's startup and
+			# helper windows) otherwise leaves gamescope on our own layer: a black screen over a
+			# running Steam.
+			if baselayer_window > 0:
+				return
+			# And when the focused window has just gone (a launcher's splash or updater window that
+			# had the focus), the newest window of a running app gamescope can focus gets it, even
+			# one that was focusable before: Steam's Big Picture is, and gamescope was left with
+			# nothing focused, OpenGamepadUI's loading screen over a running Steam (issue #29).
+			var running := _running.duplicate()
+			running.reverse()
+			for app in running:
+				var newest := -1
+				for window in to:
+					if not window in app.window_ids:
+						continue
+					if window in from:
+						newest = maxi(newest, window)
+						continue
+					# Deferred: this signal is emitted while GamescopeInstance is bound, and
+					# switch_window calls back into it (gamescope.get_xwayland), which godot-rust
+					# refuses there ("Gd<T>::bind() failed, already bound") and the switch is lost.
+					app.switch_window.call_deferred(window)
+					return
+				if dropped and newest > 0:
+					app.switch_window.call_deferred(newest)
+					return
 		_xwayland_primary.focusable_windows_updated.connect(on_focusable_windows_changed)
 
 	# Listen for signals from the secondary Gamescope XWayland
@@ -233,28 +264,41 @@ func launch(app: LibraryLaunchItem) -> RunningApp:
 			_execute_hooks(app, AppLifecycleHook.TYPE.EXIT)
 	running_app.state_changed.connect(on_app_state_changed)
 
-	# Focus any new windows that get created
+	# Focus any new windows that get created. One gamescope can focus first: window ids come sorted,
+	# so a helper window with a lower id than the app's real one would otherwise win (Steam's Big
+	# Picture window arrives together with such helpers).
 	var switch_to_new_window := func(old_windows: PackedInt64Array, new_windows: PackedInt64Array):
+		var focusable := _xwayland_primary.get_focusable_windows() if _xwayland_primary else PackedInt64Array()
+		var first := -1
 		for window in new_windows:
 			if window in old_windows:
 				continue
-			running_app.switch_window(window)
-			break
+			if window in focusable:
+				running_app.switch_window(window)
+				return
+			if first < 0:
+				first = window
+		if first >= 0:
+			running_app.switch_window(first)
 	running_app.window_ids_changed.connect(switch_to_new_window)
 
-	# Remove/restore focus if any windows get removed
+	# When the focused window goes (a launcher's splash or updater window), the app's newest window
+	# gamescope can focus gets the focus, and only with none is it removed. Removing it outright left
+	# gamescope with nothing focused while Steam's Big Picture was there to show: OpenGamepadUI's
+	# loading screen over a running Steam (issue #29). A focused window that is still there keeps
+	# the focus: switching to new_windows[0], the lowest id, picked a helper window.
 	var remove_focus := func(old_windows: PackedInt64Array, new_windows: PackedInt64Array):
 		if not _xwayland_primary:
 			return
 		var focused_window := _xwayland_primary.baselayer_window
-		if not focused_window in old_windows:
-			return
-		if not focused_window in new_windows:
-			_xwayland_primary.remove_baselayer_window()
+		if not focused_window in old_windows or focused_window in new_windows:
 			return
-		# TODO: Use the most recently created window instead of just the first in the list
-		var new_window := new_windows[0]
-		running_app.switch_window(new_window)
+		var focusable := _xwayland_primary.get_focusable_windows()
+		for i in range(new_windows.size() - 1, -1, -1):
+			if new_windows[i] in focusable:
+				running_app.switch_window(new_windows[i])
+				return
+		_xwayland_primary.remove_baselayer_window()
 	running_app.window_ids_changed.connect(remove_focus)
 
 	# Run the application
-- 
2.55.0

