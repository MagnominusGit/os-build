+## Loads the focus profile on every gamepad: from now until a game has focus again, every input
+## goes to OpenGamepadUI over DBus.
+func set_focus_profile() -> void:
+	_ogui_focused = true
+	if not FileAccess.file_exists(FOCUS_PROFILE):
+		logger.error("Focus profile missing, OpenGamepadUI will not see gamepad input: " + FOCUS_PROFILE)
+		return
+	for device: CompositeDevice in input_plumber.get_composite_devices():
+		device.load_profile_path(FOCUS_PROFILE)
+
+
+## Loads the profile of whoever has focus now, e.g. on a gamepad that was just added.
+func refresh_gamepad_profile() -> void:
+	if _ogui_focused:
+		set_focus_profile()
+	else:
+		set_app_gamepad_profile(_current_app)
+
+
+## Copies the focus profile out of the pack: InputPlumber reads profiles from the filesystem.
+func _install_focus_profile() -> void:
+	var source := FileAccess.get_file_as_string(FOCUS_PROFILE_SOURCE)
+	if source.is_empty():
+		logger.error("Unable to read the focus profile: " + FOCUS_PROFILE_SOURCE)
+		return
+	DirAccess.make_dir_recursive_absolute(FOCUS_PROFILE.get_base_dir())
+	var file := FileAccess.open(FOCUS_PROFILE, FileAccess.WRITE)
+	if not file:
+		logger.error("Unable to write the focus profile: " + FOCUS_PROFILE)
+		return
+	file.store_string(source)
+
+
+## The profile a launcher declared for the running game, or "" when there is none or its owner
+## is gone.
+func _get_declared_profile() -> String:
+	if not FileAccess.file_exists(_declared_profile):
+		return ""
+	var lines := FileAccess.get_file_as_string(_declared_profile).split("\n", false)
+	if lines.size() < 2 or not lines[1].is_valid_int():
+		logger.warn("Ignoring a malformed profile declaration: " + _declared_profile)
+		return ""
+	if not DirAccess.dir_exists_absolute("/proc/" + lines[1]):
+		logger.debug("Ignoring the profile declaration of a launcher that is gone: " + lines[1])
+		return ""
+	if not FileAccess.file_exists(lines[0]):
+		logger.warn("Declared gamepad profile does not exist: " + lines[0])
+		return ""
+	return lines[0]
+
+
+## OpenGamepadUI's Guide combos, mapped inside the layer Guide holds in a game's profile: the
+## source button and the DBus action it sends instead while Guide is held.
+const GUIDE_COMBOS := [["South", "ui_quick"], ["North", "ui_osk"]]
+
+
+## Returns a profile that carries OpenGamepadUI's Guide handling, which intercept mode used to do:
+## Guide holds a layer and sends ui_guide (InputPlumber taps it on release only when nothing in the
+## layer was used), and the layer maps GUIDE_COMBOS (Guide+A quick bar, Guide+Y keyboard). Rows the
+## profile maps itself win; a profile that maps Guide without a layer is left alone. Works on the
+## JSON directly, after the target modification, since InputPlumberProfile drops `layers`.
+func _with_guide_layer(profile_path: String) -> String:
+	var profile = JSON.parse_string(FileAccess.get_file_as_string(profile_path))
+	if not profile is Dictionary:
+		logger.warn("Unable to parse " + profile_path + ", Guide may not reach OpenGamepadUI in game")
+		return profile_path
+	if not profile.get("mapping") is Array:
+		profile["mapping"] = []
+	if not profile.get("layers") is Array:
+		profile["layers"] = []
+
+	# The layer Guide holds: the profile's own, or a new one
+	var layer_name := ""
+	var guide_mapping = _find_button_mapping(profile["mapping"], "Guide")
+	if guide_mapping:
+		for target in guide_mapping.get("target_events", []):
+			if target is Dictionary and target.get("layer") is Dictionary:
+				layer_name = target["layer"].get("name", "")
+		if layer_name.is_empty():
+			return profile_path
+	else:
+		layer_name = "ogui_guide"
+		profile["mapping"].append({
+			"name": "Guide (OpenGamepadUI)",
+			"source_event": {"gamepad": {"button": "Guide"}},
+			"target_events": [{"layer": {"name": layer_name}}, {"dbus": "ui_guide"}],
+		})
+
+	var layer = null
+	for candidate in profile["layers"]:
+		if candidate is Dictionary and candidate.get("name") == layer_name:
+			layer = candidate
+	if layer == null:
+		layer = {"name": layer_name, "mapping": []}
+		profile["layers"].append(layer)
+	if not layer.get("mapping") is Array:
+		layer["mapping"] = []
+
+	var changed := guide_mapping == null
+	for combo in GUIDE_COMBOS:
+		if _find_button_mapping(layer["mapping"], combo[0]):
+			continue
+		layer["mapping"].append({
+			"name": "Guide+" + combo[0] + " (OpenGamepadUI)",
+			"source_event": {"gamepad": {"button": combo[0]}},
+			"target_events": [{"dbus": combo[1]}],
+		})
+		changed = true
+	if not changed:
+		return profile_path
+
+	var guided := profile_path.trim_suffix(".json") + "_guide.json"
+	var file := FileAccess.open(guided, FileAccess.WRITE)
+	if not file:
+		logger.error("Unable to save " + guided + ", Guide will not reach OpenGamepadUI in game")
+		return profile_path
+	file.store_string(JSON.stringify(profile, "\t"))
+	return guided
+
+
+## The first mapping in the list whose source is the given gamepad button, or null.
+func _find_button_mapping(mappings: Array, button: String):
+	for mapping in mappings:
+		if not mapping is Dictionary:
+			continue
+		var source = mapping.get("source_event")
+		if source is Dictionary and source.get("gamepad") is Dictionary \
+				and source["gamepad"].get("button") == button:
+			return mapping
+	return null
+
