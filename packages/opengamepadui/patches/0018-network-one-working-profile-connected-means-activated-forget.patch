+## The first Wi-Fi device. The instance is loaded again each time: after NetworkManager restarts,
+## the NetworkManager node replaces it with one that knows the new devices.
+func _wifi_device() -> NetworkDevice:
+	network_manager = load(NETWORK_MANAGER_PATH) as NetworkManagerInstance
+	for device in network_manager.get_devices():
+		if device.wireless != null:
+			return device
+	return null
+
+
+## The row of the given network. Looked up by name: the selection can move during a join.
+func _item_for(ssid: String) -> TreeItem:
+	for item in get_root().get_children():
+		if item.get_metadata(0) == ssid:
+			return item
+	return null
+
+
+func _set_status(item: TreeItem, text: String) -> void:
+	if item and is_instance_valid(item):
+		item.set_text(4, text)
+
+
+func _end_connect() -> void:
+	connecting = false
+	_connecting_ssid = ""
+
+
+## Runs job on a worker thread (nmcli blocks) and returns what it returned.
+func _off_thread(job: Callable) -> Variant:
+	var result := []
+	var task := WorkerThreadPool.add_task(func(): result.append(job.call()))
+	while not WorkerThreadPool.is_task_completed(task):
+		await get_tree().process_frame
+	WorkerThreadPool.wait_for_task_completion(task)
+	return result[0] if not result.is_empty() else null
