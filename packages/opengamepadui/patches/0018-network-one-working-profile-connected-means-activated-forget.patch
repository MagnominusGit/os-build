--- a/core/systems/network/network_manager.gd
+++ b/core/systems/network/network_manager.gd
@@ -6,6 +6,13 @@ class_name NetworkManager
 ##
 ## The [NetworkManager] class is responsible for loading a [NetworkManagerInstance] and
 ## calling its 'process()' method each frame.
+##
+## The instance learns NetworkManager's devices when it is created and then follows its signals,
+## which miss whatever a restarted NetworkManager exports in its first moments: after a restart it
+## knew only the Wi-Fi P2P device, so the Wi-Fi settings logged "No wifi devices found" and every
+## join had no effect until OGUI was restarted (HW, Air X, 2026-10-18). When the instance no
+## longer knows the Wi-Fi device it knew before, a new one takes over the resource path (code that
+## loads it again gets the new one). The replaced instance is still processed: its signals queue.
 
 const bar_0 := preload("res://assets/ui/icons/wifi-none.svg")
 const bar_1 := preload("res://assets/ui/icons/wifi-low.svg")
@@ -16,6 +23,15 @@ const ethernet := preload("res://assets/ui/icons/mdi--ethernet.svg")
 
 @export var instance: NetworkManagerInstance = load("res://core/systems/network/network_manager.tres") as NetworkManagerInstance
 
+## Seconds between two looks for an instance that lost its Wi-Fi device.
+const RECHECK_SECS := 5.0
+## New instances tried, one per look, before a vanished Wi-Fi device counts as really gone.
+const MAX_RETRIES := 6
+var _replaced: Array[NetworkManagerInstance] = []
+var _since_check := 0.0
+var _had_wifi := false
+var _retries := 0
+
 
 ## Returns the texture reflecting the given wifi strength
 static func get_strength_texture(strength: int) -> Texture2D:
@@ -28,7 +44,38 @@ static func get_strength_texture(strength: int) -> Texture2D:
 	return bar_0
 
 
-func _process(_delta: float) -> void:
+func _process(delta: float) -> void:
 	if not instance:
 		return
 	instance.process()
+	for old in _replaced:
+		old.process()
+	_since_check += delta
+	if _since_check < RECHECK_SECS:
+		return
+	_since_check = 0.0
+	if has_wifi(instance) or not _had_wifi:
+		_had_wifi = has_wifi(instance)
+		return
+	if not instance.is_running():
+		return  # stopped: look again once it is back
+	var fresh := NetworkManagerInstance.new()
+	if not has_wifi(fresh):
+		# Still starting up, or the device is really gone: give up after a few looks.
+		_retries += 1
+		if _retries >= MAX_RETRIES:
+			_had_wifi = false
+			_retries = 0
+		return
+	_retries = 0
+	fresh.take_over_path(instance.resource_path)
+	_replaced.append(instance)
+	instance = fresh
+
+
+## Whether the given instance knows a Wi-Fi device.
+static func has_wifi(manager: NetworkManagerInstance) -> bool:
+	for device in manager.get_devices():
+		if device.wireless != null:
+			return true
+	return false
diff --git a/core/systems/network/network_profiles.gd b/core/systems/network/network_profiles.gd
new file mode 100644
index 0000000..3122494
--- /dev/null
+++ b/core/systems/network/network_profiles.gd
@@ -0,0 +1,61 @@
+extends RefCounted
+
+## NetworkManager's saved Wi-Fi profiles for one SSID, through nmcli.
+##
+## The core's NetworkAccessPoint.connect() adds a new profile on every join, and nothing in the
+## core lists or deletes profiles. So a second join with a corrected password left the first
+## profile, wrong password and all, next to the new one, and a network could never be forgotten
+## from the UI. NetworkManager authorizes these calls for the active local session, as it does the
+## core's AddConnection.
+##
+## Every call blocks on nmcli (each bounded by TIMEOUT): run them off the main thread.
+
+## The nmcli to run (tests point this at a fake).
+static var nmcli := "nmcli"
+## Seconds before an nmcli call is given up on (NetworkManager not answering).
+const TIMEOUT := "10"
+
+
+## UUIDs of the saved Wi-Fi profiles for the given SSID.
+static func uuids_for(ssid: String) -> PackedStringArray:
+	var found := PackedStringArray()
+	if ssid.is_empty():
+		return found
+	var out := []
+	if _run(["-t", "-f", "UUID,TYPE", "connection", "show"], out) != 0:
+		return found
+	for line in (out[0] as String).split("\n", false):
+		var fields := line.split(":")
+		if fields.size() != 2 or fields[1] != "802-11-wireless":
+			continue
+		# -e no: the SSID as it is, not with ':' and '\' escaped.
+		var value := []
+		if _run(["-e", "no", "-g", "802-11-wireless.ssid", "connection", "show", "uuid", fields[0]], value) != 0:
+			continue
+		if (value[0] as String).trim_suffix("\n") == ssid:
+			found.append(fields[0])
+	return found
+
+
+## The profiles to delete after a join, from the SSID's profiles before and after it: once it
+## worked, the ones saved before it (the new password replaces them); if it did not, the one it
+## added (a mistyped password is not kept, nor retried by NetworkManager in the background).
+static func stale_after_join(saved_before: PackedStringArray, saved_now: PackedStringArray, joined: bool) -> PackedStringArray:
+	var stale := PackedStringArray()
+	for uuid in saved_now:
+		if (uuid in saved_before) == joined:
+			stale.append(uuid)
+	return stale
+
+
+## Deletes the given profiles. Returns how many NetworkManager deleted.
+static func delete(uuids: PackedStringArray) -> int:
+	var deleted := 0
+	for uuid in uuids:
+		if _run(["connection", "delete", "uuid", uuid], []) == 0:
+			deleted += 1
+	return deleted
+
+
+static func _run(args: Array, out: Array) -> int:
+	return OS.execute("timeout", [TIMEOUT, nmcli] + args, out)
