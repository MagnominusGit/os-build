+## Follows the activation connect() started until it is up or gone. Right after the call the device
+## can still report the previous connection's state (ACTIVATED), and the access point is the active
+## one from the first association attempt, so neither means connected: the activation's own state
+## does. Returns "" once activated, otherwise the status to show.
+func _wait_for_activation(active: NetworkActiveConnection, device: NetworkDevice, item: TreeItem,
+		with_password: bool) -> String:
+	if not active:
+		return "Failed to connect"
+	var authenticated := false
+	var gone := 0
+	for i in range(ACTIVATION_POLLS):
 		await get_tree().create_timer(0.5).timeout
+		var state := active.state
+		var device_state := device.state
+		logger.info("Activation state: %d, device state: %d" % [state, device_state])
+		if state == NetworkActiveConnection.NM_ACTIVE_CONNECTION_STATE_ACTIVATED:
+			return ""
+		if device_state >= NetworkDevice.NM_DEVICE_STATE_IP_CONFIG and device_state <= NetworkDevice.NM_DEVICE_STATE_SECONDARIES:
+			authenticated = true
+		# NetworkManager removes a failed activation: its state then reads UNKNOWN.
+		if state in [NetworkActiveConnection.NM_ACTIVE_CONNECTION_STATE_DEACTIVATING,
+				NetworkActiveConnection.NM_ACTIVE_CONNECTION_STATE_DEACTIVATED]:
+			break
+		gone = gone + 1 if state == NetworkActiveConnection.NM_ACTIVE_CONNECTION_STATE_UNKNOWN else 0
+		if gone >= 2:
+			break
+		# Until then the device may still be in, or leaving, the previous connection.
+		var text := status_text(device_state)
+		_set_status(item, "Connecting" if text in ["", "Connected", "Disconnecting"] else text)
+	if with_password and not authenticated:
+		return WRONG_PASSWORD
+	return "Failed to connect"
 
