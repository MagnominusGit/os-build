+## Whether NetworkManager has a saved profile for the given network.
+func is_saved(ssid: String) -> bool:
+	var uuids: PackedStringArray = await _off_thread(func(): return NetworkProfiles.uuids_for(ssid))
+	return not uuids.is_empty()
 
 
