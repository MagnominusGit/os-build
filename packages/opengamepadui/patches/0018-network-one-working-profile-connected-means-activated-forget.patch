+## Deletes every saved profile of the given network, disconnecting from it if it is in use.
+## Returns how many NetworkManager deleted.
+func forget(ssid: String) -> int:
+	var deleted: int = await _off_thread(func(): return NetworkProfiles.delete(NetworkProfiles.uuids_for(ssid)))
+	logger.info("Forgot %s: %d saved profile(s) deleted" % [ssid, deleted])
+	_set_status(_item_for(ssid), "")
+	return deleted
