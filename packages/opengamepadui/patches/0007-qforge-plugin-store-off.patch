From d6f48a750d024a78baee4189360ba8411fde1cfb Mon Sep 17 00:00:00 2001
From: Philippe Simons <simons.philippe@gmail.com>
Date: Mon, 5 Oct 2026 22:12:58 +0200
Subject: [PATCH] QForge: turn the plugin store off

Upstream's store lists Steam, x86 and desktop plugins, none of which
work on QForge, and the request fails on every offline start. QForge
ships its own plugin in the image; its own store comes with the update
server (plan Phase 5), which this setting will then point at.
---
 project.godot | 1 +
 1 file changed, 1 insertion(+)

diff --git a/project.godot b/project.godot
index 29834fcf..413d07cc 100644
--- a/project.godot
+++ b/project.godot
@@ -11,6 +11,7 @@ config_version=5
 [OpenGamepadUI]
 
 plugin/directory="user://plugins"
+plugin/store_url=""
 data/directory="user://data"
 cache/directory="user://cache"
 
-- 
