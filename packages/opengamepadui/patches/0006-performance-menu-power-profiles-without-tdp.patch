From b105d98338db2addc19ae3dc2f2f023d169b5251 Mon Sep 17 00:00:00 2001
From: Philippe Simons <simons.philippe@gmail.com>
Date: Sat, 10 Oct 2026 17:32:42 +0200
Subject: [PATCH] feat(Performance Menu): power profiles (CPU + GPU governors)
 without a TDP

The power profile dropdown was tied to TDP-capable AMD APUs: shown only
when HardwareManager matched one, only in simple mode, and each choice a
preset that also reset the core count, the GPU clocks and the mode.
Toggling the mode forced max-performance whenever the GPU offered any
profile.

PowerStation still reports profiles on its GPU interface, but on a device
with no TDP (an SoC, e.g. Adreno through PowerStation's devfreq backend)
a profile picks how both the CPU and the GPU clocks scale (their
governors). It is not a limit, and it is independent of everything else
in the menu. When the GPU has no TDP:

- show the dropdown when PowerStation reports profiles, in both modes,
  since advanced mode has no TDP slider to take its place;
- apply a choice on its own, without the presets;
- keep the profile in force when the mode is toggled.

Since a profile covers both the CPU and the GPU, the dropdown moves above
the Advanced Mode toggle, so it is clearly not one of the advanced
controls. A TDP-capable GPU still shows it only in simple mode, now in that
same place; otherwise it behaves exactly as before.

(cherry picked from commit dd5cb3920a5d9a0d1622b3f0044909e76d83b0cf)
---
 core/ui/common/quick_bar/performance_menu.gd  | 26 +++++++++++++++++--
 .../ui/common/quick_bar/performance_menu.tscn | 12 ++++-----
 2 files changed, 30 insertions(+), 8 deletions(-)

diff --git a/core/ui/common/quick_bar/performance_menu.gd b/core/ui/common/quick_bar/performance_menu.gd
index c8892478..1bdddba4 100644
--- a/core/ui/common/quick_bar/performance_menu.gd
+++ b/core/ui/common/quick_bar/performance_menu.gd
@@ -106,6 +106,12 @@ func _ready() -> void:
 		if _profile_loading:
 			return
 
+		# Without a TDP, a power profile is not a preset for the other
+		# controls: it only picks how the clocks scale, so apply it alone.
+		if not _gpu_has_tdp():
+			apply_timer.start()
+			return
+
 		var new_profile: PerformanceProfile
 		if _profiles_available[index] == "power-saving":
 			new_profile = _create_powersaving_profile()
@@ -276,6 +282,11 @@ func _setup_interface() -> void:
 	var tdp_capable := gpu_info != null and gpu_info.tdp_capable
 	var temp_capable := gpu_info != null and gpu_info.tj_temp_capable
 	var profile_capable := gpu_info != null and gpu_info.power_profile_capable
+	# A GPU without a TDP (an SoC GPU) has power profiles when PowerStation
+	# reports some. Advanced mode has no TDP slider to take their place, so
+	# they stay in both modes.
+	if not tdp_capable and not _profiles_available.is_empty():
+		profile_capable = true
 
 	tdp_slider.visible = is_advanced and tdp_capable
 	tdp_boost_slider.visible = is_advanced and tdp_capable
@@ -286,7 +297,7 @@ func _setup_interface() -> void:
 
 	gpu_freq_enable.visible = is_advanced
 
-	power_profile_dropdown.visible = not is_advanced and profile_capable
+	power_profile_dropdown.visible = profile_capable and (not is_advanced or not tdp_capable)
 
 	gpu_freq_min_slider.visible = card.manual_clock and is_advanced
 	gpu_freq_min_slider.min_value = round(card.clock_limit_mhz_min)
@@ -299,6 +310,13 @@ func _setup_interface() -> void:
 	gpu_temp_slider.visible = is_advanced and temp_capable
 
 
+## Returns true when the GPU has a TDP to set. Without one, a power profile
+## is independent of every other control in this menu.
+func _gpu_has_tdp() -> bool:
+	var gpu_info := _hardware_manager.gpu
+	return gpu_info != null and gpu_info.tdp_capable
+
+
 ## Returns the primary integrated GPU instance
 func _get_integrated_card() -> GpuCard:
 		var card: GpuCard
@@ -341,8 +359,12 @@ func _create_performance_profile(is_advanced: bool) -> PerformanceProfile:
 	var profiles := _performance_manager.get_power_profiles_available() as PackedStringArray
 	if "custom" in profiles:
 		profiles.remove_at(profiles.find("custom"))
+	# Without a TDP the power profile is independent of the controls reset
+	# here: keep the one in force rather than switch to max-performance.
+	if not _gpu_has_tdp() and _current_profile and _current_profile.gpu_power_profile in profiles:
+		new_profile.gpu_power_profile = _current_profile.gpu_power_profile
 	# Avoid showing power profiles when not supported
-	if not profiles.is_empty():
+	elif not profiles.is_empty():
 		if not "max-performance" in profiles and not "performance" in profiles:
 			logger.error("Performance profile not found. Unable to assume sane performance defaults.")
 			return null
diff --git a/core/ui/common/quick_bar/performance_menu.tscn b/core/ui/common/quick_bar/performance_menu.tscn
index 06a49d33..f3eb5c90 100644
--- a/core/ui/common/quick_bar/performance_menu.tscn
+++ b/core/ui/common/quick_bar/performance_menu.tscn
@@ -45,6 +45,12 @@ visible = false
 layout_mode = 2
 text = "Refresh Rate"
 
+[node name="PowerProfileDropdown" parent="." unique_id=428999822 instance=ExtResource("8_j2331")]
+visible = false
+layout_mode = 2
+title = "Power Profile"
+description = ""
+
 [node name="ModeToggle" parent="." unique_id=1950806605 instance=ExtResource("7_j02ci")]
 unique_name_in_owner = true
 layout_mode = 2
@@ -176,9 +182,3 @@ text = "GPU Temp Limit"
 value = 70.0
 max_value = 105.0
 min_value = 70.0
-
-[node name="PowerProfileDropdown" parent="." unique_id=428999822 instance=ExtResource("8_j2331")]
-visible = false
-layout_mode = 2
-title = "Power Profile"
-description = ""
