From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: retroforge <retroforge@invalid>
Date: Sat, 24 Oct 2026 07:20:00 -0700
Subject: [PATCH] fix(RunningApp): a Steam launch counts once Steam starts the
 game

Through the client, a launch first goes through Steam's own steps: its
launch-option prompt, the game's install scripts, cloud and stats sync,
then a "Processing Vulkan shaders" prompt that waits for the player. The
install scripts run in Proton, whose hidden windows are not Steam's, so
they set the game running; with them gone only Steam's windows were left,
no reaper ran (Steam had not started the game yet), and 4 s later Steam
was stopped at its shader prompt (HW, MANGMI Air X, 2026-10-24: Hades,
twice).

Steam starts install scripts under "reaper SteamLaunch AppId=<id>
Install=1" and the game under the same reaper without Install=1. The
launch now counts as started once that reaper for the game itself has
run; until then Steam's steps take as long as they take. After it the
rule is unchanged.

---
 core/systems/launcher/running_app.gd | 17 +++++++++++++++--
 1 file changed

--- a/core/systems/launcher/running_app.gd
+++ b/core/systems/launcher/running_app.gd
@@ -70,6 +70,9 @@
 			state_changed.emit(old_state, state)
 var state_steam: STATE = STATE.STARTED
 var steam_missing_window_timestamp: int
+## Steam's reaper for the game itself has run (not one for its install scripts): before that, Steam's
+## own steps of the launch (its prompts, install scripts, cloud sync) are not the game.
+var steam_game_launched := false
 ## Whether or not the running app is suspended
 var is_suspended := false:
 	set(v):
@@ -284,6 +287,13 @@
 
 	# If this is a Steam app, we also need to wait until Steam starts the game
 	if state_steam == STATE.STARTED:
+		# Until then Steam may wait on the player (launch option, shader processing) and run install
+		# scripts, whose Proton windows are not the game's: they set the game running, and with them
+		# gone Steam was stopped at its shader prompt (HW, MANGMI Air X, 2026-10-24).
+		if not steam_game_launched:
+			steam_game_launched = _steam_launch_running(true)
+			if not steam_game_launched:
+				return
 		for window in self.window_ids:
 			if self.is_steam_window(window):
 				continue
@@ -336,8 +346,9 @@
 
 
 ## Returns true while Steam's own reaper for a launch ("<Steam>/.../reaper SteamLaunch AppId=...")
-## is running. OGUI's reaper takes the same arguments, so it is told apart by its path.
-func _steam_launch_running() -> bool:
+## is running. OGUI's reaper takes the same arguments, so it is told apart by its path. With
+## game_only, a reaper for install scripts ("SteamLaunch AppId=<id> Install=1 --") does not count.
+func _steam_launch_running(game_only := false) -> bool:
 	for pid in Reaper.get_pids():
 		if Reaper.get_pid_status(pid).get("Name", "") != "reaper":
 			continue
@@ -358,6 +369,8 @@
 			continue
 		if argv[0].begins_with("/usr/share/opengamepadui/"):
 			continue
+		if game_only and "Install=1" in argv.slice(2, maxi(argv.find("--"), 2)):
+			continue
 		return true
 	return false
 
