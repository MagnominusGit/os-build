# retroforge-gpu-priority — games run at LOW GPU priority, below the shell.
#
# WHY. The shell (OpenGamepadUI and its in-game overlay), Xwayland and mangoapp submit at MEDIUM;
# so does a game, and on drm/msm the same priority means the same ring, where the UI's frames wait
# behind every frame the game has queued — the overlay stutters in game. Measured by Kettle Linux
# on an SM8550 handheld over Skyrim (Steam's Quick Access, 60 Hz, 60 fps limit): 16-49 fps, p95
# 33-49 ms without this; a steady 60, p95 17 ms with it. Raising the UI instead (TU_DEBUG=hiprio)
# also reached 60 fps but froze the menus twice in 15 minutes, so the game goes down rather than
# the UI up.
#
# HOW. VK_LAYER_RETROFORGE_game_priority chains vkCreateDevice and adds
# VkDeviceQueueGlobalPriorityCreateInfoKHR(LOW) to every queue the game did not give a priority
# itself, enabling VK_KHR/EXT_global_priority. Turnip turns LOW into msm level 11 = ring 3 on the
# A7xx (SM8550 A740, SM8650 A750: four preemptible rings), MEDIUM into level 8 = ring 2, so the
# UI preempts the game. On the single-ring A650 (SM8250) and A610 (SM6115) LOW and MEDIUM are the
# same level and the layer changes nothing; the kernel's within-ring order (kernel/patches/0270)
# is what keeps the UI ahead there. If the driver refuses LOW, the game's own request is created
# unchanged. GL emulators never load it: only Vulkan has the layer, and freedreno GL keeps its
# own queue priority.
#
# SCOPE. The manifest's enable_environment gates it on RETROFORGE_GAME_LOWPRIO=1, which
# usr/bin/retroforge-launch puts in the environment of every emulator it starts (ROM cards and
# --gui alike), never the shell's own. Off for one emulator with "env":
# {"DISABLE_RETROFORGE_GAME_LOWPRIO": "1"} in its emulator.json.
pkgname=retroforge-gpu-priority
pkgver=1.0
pkgrel=1
pkgdesc='Vulkan layer: games run at low GPU priority, below the shell'
arch=('aarch64')
license=('BSD-3-Clause')
depends=('glibc' 'vulkan-icd-loader')
makedepends=('vulkan-headers')
source=()

prepare() {
  # Empty on purpose: build-overlay.sh applies patches/0001 right after this cd, and that patch
  # is the source.
  mkdir -p "${pkgname}"
  cd "${pkgname}"
}

build() {
  cd "${pkgname}"
  cc ${CFLAGS} ${LDFLAGS} -shared -fPIC -fvisibility=hidden \
    -o libVkLayer_retroforge_game_priority.so game_priority.c -lpthread
}

package() {
  cd "${pkgname}"
  install -Dm755 libVkLayer_retroforge_game_priority.so -t "${pkgdir}/usr/lib"
  install -Dm644 VkLayer_retroforge_game_priority.json -t "${pkgdir}/usr/share/vulkan/implicit_layer.d"
  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
