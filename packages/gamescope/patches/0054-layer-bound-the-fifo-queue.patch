+        const bool fifo = presentMode == VK_PRESENT_MODE_FIFO_KHR || presentMode == VK_PRESENT_MODE_FIFO_RELAXED_KHR;
+        const int limit = fifo ? getFifoQueueLimit(forceFifo) : -1;
+        if (limit < 0 || (pPresentTimes && pPresentTimes->pTimes))
+          continue;
+        if (!armedSerials[i]) {
