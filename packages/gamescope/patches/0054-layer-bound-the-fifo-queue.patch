+      // Hold the app until no more than the limit of its FIFO frames is still waiting to be latched.
+      for (uint32_t i = 0; i < presentInfo.swapchainCount; i++) {
+        auto gamescopeSwapchain = gamescopeSwapchains.find(presentInfo.pSwapchains[i]);
+        if (!gamescopeSwapchain)
+          continue;
+        const bool bounded = queueLimits[i] >= 0 && presentInfo.pResults[i] >= VK_SUCCESS;
+        auto &recent = gamescopeSwapchain->recentSerials;
+        recent[gamescopeSwapchain->presentCount++ % recent.size()] = bounded ? armedSerials[i] : 0;
+        if (!bounded || gamescopeSwapchain->presentCount <= uint64_t(queueLimits[i]))
+          continue;
+        if (const uint64_t serial = recent[(gamescopeSwapchain->presentCount - 1 - queueLimits[i]) % recent.size()])
+          WaitForFifoQueue(*gamescopeSwapchain, serial);
+      }
