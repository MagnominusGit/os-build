+  // Waits up to timeoutNs for events on queue and dispatches them. Another thread may dispatch
+  // the same queue, so callers re-check their condition after each return.
+  static int waylandWaitEvents(wl_display *display, wl_event_queue *queue, wl_event_queue *globalsQueue, uint64_t timeoutNs) {
+    if (wl_display_dispatch_queue_pending(display, globalsQueue) < 0 ||
+        wl_display_dispatch_queue_pending(display, queue) < 0)
+      return -1;
+    while (wl_display_prepare_read_queue(display, queue) < 0) {
+      if (errno != EAGAIN && errno != EINTR)
+        return -1;
+      if (wl_display_dispatch_queue_pending(display, queue) < 0)
+        return -1;
+    }
+    if (wl_display_flush(display) < 0 && errno != EAGAIN) {
+      wl_display_cancel_read(display);
+      return -1;
+    }
+    pollfd fd = { .fd = wl_display_get_fd(display), .events = POLLIN };
+    timespec timeout = { .tv_sec = time_t(timeoutNs / 1'000'000'000), .tv_nsec = long(timeoutNs % 1'000'000'000) };
+    int ret = ppoll(&fd, 1, &timeout, nullptr);
+    if (ret <= 0) {
+      wl_display_cancel_read(display);
+      return ret < 0 && errno != EINTR ? -1 : 0;
+    }
+    if (wl_display_read_events(display) < 0)
+      return -1;
+    if (wl_display_dispatch_queue_pending(display, globalsQueue) < 0 ||
+        wl_display_dispatch_queue_pending(display, queue) < 0)
+      return -1;
+    return 1;
+  }
