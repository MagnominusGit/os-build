+    // Waits until the compositor has reported serial, shown or discarded. Nothing is reported
+    // before gamescope first shows the window, so the wait starts with the first report. The bound
+    // only trims latency, so a compositor that stops reporting costs at most MaxWait per present
+    // rather than a hang.
+    static void WaitForFifoQueue(GamescopeSwapchainData &swapchain, uint64_t serial) {
+      if (!swapchain.reportedSerial->load(std::memory_order_acquire))
+        return;
+      constexpr uint64_t MaxWait = 100'000'000;
+      const uint64_t deadline = getTimeMonotonic() + MaxWait;
+      while (swapchain.reportedSerial->load(std::memory_order_acquire) < serial && !*swapchain.retired) {
+        const uint64_t now = getTimeMonotonic();
+        if (now >= deadline) {
+          if (!std::exchange(swapchain.warnedQueueWait, true))
+            fprintf(stderr, "[Gamescope WSI] FIFO queue: no report for present serial %lu in 100 ms, presenting on.\n", serial);
+          return;
+        }
+        if (waylandWaitEvents(swapchain.display, swapchain.eventQueue, swapchain.globalsQueue,
+                              std::min<uint64_t>(deadline - now, 2'000'000)) < 0)
+          return;
+      }
+    }
