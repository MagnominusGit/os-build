             gamescope_swapchain_set_present_timing(gamescopeSwapchain->object, 0, 0, 0, 0, 0);
           if (timingSerials[i] && presentInfo.pResults[i] < VK_SUCCESS) {
             std::lock_guard lock(*gamescopeSwapchain->presentTimingMutex);
@@ -2132,9 +2235,45 @@
