+      // FIFO queue bound (getFifoQueueLimit). A present the app times itself keeps its serial; an
+      // untimed one gets an internal serial so the compositor reports it as well. Apps on
+      // VK_GOOGLE_display_timing pace themselves and are left alone: that protocol reports no
+      // discarded frames, so a wait on it could stall.
+      std::vector<int> queueLimits(presentInfo.swapchainCount, -1);
+      std::vector<bool> internalArmed(presentInfo.swapchainCount, false);
+      for (uint32_t i = 0; i < presentInfo.swapchainCount; i++) {
+        auto gamescopeSwapchain = gamescopeSwapchains.find(presentInfo.pSwapchains[i]);
+        if (!gamescopeSwapchain || !gamescopeSwapchain->timingEvents ||
+            !(gamescopeSwapchain->isWayland || gamescopeSwapchain->isBypassingXWayland))
+          continue;
+        VkPresentModeKHR presentMode = oOriginalPresentModeInfo ? oOriginalPresentModeInfo->pPresentModes[i] : gamescopeSwapchain->presentMode;
+        if (forceFifo && !frameLimiterAware)
