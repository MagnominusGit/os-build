+  // How many FIFO frames a swapchain may have waiting in gamescope's queue before
+  // vkQueuePresentKHR holds the app until the oldest has been latched; the _LIMITED value applies
+  // while gamescope's frame limiter is active. 0 there would start each frame right after the
+  // previous one was latched, but a game needing most of the cap interval per frame then falls
+  // to the next lower rate (31 ms frames under a 30 fps cap ran at 20 fps). -1 ("off") removes
+  // the bound.
+  static constexpr int MaxFifoQueueLimit = 3;
+  static int parseFifoQueueLimit(const char *envName, int fallback) {
+    const char *str = std::getenv(envName);
+    if (!str || !*str)
+      return fallback;
+    int value = fallback;
+    if (str == "off"sv)
+      value = -1;
+    else if (auto parsed = parseEnv<int>(envName); parsed && *parsed >= 0)
+      value = std::min(*parsed, MaxFifoQueueLimit);
+    fprintf(stderr, "[Gamescope WSI] %s=%s: FIFO queue limit %d\n", envName, str, value);
+    return value;
+  }
+
+  static int getFifoQueueLimit(bool frameLimited) {
+    static const int s_limit = parseFifoQueueLimit("GAMESCOPE_WSI_FIFO_QUEUE", 1);
+    static const int s_limitedLimit = parseFifoQueueLimit("GAMESCOPE_WSI_FIFO_QUEUE_LIMITED", 1);
+    return frameLimited ? s_limitedLimit : s_limit;
+  }
