@@ -1097,6 +1097,8 @@ static void setup_secondary_output( struct drm_t *drm )
 	if ( !pMode )
 		return fail( "no mode" );
 	sec.mode = *pMode;
+	// The panel's orientation property (a rotated panel reports which side is up).
+	sec.pConnector->UpdateEffectiveOrientation( &sec.mode );
 
 	if ( drmModeCreatePropertyBlob( drm->fd, &sec.mode, sizeof( sec.mode ), &sec.uModeBlobId ) != 0 )
 		return fail( "cannot create its mode blob" );
@@ -5141,6 +5143,19 @@ namespace gamescope
 			return &s_HeadlessConnector;
 		}
 
+		virtual bool GetSecondaryOutputSize( uint32_t *puWidth, uint32_t *puHeight ) override
+		{
+			const drm_secondary_t &sec = g_DRMSecondary;
+			if ( !sec.pConnector )
+				return false;
+
+			const GamescopePanelOrientation eOrientation = sec.pConnector->GetCurrentOrientation();
+			const bool bSideways = eOrientation == GAMESCOPE_PANEL_ORIENTATION_90 || eOrientation == GAMESCOPE_PANEL_ORIENTATION_270;
+			*puWidth = bSideways ? sec.mode.vdisplay : sec.mode.hdisplay;
+			*puHeight = bSideways ? sec.mode.hdisplay : sec.mode.vdisplay;
+			return true;
+		}
+
 		virtual IBackendConnector *GetConnector( GamescopeScreenType eScreenType ) override
 		{
 			if ( g_DRM.pConnector && g_DRM.pConnector->GetScreenType() == eScreenType )
