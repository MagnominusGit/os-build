 std::unordered_map<gamescope::VirtualConnectorKey_t, global_focus_t> g_VirtualConnectorFocuses;
+
+// Dual-screen boards (--secondary-output). The windows of an emulator's second screen
+// (bOnSecondaryOutput) are never focus candidates for the main output; the secondary focus
+// shows the newest of them on the second panel, sized to it. Unlike g_VirtualConnectorFocuses
+// it takes no part in Steam/OpenGamepadUI focus control: no appid, no overlays, no input focus.
+static bool g_bSecondaryOutput = false;
+static uint32_t g_uSecondaryOutputWidth = 0;
+static uint32_t g_uSecondaryOutputHeight = 0;
+static std::optional<std::regex> g_SecondaryWindowTitle;
+static global_focus_t g_SecondaryFocus;
+// melonDS prefixes "[w2] " to its second window's title, Azahar ends its with "| Secondary Window".
+static constexpr const char *k_pszDefaultSecondaryWindowTitle = R"(^\[w2\] |\| Secondary Window$)";
 global_focus_t *GetCurrentFocus()
 {
 	uint64_t ulKey = GetBackend()->GetCurrentConnector() ? GetBackend()->GetCurrentConnector()->GetVirtualConnectorKey() : 0;
@@ -1580,6 +1593,7 @@ bool steamcompmgr_window_should_refresh_switch( steamcompmgr_win_t *w )
 #define STEAM_PROP			"STEAM_BIGPICTURE"
 #define OVERLAY_PROP		"STEAM_OVERLAY"
 #define EXTERNAL_OVERLAY_PROP		"GAMESCOPE_EXTERNAL_OVERLAY"
+#define OUTPUT_PROP			"GAMESCOPE_OUTPUT"
 #define MANGOAPP_MSG_TYPE_PROP		"GAMESCOPE_MANGOAPP_MSG_TYPE"
 #define GAMES_RUNNING_PROP 	"STEAM_GAMES_RUNNING"
 #define SCREEN_SCALE_PROP	"STEAM_SCREEN_SCALE"
@@ -4665,6 +4679,13 @@ found:;
 			continue;
 		}
 
+		// Shown on the secondary output. Also keeps it out of GAMESCOPE_FOCUSABLE_WINDOWS and out
+		// of a GAMESCOPECTRL_BASELAYER_WINDOW match (OpenGamepadUI names the newest window of a game).
+		if ( w->bOnSecondaryOutput )
+		{
+			continue;
+		}
+
 		// Skip overlay targets
 		if ( w->oulTargetVROverlay && !cv_vr_show_forwarded_overlays )
 		{
@@ -5670,6 +5691,41 @@ determine_and_apply_focus( global_focus_t *pFocus )
 	pFocus->ulCurrentFocusSerial = GetFocusSerial();
 }
 
+// The secondary output shows the newest viewable window tagged for it, at the panel's size.
+static void determine_and_apply_secondary_focus()
+{
+	std::vector< steamcompmgr_win_t* > vecCandidates;
+	gamescope_xwayland_server_t *server = NULL;
+	for ( size_t i = 0; ( server = wlserver_get_xwayland_server( i ) ); i++ )
+	{
+		for ( steamcompmgr_win_t *w = server->ctx->list; w; w = w->xwayland().next )
+		{
+			if ( w->bOnSecondaryOutput && w->xwayland().a.map_state == IsViewable && w->xwayland().a.c_class == InputOutput )
+				vecCandidates.push_back( w );
+		}
+	}
+	std::stable_sort( vecCandidates.begin(), vecCandidates.end(), is_focus_priority_greater );
+
+	steamcompmgr_win_t *pFocusWindow = vecCandidates.empty() ? nullptr : vecCandidates.front();
+	if ( pFocusWindow != g_SecondaryFocus.focusWindow )
+	{
+		if ( pFocusWindow )
+			focus_log.infof( "Secondary output shows %s (%x)", pFocusWindow->debug_name(), pFocusWindow->id() );
+		else
+			focus_log.infof( "Secondary output shows nothing" );
+	}
+	g_SecondaryFocus.focusWindow = pFocusWindow;
+
+	if ( pFocusWindow && ( (uint32_t)pFocusWindow->GetGeometry().nWidth != g_uSecondaryOutputWidth ||
+	                       (uint32_t)pFocusWindow->GetGeometry().nHeight != g_uSecondaryOutputHeight ) )
+	{
+		xwayland_ctx_t *ctx = pFocusWindow->xwayland().ctx;
+		XMoveResizeWindow( ctx->dpy, pFocusWindow->xwayland().id, 0, 0, g_uSecondaryOutputWidth, g_uSecondaryOutputHeight );
+	}
+
+	g_SecondaryFocus.ulCurrentFocusSerial = GetFocusSerial();
+}
+
 static void
 get_win_type(xwayland_ctx_t *ctx, steamcompmgr_win_t *w)
 {
@@ -5838,12 +5894,37 @@ get_win_icon(xwayland_ctx_t* ctx, steamcompmgr_win_t* w)
 	get_prop(ctx, w->xwayland().id, ctx->atoms.netWMIcon, *w->icon.get());
 }
 
+// Recomputes whether a window belongs on the secondary output: its GAMESCOPE_OUTPUT property when
+// it has one, else the title rule.
+static void update_win_output( steamcompmgr_win_t *w )
+{
+	bool bSecondary = false;
+	if ( g_bSecondaryOutput )
+	{
+		if ( w->bHasOutputProp )
+			bSecondary = w->uOutputProp == 1;
+		else if ( w->title && g_SecondaryWindowTitle )
+			bSecondary = std::regex_search( *w->title, *g_SecondaryWindowTitle );
+	}
+
+	if ( bSecondary == w->bOnSecondaryOutput )
+		return;
+
+	w->bOnSecondaryOutput = bSecondary;
+	focus_log.infof( "%s (%x) %s the secondary output", w->debug_name(), w->id(), bSecondary ? "goes to" : "leaves" );
+	MakeFocusDirty();
+}
+
 static void
 handle_desktop_window(steamcompmgr_win_t *w)
 {
 	if ( !w )
 		return;
 
+	// Sized to the secondary output by its own focus.
+	if ( w->bOnSecondaryOutput )
+		return;
+
 	if ( win_has_game_id( w ) || w->bIsSteamPid || w->bIsSteamWebHelperPid || w->bIsVRWebHelperPid )
 		return;
 
@@ -5934,6 +6015,8 @@ map_win(xwayland_ctx_t* ctx, Window id, unsigned long sequence)
 	w->isOverlay = get_prop(ctx, w->xwayland().id, ctx->atoms.overlayAtom, 0);
 	w->isExternalOverlay = get_prop(ctx, w->xwayland().id, ctx->atoms.externalOverlayAtom, 0, &w->bHasExternalOverlayProp);
 	w->uMangoappMsgType = get_prop(ctx, w->xwayland().id, ctx->atoms.mangoappMsgTypeAtom, 0);
+	w->uOutputProp = get_prop(ctx, w->xwayland().id, ctx->atoms.gamescopeOutputAtom, 0, &w->bHasOutputProp);
+	update_win_output( w );
 
 	// misyl: Disable appID for overlay types, as parts of the code don't expect that focus-wise.
 	// Fixes mangoapp usage when nested, and not in SteamOS.
@@ -6327,6 +6410,15 @@ static void configure_request(xwayland_ctx_t *ctx, XConfigureRequestEvent *confi
 
 	// Take a client's own drag out of the pointer position so it does not chase itself.
 	steamcompmgr_win_t *w = find_win( ctx, configureRequest->window, false );
+
+	// A window on the secondary output keeps the panel's size.
+	if ( w && w->bOnSecondaryOutput )
+	{
+		changes.x = 0;
+		changes.y = 0;
+		changes.width = g_uSecondaryOutputWidth;
+		changes.height = g_uSecondaryOutputHeight;
+	}
 	if ( w && ( configureRequest->value_mask & ( CWX | CWY ) ) && w->xwayland().a.map_state == IsViewable )
 	{
 		// Any window moved during a press may be the drag target, the anchor only applies under the pointer.
@@ -6447,6 +6539,9 @@ destroy_win(xwayland_ctx_t *ctx, Window id, bool gone, bool fade)
 		std::erase_if(pFocus->decorationWindows, [id](steamcompmgr_win_t *w) { return x11_win(w) == id; });
 	}
 
+	if (x11_win(g_SecondaryFocus.focusWindow) == id)
+		g_SecondaryFocus.focusWindow = nullptr;
+
 #if HAVE_PIPEWIRE
 	// The pipewire repick can retain the old focus when no candidates remain.
 	if (x11_win(s_PipewireFocus.focusWindow) == id)
@@ -7154,6 +7249,15 @@ handle_property_notify(xwayland_ctx_t *ctx, XPropertyEvent *ev)
 			MakeFocusDirty();
 		}
 	}
+	if (ev->atom == ctx->atoms.gamescopeOutputAtom)
+	{
+		steamcompmgr_win_t * w = find_win(ctx, ev->window);
+		if (w)
+		{
+			w->uOutputProp = get_prop(ctx, w->xwayland().id, ctx->atoms.gamescopeOutputAtom, 0, &w->bHasOutputProp);
+			update_win_output( w );
+		}
+	}
 	if (ev->atom == ctx->atoms.externalOverlayAtom)
 	{
 		steamcompmgr_win_t * w = find_win(ctx, ev->window);
@@ -7269,6 +7373,7 @@ handle_property_notify(xwayland_ctx_t *ctx, XPropertyEvent *ev)
 		if (w)
 		{
 			get_win_title(ctx, w, ev->atom);
+			update_win_output( w );
 
 			for ( auto &iter : g_VirtualConnectorFocuses )
 			{
@@ -9116,6 +9221,7 @@ void init_xwayland_ctx(uint32_t serverId, gamescope_xwayland_server_t *xwayland_
 	ctx->atoms.gameAtom = XInternAtom(ctx->dpy, GAME_PROP, false);
 	ctx->atoms.overlayAtom = XInternAtom(ctx->dpy, OVERLAY_PROP, false);
 	ctx->atoms.externalOverlayAtom = XInternAtom(ctx->dpy, EXTERNAL_OVERLAY_PROP, false);
+	ctx->atoms.gamescopeOutputAtom = XInternAtom(ctx->dpy, OUTPUT_PROP, false);
 	ctx->atoms.mangoappMsgTypeAtom = XInternAtom(ctx->dpy, MANGOAPP_MSG_TYPE_PROP, false);
 	ctx->atoms.opacityAtom = XInternAtom(ctx->dpy, OPACITY_PROP, false);
 	ctx->atoms.gamesRunningAtom = XInternAtom(ctx->dpy, GAMES_RUNNING_PROP, false);
@@ -10192,6 +10298,23 @@ steamcompmgr_main(int argc, char **argv)
 		set_string_prop( root_ctx, root_ctx->atoms.gamescopeMainSteamVROverlay, *g_pVROverlayKey );
 	}
 
+	g_bSecondaryOutput = GetBackend()->GetSecondaryOutputSize( &g_uSecondaryOutputWidth, &g_uSecondaryOutputHeight );
+	if ( g_bSecondaryOutput )
+	{
+		const char *pszTitle = g_sSecondaryWindowTitle ? g_sSecondaryWindowTitle : k_pszDefaultSecondaryWindowTitle;
+		try
+		{
+			if ( *pszTitle )
+				g_SecondaryWindowTitle.emplace( pszTitle, std::regex::ECMAScript | std::regex::optimize );
+		}
+		catch ( const std::regex_error &e )
+		{
+			xwm_log.errorf( "--secondary-window-title '%s' is not a valid regex (%s): only GAMESCOPE_OUTPUT places windows", pszTitle, e.what() );
+		}
+		xwm_log.infof( "Secondary output %ux%u, windows titled /%s/ or with GAMESCOPE_OUTPUT=1 go there",
+			g_uSecondaryOutputWidth, g_uSecondaryOutputHeight, pszTitle );
+	}
+
 	update_edid_prop();
 
 	update_screenshot_color_mgmt();
@@ -10715,6 +10838,9 @@ steamcompmgr_main(int argc, char **argv)
 			}
 		}
 
+		if ( g_bSecondaryOutput && g_SecondaryFocus.IsDirty() )
+			determine_and_apply_secondary_focus();
+
 		if ( g_bPendingFocusInfo.exchange( false ) )
 			DumpFocusInfo();
 
