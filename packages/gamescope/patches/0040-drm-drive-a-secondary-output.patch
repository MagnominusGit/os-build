+
 		if ( pPlane->GetProperties().type->GetCurrentValue() == DRM_PLANE_TYPE_PRIMARY )
 			return pPlane.get();
 	}
@@ -783,9 +828,300 @@ static bool have_overlay_planes(struct drm_t *drm)
 	return false;
 }
 
+static void OnSecondaryPatternChanged( gamescope::ConVar<bool> & );
+gamescope::ConVar<bool> cv_drm_debug_secondary_pattern( "drm_debug_secondary_pattern", false, "Flip the secondary output between two greys every vblank and log its flip rate.", OnSecondaryPatternChanged );
+
+// Puts uFbId on the secondary output with a non-blocking flip; the first one also modesets
+// it. Fails while the previous flip is pending: never waits, so a slow panel cannot hold up
+// the main output. Caller holds g_DRMSecondary.mutCommit.
+static bool drm_secondary_commit_locked( struct drm_t *drm, uint32_t uFbId )
+{
+	drm_secondary_t &sec = g_DRMSecondary;
+	if ( !sec.pConnector || sec.bFlipPending || drm->paused )
+		return false;
+
+	drmModeAtomicReq *req = drmModeAtomicAlloc();
+	defer( drmModeAtomicFree( req ) );
+
+	auto add = [ req ]( uint32_t uObjectId, const std::optional<gamescope::CDRMAtomicProperty> &oProperty, uint64_t ulValue )
+	{
+		if ( oProperty )
+			drmModeAtomicAddProperty( req, uObjectId, oProperty->GetPropertyId(), ulValue );
+	};
+
+	uint32_t uFlags = DRM_MODE_ATOMIC_NONBLOCK | DRM_MODE_PAGE_FLIP_EVENT;
+	const uint32_t uCRTCId = sec.pCRTC->GetObjectId();
+	const auto &crtcProps = sec.pCRTC->GetProperties();
+	if ( !sec.bModeSet )
+	{
+		uFlags |= DRM_MODE_ATOMIC_ALLOW_MODESET;
+		add( sec.pConnector->GetObjectId(), sec.pConnector->GetProperties().CRTC_ID, uCRTCId );
+		add( uCRTCId, crtcProps.ACTIVE, 1 );
+		add( uCRTCId, crtcProps.MODE_ID, sec.uModeBlobId );
+		// No colour management on this output yet: drop whatever a previous DRM master left.
+		add( uCRTCId, crtcProps.GAMMA_LUT, 0 );
+		add( uCRTCId, crtcProps.DEGAMMA_LUT, 0 );
+		add( uCRTCId, crtcProps.DPU_3D_LUT, 0 );
+		add( uCRTCId, crtcProps.CTM, 0 );
+		add( uCRTCId, crtcProps.VRR_ENABLED, 0 );
+	}
+
+	const uint32_t uPlaneId = sec.pPlane->GetObjectId();
+	const auto &planeProps = sec.pPlane->GetProperties();
+	add( uPlaneId, planeProps.FB_ID, uFbId );
+	add( uPlaneId, planeProps.CRTC_ID, uCRTCId );
+	add( uPlaneId, planeProps.SRC_X, 0 );
+	add( uPlaneId, planeProps.SRC_Y, 0 );
+	add( uPlaneId, planeProps.SRC_W, uint64_t( sec.mode.hdisplay ) << 16 );
+	add( uPlaneId, planeProps.SRC_H, uint64_t( sec.mode.vdisplay ) << 16 );
+	add( uPlaneId, planeProps.CRTC_X, 0 );
+	add( uPlaneId, planeProps.CRTC_Y, 0 );
+	add( uPlaneId, planeProps.CRTC_W, sec.mode.hdisplay );
+	add( uPlaneId, planeProps.CRTC_H, sec.mode.vdisplay );
+	add( uPlaneId, planeProps.rotation, DRM_MODE_ROTATE_0 );
+	add( uPlaneId, planeProps.alpha, 0xFFFF );
+
+	int ret = drmModeAtomicCommit( drm->fd, req, uFlags, &g_DRMSecondary );
+	if ( ret != 0 )
+	{
+		// -EACCES: VT-switched away. Log the first failure and then every 600th, a
+		// rejected flip would otherwise repeat every frame.
+		if ( ret != -EACCES && sec.uFailedCommits++ % 600 == 0 )
+			drm_log.errorf( "secondary output %s: commit failed: %s (%u so far)", sec.pConnector->GetName(), strerror( -ret ), sec.uFailedCommits );
+		return false;
+	}
+
+	if ( !sec.bModeSet )
+		drm_log.infof( "secondary output %s: modeset %ux%u@%u on CRTC %u, plane %u", sec.pConnector->GetName(),
+			sec.mode.hdisplay, sec.mode.vdisplay, sec.mode.vrefresh, uCRTCId, uPlaneId );
+
+	sec.bModeSet = true;
+	sec.bFlipPending = true;
+	return true;
+}
+
+// Until the compositor paints this output it shows black, or the debug pattern.
+static void drm_secondary_show_debug_fb_locked( struct drm_t *drm )
+{
+	drm_secondary_t &sec = g_DRMSecondary;
+	uint32_t uNext = cv_drm_debug_secondary_pattern ? ( sec.uDebugFb == 1 ? 2 : 1 ) : 0;
+	if ( sec.bModeSet && uNext == sec.uDebugFb )
+		return;
+
+	if ( drm_secondary_commit_locked( drm, sec.uDebugFbIds[ uNext ] ) )
+		sec.uDebugFb = uNext;
+}
+
+// After a VT switch (another DRM master may have changed everything) or a forced modeset, the
+// next commit modesets again. A flip pending across the pause may never report back.
+static void drm_secondary_needs_modeset()
+{
+	std::scoped_lock lock{ g_DRMSecondary.mutCommit };
+	g_DRMSecondary.bModeSet = false;
+	g_DRMSecondary.bFlipPending = false;
+}
+
+// Called with the main output's state polls: (re)shows the output after a modeset request or a
+// failed commit, once the session is active.
+static void drm_secondary_refresh( struct drm_t *drm )
+{
+	std::scoped_lock lock{ g_DRMSecondary.mutCommit };
+	drm_secondary_show_debug_fb_locked( drm );
+}
+
+static void OnSecondaryPatternChanged( gamescope::ConVar<bool> & )
+{
+	std::scoped_lock lock{ g_DRMSecondary.mutCommit };
+	g_DRMSecondary.ulPatternFlips = 0;
+	g_DRMSecondary.ulMaxInterval = 0;
+	drm_secondary_show_debug_fb_locked( &g_DRM );
+}
+
+static void drm_secondary_page_flip( uint64_t ulVBlankTime )
+{
+	drm_secondary_t &sec = g_DRMSecondary;
+	std::scoped_lock lock{ sec.mutCommit };
+	sec.bFlipPending = false;
+
+	if ( cv_drm_debug_secondary_pattern )
+	{
+		if ( sec.ulPatternFlips++ == 0 )
+			sec.ulPatternStart = ulVBlankTime;
+		else
+			sec.ulMaxInterval = std::max( sec.ulMaxInterval, ulVBlankTime - sec.ulLastVBlank );
+
+		if ( sec.ulPatternFlips % 600 == 0 )
+		{
+			const double flSeconds = double( ulVBlankTime - sec.ulPatternStart ) / 1'000'000'000.0;
+			drm_log.infof( "secondary output pattern: %" PRIu64 " flips in %.1f s (%.2f/s), longest interval %.2f ms",
+				sec.ulPatternFlips, flSeconds, double( sec.ulPatternFlips - 1 ) / flSeconds, double( sec.ulMaxInterval ) / 1'000'000.0 );
+		}
+	}
+	sec.ulLastVBlank = ulVBlankTime;
+
+	drm_secondary_show_debug_fb_locked( &g_DRM );
+}
+
+static bool drm_secondary_create_debug_fb( struct drm_t *drm, uint32_t uColor, uint32_t *pFbId )
+{
+	const drmModeModeInfo &mode = g_DRMSecondary.mode;
+	uint32_t uHandle = 0, uPitch = 0;
+	uint64_t ulSize = 0, ulOffset = 0;
+	if ( drmModeCreateDumbBuffer( drm->fd, mode.hdisplay, mode.vdisplay, 32, 0, &uHandle, &uPitch, &ulSize ) != 0 )
+		return false;
+
+	bool bOk = drmModeMapDumbBuffer( drm->fd, uHandle, &ulOffset ) == 0;
+	void *pData = bOk ? mmap( nullptr, ulSize, PROT_WRITE, MAP_SHARED, drm->fd, ulOffset ) : MAP_FAILED;
+	bOk = pData != MAP_FAILED;
+	if ( bOk )
+	{
+		for ( uint32_t y = 0; y < mode.vdisplay; y++ )
+			std::fill_n( reinterpret_cast<uint32_t *>( static_cast<uint8_t *>( pData ) + y * uPitch ), mode.hdisplay, uColor );
+		munmap( pData, ulSize );
+
+		uint32_t uHandles[4] = { uHandle }, uPitches[4] = { uPitch }, uOffsets[4] = {};
+		bOk = drmModeAddFB2( drm->fd, mode.hdisplay, mode.vdisplay, DRM_FORMAT_XRGB8888, uHandles, uPitches, uOffsets, pFbId, 0 ) == 0;
+	}
+
+	// The FB keeps the buffer alive.
+	drmModeDestroyDumbBuffer( drm->fd, uHandle );
+	return bOk;
+}
+
+// Claims the --secondary-output connector, a CRTC and primary plane for it, and its preferred
+// mode. Runs before libliftoff learns the planes, so liftoff never gets this one. Any failure
+// leaves the session on one output.
+static void setup_secondary_output( struct drm_t *drm )
+{
+	drm_secondary_t &sec = g_DRMSecondary;
+	if ( !g_sSecondaryOutputName || !*g_sSecondaryOutputName )
+		return;
+
+	auto fail = [ &sec ]( const char *pszWhy )
+	{
+		drm_log.errorf( "secondary output %s: %s, running with one output", g_sSecondaryOutputName, pszWhy );
+		sec.pConnector = nullptr;
+		sec.pCRTC = nullptr;
+		sec.pPlane = nullptr;
+	};
+
+	for ( auto &iter : drm->connectors )
+	{
+		if ( strcmp( iter.second.GetName(), g_sSecondaryOutputName ) == 0 )
+			sec.pConnector = &iter.second;
+	}
+	if ( !sec.pConnector || sec.pConnector->GetModeConnector()->connection != DRM_MODE_CONNECTED )
+		return fail( "no such connected connector" );
+
+	// Keep the CRTC already driving this connector (the boot console leaves every panel lit).
+	// Moving the connector to another CRTC leaves that one active with no connector, which the
+	// kernel rejects, and the main output's first modeset would turn it off under the connector.
+	// Otherwise take the last CRTC no other connector uses, so the main output keeps the first.
+	const uint64_t ulCurrentCRTCId = sec.pConnector->GetProperties().CRTC_ID->GetCurrentValue();
+	auto crtcUsedByOther = [ & ]( const gamescope::CDRMCRTC *pCRTC )
+	{
+		for ( auto &iter : drm->connectors )
+		{
+			if ( &iter.second != sec.pConnector && iter.second.GetProperties().CRTC_ID->GetCurrentValue() == pCRTC->GetObjectId() )
+				return true;
+		}
+		return false;
+	};
+	for ( std::unique_ptr< gamescope::CDRMCRTC > &pCRTC : drm->crtcs )
+	{
+		if ( pCRTC->GetObjectId() == ulCurrentCRTCId && ( sec.pConnector->GetPossibleCRTCMask() & pCRTC->GetCRTCMask() ) )
+			sec.pCRTC = pCRTC.get();
+	}
+	for ( auto iter = drm->crtcs.rbegin(); iter != drm->crtcs.rend() && !sec.pCRTC; iter++ )
+	{
+		if ( ( sec.pConnector->GetPossibleCRTCMask() & (*iter)->GetCRTCMask() ) && !crtcUsedByOther( iter->get() ) )
+			sec.pCRTC = iter->get();
+	}
+	if ( !sec.pCRTC )
+		return fail( "no free CRTC" );
+
+	// Same for the plane: the primary plane already on that CRTC, else the last free one.
+	auto isPrimaryFor = [ & ]( const gamescope::CDRMPlane *pPlane )
+	{
+		return ( pPlane->GetModePlane()->possible_crtcs & sec.pCRTC->GetCRTCMask() ) &&
+			pPlane->GetProperties().type->GetCurrentValue() == DRM_PLANE_TYPE_PRIMARY;
+	};
+	for ( std::unique_ptr< gamescope::CDRMPlane > &pPlane : drm->planes )
+	{
+		if ( isPrimaryFor( pPlane.get() ) && pPlane->GetModePlane()->crtc_id == sec.pCRTC->GetObjectId() )
+			sec.pPlane = pPlane.get();
+	}
+	for ( auto iter = drm->planes.rbegin(); iter != drm->planes.rend() && !sec.pPlane; iter++ )
+	{
+		const uint32_t uPlaneCRTCId = (*iter)->GetModePlane()->crtc_id;
+		if ( isPrimaryFor( iter->get() ) && ( uPlaneCRTCId == 0 || uPlaneCRTCId == sec.pCRTC->GetObjectId() ) )
+			sec.pPlane = iter->get();
+	}
+	if ( !sec.pPlane )
+		return fail( "no free primary plane" );
+
+	// Never at the main output's expense: some other connected connector must keep a CRTC and a
+	// primary plane, or gamescope would not start at all.
+	bool bMainKeepsAnOutput = false;
+	for ( auto &iter : drm->connectors )
+	{
+		gamescope::CDRMConnector *pOther = &iter.second;
+		if ( pOther == sec.pConnector || pOther->GetModeConnector()->connection != DRM_MODE_CONNECTED )
+			continue;
+
+		for ( std::unique_ptr< gamescope::CDRMCRTC > &pCRTC : drm->crtcs )
+		{
+			if ( pCRTC.get() == sec.pCRTC || !( pOther->GetPossibleCRTCMask() & pCRTC->GetCRTCMask() ) )
+				continue;
+
+			for ( std::unique_ptr< gamescope::CDRMPlane > &pPlane : drm->planes )
+			{
+				if ( pPlane.get() != sec.pPlane && ( pPlane->GetModePlane()->possible_crtcs & pCRTC->GetCRTCMask() ) &&
+					 pPlane->GetProperties().type->GetCurrentValue() == DRM_PLANE_TYPE_PRIMARY )
+					bMainKeepsAnOutput = true;
+			}
+		}
+	}
+	if ( !bMainKeepsAnOutput )
+		return fail( "the main output would have no CRTC or primary plane left" );
+
+	const drmModeConnector *pModeConnector = sec.pConnector->GetModeConnector();
+	const drmModeModeInfo *pMode = nullptr;
+	for ( int i = 0; i < pModeConnector->count_modes && !pMode; i++ )
+	{
+		if ( pModeConnector->modes[i].type & DRM_MODE_TYPE_PREFERRED )
+			pMode = &pModeConnector->modes[i];
+	}
+	if ( !pMode && pModeConnector->count_modes > 0 )
+		pMode = &pModeConnector->modes[0];
+	if ( !pMode )
+		return fail( "no mode" );
+	sec.mode = *pMode;
+
+	if ( drmModeCreatePropertyBlob( drm->fd, &sec.mode, sizeof( sec.mode ), &sec.uModeBlobId ) != 0 )
+		return fail( "cannot create its mode blob" );
+
+	const uint32_t uDebugColors[3] = { 0x00000000, 0x00303030, 0x00323232 };
+	for ( int i = 0; i < 3; i++ )
+	{
+		if ( !drm_secondary_create_debug_fb( drm, uDebugColors[i], &sec.uDebugFbIds[i] ) )
+			return fail( "cannot create its framebuffers" );
+	}
+
+	drm_log.infof( "secondary output %s: CRTC %u, plane %u, %ux%u@%u", sec.pConnector->GetName(),
+		sec.pCRTC->GetObjectId(), sec.pPlane->GetObjectId(), sec.mode.hdisplay, sec.mode.vdisplay, sec.mode.vrefresh );
+}
