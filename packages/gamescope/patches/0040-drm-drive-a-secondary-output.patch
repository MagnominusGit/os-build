 struct drm_t g_DRM = {};
 
+// --secondary-output: a second panel driven next to the main output (dual-screen boards).
+// It owns its connector, CRTC and primary plane outright: the main output's connector and
+// plane selection, modesets, foreign-plane cleanup and libliftoff never touch them, and it is
+// committed with its own non-blocking atomic requests. Separate commits per CRTC, because the
+// two panels are not genlocked and a joint commit would hold the main flip until the other
+// panel's vblank. Its properties are written raw rather than through CDRMAtomicProperty, whose
+// pending/current tracking the main path commits and rolls back for every object at once.
+struct drm_secondary_t
+{
+	gamescope::CDRMConnector *pConnector = nullptr;
+	gamescope::CDRMCRTC *pCRTC = nullptr;
+	gamescope::CDRMPlane *pPlane = nullptr;
+	drmModeModeInfo mode = {};
+	uint32_t uModeBlobId = 0;
+
+	// Commits come from more than one thread (the debug pattern flips from the
+	// flip handler thread), so everything below is guarded by this.
+	std::mutex mutCommit;
+	bool bModeSet = false;
+	bool bFlipPending = false;
+	uint32_t uFailedCommits = 0;
+
+	// Until the compositor paints this output: [0] black, and two greys one step
+	// apart that drm_debug_secondary_pattern flips between every vblank.
+	uint32_t uDebugFbIds[3] = {};
+	uint32_t uDebugFb = 0;
+
+	uint64_t ulPatternFlips = 0;
+	uint64_t ulPatternStart = 0;
+	uint64_t ulLastVBlank = 0;
+	uint64_t ulMaxInterval = 0;
+};
+static drm_secondary_t g_DRMSecondary;
+
 // Flip handler thread control. Keep the thread object global so we
 // can join it during shutdown instead of detaching and risking the
 // thread still using the DRM fd while we clean up.
@@ -670,6 +706,9 @@ static gamescope::CDRMCRTC *find_crtc_for_connector( struct drm_t *drm, gamescop
 {
 	for ( std::unique_ptr< gamescope::CDRMCRTC > &pCRTC : drm->crtcs )
 	{
+		if ( pCRTC.get() == g_DRMSecondary.pCRTC )
+			continue;
+
 		if ( pConnector->GetPossibleCRTCMask() & pCRTC->GetCRTCMask() )
 			return pCRTC.get();
 	}
@@ -744,6 +783,9 @@ static gamescope::CDRMPlane *find_primary_plane(struct drm_t *drm)
 
 	for ( std::unique_ptr< gamescope::CDRMPlane > &pPlane : drm->planes )
 	{
