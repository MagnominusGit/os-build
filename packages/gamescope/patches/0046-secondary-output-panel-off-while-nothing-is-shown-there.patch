diff --git a/src/steamcompmgr.cpp b/src/steamcompmgr.cpp
index e8565de..3fd104c 100644
--- a/src/steamcompmgr.cpp
+++ b/src/steamcompmgr.cpp
@@ -5710,6 +5710,29 @@ determine_and_apply_focus( global_focus_t *pFocus )
 	pFocus->ulCurrentFocusSerial = GetFocusSerial();
 }
 
+gamescope::ConVar<bool> cv_secondary_output_off_when_unused( "secondary_output_off_when_unused", true, "Turn the secondary output's panel off while no window is shown there." );
+
+// How long the secondary output stays on with nothing to show: a window remapping (an emulator
+// changing its screen layout) should not blank and relight the panel.
+static constexpr uint64_t k_ulSecondaryOutputOffDelay = 2'000'000'000ul;
+
+// The secondary panel is on while a window is shown there, and turns off once none has been for
+// k_ulSecondaryOutputOffDelay. Called every vblank, before painting it.
+static void update_secondary_output_power()
+{
+	static uint64_t s_ulLastInUse = get_time_in_nanos();
+	const uint64_t ulNow = get_time_in_nanos();
+	if ( g_SecondaryFocus.focusWindow || !cv_secondary_output_off_when_unused )
+	{
+		s_ulLastInUse = ulNow;
+		GetBackend()->SetSecondaryOutputActive( true );
+	}
+	else if ( ulNow - s_ulLastInUse >= k_ulSecondaryOutputOffDelay )
+	{
+		GetBackend()->SetSecondaryOutputActive( false );
+	}
+}
+
 // Paints the secondary focus onto the secondary output when it has new content and the output can
 // take a frame. Direct scanout first: on an unrotated panel, a buffer the size of the output goes
 // on the plane as is. Otherwise (a rotated panel, other sizes, or a buffer the plane refuses) the
@@ -11168,7 +11191,10 @@ steamcompmgr_main(int argc, char **argv)
 		// The secondary output paints on its own: it never sets bPainted, so the main output's
 		// repaint state and frame pacing do not see it.
 		if ( vblank && g_bSecondaryOutput )
+		{
+			update_secondary_output_power();
 			paint_secondary_output();
+		}
 
 		if ( vblank && g_bUpdateForwardedVROverlays )
 		{
