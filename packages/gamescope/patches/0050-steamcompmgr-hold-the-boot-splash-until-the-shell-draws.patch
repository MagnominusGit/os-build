 }
 
+void CVulkanCmdBuffer::copyBufferToImageRect(VkBuffer buffer, VkDeviceSize offset, gamescope::Rc<CVulkanTexture> dst, uint32_t x, uint32_t y, uint32_t width, uint32_t height)
+{
+	prepareDestImage(dst.get());
+	insertBarrier();
+	VkBufferImageCopy region = {
+		.bufferOffset = offset,
+		.imageSubresource = {
+			.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+			.layerCount = 1,
+		},
+		.imageOffset = { int32_t(x), int32_t(y), 0 },
+		.imageExtent = { width, height, 1 },
+	};
+
+	m_device->vk.CmdCopyBufferToImage(m_cmdBuffer, buffer, dst->vkImage(), VK_IMAGE_LAYOUT_GENERAL, 1, &region);
+
+	markDirty(dst.get());
+
+	m_textureRefs.emplace_back(std::move(dst));
+}
+
 void CVulkanCmdBuffer::clearImage(gamescope::Rc<CVulkanTexture> dst, const VkClearColorValue &color)
 {
 	prepareDestImage(dst.get());
@@ -4331,6 +4352,23 @@ gamescope::OwningRc<CVulkanTexture> vulkan_create_texture_from_bits( uint32_t wi
 	return pTex;
 }
 
+void vulkan_upload_texture_rect( gamescope::Rc<CVulkanTexture> pTex, uint32_t x, uint32_t y, uint32_t width, uint32_t height, const void *bits )
+{
+	// In bands the upload buffer holds: a whole frame of a panel past 1080p does not fit in it.
+	const uint32_t uRowSize = width * DRMFormatGetBPP( pTex->drmFormat() );
+	const uint32_t uBandRows = std::max<uint32_t>( CVulkanDevice::upload_buffer_size / uRowSize, 1u );
+	for ( uint32_t uRow = 0; uRow < height; uRow += uBandRows )
+	{
+		const uint32_t uRows = std::min( uBandRows, height - uRow );
+		auto [ dst, offset ] = g_device.uploadBufferData( uRows * uRowSize );
+		memcpy( dst, (const uint8_t *)bits + size_t( uRow ) * uRowSize, size_t( uRows ) * uRowSize );
+
+		auto cmdBuffer = g_device.commandBuffer();
+		cmdBuffer->copyBufferToImageRect( g_device.uploadBuffer(), offset, pTex, x, y + uRow, width, uRows );
+		g_device.wait( g_device.submit( std::move( cmdBuffer ) ) );
+	}
+}
+
 static uint32_t s_frameId = 0;
 
 void vulkan_garbage_collect( void )
