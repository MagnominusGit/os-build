+  // Late input sampling. A game that reads its input right after vkQueuePresentKHR returns
+  // reads it as late as it can still make the next latch: the layer waits for the frame to be
+  // latched, then holds the app until the next latch minus the app's slowest recent frame (from
+  // release to ready, over ~2 s) minus a margin. It engages only while that fits in one frame
+  // interval, so a heavy game keeps the FIFO queue bound instead and loses no frames.
+  static bool getLateSampling() {
+    static const bool s_enabled = []() -> bool {
+      const bool enabled = parseEnv<bool>("GAMESCOPE_WSI_LATE_SAMPLING").value_or(false);
+      if (enabled)
+        fprintf(stderr, "[Gamescope WSI] Late input sampling on.\n");
+      return enabled;
+    }();
+    return s_enabled;
+  }
+
+  static uint64_t getLateSamplingMargin() {
+    static const uint64_t s_margin = uint64_t(std::clamp(parseEnv<int>("GAMESCOPE_WSI_LATE_SAMPLING_MARGIN").value_or(2000), 500, 8000)) * 1000;
+    return s_margin;
+  }
