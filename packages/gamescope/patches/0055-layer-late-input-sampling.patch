+    // Late input sampling (getLateSampling). Learns from the reports that have come in, then, if
+    // this frame was paced (it waited for its own report) and pacing still fits, holds the app
+    // until the next latch minus its slowest recent frame minus the margin. A paced frame shown
+    // more than 1.5 intervals after the one before missed: the margin grows 1.5 ms (decaying 1 us
+    // per frame on time), and 4 misses within 10 s stop pacing for 10 s.
+    static void SampleLate(GamescopeSwapchainData &swapchain, uint64_t serial) {
+      using Report = GamescopeSwapchainData::FrameReport;
+      // How far ahead of a vblank gamescope latches (its commit lead, measured 1.9-2.5 ms median).
+      constexpr uint64_t LatchLead = 3'000'000;
+      uint64_t period;
+      decltype(swapchain.frameReports) reports;
+      {
+        std::lock_guard lock(*swapchain.presentTimingMutex);
+        period = swapchain.refreshCycle;
+        reports = swapchain.frameReports;
+      }
+      auto findReport = [&](uint64_t s) -> const Report * {
+        const Report &report = reports[s % reports.size()];
+        return s && report.serial == s ? &report : nullptr;
+      };
+
+      const uint64_t now = getTimeMonotonic();
+      auto &pending = swapchain.pendingFrames;
+      const uint32_t first = swapchain.pendingCount > pending.size() ? swapchain.pendingCount - uint32_t(pending.size()) : 0;
+      for (uint32_t i = first; i < swapchain.pendingCount; i++) {
+        auto &frame = pending[i % pending.size()];
+        const Report *report = findReport(frame.serial);
+        if (!report)
+          continue;
+        if (report->ready && report->shown) {
+          if (frame.released && report->ready > frame.released)
+            swapchain.costs[swapchain.costCount++ % swapchain.costs.size()] = report->ready - frame.released;
+          if (swapchain.lastShown && report->shown > swapchain.lastShown) {
+            if (frame.paced && report->shown - swapchain.lastShown > period * 3 / 2) {
+              swapchain.marginFloor = std::min<uint64_t>(swapchain.marginFloor + 1'500'000, 6'000'000);
+              if (now - swapchain.missWindowStart > 10'000'000'000) {
+                swapchain.missWindowStart = now;
+                swapchain.missesInWindow = 0;
+              }
+              if (++swapchain.missesInWindow >= 4) {
+                swapchain.pausedUntil = now + 10'000'000'000;
+                swapchain.missesInWindow = 0;
+                fprintf(stderr, "[Gamescope WSI] Late input sampling: 4 missed latches in 10 s, pausing for 10 s.\n");
+              }
+            } else if (swapchain.marginFloor >= 1'000) {
+              swapchain.marginFloor -= 1'000;
+            }
+          }
+          swapchain.lastShown = report->shown;
+        }
+        frame.serial = 0;
+      }
+
+      const uint32_t samples = std::min<uint32_t>(swapchain.costCount, uint32_t(swapchain.costs.size()));
+      uint64_t worst = 0;
+      for (uint32_t i = 0; i < samples; i++)
+        worst = std::max(worst, swapchain.costs[i]);
+      const uint64_t margin = getLateSamplingMargin() + swapchain.marginFloor;
+      // Engage with half a millisecond to spare, keep going while it still fits at all.
+      const uint64_t need = worst + margin + LatchLead + (swapchain.latePaced ? 0 : 500'000);
+      const bool fits = samples >= 32 && now >= swapchain.pausedUntil && need < period;
+
+      if (swapchain.latePaced && fits) {
+        if (const Report *report = findReport(serial); report && report->shown) {
+          // The next frame is shown one interval later and has to be ready before gamescope
+          // latches it, LatchLead ahead of that vblank.
+          const uint64_t wake = report->shown + period - LatchLead - worst - margin;
+          // The report can come most of a refresh before its frame is shown, so the hold can be
+          // longer than one interval while that frame waits on screen.
+          if (wake > now && wake - now < 2 * period) {
+            timespec until = { .tv_sec = time_t(wake / 1'000'000'000), .tv_nsec = long(wake % 1'000'000'000) };
+            while (clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &until, nullptr) == EINTR)
+              ;
+          }
+        }
+      }
+      if (fits != swapchain.latePaced && now - swapchain.lastLateLog > 5'000'000'000) {
+        swapchain.lastLateLog = now;
+        fprintf(stderr, "[Gamescope WSI] Late input sampling %s: slowest frame %.1f ms, margin %.1f ms, interval %.1f ms.\n",
+          fits ? "on" : "off", worst / 1e6, margin / 1e6, period / 1e6);
+      }
+      swapchain.latePaced = fits;
     }
 
     // Waits until the compositor has reported serial, shown or discarded. Nothing is reported
