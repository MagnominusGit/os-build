 	double mouse_surface_cursorx = 0.0f;
@@ -247,6 +256,8 @@ struct wlserver_touch {
 	struct wl_listener destroy;
 
     gamescope::IBackendConnector* connector;
+    // The --secondary-touch-device: routed to the secondary output, never to the main one.
+    bool bSecondary;
 };
 
 void xwayland_surface_commit(struct wlr_surface *wlr_surface);
@@ -281,6 +292,9 @@ void wlserver_drag_anchor_move( struct wlr_surface *surface, int x, int y, int b
 void wlserver_touchmotion( double x, double y, int touch_id, uint32_t time, bool bAlwaysWarpCursor = false, gamescope::IBackendConnector* connector = nullptr );
 void wlserver_touchdown( double x, double y, int touch_id, uint32_t time, gamescope::IBackendConnector* connector = nullptr );
 void wlserver_touchup( int touch_id, uint32_t time );
+// The surface the secondary touchscreen drives (nullptr: none), with the secondary output's
+// logical size and panel orientation. Takes the wlserver lock.
+void wlserver_set_secondary_touch_target( struct wlr_surface *surface, uint32_t width, uint32_t height, GamescopePanelOrientation orientation );
 
 void wlserver_send_frame_done( struct wlr_surface *surf, const struct timespec *when );
 
