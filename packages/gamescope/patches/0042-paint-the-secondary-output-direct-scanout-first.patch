+// Paints the secondary focus onto the secondary output when it has new content and the output can
+// take a frame. Direct scanout first: on an unrotated panel, a buffer the size of the output goes
+// on the plane as is. Otherwise (a rotated panel, other sizes, or a buffer the plane refuses) the
+// frame is composited into a panel-sized image, the composite rotating it (with one unscaled layer,
+// a rotated-copy blit). The plane is never asked to rotate, see drm_secondary_t.
+static void paint_secondary_output()
+{
+	bool bNeedsFrame = false;
+	if ( !GetBackend()->SecondaryOutputReady( &bNeedsFrame ) )
+		return;
+
+	steamcompmgr_win_t *w = g_SecondaryFocus.focusWindow;
+	static const steamcompmgr_win_t *s_pLastWindow = nullptr;
+	static uint64_t s_ulLastCommitId = UINT64_MAX;
+	const uint64_t ulCommitId = window_last_done_commit_id( w );
+	if ( !bNeedsFrame && w == s_pLastWindow && ulCommitId == s_ulLastCommitId )
+		return;
+
+	struct FrameInfo_t frameInfo = {};
+	// No colour management on this panel: neither the DPU nor the composite applies any, so the
+	// rotated-copy blit is as good as the composite shader.
+	frameInfo.applyOutputColorMgmt = false;
+	frameInfo.scanoutIsColorManaged = true;
+	frameInfo.outputEncodingEOTF = EOTF_Gamma22;
+	frameInfo.allowVRR = false;
+	frameInfo.bFadingOut = false;
+
+	const uint32_t uCompositeDebugBackup = g_uCompositeDebug;
+	const uint32_t uBackupWidth = currentOutputWidth;
+	const uint32_t uBackupHeight = currentOutputHeight;
+	defer(
+		g_uCompositeDebug = uCompositeDebugBackup;
+		currentOutputWidth = uBackupWidth;
+		currentOutputHeight = uBackupHeight;
+	);
+	g_uCompositeDebug = 0;
+	currentOutputWidth = g_uSecondaryOutputWidth;
+	currentOutputHeight = g_uSecondaryOutputHeight;
+
+	if ( w )
+		paint_window( &g_SecondaryFocus, w, w, &frameInfo, nullptr, 0, 1.0f, nullptr );
+
+	enum class SecondaryPath { Unset, DirectScanout, Composited };
+	static SecondaryPath s_eLastPath = SecondaryPath::Unset;
+	SecondaryPath ePath = SecondaryPath::DirectScanout;
+
+	const uint32_t uRotation = GetBackend()->GetSecondaryOutputRotation();
+	gamescope::SecondaryPresentResult eResult = gamescope::SecondaryPresentResult::Refused;
+	if ( uRotation == 0 && frameInfo.layers.count() == 1 )
+	{
+		const FrameInfo_t::Layer_t &layer = frameInfo.layers.get( 0 );
+		if ( layer.tex && layer.tex->GetBackendFb() && !layer.isYcbcr() && !layer.bPreRotated &&
+		     layer.opacity >= 1.0f && layer.isScreenSize() && layer.offset.x == 0.0f && layer.offset.y == 0.0f &&
+		     layer.tex->width() == g_uSecondaryOutputWidth && layer.tex->height() == g_uSecondaryOutputHeight )
+		{
+			eResult = GetBackend()->PresentSecondary( layer.tex->GetBackendFb(), layer.tex->width(), layer.tex->height(), true );
+		}
+	}
+
+	if ( eResult == gamescope::SecondaryPresentResult::Refused )
+	{
+		ePath = SecondaryPath::Composited;
+
