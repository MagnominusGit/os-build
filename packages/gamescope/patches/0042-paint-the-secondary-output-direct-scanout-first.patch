+gamescope::Rc<CVulkanTexture> vulkan_acquire_secondary_output_image( uint32_t uWidth, uint32_t uHeight )
+{
+	// Three: one on screen, one queued, one being drawn.
+	static std::vector<gamescope::OwningRc<CVulkanTexture>> s_Images;
+	static uint32_t s_uNext = 0;
+
+	if ( s_Images.empty() || s_Images[0]->width() != uWidth || s_Images[0]->height() != uHeight )
+	{
+		CVulkanTexture::createFlags flags;
+		flags.bFlippable = true;
+		flags.bStorage = !g_bCompositeGraphics;
+		flags.bColorAttachment = g_bCompositeGraphics;
+		flags.bTransferSrc = true;
+		flags.bTransferDst = true; // the rotated blit of composite-blit
+		flags.bSampled = true;
+		flags.bOutputImage = true;
+
+		s_Images.clear();
+		for ( int i = 0; i < 3; i++ )
+		{
+			gamescope::OwningRc<CVulkanTexture> pImage = new CVulkanTexture();
+			if ( !pImage->BInit( uWidth, uHeight, 1u, g_output.uOutputFormat, flags ) )
+			{
+				vk_log.errorf( "failed to allocate a %ux%u secondary output image", uWidth, uHeight );
+				s_Images.clear();
+				return nullptr;
+			}
+			s_Images.push_back( std::move( pImage ) );
+		}
+		s_uNext = 0;
+	}
+
+	gamescope::Rc<CVulkanTexture> pImage = s_Images[ s_uNext ];
+	s_uNext = ( s_uNext + 1 ) % s_Images.size();
+	return pImage;
+}
