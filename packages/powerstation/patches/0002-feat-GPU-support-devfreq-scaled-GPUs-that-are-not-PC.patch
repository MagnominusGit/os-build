+//! Power profiles for SoCs whose GPU scales through devfreq.
+//!
+//! An SoC has no TDP, boost or thermal limit a client can set, but its clocks are
+//! picked by governors: one per cpufreq policy and one for the GPU's devfreq
+//! node. A power profile here is a pair of governors, applied to every CPU
+//! policy and to the GPU. It never touches a frequency limit: those stay with
+//! the GPU clock range and the CPU core count, which a profile must not undo.
+//!
+//! Nothing is cached. The profile in force is read back from sysfs, so a
+//! governor someone else wrote shows up as what it is, rather than as the last
+//! profile set through this interface.
+
+use std::{
+    fs, io,
+    path::{Path, PathBuf},
+};
+
+use crate::performance::gpu::{
+    platform::hardware::Hardware,
+    tdp::{HardwareAccess, TDPDevice, TDPError, TDPResult},
+};
+
+const CPUFREQ_PATH: &str = "/sys/devices/system/cpu/cpufreq";
+
+/// A power profile: its name, the governor of every CPU policy and the GPU's.
+struct Profile {
+    name: &'static str,
+    cpu_governor: &'static str,
+    gpu_governor: &'static str,
+}
+
+/// Lowest power first. `schedutil` follows the scheduler's utilisation signal
+/// (and drives energy-aware placement on big.LITTLE); `ondemand` samples load
+/// and jumps straight to the top clock when busy, which keeps frame times
+/// steadier; `performance` holds the top of whatever range is allowed.
+const PROFILES: [Profile; 3] = [
+    Profile {
+        name: "power-saving",
+        cpu_governor: "schedutil",
+        gpu_governor: "simple_ondemand",
+    },
+    Profile {
+        name: "balanced",
+        cpu_governor: "ondemand",
+        gpu_governor: "simple_ondemand",
+    },
+    Profile {
+        name: "max-performance",
+        cpu_governor: "performance",
+        gpu_governor: "performance",
+    },
+];
+
+pub struct Tdp {
+    /// The GPU's devfreq node, e.g. /sys/class/devfreq/3d00000.gpu
+    devfreq: PathBuf,
+}
+
+impl Tdp {
+    pub fn new(devfreq: PathBuf) -> Tdp {
+        Tdp { devfreq }
+    }
+}
+
+/// The `scaling_governor` file of every cpufreq policy.
+fn cpu_governor_files() -> TDPResult<Vec<PathBuf>> {
+    let mut files: Vec<PathBuf> = fs::read_dir(CPUFREQ_PATH)?
+        .flatten()
+        .map(|entry| entry.path())
+        .filter(|path| {
+            path.file_name()
+                .is_some_and(|name| name.to_string_lossy().starts_with("policy"))
+        })
+        .map(|path| path.join("scaling_governor"))
+        .collect();
+    files.sort();
+    Ok(files)
+}
+
+/// The profile with exactly these governors on the GPU and the online CPU policies.
+fn matching_profile(gpu: &str, cpus: &[String]) -> Option<&'static Profile> {
+    PROFILES
+        .iter()
+        .find(|p| p.gpu_governor == gpu && cpus.iter().all(|c| c == p.cpu_governor))
+}
+
+/// Reads a governor, or `None` for a policy whose CPUs are all offline: the
+/// kernel answers EBUSY there, and such a policy has no governor in force.
+fn read_governor(path: &Path) -> TDPResult<Option<String>> {
+    match fs::read_to_string(path) {
+        Ok(text) => Ok(Some(text.trim().to_string())),
+        Err(err) if err.kind() == io::ErrorKind::ResourceBusy => Ok(None),
+        Err(err) => Err(err.into()),
+    }
+}
+
+/// Writes a governor unless it is already in force, so a profile set twice does
+/// not restart the governor's sampling. Returns false for an offline policy,
+/// which refuses the write with EBUSY.
+fn write_governor(path: &Path, governor: &str) -> TDPResult<bool> {
+    match read_governor(path)? {
+        None => return Ok(false),
+        Some(current) if current == governor => return Ok(true),
+        Some(_) => {}
+    }
+    log::debug!("Writing value '{}' to: {}", governor, path.display());
+    match fs::write(path, governor) {
+        Ok(()) => Ok(true),
+        Err(err) if err.kind() == io::ErrorKind::ResourceBusy => Ok(false),
+        Err(err) => Err(TDPError::FailedOperation(format!(
+            "{}: {governor}: {err}",
+            path.display()
+        ))),
+    }
+}
+
+impl HardwareAccess for Tdp {
+    fn hardware(&self) -> Option<&Hardware> {
+        None
+    }
+}
+
+impl TDPDevice for Tdp {
+    async fn tdp(&self) -> TDPResult<f64> {
+        Err(TDPError::FeatureUnsupported)
+    }
+
+    async fn set_tdp(&mut self, _value: f64) -> TDPResult<()> {
+        Err(TDPError::FeatureUnsupported)
+    }
+
+    async fn boost(&self) -> TDPResult<f64> {
+        Err(TDPError::FeatureUnsupported)
+    }
+
+    async fn set_boost(&mut self, _value: f64) -> TDPResult<()> {
+        Err(TDPError::FeatureUnsupported)
+    }
+
+    async fn thermal_throttle_limit_c(&self) -> TDPResult<f64> {
+        Err(TDPError::FeatureUnsupported)
+    }
+
+    async fn set_thermal_throttle_limit_c(&mut self, _limit: f64) -> TDPResult<()> {
+        Err(TDPError::FeatureUnsupported)
+    }
+
+    /// The profile whose governors are the ones in force on the GPU and on every
+    /// online CPU policy. Any other mix matches no profile and is an error, so a
+    /// client re-applies the profile it wants instead of trusting a near match.
+    async fn power_profile(&self) -> TDPResult<String> {
+        let gpu = read_governor(&self.devfreq.join("governor"))?.unwrap_or_default();
+        let mut cpus = Vec::new();
+        for file in cpu_governor_files()? {
+            if let Some(governor) = read_governor(&file)? {
+                cpus.push(governor);
+            }
+        }
+        matching_profile(&gpu, &cpus)
+            .map(|p| p.name.to_string())
+            .ok_or_else(|| {
+                TDPError::FailedOperation(format!(
+                    "governors match no profile: GPU {gpu}, CPU {}",
+                    cpus.join(",")
+                ))
+            })
+    }
+
+    async fn power_profiles_available(&self) -> TDPResult<Vec<String>> {
+        Ok(PROFILES.iter().map(|p| p.name.to_string()).collect())
+    }
+
+    /// Policies whose CPUs are all offline are skipped: the kernel refuses them
+    /// and restores their previous governor when a CPU comes back, so whoever
+    /// onlines one has to bring its governor in line (see `CPUCore`).
+    async fn set_power_profile(&mut self, profile: String) -> TDPResult<()> {
+        let Some(p) = PROFILES.iter().find(|p| p.name == profile) else {
+            return Err(TDPError::InvalidArgument(format!(
+                "{profile} is not a valid profile"
+            )));
+        };
+        log::info!("Setting power profile {}", p.name);
+        write_governor(&self.devfreq.join("governor"), p.gpu_governor)?;
+        for file in cpu_governor_files()? {
+            if !write_governor(&file, p.cpu_governor)? {
+                log::debug!("{} is offline; left as is", file.display());
+            }
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn cpus(governors: &[&str]) -> Vec<String> {
+        governors.iter().map(|g| g.to_string()).collect()
+    }
+
+    #[test]
+    fn matches_the_profile_whose_governors_are_all_in_force() {
+        let found = matching_profile("simple_ondemand", &cpus(&["ondemand", "ondemand"]));
+        assert_eq!(found.map(|p| p.name), Some("balanced"));
+        let found = matching_profile("performance", &cpus(&["performance"]));
+        assert_eq!(found.map(|p| p.name), Some("max-performance"));
+    }
+
+    #[test]
+    fn a_mix_of_cpu_governors_matches_no_profile() {
+        let found = matching_profile("simple_ondemand", &cpus(&["ondemand", "performance"]));
+        assert!(found.is_none());
+    }
+
+    #[test]
+    fn the_kernel_boot_governors_match_no_profile() {
+        // performance on the CPUs (the kernel's boot default) with the GPU still scaling
+        assert!(matching_profile("simple_ondemand", &cpus(&["performance"])).is_none());
+    }
+
+    #[test]
+    fn profile_names_are_unique_and_lowest_power_first() {
+        let names: Vec<&str> = PROFILES.iter().map(|p| p.name).collect();
+        assert_eq!(names, ["power-saving", "balanced", "max-performance"]);
+    }
+}
