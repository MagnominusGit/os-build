index a17fe82..8042a5f 100644
--- a/src/performance/cpu/core.rs
+++ b/src/performance/cpu/core.rs
@@ -1,6 +1,7 @@
 use std::{
     fs::{self, OpenOptions},
     io::Write,
+    path::Path,
 };
 use tokio::io::AsyncWriteExt;
 use zbus::fdo;
@@ -33,6 +34,29 @@ impl CPUCore {
             .min()
     }
 
+    /// A cpufreq policy whose CPUs were all offline refuses governor writes and
+    /// comes back on the governor it had when it went down, so a power profile
+    /// set in between never reaches it. Once this core is back, give its policy
+    /// the governor of cpu0, which is never taken offline.
+    fn follow_boot_cpu_governor(&self) {
+        let ours = Path::new(&self.path).join("cpufreq/scaling_governor");
+        let boot = Path::new(&self.path)
+            .with_file_name("cpu0")
+            .join("cpufreq/scaling_governor");
+        let (Ok(governor), Ok(current)) = (fs::read_to_string(&boot), fs::read_to_string(&ours))
+        else {
+            return;
+        };
+        let governor = governor.trim();
+        if current.trim() == governor {
+            return;
+        }
+        log::info!("Setting core {} governor to {}", self.number, governor);
+        if let Err(err) = fs::write(&ours, governor) {
+            log::warn!("Unable to set {}: {err}", ours.display());
+        }
+    }
+
     /// Asyncronously set the core to online
     pub async fn set_online_async(&self, enabled: bool) -> Result<(), std::io::Error> {
         let enabled_str = if enabled { "enabled" } else { "disabled" };
@@ -49,6 +73,9 @@ impl CPUCore {
 
         // Write the value
         file.await?.write_all(status.as_bytes()).await?;
+        if enabled {
+            self.follow_boot_cpu_governor();
+        }
 
         Ok(())
     }
@@ -121,6 +148,9 @@ impl CPUCore {
             .write_all(status.as_bytes())
             // convert the std::io::Error to a zbus::fdo::Error
             .map_err(|err| fdo::Error::IOError(err.to_string()))?;
+        if enabled {
