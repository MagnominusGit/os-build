From: sunshineinabox <aqemail@gmail.com>
Subject: [PATCH] serial: qcom-geni: restart RX after the read command terminates itself
---
 drivers/tty/serial/qcom_geni_serial.c | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/drivers/tty/serial/qcom_geni_serial.c b/drivers/tty/serial/qcom_geni_serial.c
index af314055f..120a68597 100644
--- a/drivers/tty/serial/qcom_geni_serial.c
+++ b/drivers/tty/serial/qcom_geni_serial.c
@@ -1039,8 +1039,21 @@ static void qcom_geni_serial_handle_rx_dma(struct uart_port *uport, bool drop)
 	struct qcom_geni_serial_port *port = to_dev_port(uport);
 	u32 rx_in;
 
-	if (!qcom_geni_serial_secondary_active(uport))
+	if (!qcom_geni_serial_secondary_active(uport)) {
+		if (!port->rx_dma_addr)
+			return;
+
+		geni_se_rx_dma_unprep(&port->se, port->rx_dma_addr,
+				      DMA_RX_BUF_SIZE);
+		port->rx_dma_addr = 0;
+
+		rx_in = readl(uport->membase + SE_DMA_RX_LEN_IN);
+		if (rx_in && !drop)
+			handle_rx_uart(uport, rx_in);
+
+		qcom_geni_serial_start_rx_dma(uport);
 		return;
+	}
 
 	if (!port->rx_dma_addr)
 		return;
