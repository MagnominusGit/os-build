From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Martin <dmanlfc@gmail.com>
Date: Wed, 23 Sep 2026 12:00:00 +0100
Subject: [PATCH] input: singleadc-joypad: park the stick LEDs across suspend

The MCU keeps driving the LED rings from the last frame it was sent and
stays powered through suspend, so the rings stayed lit in standby. Add
sleep PM ops to the SPI client that send an off frame on suspend and
restore the segment colours on resume.

[Philippe Simons: reworked onto the LED-class 0763: a parked flag forces
 the switch off instead of saving and restoring a staged switch, under
 the frame lock.]
---
diff --git a/drivers/input/joystick/singleadc-joypad.c b/drivers/input/joystick/singleadc-joypad.c
index 065c1c625..0ddfc4375 100644
--- a/drivers/input/joystick/singleadc-joypad.c
+++ b/drivers/input/joystick/singleadc-joypad.c
@@ -669,6 +669,8 @@ struct joypad_led {
 
 /* Segment colours, kept here so they outlive a late or re-probed MCU client. */
 static u8 joypad_led_seg[JOYPAD_LED_COUNT * 3];
+/* Rings forced off across suspend, whatever the segments say. */
+static bool joypad_led_parked;
 
 /* Write the segment colours into the frame; it goes out on the next poll. */
 static void joypad_led_apply(struct spi_mcu_data *smd)
@@ -681,8 +683,8 @@ static void joypad_led_apply(struct spi_mcu_data *smd)
 		return;
 
 	f[JOYPAD_LED_OFF_MODE] = JOYPAD_LED_MODE_SEGMENTS;
-	f[JOYPAD_LED_OFF_SWITCH] =
-		!!memchr_inv(joypad_led_seg, 0, sizeof(joypad_led_seg));
+	f[JOYPAD_LED_OFF_SWITCH] = !joypad_led_parked &&
+		memchr_inv(joypad_led_seg, 0, sizeof(joypad_led_seg));
 	f[JOYPAD_LED_OFF_LEVEL] = 0xff;
 	f[JOYPAD_LED_OFF_SPEED] = JOYPAD_LED_SPEED;
 	memcpy(f + JOYPAD_LED_OFF_SEG, joypad_led_seg, sizeof(joypad_led_seg));
@@ -1550,6 +1552,47 @@ static void sprd_spi_mcu_remove(struct spi_device *spi)
 	}
 }
 
+/*
+ * The MCU keeps the rings in whatever state the last frame set and stays
+ * powered through suspend, so send an off frame going down and the segment
+ * colours coming back. The poller is frozen by then; the SPI client suspends
+ * before and resumes after its controller.
+ */
+static int spi_mcu_led_send(struct spi_mcu_data *smd, bool on)
+{
+	int ret;
+
+	guard(mutex)(&joypad_frame_lock);
+	joypad_led_parked = !on;
+	joypad_led_apply(smd);
+
+	ret = joypad_mcu_xfer(smd);
+	if (ret)
+		dev_warn(smd->dev, "LED %s frame failed: %d\n",
+			 on ? "restore" : "off", ret);
+	return ret;
+}
+
+static int spi_mcu_suspend(struct device *dev)
+{
+	struct spi_mcu_data *smd = spi_get_drvdata(to_spi_device(dev));
+
+	if (smd)
+		spi_mcu_led_send(smd, false);
+	return 0;
+}
+
+static int spi_mcu_resume(struct device *dev)
+{
+	struct spi_mcu_data *smd = spi_get_drvdata(to_spi_device(dev));
+
+	if (smd)
+		spi_mcu_led_send(smd, true);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(spi_mcu_pm_ops, spi_mcu_suspend, spi_mcu_resume);
+
 static const struct of_device_id sprd_spi_mcu_dt_match[] = {
 	{ .compatible = "mcu,spi_joystick" },
 	{ }
@@ -1560,6 +1603,7 @@ static struct spi_driver spi_mcu_joy_driver = {
 	.driver = {
 		.name = "spi_mcu",
 		.of_match_table = sprd_spi_mcu_dt_match,
+		.pm = pm_sleep_ptr(&spi_mcu_pm_ops),
 	},
 	.probe = sprd_spi_mcu_probe,
 	.remove = sprd_spi_mcu_remove,
