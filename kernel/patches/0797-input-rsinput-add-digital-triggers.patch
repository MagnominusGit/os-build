From: Jacob Cook <jacobmcook1984@gmail.com>
Date: Tue, 13 Oct 2026 17:00:00 -0400
Subject: [PATCH] input: rsinput: add digital-triggers

[retroforge: rebased on our rsinput stack (0745, 0790, 0791).]
---
diff --git a/drivers/input/joystick/rsinput.c b/drivers/input/joystick/rsinput.c
index 44e50e680..0a012b9e2 100644
--- a/drivers/input/joystick/rsinput.c
+++ b/drivers/input/joystick/rsinput.c
@@ -139,6 +139,7 @@ struct rsinput_driver {
     bool invert_y;
     bool invert_rx;
     bool invert_ry;
+    bool digital_triggers;
     uint8_t rx_buf[1024];
     size_t rx_len;
     uint8_t sequence_number;
@@ -283,8 +284,10 @@ static void handle_cmd_status(struct rsinput_driver *drv, const uint8_t *data, s
             INT_SIGN(axis_righty_min) * ( abs(axis_righty_min) - axis_righty_antideadzone ),
             INT_SIGN(axis_righty_max) * ( abs(axis_righty_max) - axis_righty_antideadzone ),
              0, 0);
-        input_set_abs_params(drv->input, ABS_Z, 0, trigger_left_max - trigger_left_antideadzone, 0, 30);
-        input_set_abs_params(drv->input, ABS_RZ, 0, trigger_right_max - trigger_right_antideadzone, 0, 30);
+        if (!drv->digital_triggers) {
+            input_set_abs_params(drv->input, ABS_Z, 0, trigger_left_max - trigger_left_antideadzone, 0, 30);
+            input_set_abs_params(drv->input, ABS_RZ, 0, trigger_right_max - trigger_right_antideadzone, 0, 30);
+        }
         update_params = 0;
     }
 
@@ -318,8 +321,13 @@ static void handle_cmd_status(struct rsinput_driver *drv, const uint8_t *data, s
     int16_t ry = raw_ry + axis_righty_center;
     ry = ( abs(ry) < axis_righty_deadzone ) ? 0 : INT_SIGN(ry) * ( abs(ry) - axis_righty_antideadzone );
 
-    input_report_abs(drv->input, ABS_Z, z);
-    input_report_abs(drv->input, ABS_RZ, rz);
+    if (drv->digital_triggers) {
+        input_report_key(drv->input, BTN_TL2, raw_trig_l != 0);
+        input_report_key(drv->input, BTN_TR2, raw_trig_r != 0);
+    } else {
+        input_report_abs(drv->input, ABS_Z, z);
+        input_report_abs(drv->input, ABS_RZ, rz);
+    }
     input_report_abs(drv->input, ABS_X, drv->invert_x ? x * (-1) : x);
     input_report_abs(drv->input, ABS_Y, drv->invert_y ? y * (-1) : y);
     input_report_abs(drv->input, ABS_RX, drv->invert_rx ? rx * (-1) : rx);
@@ -497,6 +505,7 @@ static int rsinput_probe(struct serdev_device *serdev) {
     drv->invert_y = device_property_present(&serdev->dev, "invert-y");
     drv->invert_rx = device_property_present(&serdev->dev, "invert-rx");
     drv->invert_ry = device_property_present(&serdev->dev, "invert-ry");
+    drv->digital_triggers = device_property_present(&serdev->dev, "digital-triggers");
 
     {
         u32 range;
@@ -606,8 +615,13 @@ static int rsinput_probe(struct serdev_device *serdev) {
         INT_SIGN(axis_righty_max) * ( abs(axis_righty_max) - axis_righty_antideadzone ),
         0, 0);
 
-    input_set_abs_params(drv->input, ABS_Z, 0, trigger_left_max - trigger_left_antideadzone, 0, 30);
-    input_set_abs_params(drv->input, ABS_RZ, 0, trigger_right_max - trigger_right_antideadzone, 0, 30);
+    if (drv->digital_triggers) {
+        input_set_capability(drv->input, EV_KEY, BTN_TL2);
+        input_set_capability(drv->input, EV_KEY, BTN_TR2);
+    } else {
+        input_set_abs_params(drv->input, ABS_Z, 0, trigger_left_max - trigger_left_antideadzone, 0, 30);
+        input_set_abs_params(drv->input, ABS_RZ, 0, trigger_right_max - trigger_right_antideadzone, 0, 30);
+    }
 
     if (device_property_present(&serdev->dev, "rumble-haptics")) {
         input_set_drvdata(drv->input, drv);
