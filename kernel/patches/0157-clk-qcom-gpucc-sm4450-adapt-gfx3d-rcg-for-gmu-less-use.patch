From: sunshineinabox <aqemail@gmail.com>
Subject: [PATCH] clk: qcom: gpucc-sm4450: adapt gfx3d RCG for GMU-less use
---
diff --git a/drivers/clk/qcom/gpucc-sm4450.c b/drivers/clk/qcom/gpucc-sm4450.c
index 6a756937d..d3f1c6bf7 100644
--- a/drivers/clk/qcom/gpucc-sm4450.c
+++ b/drivers/clk/qcom/gpucc-sm4450.c
@@ -222,8 +222,8 @@ static struct clk_rcg2 gpu_cc_gx_gfx3d_clk_src = {
 		.name = "gpu_cc_gx_gfx3d_clk_src",
 		.parent_data = gpu_cc_parent_data_2,
 		.num_parents = ARRAY_SIZE(gpu_cc_parent_data_2),
-		.flags = CLK_SET_RATE_PARENT,
-		.ops = &clk_rcg2_shared_ops,
+		.flags = CLK_SET_RATE_PARENT | CLK_OPS_PARENT_ENABLE,
+		.ops = &clk_rcg2_shared_no_init_park_ops,
 	},
 };
 
