+};
+
 static const struct dpu_lm_sub_blks sm8750_lm_sblk = {
 	.maxblendstages = 11, /* excluding base layer */
 	.blendstage_base = { /* offsets relative to mixer base */
@@ -839,6 +856,10 @@ static const struct dpu_qos_lut_entry sc7180_qos_nrt[] = {
 	{.fl = 0, .lut = 0x0},
 };
 
+static const struct dpu_qos_lut_entry sm4450_qos_linear_macrotile[] = {
+	{.fl = 0, .lut = 0x0122334445566777},
+};
