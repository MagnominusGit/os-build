Add the ESP GRUB's two read-only commands to the retroforge module.

retroforge_dt_model VAR sets VAR to the root `model` of the devicetree the
firmware installed. OpenABL installs the DTB of its Device model setting,
read from the boot drive, before it starts an EFI program, so this is how the
board picked in OpenABL's menu reaches the stage-2 config, which then boots
the slot's own DTB for that board.

retroforge_conf_get FILE KEY VAR sets VAR to the value of a `KEY: value`
line. The ESP GRUB uses it to follow a SteamOS boot conf that an older root's
RAUC hook re-armed, for as long as roots from before the switch exist.

Both read through GRUB's own drivers and leave VAR unset when there is
nothing to report. retroforge_bootattempts stays for the stage-2 configs of
those older roots.

diff -urN a/grub-core/commands/efi/retroforge.c b/grub-core/commands/efi/retroforge.c
--- a/grub-core/commands/efi/retroforge.c
+++ b/grub-core/commands/efi/retroforge.c
@@ -25,8 +25,13 @@
  *      retroforge_bootattempts <image-name>          # e.g. retroforge_bootattempts A
  *
  *  It opens \SteamOS\conf\<image-name>.conf on the ESP, increments the
- *  `boot-attempts:` value in it, and writes it back. That is the whole module.
+ *  `boot-attempts:` value in it, and writes it back. Only stage-2 configs of
+ *  older roots still call it; the ESP GRUB counts tries in its grubenv.
  *
+ *  Two read-only commands sit at the end of the file for the ESP GRUB:
+ *  retroforge_dt_model (the board OpenABL's Device model names) and
+ *  retroforge_conf_get (an older root's boot conf). See their own comments.
+ *
  *  It exists because GRUB cannot do this itself: GRUB's own `fat` driver is
  *  READ-ONLY, so the only way to write the ESP from stage 2 is the firmware's
  *  EFI_FILE_PROTOCOL. Hence a module rather than a line of grub.cfg.
@@ -131,6 +136,9 @@
 #include <grub/command.h>
 #include <grub/efi/api.h>
 #include <grub/efi/efi.h>
+#include <grub/env.h>
+#include <grub/fdt.h>
+#include <grub/file.h>
 
 GRUB_MOD_LICENSE ("GPLv3+");
 
@@ -632,8 +640,117 @@
   return rv;
 }
 
-static grub_command_t cmd_bootattempts;
+/* ==========================================================================
+   The two read-only commands: retroforge_dt_model and retroforge_conf_get.
+
+   They serve the ESP GRUB, which OpenABL starts as \EFI\BOOT\bootaa64.efi and
+   which picks the slot itself (boot/gen-esp-cfg.sh). Both READ through GRUB's
+   own drivers, so neither needs the firmware file protocol the counter above
+   has to use, and both leave VAR unset when there is nothing to report: the
+   configs test `[ -n "$VAR" ]` and need no error arm for the absent case.
+   ========================================================================== */
+
+/* retroforge_dt_model VAR
+
+   VAR := the root `model` of the devicetree the firmware installed, if any.
+   OpenABL installs the DTB of its Device model setting, read from the boot
+   drive, before it starts an EFI program (Efi/Handover.c HandoverPrepare), so
+   this is how the board choice made in OpenABL's own menu reaches us. Only the
+   NAME is used: the slot boots its own DTB, never this one. */
+static grub_err_t
+grub_cmd_dt_model (grub_command_t cmd __attribute__ ((unused)),
+                   int argc, char **args)
+{
+  const void *fdt;
+  const char *model;
+  grub_uint32_t len = 0;
+
+  if (argc != 1)
+    return grub_error (GRUB_ERR_BAD_ARGUMENT,
+                       "usage: retroforge_dt_model VAR");
+  grub_env_unset (args[0]);
+
+  fdt = grub_efi_get_firmware_fdt ();
+  if (!fdt || grub_fdt_check_header_nosize (fdt) != 0)
+    return GRUB_ERR_NONE;
+
+  model = grub_fdt_get_prop (fdt, 0, "model", &len);
+  /* A property that is not a NUL-terminated string is not a name we can
+     compare, so it reads as no model at all. */
+  if (!model || len < 2 || model[len - 1] != '\0')
+    return GRUB_ERR_NONE;
+
+  return grub_env_set (args[0], model);
+}
+
+/* retroforge_conf_get FILE KEY VAR
+
+   VAR := the value of the `KEY: value` line in FILE (holo-bootconf's format).
+   Read-only and compatibility-only: it lets the ESP GRUB follow a boot conf
+   that an OLDER root's update hook re-armed, for as long as such roots exist.
+   A missing file or key leaves VAR unset; a file over CONF_MAX is corrupt and
+   is reported. */
+static grub_err_t
+grub_cmd_conf_get (grub_command_t cmd __attribute__ ((unused)),
+                   int argc, char **args)
+{
+  grub_file_t file;
+  grub_ssize_t n;
+  grub_size_t klen;
+  char *p, *end, *v, *ve;
 
+  if (argc != 3)
+    return grub_error (GRUB_ERR_BAD_ARGUMENT,
+                       "usage: retroforge_conf_get FILE KEY VAR");
+  grub_env_unset (args[2]);
+
+  file = grub_file_open (args[0], GRUB_FILE_TYPE_CONFIG);
+  if (!file)
+    {
+      grub_errno = GRUB_ERR_NONE;
+      return GRUB_ERR_NONE;
+    }
+  n = grub_file_read (file, confbuf, CONF_MAX + 1);
+  grub_file_close (file);
+  if (n < 0)
+    return grub_errno;
+  if (n > CONF_MAX)
+    return grub_error (GRUB_ERR_FILE_READ_ERROR,
+                       "retroforge: %s is over the %d-byte limit",
+                       args[0], CONF_MAX);
+  confbuf[n] = '\0';
+
+  /* `KEY:` at a line start; a key that is only a prefix of another does not
+     match, because the colon has to follow it. */
+  klen = grub_strlen (args[1]);
+  end = confbuf + n;
+  for (p = confbuf; p < end; )
+    {
+      if ((grub_size_t) (end - p) > klen
+          && grub_memcmp (p, args[1], klen) == 0 && p[klen] == ':')
+        {
+          v = p + klen + 1;
+          while (v < end && (*v == ' ' || *v == '\t'))
+            v++;
+          ve = v;
+          while (ve < end && *ve != '\n' && *ve != '\r')
+            ve++;
+          while (ve > v && (ve[-1] == ' ' || ve[-1] == '\t'))
+            ve--;
+          *ve = '\0';
+          return grub_env_set (args[2], v);
+        }
+      while (p < end && *p != '\n')
+        p++;
+      if (p < end)
+        p++;
+    }
+
+  return GRUB_ERR_NONE;
+}
+
+static grub_command_t cmd_bootattempts, cmd_dt_model, cmd_conf_get;
+
 GRUB_MOD_INIT (retroforge)
 {
   cmd_bootattempts =
@@ -641,9 +758,20 @@
                            "IMAGE",
                            "Increment boot-attempts in the SteamOS boot "
                            "config of IMAGE (A or B) on the ESP.");
+  cmd_dt_model =
+    grub_register_command ("retroforge_dt_model", grub_cmd_dt_model,
+                           "VAR",
+                           "Set VAR to the model of the firmware's "
+                           "devicetree, if it installed one.");
+  cmd_conf_get =
+    grub_register_command ("retroforge_conf_get", grub_cmd_conf_get,
+                           "FILE KEY VAR",
+                           "Set VAR to the value of `KEY:` in FILE.");
 }
 
 GRUB_MOD_FINI (retroforge)
 {
   grub_unregister_command (cmd_bootattempts);
+  grub_unregister_command (cmd_dt_model);
+  grub_unregister_command (cmd_conf_get);
 }
