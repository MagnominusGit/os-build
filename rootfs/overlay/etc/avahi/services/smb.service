<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Announces the RetroForge SMB shares (/etc/ksmbd/ksmbd.conf) so Linux/macOS file browsers list the
     device by itself; %h is the hostname (retroforge, or retroforge-2 ... when several are on one LAN). -->
<service-group>
  <name replace-wildcards="yes">%h</name>
  <service>
    <type>_smb._tcp</type>
    <port>445</port>
  </service>
</service-group>
