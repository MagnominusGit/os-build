#!/usr/bin/env python3
# steam-x86-guest — the x86 guest Valve's FEX tool needs for x86 Steam games: downloaded into the
# player's home, and mounted while /usr/bin/steam runs.
#
# Valve's arm64 client runs x86 games and x86 Protons through its FEX tool (Steam app 3127680). That
# tool needs an x86_64 + i386 "graphics provider": a tree with ld.so, glibc, x86 Mesa (Turnip) and
# graphics_provider.json at its root. SteamOS ships one at /usr/share/guestos/fex-mesa. The image ships
# no guest, because a root slot is 2 GB (only our x86 Mesa to lay over one: below). The tool
# also takes STEAM_COMPAT_GRAPHICS_PROVIDER=<dir>/graphics_provider.json, and <dir> then becomes both
# pressure-vessel's graphics provider and FEX's RootFS. It has to be a real tree (symlinks into another
# tree do not work). So: a squashfs image, kept as one file in ~/.local/share/retroforge/fex-guest/ and
# mounted with squashfuse on fex-guest/root while Steam runs.
#
# Which image: /usr/share/retroforge/steam/x86-guest.pin names either
#   a CHANNEL  (channel: + distro: + type:) -- FEX's RootFS_links.json and which of its entries, e.g. its
#              ArchLinux SquashFS. Each `fetch` reads the links file (one small GET) and takes whatever
#              the entry names NOW, checked against the entry's XXH3-64 with xxhsum; or
#   a FIXED image (version: + url: + sha256:), checked against the sha256.
# fex-guest/current points at the image to mount: the last one fetched and checked. A new one becomes
# current only once it is complete and checked; until then the old one is used and mounted.
#
#   steam-x86-guest start <pid>  what /usr/bin/steam (<pid>) runs before the client: hold the guest for as
#                                long as <pid> runs (below), mount it, and start `fetch` detached: for a
#                                channel at every start (it checks the channel), for a fixed image while it
#                                is not downloaded yet. It never waits for the network.
#   steam-x86-guest fetch        find the image the pin wants and download it unless it is there. It is
#                                checked, resumed when an earlier download was cut short, renamed into place
#                                and made current. Older images are removed once they are neither current
#                                nor mounted. Offline, or a links file it cannot use: exit 1, nothing changes.
#                                One fetch at a time: another one exits 0 at once. When a `steam` is running
#                                and nothing is mounted, the new image is mounted as soon as it is in place.
#   steam-x86-guest mount        mount an image on fex-guest/root unless a working mount is there. A dead one
#                                (squashfuse killed) is released first. A fixed pin's image when it is
#                                downloaded, else the current one. Exit 2 when the fixed pin's image is not
#                                downloaded yet (whether or not an older one got mounted), or a channel has
#                                none yet.
#   steam-x86-guest release      unmount fex-guest/root, unless a `steam` is still running; then remove the
#                                images that were kept only because they were mounted.
#
# Who uses the mount: for each running /usr/bin/steam, a holder process holds fex-guest/.users.lock
# SHARED. `start` forks it before mounting, outside the steam's process tree (OGUI's Exit reaps that
# tree), with TERM, INT and HUP ignored; it waits for the steam's PID to exit (a pidfd), whatever ends
# it, SIGKILL included, then lets go of the lock and releases. `release` and `fetch` try the lock
# EXCLUSIVE without waiting: getting it means no steam runs. So the last steam to exit releases the
# mount, and a second `steam steam://...` never releases what the first one is using. The client does
# not inherit the lock, so its leftover children cannot keep the mount. Mounting, unmounting and removing
# images happen under fex-guest/.mount.lock, so they never race; fex-guest/.mounted says which image is
# mounted.
#
# OUR x86 MESA: the image carries an x86_64 + i686 build of our own Mesa (Turnip, zink, the GL front
# ends; packages/mesa-x86) at /usr/lib/retroforge/x86-mesa/root, built against the Arch snapshot named
# in x86-mesa/payload.conf. When it is there, the image is mounted on fex-guest/base instead, and
# fex-guest/root is fuse-overlayfs with the payload over it (lower layers only, so read-only): every
# file of ours replaces the guest's at the same path, the rest is the guest's. Only over a guest no
# older than the payload's snapshot (an older one could lack the glibc it links against); otherwise,
# and without a payload, the image is mounted on fex-guest/root as it is, and one line says why.
# Released together: the overlay, then the base.
#
# squashfuse starts with TERM and INT ignored, as PortMaster's runtimes do (portmaster/bin/mount), so
# OGUI's Exit cannot pull the tree out from under a game that is still shutting down. It ends with a
# lazy unmount (fusermount3 -u -z): whatever still has a file open keeps it, and squashfuse exits once
# that is gone.
#
# Everything goes to stderr (the session log). A fetch outlives the `steam` that started it, so a
# stderr that went away is ignored rather than ending the download.
#
# TEST SEAMS (tests/test-steam-x86-guest.sh): RETROFORGE_STEAM_X86_GUEST_DIR (also set by
# /usr/bin/steam), RETROFORGE_STEAM_X86_GUEST_PIN, RETROFORGE_MOUNTS, RETROFORGE_SQUASHFUSE,
# RETROFORGE_FUSERMOUNT, RETROFORGE_XXHSUM, RETROFORGE_X86_MESA, RETROFORGE_FUSE_OVERLAYFS.
import fcntl
import glob
import hashlib
import http.client
import json
import os
import re
import select
import shutil
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

DATA = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
GUEST = os.path.abspath(os.environ.get("RETROFORGE_STEAM_X86_GUEST_DIR")
                        or os.path.join(DATA, "retroforge", "fex-guest"))
PIN = os.environ.get("RETROFORGE_STEAM_X86_GUEST_PIN", "/usr/share/retroforge/steam/x86-guest.pin")
MOUNTS = os.environ.get("RETROFORGE_MOUNTS", "/proc/self/mounts")
SQUASHFUSE = os.environ.get("RETROFORGE_SQUASHFUSE", "squashfuse")
FUSERMOUNT = os.environ.get("RETROFORGE_FUSERMOUNT", "fusermount3")
FUSE_OVERLAYFS = os.environ.get("RETROFORGE_FUSE_OVERLAYFS", "fuse-overlayfs")
MESA = os.environ.get("RETROFORGE_X86_MESA", "/usr/lib/retroforge/x86-mesa")
XXHSUM = os.environ.get("RETROFORGE_XXHSUM", "xxhsum")
ROOT = os.path.join(GUEST, "root")
BASE = os.path.join(GUEST, "base")  # the image, under our x86 Mesa on ROOT
CURRENT = os.path.join(GUEST, "current")
MOUNTED = os.path.join(GUEST, ".mounted")
USERS = os.path.join(GUEST, ".users.lock")
MOUNT_LOCK = os.path.join(GUEST, ".mount.lock")
FETCH_LOCK = os.path.join(GUEST, ".fetch.lock")
SPARE = 256 << 20  # left free in /home after the download
MOUNT_WAIT = 5.0
CHANNEL_WAIT = 15.0  # seconds for the links file; the fetch runs detached, so this never delays a steam
LINKS_MAX = 1 << 20  # FEX's is 5 kB
FIXED = ("version", "url", "sha256")
CHANNEL = ("channel", "distro", "type")


class Failed(Exception):
    pass


def log(msg):
    try:
        print(f"steam-x86-guest: {msg}", file=sys.stderr, flush=True)
    except (OSError, ValueError):
        pass


def pinned():
    """The pin's fields: name, and either channel + distro + type, or version + url + sha256."""
    try:
        with open(PIN, encoding="utf-8") as f:
            text = f.read()
    except OSError as err:
        raise Failed(f"no x86 guest pin: {err}")
    pin = {}
    for key in ("name",) + CHANNEL + FIXED:
        m = re.search(rf"^{key}:[ \t]*(\S+)", text, re.M)
        if m:
            pin[key] = m.group(1)
    need = CHANNEL if "channel" in pin else FIXED
    if "name" not in pin or not all(k in pin for k in need) or ("channel" in pin and any(k in pin for k in FIXED)):
        raise Failed(f"{PIN}: needs name, and either channel, distro and type or version, url and sha256")
    return pin


def wanted(pin):
    """(version, url, algo, digest) of the image the pin wants. For a channel, read its links file now."""
    if "channel" not in pin:
        return pin["version"], pin["url"], "sha256", pin["sha256"].lower()
    channel = pin["channel"]
    try:
        with urllib.request.urlopen(channel, timeout=CHANNEL_WAIT) as response:
            raw = response.read(LINKS_MAX + 1)
    except (OSError, ValueError, http.client.HTTPException) as err:
        raise Failed(f"could not read the x86 guest channel {channel}: {err}")
    try:
        if len(raw) > LINKS_MAX:
            raise ValueError("over 1 MB")
        # {"v1": {"ArchLinux (SquashFS)": {"DistroMatch": "arch", "Type": "squashfs", "URL": ..., "Hash": ...}}}
        found = [e for e in json.loads(raw)["v1"].values()
                 if isinstance(e, dict) and e.get("DistroMatch") == pin["distro"] and e.get("Type") == pin["type"]]
        if len(found) != 1:
            raise ValueError(f"{len(found)} entries for {pin['distro']} {pin['type']}, not one")
        url, xxh3 = found[0].get("URL"), found[0].get("Hash")
        # The Hash is FEX's XXH3-64 in hex, without leading zeros (FEX reads it with stoul(Hash, 16)).
        if not (isinstance(url, str) and isinstance(xxh3, str) and re.fullmatch(r"[0-9A-Fa-f]{1,16}", xxh3)):
            raise ValueError(f"no URL and Hash in {found[0]!r}")
        scheme = urllib.parse.urlsplit(url).scheme
        if scheme != "https" and scheme != urllib.parse.urlsplit(channel).scheme:
            raise ValueError(f"{url} is neither https nor from where the channel is")
    except (ValueError, KeyError, TypeError, AttributeError) as err:
        raise Failed(f"the x86 guest channel {channel} is not a links file this can use: {err}")
    digest = f"{int(xxh3, 16):016x}"
    # The version names the file: FEX's dated directory (".../ArchLinux/2026-08-11/ArchLinux.sqsh") and the
    # hash, so the same bytes are never fetched twice and different ones never pass for them.
    path = urllib.parse.urlsplit(url).path.split("/")
    dated = path[-2] if len(path) > 2 else ""
    version = f"{dated}-{digest}" if re.fullmatch(r"[0-9A-Za-z][0-9A-Za-z._-]{0,63}", dated) else digest
    return version, url, "xxh3", digest


def image_path(name, version):
    return os.path.join(GUEST, f"{name}-{version}.sqsh")


def images():
    return glob.glob(os.path.join(glob.escape(GUEST), "*.sqsh"))


def current():
    """The image fex-guest/current points at, when it is there."""
    try:
        path = os.path.join(GUEST, os.path.basename(os.readlink(CURRENT)))
    except OSError:
        return None
    return path if os.path.isfile(path) else None


def set_current(image):
    new = os.path.join(GUEST, ".current.new")
    try:
        os.unlink(new)
    except FileNotFoundError:
        pass
    os.symlink(os.path.basename(image), new)
    os.replace(new, CURRENT)


def lock(path, mode):
    """An open lock file, locked with `mode` (fcntl.LOCK_*); None when LOCK_NB could not get it."""
    f = open(path, "a")
    try:
        fcntl.flock(f, mode)
    except BlockingIOError:
        f.close()
        return None
    return f


def steam_running():
    """True while some steam's holder holds .users.lock."""
    f = lock(USERS, fcntl.LOCK_EX | fcntl.LOCK_NB)
    if f is None:
        return True
    f.close()
    return False


def unescape(field):
    """A /proc/mounts field: a space is \\040, a tab \\011, a newline \\012, a backslash \\134."""
    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), field)


def mounted(path=ROOT):
    try:
        with open(MOUNTS, encoding="utf-8", errors="replace") as f:
            return any(len(fl) > 1 and unescape(fl[1]) == path for fl in (line.split() for line in f))
    except OSError:
        return False


def mounted_image():
    """The image on ROOT, as do_mount noted it; None when nothing is mounted."""
    if not mounted():
        return None
    try:
        with open(MOUNTED, encoding="utf-8") as f:
            return f.read().strip() or None
    except OSError:
        return None


def working(path=ROOT):
    """A mount there that serves the tree (a killed squashfuse leaves one that fails: ENOTCONN)."""
    try:
        return os.path.isfile(os.path.join(path, "graphics_provider.json"))
    except OSError:
        return False


def fusermount_u():
    """Release ROOT, then the image under our x86 Mesa when one is mounted on BASE."""
    for path in (ROOT, BASE):
        if path == BASE and not mounted(BASE):
            continue
        try:
            subprocess.run([FUSERMOUNT, "-u", "-z", path], stdin=subprocess.DEVNULL,
                           stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, check=False)
        except OSError as err:
            log(f"{FUSERMOUNT}: {err}")


def payload(image):
    """Our x86 Mesa tree to lay over image, or None: none in the image, or the image predates the
    snapshot the payload was built against (it could lack the glibc the payload links against)."""
    tree = os.path.join(MESA, "root")
    if not os.path.isdir(tree):
        return None
    name = os.path.basename(image)
    try:
        with open(os.path.join(MESA, "payload.conf"), encoding="utf-8") as f:
            snap = re.search(r"^snapshot=([0-9]{4}-[0-9]{2}-[0-9]{2})$", f.read(), re.M)
    except OSError:
        snap = None
    date = re.search(r"-([0-9]{4}-[0-9]{2}-[0-9]{2})(?:-[0-9a-f]+)?\.sqsh$", name)
    if not snap or not date:
        log(f"not laying our x86 Mesa over {name}: cannot tell its date or the payload's")
        return None
    if date.group(1) < snap.group(1):
        log(f"not laying our x86 Mesa over {name}: it predates the payload's snapshot {snap.group(1)}")
        return None
    return tree


def fuse(argv, what):
    """Run a FUSE mounter with TERM and INT ignored; True when it says it mounted."""
    # Ignored signals survive exec, and libfuse keeps them (it only replaces default handlers).
    old = [signal.signal(s, signal.SIG_IGN) for s in (signal.SIGTERM, signal.SIGINT)]
    try:
        res = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.PIPE, text=True)
    except OSError as err:
        log(f"could not run {argv[0]}: {err}")
        return False
    finally:
        signal.signal(signal.SIGTERM, old[0])
        signal.signal(signal.SIGINT, old[1])
    if res.returncode != 0:
        log(f"{argv[0]} could not mount {what}: {res.stderr.strip()}")
        return False
    return True


def serving(path, what):
    """Wait until path is mounted and serves graphics_provider.json."""
    deadline = time.monotonic() + MOUNT_WAIT
    while not (mounted(path) and working(path)):
        if time.monotonic() > deadline:
            if mounted(path):
                log(f"{what} is mounted but has no graphics_provider.json at its root")
            else:
                log(f"{what} did not mount on {path}")
            return False
        time.sleep(0.05)
    return True


def do_mount(image):
    """Mount image on ROOT (the caller holds MOUNT_LOCK); True when it serves the tree afterwards."""
    if mounted():
        if working():
            return True
        log(f"releasing a dead mount on {ROOT}")
        fusermount_u()
    elif mounted(BASE):  # a mount cut short between the image and the overlay
        fusermount_u()
    tree = payload(image)
    os.makedirs(ROOT, exist_ok=True)
    if tree is None:
        if not fuse([SQUASHFUSE, image, ROOT], image) or not serving(ROOT, image):
            return False
    else:
        os.makedirs(BASE, exist_ok=True)
        if not fuse([SQUASHFUSE, image, BASE], image) or not serving(BASE, image):
            fusermount_u()
            return False
        if not fuse([FUSE_OVERLAYFS, "-o", f"lowerdir={tree}:{BASE}", ROOT], f"our x86 Mesa over {image}") \
                or not serving(ROOT, f"our x86 Mesa over {image}"):
            fusermount_u()
            return False
    with open(MOUNTED, "w", encoding="utf-8") as f:
        f.write(image + "\n")
    log(f"mounted {os.path.basename(image)} on {ROOT}" + (", with our x86 Mesa over it" if tree else ""))
    return True


def remove(paths):
    for path in paths:
        log(f"removing {os.path.basename(path)}")
        try:
            os.unlink(path)
        except OSError as err:
            log(f"could not remove {path}: {err}")


def tidy():
    """Remove every image but the current one, the mounted one and a fixed pin's own. The caller holds
    MOUNT_LOCK and FETCH_LOCK. Nothing goes while no image is current or the pin cannot be read."""
    cur = current()
    if cur is None:
        return
    try:
        pin = pinned()
    except Failed:
        return
    keep = {cur, mounted_image()}
    if "channel" not in pin:
        keep.add(image_path(pin["name"], pin["version"]))
    remove(p for p in images() if p not in keep)


def cmd_mount(pin=None):
    pin = pin or pinned()
    with lock(MOUNT_LOCK, fcntl.LOCK_EX):
        image = current()
        have = image is not None
        if "channel" not in pin:
            want = image_path(pin["name"], pin["version"])
            have = os.path.isfile(want)
            if have:
                image = want
        if image:
            if not do_mount(image):
                return 1
        elif mounted() and not working():
            log(f"releasing a dead mount on {ROOT}")
            fusermount_u()
    return 0 if have else 2


def cmd_release():
    with lock(MOUNT_LOCK, fcntl.LOCK_EX):
        if not mounted() or steam_running():
            return 0
        fusermount_u()
        if mounted() or mounted(BASE):
            log(f"could not release {ROOT}")
            return 1
        # An older image kept because it was mounted can go now. A fetch that is at it tidies up itself.
        fetching = lock(FETCH_LOCK, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if fetching is not None:
            with fetching:
                tidy()
    return 0


def hold(pid, ready):
    """The holder: .users.lock shared until steam (pid) exits, then release. Never returns."""
    code = 0
    try:
        for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            signal.signal(s, signal.SIG_IGN)
        null = os.open(os.devnull, os.O_RDWR)
        os.dup2(null, 0)
        os.dup2(null, 1)
        os.close(null)
        os.chdir("/")
        users = lock(USERS, fcntl.LOCK_SH)
        try:
            pidfd = os.pidfd_open(pid)
        except OSError:
            pidfd = None  # gone already, or no pidfd: poll below
        os.write(ready, b"1")
        os.close(ready)
        if pidfd is not None:
            p = select.poll()
            p.register(pidfd, select.POLLIN)
            p.poll()
        else:
            while True:
                try:
                    os.kill(pid, 0)
                except ProcessLookupError:
                    break
                except PermissionError:
                    pass
                time.sleep(1)
        users.close()
        cmd_release()
    except BaseException as err:  # noqa: BLE001 -- a forked child must never return into the caller
        log(f"holder: {err}")
        code = 1
    os._exit(code)


def cmd_start(pid):
    pin = pinned()
    # The holder first: a steam exiting between our mount and our lock would release our mount.
    r, w = os.pipe()
    child = os.fork()
    if child == 0:
        os.close(r)
        try:
            os.setsid()
            if os.fork():
                os._exit(0)
        except BaseException:  # noqa: BLE001
            os._exit(1)
        hold(pid, w)
    os.close(w)
    os.waitpid(child, 0)
    held = os.read(r, 1) == b"1"
    os.close(r)
    if not held:
        log("could not hold the x86 guest for this steam; not mounting it")
        return 1
    code = cmd_mount(pin)
    if code == 2 or "channel" in pin:
        try:
            subprocess.Popen([sys.executable, os.path.abspath(sys.argv[0]), "fetch"], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, start_new_session=True)
        except OSError as err:
            log(f"could not start the download: {err}")
            return 1
    return 1 if code == 1 else 0


def digest_of(path, algo):
    """path's sha256, or its XXH3-64 (FEX's links file has only that) from xxhsum, in lowercase hex. Failed
    when it cannot be computed: the file is left for the next fetch to check again."""
    if algo == "sha256":
        digest = hashlib.sha256()
        with open(path, "rb") as f:
            while chunk := f.read(1 << 20):
                digest.update(chunk)
        return digest.hexdigest()
    try:
        with open(path, "rb") as f:
            res = subprocess.run([XXHSUM, "-H3"], stdin=f, capture_output=True, text=True)
    except OSError as err:
        raise Failed(f"could not check {os.path.basename(path)}: {err}")
    m = re.match(r"(?:XXH3_)?([0-9a-fA-F]{1,16})\s", res.stdout)  # "XXH3_23350f949fc1413d  stdin"
    if res.returncode != 0 or not m:
        raise Failed(f"could not check {os.path.basename(path)} with {XXHSUM}: {(res.stderr or res.stdout).strip()}")
    return f"{int(m.group(1), 16):016x}"


def download(url, part, algo, digest):
    """url -> part, continuing a part an earlier download left; removed unless its digest matches."""
    have = on_disk = os.path.getsize(part) if os.path.isfile(part) else 0
    req = urllib.request.Request(url, headers={"Range": f"bytes={have}-"} if have else {})
    response = None
    try:
        response = urllib.request.urlopen(req, timeout=60)
    except urllib.error.HTTPError as err:
        if not (err.code == 416 and have):  # 416: the part is already whole
            raise Failed(f"could not download {url}: {err}")
    except (OSError, http.client.HTTPException) as err:
        raise Failed(f"could not download {url}: {err}")
    if response is not None:
        with response:
            if getattr(response, "status", None) != 206:
                have = 0  # the server sent it all again
            size = response.headers.get("Content-Length")
            todo = int(size) if size and size.isdigit() else 0
            if todo + SPARE > shutil.disk_usage(GUEST).free + on_disk - have:
                raise Failed(f"not enough space in {GUEST}: the x86 guest needs {(todo + SPARE) >> 20} MB free")
            if have:
                log(f"continuing the download at {have >> 20} MB")
            done, step = 0, max(todo // 10, 1)
            try:
                with open(part, "ab" if have else "wb") as out:
                    while chunk := response.read(1 << 20):
                        out.write(chunk)
                        if todo and (done + len(chunk)) // step > done // step:
                            log(f"{min(100, (done + len(chunk)) * 100 // todo)}% of {todo >> 20} MB")
                        done += len(chunk)
            except (OSError, http.client.HTTPException) as err:  # the part stays, for the next fetch
                raise Failed(f"download of {url} cut short at {(have + done) >> 20} MB: {err!r}")
            # http.client ends a body the server cut off without an error; the part stays for next time.
            if todo and done < todo:
                raise Failed(f"download of {url} cut short at {(have + done) >> 20} MB of {(have + todo) >> 20} MB")
    got = digest_of(part, algo)
    if got != digest:
        os.unlink(part)
        raise Failed(f"{algo} mismatch for {url}: got {got}, want {digest}")


def cmd_fetch():
    pin = pinned()
    busy = lock(FETCH_LOCK, fcntl.LOCK_EX | fcntl.LOCK_NB)
    if busy is None:
        return 0  # another fetch is at it
    with busy:
        try:
            version, url, algo, digest = wanted(pin)
        except Failed as err:
            cur = current()
            raise Failed(f"{err}; keeping {os.path.basename(cur)}" if cur else str(err))
        name = pin["name"]
        image = image_path(name, version)
        if not os.path.isfile(image):
            part = os.path.join(GUEST, f".{name}-{version}.sqsh.part")
            # Images stay until this one is in place (`mount` uses the current one); other parts go now.
            remove(p for p in glob.glob(os.path.join(glob.escape(GUEST), ".*.sqsh.part")) if p != part)
            log(f"downloading the x86 guest for Steam's FEX ({name} {version}) in the background: {url}")
            download(url, part, algo, digest)
            os.rename(part, image)
            log(f"the x86 guest is in place: {image}")
        set_current(image)
        with lock(MOUNT_LOCK, fcntl.LOCK_EX):
            tidy()
            busy.close()  # before .mount.lock goes, so a release that comes next can tidy too
            # A steam that started before this finished gets it now, unless an older image is mounted for it
            # (a game may be running from that one): then a start after the last steam exits does.
            if not (mounted() and working()) and steam_running():
                do_mount(image)
    return 0


def main():
    cmds = {"fetch": cmd_fetch, "mount": cmd_mount, "release": cmd_release}
    args = sys.argv[1:]
    if not ((len(args) == 1 and args[0] in cmds) or (len(args) == 2 and args[0] == "start" and args[1].isdigit())):
        print("usage: steam-x86-guest start <steam pid> | fetch | mount | release", file=sys.stderr)
        return 64
    # A steam's .users.lock inherited here would count as a running Steam.
    os.closerange(3, os.sysconf("SC_OPEN_MAX"))
    try:
        os.makedirs(GUEST, exist_ok=True)
        if args[0] == "start":
            return cmd_start(int(args[1]))
        return cmds[args[0]]()
    except (Failed, OSError) as err:
        log(str(err))
        return 1


if __name__ == "__main__":
    sys.exit(main())
