#!/usr/bin/env python3
# install-steamcmd — put the image's arm64 steamcmd where the OpenGamepadUI Steam plugin runs it from.
#
# The plugin (ShadowBlip/OpenGamepadUI-steam) runs ~/.steam/steamcmd/steamcmd.sh, and when that is
# missing it downloads Valve's x86 bootstrapper there, which cannot run on this machine. The image
# ships Valve's arm64 one read-only (/usr/lib/retroforge/steamcmd, packages/steamcmd/prebuilt.pin).
# steamcmd updates itself where it runs, so it needs a writable copy. retroforge-session runs this, as
# the player, before every start of the shell:
#   - installs it when there is no working arm64 copy: nothing there yet, an x86 one the plugin
#     downloaded, or a half-written one;
#   - never touches a working arm64 copy (linuxarm64/steamcmd, and a steamcmd.sh that knows
#     linuxarm64): steamcmd has updated it past the image's copy, and the image's copy is only a
#     bootstrapper anyway;
#   - copies each file through a temporary file and a rename, steamcmd.sh LAST: the plugin skips
#     its download as soon as steamcmd.sh exists, so steamcmd.sh is what marks the copy complete;
#   - leaves everything else in the folder alone (the plugin's game installs, an x86 linux32/).
# Exit 0 when a working copy is in place (installed or kept), 1 when the image's copy is missing or
# the copy failed. Messages go to stderr (the session log); stdout stays empty.
#
# TEST SEAMS (tests/test-steamcmd-install.sh): RETROFORGE_STEAMCMD_SRC, RETROFORGE_STEAMCMD_DIR.
import os
import shutil
import sys
import tempfile

SRC = os.environ.get("RETROFORGE_STEAMCMD_SRC", "/usr/lib/retroforge/steamcmd")
DST = os.environ.get("RETROFORGE_STEAMCMD_DIR", os.path.expanduser("~/.steam/steamcmd"))
SCRIPT = "steamcmd.sh"
BINARY = os.path.join("linuxarm64", "steamcmd")


def log(msg):
    print(f"install-steamcmd: {msg}", file=sys.stderr)


def is_arm64_copy(root):
    """steamcmd.sh that picks linuxarm64 (Valve's x86 one only knows linux32) plus the binary."""
    try:
        with open(os.path.join(root, SCRIPT), encoding="utf-8", errors="replace") as f:
            knows_arm64 = "linuxarm64" in f.read()
    except OSError:
        return False
    return knows_arm64 and os.path.isfile(os.path.join(root, BINARY))


def files(root):
    """Every file of the image's copy, relative to it, steamcmd.sh last."""
    out = []
    for dirpath, _, names in os.walk(root):
        out += [os.path.relpath(os.path.join(dirpath, n), root) for n in names]
    return sorted(out, key=lambda rel: (rel == SCRIPT, rel))


def copy(rel):
    src, dst = os.path.join(SRC, rel), os.path.join(DST, rel)
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(dst), prefix=f".{os.path.basename(rel)}.")
    try:
        with os.fdopen(fd, "wb") as out, open(src, "rb") as f:
            shutil.copyfileobj(f, out)
        os.chmod(tmp, os.stat(src).st_mode & 0o777)
        os.replace(tmp, dst)
    except OSError:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def main():
    if not is_arm64_copy(SRC):
        log(f"no arm64 steamcmd in the image at {SRC}")
        return 1
    if is_arm64_copy(DST):
        return 0
    had_x86 = os.path.isfile(os.path.join(DST, SCRIPT))
    try:
        for rel in files(SRC):
            copy(rel)
    except OSError as err:
        log(f"could not install steamcmd: {err}")
        return 1
    log("installed the arm64 steamcmd" + (" over an x86 one" if had_x86 else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
