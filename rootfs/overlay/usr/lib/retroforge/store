def read_json(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def http_json(url, token=None, headers=None):
    hdrs = {"User-Agent": AGENT, **(headers or {})}
    if token:
        hdrs["Authorization"] = f"Bearer {token}"
    try:
        with urllib.request.urlopen(urllib.request.Request(url_of(url), headers=hdrs), timeout=30) as r:
            return json.load(r)
    except urllib.error.HTTPError as err:
        raise Failed(f"{url} answered {err.code}")
    except urllib.error.URLError as err:
        raise Offline(f"could not reach {url}: {err.reason}")
    except ValueError as err:
        raise Failed(f"{url} sent no JSON: {err}")


def follow(name, args, progress_re, progress, env=None):
    """The tool's download (install), progress(percent, 100) as it goes: (exit status, last error
    line). TERM or INT here stops it the way its own Ctrl-C does: SIGINT to its whole process group."""
    cmd = tool_command(name)
    if not cmd:
        raise NotReady(f"{name} is not set up")
    proc = subprocess.Popen(cmd + args, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True,
                            env=env, start_new_session=True)

    def stop(_sig, _frame):
        try:
            os.killpg(proc.pid, signal.SIGINT)
        except OSError:
            pass
        threading.Timer(20, lambda: proc.poll() is None and os.killpg(proc.pid, signal.SIGKILL)).start()
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, stop)
    error = ""
    for line in proc.stderr:
        m = re.search(progress_re, line)
        if m:
            progress(min(int(float(m.group(1))), 99), 100)
        elif "ERROR" in line or "CRITICAL" in line:
            error = line.strip()
            log(error)
    return proc.wait(), error


def prepare_prefix(store, gid):
    """The game's prefix, set up once before its first sync: a save path resolves inside it, and a
    new device's empty saves must not look newer than the cloud's."""
    if os.path.isfile(os.path.join(prefix_path(store, gid), "user.reg")):
        return
    log(f"{store} {gid}: setting up its Wine prefix")
    runtime, proton = runtime_dir(), proton_dir(store, gid)
    compat = os.path.dirname(prefix_path(store, gid))
    os.makedirs(compat, mode=0o700, exist_ok=True)
    env = dict(os.environ, STEAM_COMPAT_DATA_PATH=compat, STEAM_COMPAT_TOOL_PATHS=f"{proton}:{runtime}",
               STEAM_COMPAT_CLIENT_INSTALL_PATH=os.path.join(DATA, "steam-client"), SteamAppId="0", SteamGameId="0")
    os.makedirs(env["STEAM_COMPAT_CLIENT_INSTALL_PATH"], mode=0o700, exist_ok=True)
    cmd = [os.path.join(runtime, "_v2-entry-point"), "--verb=run", "--",
           os.path.join(proton, "proton"), "run", "wineboot", "--init"]
    seam = os.environ.get("RETROFORGE_STORE_RUN")
    subprocess.run(([seam] if seam else []) + cmd, env=env, stdout=subprocess.DEVNULL, check=False,
                   preexec_fn=game_child)


class Epic:
    """The Epic Games Store, through legendary. Its own config folder (LEGENDARY_CONFIG_PATH) holds
    user.json (the tokens) and installed.json. legendary exits 0 also when a command failed, so a
    result is read from what it logs and from installed.json."""

    name, title, tool = "epic", "Epic Games", "legendary"
    # Epic's sign-in, ending on its redirect API's JSON page with the authorizationCode for legendary's
    # client (what legendary.gl/epiclogin links to).
    redirect = "https://www.epicgames.com/id/api/redirect?clientId=34a02cf8f4414e29b15921876da36f9a&responseType=code"
    sign_in_url = "https://www.epicgames.com/id/login?redirectUrl=" + urllib.parse.quote(redirect, safe="")
    code_shape = r"[0-9a-f]{32}"
    # Art key -> (keyImages types, best first; the CDN's resize query, "" for the file as it is). The
    # files are up to 1200x1600 PNGs of 2-3 MB, which a card shows at 300x450: resized, a 360 px JPEG is
    # ~25 KB. A logo keeps its PNG, for its transparency.
    ART = {"portrait": (("DieselGameBoxTall", "OfferImageTall", "DieselStoreFrontTall"), "w=360&resize=1&quality=medium"),
           "landscape": (("DieselGameBox", "OfferImageWide"), "w=800&resize=1&quality=medium"),
           "hero": (("DieselGameBox", "OfferImageWide"), "w=1600&resize=1&quality=medium"),
           "logo": (("DieselGameBoxLogo",), "")}

    # What legendary logs when Epic refuses the stored refresh token (expired after a year, or revoked
    # by a password change; it then clears user.json itself), and when it cannot reach Epic to use it.
    REFUSED = "Stored credentials are no longer valid"
    UNREACHED = "HTTP request for login failed"

    def __init__(self):
        self.cfg = os.path.join(STORE_CONFIG, "legendary")
        self.env = dict(os.environ, LEGENDARY_CONFIG_PATH=self.cfg)

    def run(self, args, check=False):
        res = run_tool(self.tool, args, check=False, env=self.env)
        errors = [l for l in res.stderr.splitlines() if "ERROR" in l or "CRITICAL" in l]
        if check and self.REFUSED in res.stderr:
            # legendary has already cleared user.json: status reads signed out, the row says Sign in.
            raise NotReady("Epic Games ended the sign-in: sign in again in Settings > Stores")
        if check and self.UNREACHED in res.stderr:
            raise Offline("Epic Games could not be reached to renew the sign-in")
        if check and (res.returncode != 0 or errors):
            raise Failed(f"legendary {args[0]}: {(errors or [res.stderr.strip()])[-1]}")
        return res

    def status(self):
        user = read_json(os.path.join(self.cfg, "user.json"), {})
        return {"signed_in": bool(user.get("refresh_token")), "account": str(user.get("displayName", ""))}

    @staticmethod
    def code_in_url(url):
        return None

    @staticmethod
    def reads_page(url):
        u = urllib.parse.urlsplit(url)
        return u.scheme == "https" and u.hostname == "www.epicgames.com" and u.path == "/id/api/redirect"

    @classmethod
    def code_in_page(cls, text):
        try:
            code = json.loads(text).get("authorizationCode")
        except (ValueError, AttributeError):
            return None
        return code if isinstance(code, str) and re.fullmatch(cls.code_shape, code) else None

    def sign_in(self, code):
        os.makedirs(self.cfg, mode=0o700, exist_ok=True)
        self.run(["auth", "--delete"])
        res = self.run(["auth", "--code", code])
        m = re.search(r'Successfully logged in as "(.*)"', res.stderr)
        if not m:
            errors = [l for l in res.stderr.splitlines() if "ERROR" in l]
            raise Failed((errors or ["Epic did not sign in"])[-1].split(": ", 1)[-1])
        return m.group(1)

    def sign_out(self):
        self.run(["auth", "--delete"])

    def installed(self):
        return {k: v for k, v in read_json(os.path.join(self.cfg, "installed.json"), {}).items()
                if isinstance(v, dict) and not v.get("is_dlc")}

    def games(self):
        cache = os.path.join(DATA, "epic-games.json")
        try:
            owned = json.loads(self.run(["list", "--json", "--platform", "Windows"], check=True).stdout or "[]")
            write_private(cache, json.dumps(owned))
        except (Failed, ValueError) as err:
            if isinstance(err, NotReady):
                raise  # signed out: no library, not the last one
            owned = read_json(cache, None)
            if owned is None:
                raise
            log(f"the Epic library as last listed (now: {err})")
        installed, out = self.installed(), []
        for game in owned:
            if not self.is_game(game):
                continue
            app = str(game.get("app_name", ""))
            images = {i.get("type"): i.get("url") for i in game.get("metadata", {}).get("keyImages", [])
                      if isinstance(i, dict)}
            art = {}
            for key, (types, size) in self.ART.items():
                url = next((images[t] for t in types if images.get(t)), "")
                if url:
                    art[key] = url + ("&" if "?" in url else "?") + size if size else url
            inst = installed.get(app)
            out.append({"id": app, "title": str(game.get("app_title") or app), "installed": inst is not None,
                        "dir": inst.get("install_path", "") if inst else "", "art": art})
        return out

    @staticmethod
    def is_game(item):
        """An owned item that is a game. `legendary list` also gives a game's digital extras as items
        of their own (Death Stranding Content: its soundtrack and art book, categories games +
        digitalextras, not flagged DLC; Pocket FIT, 2026-10-29) and could give Unreal Engine assets
        (no `games` category). An item without categories is kept."""
        cats = {c.get("path") for c in item.get("metadata", {}).get("categories", []) if isinstance(c, dict)}
        return not cats or ("games" in cats and "digitalextras" not in cats)

    def install(self, gid, progress):
        base = os.path.join(GAMES, self.name)
        os.makedirs(base, mode=0o700, exist_ok=True)
        code, error = follow(self.tool, ["-y", "install", gid, "--platform", "Windows", "--base-path", base,
                                                    "--skip-sdl", "--skip-dlcs", "--max-shared-memory", MAX_MEMORY_MIB,
                                                    "--max-workers", MAX_WORKERS],
                             r"= Progress: (\d+(?:\.\d+)?)%", progress, env=self.env)
        if gid not in self.installed():
            raise Failed(error.split(": ", 1)[-1] if error else f"legendary install exited {code}")

    def uninstall(self, gid):
        self.run(["-y", "uninstall", gid])
        if gid in self.installed():
            raise Failed("legendary did not uninstall it")

    def launch_info(self, gid):
        """(exe, args, working folder, install folder) from `legendary launch --json`: online for a fresh exchange
        code, else offline (a game that runs offline still starts without the network)."""
        res = self.run(["launch", gid, "--json", "--no-wine", "--skip-version-check"])
        try:
            p = json.loads(res.stdout)
        except ValueError:
            log("Epic could not be reached: the game starts offline")
            p = json.loads(self.run(["launch", gid, "--json", "--no-wine", "--offline"], check=True).stdout)
        exe = os.path.join(p["game_directory"], p["game_executable"].replace("\\", "/"))
        args = list(p.get("game_parameters", [])) + list(p.get("user_parameters", [])) + list(p.get("egl_parameters", []))
        return exe, args, p.get("working_directory") or p["game_directory"], p["game_directory"]

    def sync_saves(self, gid, direction):
        """down: before the game (and records the save path, from the prefix); up: after it."""
        env = dict(self.env, STEAM_COMPAT_DATA_PATH=os.path.dirname(prefix_path(self.name, gid)))
        args = ["-y", "sync-saves", gid] + (["--skip-upload", "--accept-path"] if direction == "down" else ["--skip-download"])
        res = run_tool(self.tool, args, check=False, env=env)
        errors = [l for l in res.stderr.splitlines() if "ERROR" in l]
        if errors:
            raise Failed(errors[-1].split(": ", 1)[-1])


class Gog:
    """GOG, through gogdl. gogdl lists no library and keeps no record of installs: the library comes
    from GOG's own API (as Heroic reads it), installs are recorded here (gog-installed.json)."""

    name, title, tool = "gog", "GOG", "gogdl"
    client_id = "46899977096215655"
    # GOG Galaxy's sign-in, ending on an empty page whose address carries the code.
    sign_in_url = ("https://auth.gog.com/auth?client_id=46899977096215655&redirect_uri=https%3A%2F%2Fembed.gog.com"
                   "%2Fon_login_success%3Forigin%3Dclient&response_type=code&layout=galaxy")
    code_shape = r"[A-Za-z0-9_\-.~]{10,2048}"

    def __init__(self):
        self.auth = os.path.join(STORE_CONFIG, "gog-auth.json")
        self.account = os.path.join(STORE_CONFIG, "gog-account.json")
        self.records = os.path.join(DATA, "gog-installed.json")
        self.env = dict(os.environ, GOGDL_CONFIG_PATH=os.path.join(DATA, "gogdl"))

    def run(self, args, check=True):
        return run_tool(self.tool, ["--auth-config-path", self.auth] + args, check=check, env=self.env)

    def status(self):
        signed_in = bool(read_json(self.auth, {}).get(self.client_id))
        return {"signed_in": signed_in, "account": read_json(self.account, {}).get("username", "") if signed_in else ""}

    @classmethod
    def code_in_url(cls, url):
        u = urllib.parse.urlsplit(url)
        if u.scheme != "https" or u.hostname != "embed.gog.com" or u.path != "/on_login_success":
            return None
        code = (urllib.parse.parse_qs(u.query).get("code") or [None])[0]
        return code if code and re.fullmatch(cls.code_shape, code) else None

    @staticmethod
    def reads_page(url):
        return False

    @staticmethod
    def code_in_page(text):
        return None

    def credentials(self):
        """The account's token, refreshed when it has expired (gogdl auth). gogdl prints null both when
        GOG refuses the refresh token (revoked) and when GOG cannot be reached, and logs only the
        latter. Refused: signed out here too, so the Stores row says Sign in."""
        res = self.run(["auth"])
        try:
            creds = json.loads(res.stdout or "null")
        except ValueError:
            creds = None
        if isinstance(creds, dict) and creds.get("access_token"):
            return creds
        if "Failed to refresh credentials" in res.stderr:
            raise Offline("GOG could not be reached to renew the sign-in")
        if self.status()["signed_in"]:
            self.sign_out()
            raise NotReady("GOG ended the sign-in: sign in again in Settings > Stores")
        raise NotReady("not signed in to GOG")

    def sign_in(self, code):
        os.makedirs(STORE_CONFIG, mode=0o700, exist_ok=True)
        res = self.run(["auth", "--code", code], check=False)
        creds = json.loads(res.stdout or "null") if res.stdout.strip().startswith("{") else None
        if not isinstance(creds, dict) or creds.get("error") or not creds.get("access_token"):
            raise Failed("GOG did not take the code; it may have expired")
        os.chmod(self.auth, 0o600)
        user = http_json(f"https://users.gog.com/users/{creds['user_id']}", creds["access_token"])
        name = str(user.get("username", ""))
        write_private(self.account, json.dumps({"username": name, "user_id": creds["user_id"]}))
        return name

    def sign_out(self):
        for path in (self.auth, self.account):
            try:
                os.remove(path)
            except FileNotFoundError:
                pass

    def installed(self):
        return {k: v for k, v in read_json(self.records, {}).items()
                if os.path.isdir(v.get("path", "")) and not os.path.exists(os.path.join(v["path"], ".gogdl-resume"))}

    def details(self, gid, token):
        """gamesdb's entry for a game, kept in <data>/gog-meta/<id>.json."""
        path = os.path.join(DATA, "gog-meta", f"{gid}.json")
        meta = read_json(path, None)
        if meta is None:
            meta = http_json(f"https://gamesdb.gog.com/platforms/gog/external_releases/{gid}", token)
            write_private(path, json.dumps(meta))
        return meta

    def games(self):
        cache = os.path.join(DATA, "gog-games.json")
        try:
            creds = self.credentials()
            ids, page = [], ""
            while True:
                url = f"https://galaxy-library.gog.com/users/{creds['user_id']}/releases"
                data = http_json(url + (f"?page_token={page}" if page else ""), creds["access_token"])
                ids += [str(i["external_id"]) for i in data.get("items", [])
                        if i.get("platform_id") == "gog" and i.get("owned", True)]
                page = data.get("next_page_token") or ""
                if not page:
                    break
            from concurrent.futures import ThreadPoolExecutor
            with ThreadPoolExecutor(8) as pool:
                metas = list(pool.map(lambda g: (g, self._safe_details(g, creds["access_token"])), ids))
            owned = []
            for gid, meta in metas:
                game = meta.get("game") or {}
                oses = {o.get("slug") for o in meta.get("supported_operating_systems", []) if isinstance(o, dict)}
                if meta.get("type") != "game" or game.get("visible_in_library") is False or "windows" not in oses:
                    continue
                title = (meta.get("title") or {}).get("*") or (game.get("title") or {}).get("*") or gid
                # GOG's image service sizes by a suffix ("{formatter}"): a cover is 54 KB as it is
                # and 30 KB as _glx_vertical_cover (both 342x482), a background 365 KB and 63 KB at
                # _800, a logo 2.1 MB and 14 KB as _glx_logo.
                art = {}
                for key, field, size, ext in (("portrait", "vertical_cover", "_glx_vertical_cover", "jpg"), ("landscape", "background", "_800", "jpg"),
                                              ("hero", "background", "_1600", "jpg"), ("logo", "logo", "_glx_logo", "png")):
                    fmt = (game.get(field) or {}).get("url_format", "")
                    if fmt:
                        art[key] = fmt.replace("{formatter}", size).replace("{ext}", ext)
                owned.append({"id": gid, "title": title, "art": art})
            write_private(cache, json.dumps(owned))
        except (Failed, ValueError) as err:
            if isinstance(err, NotReady):
                raise
            owned = read_json(cache, None)
            if owned is None:
                raise
            log(f"the GOG library as last listed (now: {err})")
        installed = self.installed()
        for game in owned:
            inst = installed.get(game["id"])
            game.update(installed=inst is not None, dir=inst["path"] if inst else "")
        return owned

    def _safe_details(self, gid, token):
        try:
            return self.details(gid, token)
        except Failed as err:
            log(f"no details for GOG game {gid}: {err}")
            return {}

    def install(self, gid, progress):
        info = json.loads(self.run(["info", gid, "--os", "windows", "--lang", "en-US"]).stdout or "{}")
        folder = info.get("folder_name")
        if not folder:
            raise Failed("GOG lists no Windows build of it")
        base = os.path.join(GAMES, self.name)
        support = os.path.join(DATA, "gog-support", gid)
        os.makedirs(base, mode=0o700, exist_ok=True)
        code, error = follow(self.tool, ["--auth-config-path", self.auth, "download", gid, "--platform", "windows",
                                                    "--path", base, "--support", support, "--lang", "en-US",
                                                    "--skip-dlcs", "--max-workers", MAX_WORKERS],
                             r"= Progress: (\d+(?:\.\d+)?) ", progress, env=self.env)
        path = os.path.join(base, folder)
        if code != 0 or not os.path.isfile(os.path.join(path, f"goggame-{gid}.info")):
            raise Failed(error.split(": ", 1)[-1] if error else f"gogdl download exited {code}")
        records = read_json(self.records, {})
        records[gid] = {"path": path, "support": support, "build": info.get("buildId", ""),
                        "etag": info.get("versionEtag", ""), "lang": "en-US"}
        write_private(self.records, json.dumps(records))

    def uninstall(self, gid):
        records = read_json(self.records, {})
        rec = records.pop(gid, None)
        if not rec:
            raise Failed("it is not installed")
        for path in (rec.get("path", ""), rec.get("support", ""),
                     os.path.join(self.env["GOGDL_CONFIG_PATH"], "heroic_gogdl", "manifests", gid)):
            if path and os.path.isdir(path):
                shutil.rmtree(path, ignore_errors=True)
            elif path and os.path.isfile(path):
                os.remove(path)
        write_private(self.records, json.dumps(records))

    def game_info(self, gid):
        rec = self.installed().get(gid)
        if not rec:
            raise Failed("it is not installed")
        info = read_json(os.path.join(rec["path"], f"goggame-{gid}.info"), None)
        if not isinstance(info, dict):
            raise Failed(f"goggame-{gid}.info is missing or unreadable")
        return rec["path"], info

    def launch_info(self, gid):
        """(exe, args, working folder, install folder) of the build's primary play task (goggame-<id>.info)."""
        import shlex
        path, info = self.game_info(gid)
        tasks = [t for t in info.get("playTasks", []) if t.get("type", "FileTask") == "FileTask" and t.get("path")]
        task = next((t for t in tasks if t.get("isPrimary")), tasks[0] if tasks else None)
        if not task:
            raise Failed("the game lists nothing to run")
        exe = self._file(path, task["path"])
        args = shlex.split(task.get("arguments", "").replace("\\", "/"))
        workdir = self._file(path, task["workingDir"]) if task.get("workingDir") else os.path.dirname(exe)
        return exe, args, workdir, path

    @staticmethod
    def _file(root, rel):
        """root/rel with rel's backslashes, matched case-insensitively as Windows would."""
        cur = root
        for part in [p for p in rel.replace("\\", "/").split("/") if p and p != "."]:
            nxt = os.path.join(cur, part)
            if not os.path.exists(nxt) and os.path.isdir(cur):
                nxt = os.path.join(cur, next((e for e in os.listdir(cur) if e.lower() == part.lower()), part))
            cur = nxt
        return cur

    def save_locations(self, gid):
        """[(name, folder)] of the game's cloud saves, inside its prefix; [] without cloud saves."""
        path, info = self.game_info(gid)
        client = info.get("clientId", "")
        if not client:
            return []
        conf = http_json(f"https://remote-config.gog.com/components/galaxy_client/clients/{client}?component_version=2.0.45")
        cloud = conf.get("content", {}).get("Windows", {}).get("cloudStorage", {})
        if not cloud.get("enabled"):
            return []
        user = os.path.join(prefix_path(self.name, gid), "drive_c", "users", "steamuser")
        where = {"INSTALL": path, "SAVED_GAMES": os.path.join(user, "Saved Games"),
                 "APPLICATION_DATA_LOCAL": os.path.join(user, "AppData", "Local"),
                 "APPLICATION_DATA_LOCAL_LOW": os.path.join(user, "AppData", "LocalLow"),
                 "APPLICATION_DATA_ROAMING": os.path.join(user, "AppData", "Roaming"),
                 "DOCUMENTS": os.path.join(user, "Documents")}
        locations = cloud.get("locations") or [{"name": "__default", "location":
                    f"<?APPLICATION_DATA_LOCAL?>/GOG.com/Galaxy/Applications/{client}/Storage/Shared/Files"}]
        out = []
        for loc in locations:
            text = str(loc.get("location", ""))
            if re.search(r"<\?(\w+)\?>", text) and all(m in where for m in re.findall(r"<\?(\w+)\?>", text)):
                folder = re.sub(r"<\?(\w+)\?>", lambda m: where[m.group(1)], text).replace("\\", "/")
                out.append((str(loc.get("name", "__default")), os.path.normpath(folder)))
        return out

    def sync_saves(self, gid, direction):
        """One gogdl save-sync per location. The time of the last sync is kept per location; after a
        conflict (both sides changed) it is NOT moved on, so nothing is overwritten later: gogdl
        transfers nothing on a conflict but still prints a fresh time."""
        stamps_path = os.path.join(DATA, "gog-saves.json")
        stamps = read_json(stamps_path, {})
        conflicts = []
        for name, folder in self.save_locations(gid):
            key = f"{gid}.{name}"
            res = self.run(["save-sync", folder, gid, "--os", "windows", "--ts", stamps.get(key, "0"),
                            "--name", name, "--skip-upload" if direction == "down" else "--skip-download"], check=False)
            if res.returncode != 0:
                raise Failed((res.stderr.strip().splitlines() or [f"exit {res.returncode}"])[-1].split(": ", 1)[-1])
            if "Files in conflict" in res.stderr:
                conflicts.append(name)
            elif re.fullmatch(r"\d+(\.\d+)?", res.stdout.strip()):
                stamps[key] = res.stdout.strip()
        write_private(stamps_path, json.dumps(stamps))
        if conflicts:
            raise Failed("its saves changed both here and in GOG's cloud; both were left as they are")


STORES = {"gog": Gog, "epic": Epic}


def art_path(store, gid, key, url):
    """Where library_store.gd keeps a game's art: <cache>/retroforge/store-art/<store>/<id>/<key>-<the
    url's sha1, 12 hex> (Godot's validate_filename on the id, sha1_text on the url)."""
    cache = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    safe = re.sub(r'[:/\\?*"|%<>]', "_", gid)
    return os.path.join(cache, "retroforge", "store-art", store, safe, f"{key}-{hashlib.sha1(url.encode()).hexdigest()[:12]}")


def prefetch_art(name):
    """Every listed game's portrait cover that is not cached yet (ART above). One run per store at a time."""
    import fcntl
    import http.client
    import urllib.parse
    from concurrent.futures import ThreadPoolExecutor
    os.makedirs(DATA, mode=0o700, exist_ok=True)
    lock = open(os.path.join(DATA, f".art-{name}.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return
    todo = []
    for game in read_json(os.path.join(DATA, f"{name}-library.json"), []):
        url = str((game.get("art") or {}).get("portrait", ""))
        dest = art_path(name, str(game.get("id", "")), "portrait", url) if url.startswith("https://") else ""
        if dest and not os.path.exists(dest) and not os.path.exists(dest + ".missing"):
            todo.append((url, dest))
    local = threading.local()

    def get(url, dest):
        target = urllib.parse.urlsplit(url_of(url))
        conns = local.__dict__.setdefault("conns", {})
        status, body = 0, b""
        for _ in range(2):  # a kept-alive connection the server closed: once more, on a new one
            conn = conns.get(target.netloc)
            if conn is None:
                kind = http.client.HTTPSConnection if target.scheme == "https" else http.client.HTTPConnection
                conn = conns[target.netloc] = kind(target.netloc, timeout=20)
            try:
                conn.request("GET", target.path + (f"?{target.query}" if target.query else ""), headers={"User-Agent": AGENT})
                r = conn.getresponse()
                status, body = r.status, r.read()
                if status in (301, 302, 303, 307, 308):
                    with urllib.request.urlopen(urllib.request.Request(r.getheader("Location", ""), headers={"User-Agent": AGENT}),
                                                timeout=20) as moved:
                        status, body = moved.status, moved.read()
                break
            except (OSError, http.client.HTTPException, ValueError):
                conn.close()
                conns.pop(target.netloc, None)
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        if status == 200 and body:
            with open(dest + ".part", "wb") as f:
                f.write(body)
            os.replace(dest + ".part", dest)
            return "fetched"
        if 400 <= status < 500:  # as library_store.gd: not asked again for a day
            open(dest + ".missing", "w").close()
            return "missing"
        return "failed"

    with ThreadPoolExecutor(4) as pool:
        results = list(pool.map(lambda t: get(*t), todo))
    if todo:
        log(f"{name} covers: {results.count('fetched')} fetched, {results.count('missing')} missing, "
            f"{results.count('failed')} failed, of {len(todo)} not cached")


def launch(store, gid):
    """Saves down, the game, saves up. No upload after a failed download: this device's saves could
    then be older than the cloud's and still win."""
    exe, args, workdir, game_dir = store.launch_info(gid)
    try:
        prepare_prefix(store.name, gid)
        store.sync_saves(gid, "down")
        synced = True
    except Failed as err:
        notice(store.name, f"Cloud saves were not synced this time, so the cloud copy stays as it was: {err}")
        synced = False
    code = run_windows_game(store.name, gid, exe, args, workdir, game_dir)
    if synced:
        try:
            store.sync_saves(gid, "up")
        except Failed as err:
            notice(store.name, f"Cloud saves were not uploaded: {err}")
    return code


def set_up_browser(progress):
    """The sign-in's Chromium (BROWSER above), set up when it is not; its paths."""
    try:
        return chromium_setup.set_up(DATA, os.path.join(PINS, "chromium.pin"), fetch, progress)
    except (chromium_setup.SetupError, OSError) as err:
        raise Failed(f"Chromium set-up: {err}")


def browser(verb):
    """`store browser status|setup`: the sign-in's Chromium (BROWSER above)."""
    if verb == "status":
        found = chromium_setup.installed(DATA, os.path.join(PINS, "chromium.pin"))
        print(json.dumps({"ready": bool(found), "binary": found["binary"] if found else None}))
    elif verb == "setup":
        os.nice(10)  # as a tool's set-up: behind OGUI
        set_up_browser(percent_printer())
    else:
        print("usage: store browser status|setup", file=sys.stderr)
        return 2
    return 0


def main(argv):
    if len(argv) == 3 and argv[1] == "browser":
        try:
            return browser(argv[2])
        except Failed as err:
            log(str(err))
            return err.code
    if len(argv) < 3 or argv[1] not in STORES:
        print("usage: store <gog|epic> status|setup|sign-in|sign-out|games|install <id>|uninstall <id>|launch <id>",
              file=sys.stderr)
        return 2
    store, verb, rest = STORES[argv[1]](), argv[2], argv[3:]
    if verb in ("setup", "games", "art", "install", "uninstall"):
        os.nice(10)  # behind OGUI and a running game: a download decompresses on every core
    if verb in ("install", "uninstall", "launch") and len(rest) != 1:
        print(f"usage: store {store.name} {verb} <id>", file=sys.stderr)
        return 2
    try:
        if verb == "status":
            print(json.dumps({"ready": bool(tool_command(store.tool)), **store.status()}))
        elif verb == "setup":
            set_up_tool(store.tool, percent_printer())
        elif verb == "sign-in":
            sign_in(store, sign_in_display(rest))
        elif verb == "sign-out":
            store.sign_out()
        elif verb == "games":
            if not store.status()["signed_in"]:
                raise NotReady(f"not signed in to {store.title}")
            games = store.games()
            write_private(os.path.join(DATA, f"{store.name}-library.json"), json.dumps(games))  # for `art`
            print(json.dumps(games))
        elif verb == "art":
            prefetch_art(store.name)
        elif verb == "install":
            if not tool_command(store.tool):
                set_up_tool(store.tool, lambda d, t: None)
            # The game, then what it runs in (a first one may download both) and the umu-database,
            # so that its first launch does not wait for them, and has its fixes offline. A launch
            # never downloads the runtime: without it the install fails, and installing again
            # finds the game there and fetches only the rest.
            store.install(rest[0], percent_printer(0, 90))
            runtime_dir(percent_printer(90, 99))
            proton_dir()
            umu_database()
            print("100%", flush=True)
        elif verb == "uninstall":
            store.uninstall(rest[0])
        elif verb == "launch":
            return launch(store, rest[0])
        else:
            print(f"store: unknown command {verb}", file=sys.stderr)
            return 2
    except Failed as err:
        log(str(err))
        return err.code
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
