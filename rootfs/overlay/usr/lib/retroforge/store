def url_of(url):
    """url, or under RETROFORGE_STORE_API (tests)."""
    return f"{API}/{url.split('://', 1)[1]}" if API and url.startswith("https://") else url


class Failed(Exception):
    code = 1


class NotReady(Failed):
    code = 3


class Offline(Failed):
    code = 4


class Usage(Failed):
    code = 2


def log(msg):
    print(f"store: {msg}", file=sys.stderr, flush=True)


def event(**fields):
    print(json.dumps(fields), flush=True)


def read_pin(name):
    fields = {}
    try:
        with open(os.path.join(PINS, name + ".pin"), encoding="utf-8") as f:
            for line in f:
                if ":" in line and not line.lstrip().startswith("#"):
                    key, value = line.split(":", 1)
                    fields[key.strip()] = value.strip()
    except OSError as err:
        raise Failed(f"no pin for {name}: {err}")
    return fields


def write_private(path, text):
    """text into path, readable by the player only, replaced in one rename."""
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = path + ".part"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def fetch(url, dest, sha256=None, progress=None):
    """url -> dest, refused unless its sha256 matches (when one is given). progress(done, total).
    A transfer that fails is started again, FETCH_TRIES times in all: the snapshot's CDN (Akamai) now
    and then stalls a TLS handshake and resets it, which ended a 190 MB Chromium set-up on its 19th
    package while the same file came at once on the next try (Pocket FIT, 2026-10-29)."""
    return _tries(lambda: _fetch_once(url, dest, sha256, progress))


def _tries(attempt_once):
    """attempt_once(), again after a network failure, FETCH_TRIES times in all."""
    for attempt in range(1, FETCH_TRIES + 1):
        try:
            return attempt_once()
        except (Offline, _Transfer) as err:
            if attempt == FETCH_TRIES:
                raise
            log(f"{err}; trying again ({attempt + 1}/{FETCH_TRIES})")
            time.sleep(FETCH_PAUSE * attempt)


FETCH_TRIES = 3
FETCH_PAUSE = 2  # seconds before the second try, twice that before the third
FETCH_TIMEOUT = 30  # seconds one connect or read may wait


class _Transfer(Failed):
    """A download that broke off (a connection reset mid-file)."""


def _fetch_once(url, dest, sha256, progress):
    h = hashlib.sha256()
    req = urllib.request.Request(url_of(url), headers={"User-Agent": AGENT})
    try:
        with urllib.request.urlopen(req, timeout=FETCH_TIMEOUT) as r, open(dest, "wb") as out:
            total, done = int(r.headers.get("Content-Length") or 0), 0
            while chunk := r.read(1 << 20):
                h.update(chunk)
                out.write(chunk)
                done += len(chunk)
                if progress:
                    progress(done, total)
    except urllib.error.HTTPError as err:
        raise Failed(f"could not download {url}: HTTP {err.code}")
    except urllib.error.URLError as err:
        raise Offline(f"could not download {url}: {err.reason}")
    except OSError as err:
        raise _Transfer(f"could not download {url}: {err}")
    if sha256 and h.hexdigest() != sha256:
        raise Failed(f"sha256 mismatch for {url}: got {h.hexdigest()}, want {sha256}")
    return h.hexdigest()


def get_text(url, timeout=30, tries=True):
    """url's text. Tried again as fetch() is (a TLS handshake to repo.steampowered.com timed out
    once and failed a whole install, Pocket FIT 2026-10-29), unless tries is False."""
    def once():
        req = urllib.request.Request(url_of(url), headers={"User-Agent": AGENT})
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return r.read().decode("utf-8", "replace")
        except urllib.error.HTTPError as err:
            raise Failed(f"could not reach {url}: HTTP {err.code}")
        except urllib.error.URLError as err:
            raise Offline(f"could not reach {url}: {err.reason}")
        except OSError as err:
            raise _Transfer(f"could not reach {url}: {err}")
    return _tries(once) if tries else once()


def percent_printer(lo=0, hi=100, emit=None):
    """A progress(done, total) that prints `N%` lines (or calls emit(N)), scaled into lo..hi, each value once."""
    last = [-1]
    emit = emit or (lambda pct: print(f"{pct}%", flush=True))

    def progress(done, total):
        if total > 0:
            pct = lo + (hi - lo) * min(done, total) // total
            if pct != last[0]:
                last[0] = pct
                emit(pct)
    return progress


# ---- the stores' tools ----------------------------------------------------------------------------

def tool_dir(name):
    return os.path.join(DATA, "tools", f"{name}-{read_pin(name)['tag']}")


def tool_command(name):
    """The command that runs the tool, [] when it is not set up."""
    seam = os.environ.get("RETROFORGE_STORE_TOOL_" + name.upper())
    if seam:
        return [seam]
    folder = tool_dir(name)
    return [sys.executable, folder] if os.path.isfile(os.path.join(folder, "__main__.py")) else []


def set_up_tool(name, progress):
    """The pinned release of the tool, downloaded, checked, unpacked and compiled. Older ones go."""
    if tool_command(name):
        progress(1, 1)
        return
    pin = read_pin(name)
    final = tool_dir(name)
    tools = os.path.dirname(final)
    os.makedirs(tools, mode=0o700, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=tools, prefix=".setup-") as tmp:
        app = os.path.join(tmp, name)
        fetch(pin["url"], app, pin["sha256"], lambda d, t: progress(d * 9 // 10, t))
        unpacked = os.path.join(tmp, "unpacked")
        try:
            with zipfile.ZipFile(app) as z:
                for member in z.namelist():
                    if member.startswith("/") or ".." in member.split("/"):
                        raise Failed(f"{name}: a file outside its folder in the release ({member})")
                z.extractall(unpacked)
        except zipfile.BadZipFile as err:
            raise Failed(f"{name}: the release is not a zipapp ({err})")
        if not os.path.isfile(os.path.join(unpacked, "__main__.py")):
            raise Failed(f"{name}: the release has no __main__.py")
        subprocess.run([sys.executable, "-m", "compileall", "-q", "-j0", "--invalidation-mode", "checked-hash",
                        unpacked], stdout=subprocess.DEVNULL, check=False)
        shutil.rmtree(final, ignore_errors=True)
        os.rename(unpacked, final)
    for other in os.listdir(tools):
        if other.startswith(name + "-") and os.path.join(tools, other) != final:
            shutil.rmtree(os.path.join(tools, other), ignore_errors=True)
    progress(1, 1)
    log(f"{name} {pin['tag']} is set up in {final}")


def run_tool(name, args, check=True, **kw):
    cmd = tool_command(name)
    if not cmd:
        raise NotReady(f"{name} is not set up (store <store> setup)")
    res = subprocess.run(cmd + args, text=True, capture_output=True, **kw)
    if check and res.returncode != 0:
        last = (res.stderr.strip().splitlines() or [f"exit {res.returncode}"])[-1]
        raise Failed(f"{name} {args[0]}: {last}")
    return res


# ---- what a game runs in --------------------------------------------------------------------------

def read_text(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return ""


def runtime_dir(progress=None):
    """Steam Linux Runtime 4 arm64: Steam's, else ours (downloaded when progress is given)."""
    seam = os.environ.get("RETROFORGE_STORE_RUNTIME")
    if seam:
        return seam
    steams = os.path.join(STEAM_ROOT, "steamapps", "common", RUNTIME_NAME)
    if os.path.isfile(os.path.join(steams, "_v2-entry-point")):
        return steams
    ours = os.path.join(DATA, "runtime", RUNTIME_NAME)
    have = os.path.isfile(os.path.join(ours, "_v2-entry-point"))
    if progress is None:
        if have:
            return ours
        raise NotReady("Steam Linux Runtime 4 arm64 is not set up")
    pin = read_pin("steamrt4")
    try:
        version = get_text(f"{pin['base']}/VERSION.txt").strip()
    except Offline:
        if have:
            progress(1, 1)
            return ours
        raise
    stamp = os.path.join(DATA, "runtime", ".version")
    if have and read_text(stamp).strip() == version:
        progress(1, 1)
        return ours
    sums = get_text(f"{pin['base']}/SHA256SUMS")
    want = next((line.split()[0] for line in sums.splitlines()
                 if line.split() and line.split()[-1].lstrip("*") == pin["asset"]), None)
    if not want:
        raise Failed(f"{pin['base']}/SHA256SUMS lists no {pin['asset']}")
    top = os.path.dirname(ours)
    os.makedirs(top, mode=0o700, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=top, prefix=".setup-") as tmp:
        tarball = os.path.join(tmp, pin["asset"])
        fetch(f"{pin['base']}/{pin['asset']}", tarball, want, lambda d, t: progress(d * 9 // 10, t))
        with tarfile.open(tarball) as tar:
            tar.extractall(tmp, filter="tar")
        if not os.path.isfile(os.path.join(tmp, RUNTIME_NAME, "_v2-entry-point")):
            raise Failed(f"{pin['asset']} holds no {RUNTIME_NAME}/_v2-entry-point")
        old = ours + ".old"
        shutil.rmtree(old, ignore_errors=True)
        if os.path.isdir(ours):
            os.rename(ours, old)
        os.rename(os.path.join(tmp, RUNTIME_NAME), ours)
        shutil.rmtree(old, ignore_errors=True)
    with open(stamp, "w", encoding="utf-8") as f:
        f.write(version + "\n")
    progress(1, 1)
    log(f"Steam Linux Runtime 4 arm64 {version} is set up in {ours}")
    return ours


def proton_dir(store=None, gid=None):
    """The game's chosen Proton (game_choice "proton"), else the one steam-compat-tools keeps for this
    CPU, installed when it is missing."""
    name = game_choice(store, gid, "proton") if store else ""
    for base in ("compatibilitytools.d", os.path.join("steamapps", "common")):
        folder = os.path.join(STEAM_ROOT, base, name)
        if name and "/" not in name and os.path.isfile(os.path.join(folder, "proton")):
            return folder
    if name:
        log(f"{store} {gid}: no Proton {name!r}; the default one")
    env = dict(os.environ, RETROFORGE_STEAM_ROOT=STEAM_ROOT)
    res = subprocess.run([COMPAT_TOOLS, "on"], env=env, text=True, capture_output=True)
    folder = res.stdout.strip().splitlines()[-1] if res.stdout.strip() else ""
    if res.returncode != 0 or not os.path.isfile(os.path.join(folder, "proton")):
        last = (res.stderr.strip().splitlines() or ["no Proton"])[-1]
        raise Failed(f"no Proton to run the game with: {last}")
    return folder


def sarek():
    """The player's DXVK-Sarek setting for the game's environment ("1", "0", or "" to leave it)."""
    if not os.access(SAREK, os.X_OK):
        return ""
    res = subprocess.run([SAREK, "apply"], text=True, capture_output=True)
    return {"on": "1", "off": "0"}.get(res.stdout.strip(), "")


# The player's per-game choices, keyed "<store>-<id>": {"tso": "on" | "off" | "default", "proton": the
# folder name of a Proton in Steam's compatibilitytools.d or steamapps/common, e.g. "Proton
# Experimental (ARM64)"; unset or not there: the one steam-compat-tools keeps for this CPU,
# "protonfixes": "off" for none of umu-protonfixes' fixes or RetroForge's own (OWN_FIXES)}.
GAME_CHOICES = os.path.join(CONFIG_HOME, "retroforge", "store-games.json")


def game_choice(store, gid, key):
    try:
        with open(GAME_CHOICES, encoding="utf-8") as f:
            mine = json.load(f).get(f"{store}-{gid}", {})
    except (OSError, ValueError, AttributeError):
        mine = {}
    return str(mine.get(key, "")) if isinstance(mine, dict) else ""


def fex_tso(store, gid):
    """STEAM_FEX_TSOENABLED for the game: x86 memory ordering emulated (TSO) unless the player turned it
    off. A Steam game has Valve's per-game hint (retroforge-steam-direct); a store game has none, and
    without TSO GRIP crashed a minute in with a corrupt stack (Air X, 2026-10-24), the kind of race an
    x86 game's threads hit when their memory order is the ARM CPU's."""
    return "0" if game_choice(store, gid, "tso") == "off" else "1"


UMU_DATABASE = "https://raw.githubusercontent.com/Open-Wine-Components/umu-database/main/umu-database.csv"
UMU_STORES = {"gog": "gog", "epic": "egs"}  # our store -> the database's (and protonfixes') name for it


def umu_database():
    """The umu-database's CSV in <data>, fetched when it is missing or a day old; "" without one. When
    that fails the cached one stays, and is not tried again for a day."""
    path = os.path.join(DATA, "umu-database.csv")
    try:
        if time.time() - os.path.getmtime(path) < 86400:
            return path
    except OSError:
        pass
    try:
        text = get_text(UMU_DATABASE, timeout=10, tries=False)  # the cache serves when it fails
        header = next(csv.reader([text.split("\n", 1)[0]]), [])
        if not {"STORE", "CODENAME", "UMU_ID"} <= set(header):
            raise Failed(f"{UMU_DATABASE} sent no umu-database")
        write_private(path, text)
    except (Failed, OSError, ValueError) as err:
        if not os.path.isfile(path):
            log(f"no umu-database: {err}")
            return ""
        log(f"the umu-database as last fetched (now: {err})")
        os.utime(path)
    return path


def umu_id(store, gid):
    """The game's umu id in the umu-database ("umu-<n>"), "" when it has none. Its store's id is matched
    exactly, else ignoring case."""
    path, name, found = umu_database(), UMU_STORES.get(store), ""
    if not path or not name:
        return ""
    try:
        with open(path, newline="", encoding="utf-8") as f:
            for row in csv.DictReader(f):
                if row.get("STORE") == name and (row.get("CODENAME") or "").lower() == gid.lower():
                    found = str(row.get("UMU_ID") or "").strip()
                    if row["CODENAME"] == gid:
                        break
    except (OSError, csv.Error, UnicodeDecodeError):
        return ""
    return found


def protonfixes_env(store, gid):
    """What umu-protonfixes picks the game's fixes by (fix.py: UMU_ID, and STORE for its gamefixes-<store>),
    as umu-run sets them; PROTONFIXES_DISABLE when the player turned them off."""
    if game_choice(store, gid, "protonfixes") == "off":
        return {"PROTONFIXES_DISABLE": "1"}
    return {"UMU_ID": umu_id(store, gid) or "umu-default", "STORE": UMU_STORES[store]}


# RetroForge's own per-game fixes, keyed "<store>-<id>": {"title", "why", "ini": [{"file": a path in the
# prefix, "section", "key", "value"}]}.
OWN_FIXES = os.path.join(PINS, "game-fixes.json")


def set_ini(path, section, key, value):
    """key=value in [section] of an INI file (made when missing), every line for the key; the file's other
    lines, encoding (UTF-8, or UTF-16 as Unreal saves non-ASCII ones) and line ends stay. True if it changed."""
    try:
        with open(path, "rb") as f:
            raw = f.read()
    except FileNotFoundError:
        raw = b""
    enc = "utf-16" if raw[:2] in (b"\xff\xfe", b"\xfe\xff") else "utf-8-sig" if raw[:3] == b"\xef\xbb\xbf" else "utf-8"
    text = raw.decode(enc, "strict" if enc == "utf-16" else "surrogateescape")
    nl, lines, want = "\r\n" if "\r\n" in text else "\n", text.splitlines(), f"{key}={value}"
    start = next((i for i, line in enumerate(lines) if line.strip().lower() == f"[{section.lower()}]"), None)
    if start is None:
        lines += ([""] if lines and lines[-1].strip() else []) + [f"[{section}]", want]
    else:
        stop = next((i for i in range(start + 1, len(lines)) if lines[i].lstrip().startswith("[")), len(lines))
        hits = [i for i in range(start + 1, stop) if lines[i].split("=", 1)[0].strip().lower() == key.lower()]
        for i in hits:
            lines[i] = want
        if not hits:
            at = stop
            while at > start + 1 and not lines[at - 1].strip():
                at -= 1
            lines.insert(at, want)
    new = nl.join(lines) + nl
    if new == text:
        return False
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".part", "wb") as f:
        f.write(new.encode(enc, "strict" if enc == "utf-16" else "surrogateescape"))
    os.replace(path + ".part", path)
    return True


def apply_own_fixes(store, gid):
    """The game's entry in OWN_FIXES, into its prefix (set up by then: the prefix is Proton's to make). A
    folder of a file's path is matched case-insensitively, as Windows would; a fix that fails is logged."""
    fix = read_json(OWN_FIXES, {}).get(f"{store}-{gid}")
    pfx = prefix_path(store, gid)
    if not isinstance(fix, dict) or not os.path.isfile(os.path.join(pfx, "user.reg")):
        return
    for ini in fix.get("ini", []):
        rel = str(ini.get("file", ""))
        if not rel or rel.startswith("/") or ".." in rel.replace("\\", "/").split("/"):
            log(f"{store} {gid}: a fix outside its prefix ({rel!r}) is skipped")
            continue
        try:
            if set_ini(Gog._file(pfx, rel), ini["section"], ini["key"], str(ini["value"])):
                log(f"{store} {gid}: RetroForge fix: {rel.rsplit('/', 1)[-1]} [{ini['section']}] {ini['key']}={ini['value']}")
        except (OSError, KeyError, ValueError) as err:
            log(f"{store} {gid}: a RetroForge fix failed ({rel}): {err}")


def prefix_path(store, gid):
    """The game's Wine prefix (Proton's pfx/ in its compat data folder)."""
    return os.path.join(DATA, "prefixes", f"{store}-{gid}", "pfx")


def game_child():
    """The preexec_fn of every Proton process: in the child, before exec, the OOM killer's first choice
    (header). Its children inherit it."""
    try:
        with open("/proc/self/oom_score_adj", "w") as f:
            f.write(str(OOM_SCORE_ADJ))
    except OSError:
        pass  # never a reason not to start the game


def run_windows_game(store, gid, exe, args, workdir, game_dir, extra_env=None):
    """The game through Proton in the runtime; its exit status. game_dir is its install folder: Proton
    maps drive S: to the library folder holding it (STEAM_COMPAT_LIBRARY_PATHS), and a game that
    climbs from its program to its content (Unreal: Binaries/Win64 -> ../../) needs room above the
    program. With the working folder there, GRIP saw itself as S:\\Win64\\... and could not find its
    content ("Failed to load Grip.uproject", Air X, 2026-10-24)."""
    runtime, proton = runtime_dir(), proton_dir(store, gid)
    compat = os.path.dirname(prefix_path(store, gid))
    client = os.path.join(DATA, "steam-client")
    for d in (compat, client):
        os.makedirs(d, mode=0o700, exist_ok=True)
    env = dict(os.environ)
    env.update({
        "SteamAppId": "0", "SteamGameId": "0", "STEAM_COMPAT_APP_ID": "0",
        "STEAM_COMPAT_CLIENT_INSTALL_PATH": client,
        "STEAM_COMPAT_DATA_PATH": compat,
        "STEAM_COMPAT_INSTALL_PATH": game_dir,
        "STEAM_COMPAT_SHADER_PATH": os.path.join(DATA, "shadercache", f"{store}-{gid}"),
        "STEAM_COMPAT_LIBRARY_PATHS": os.path.dirname(game_dir.rstrip("/")),
        # Innermost first, as Steam lists them: Proton, then the runtime it runs in.
        "STEAM_COMPAT_TOOL_PATHS": f"{proton}:{runtime}",
        "SteamDeck": "1",
        "STEAM_FEX_TSOENABLED": fex_tso(store, gid),
    })
    s = sarek()
    if s:
        env["PROTON_DXVK_SAREK"] = s
    if game_choice(store, gid, "protonfixes") != "off":
        apply_own_fixes(store, gid)
    env.update(protonfixes_env(store, gid))
    env.update(extra_env or {})
    cmd = [os.path.join(runtime, "_v2-entry-point"), "--verb=waitforexitandrun", "--",
           os.path.join(proton, "proton"), "waitforexitandrun", exe] + list(args)
    seam = os.environ.get("RETROFORGE_STORE_RUN")
    if seam:
        cmd = [seam] + cmd
    log(f"{store} {gid}: {exe} with {os.path.basename(proton)} in {os.path.basename(runtime)}, protonfixes "
        + ("off" if "PROTONFIXES_DISABLE" in env else env.get("UMU_ID", "")))
    proc = subprocess.Popen(cmd, cwd=workdir, env=env, preexec_fn=game_child)
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, lambda s, _f: proc.send_signal(s))
    return proc.wait()


