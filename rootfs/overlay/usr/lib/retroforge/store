def sign_in_browser():
    """(Chromium's command, its environment): RETROFORGE_STORE_CHROMIUM (tests), else the set-up one,
    set up first when it is not, with `browser` setup events."""
    forced = os.environ.get("RETROFORGE_STORE_CHROMIUM")
    if forced:
        return forced, dict(os.environ)
    found = chromium_setup.installed(DATA, os.path.join(PINS, "chromium.pin"))
    if not found:
        found = set_up_browser(percent_printer(emit=lambda pct: event(event="browser", state="setup", percent=pct)))
    return found["binary"], chromium_setup.environment(found)


def sign_in(store, display=None):
    """SIGN-IN above: the store's page in Chromium until it shows a code, which then signs in. Events:
    browser setup (percent), open (pid), closed; then code, and signed_in (account) or error (message).
    The player closing the window, or stdin closing (the plugin's Cancel), ends it without a sign-in."""
    if not tool_command(store.tool):
        raise NotReady(f"{store.title} is not set up")
    binary, env = sign_in_browser()
    if display:
        env = dict(env, DISPLAY=display)
    forced = os.environ.get("RETROFORGE_STORE_SCALE")
    if forced and not re.fullmatch(r"[1-4](\.[0-9]{1,2})?", forced):
        raise Failed(f"RETROFORGE_STORE_SCALE is not a scale from 1 to 4: {forced}")
    scale = float(forced) if forced else chromium_signin.screen_scale(display)
    try:
        reason, code = chromium_signin.run(
            binary, store.sign_in_url, env=env, scale=scale,
            code_in_url=store.code_in_url, reads_page=store.reads_page, code_in_page=store.code_in_page,
            stop_fd=sys.stdin.fileno(), timeout=SIGN_IN_TIMEOUT,
            on_open=lambda pid: event(event="browser", state="open", pid=pid))
    except OSError as err:
        raise Failed(f"could not open Chromium: {err}")
    event(event="browser", state="closed")
    if reason == "timeout":
        raise Failed(f"{SIGN_IN_TIMEOUT // 60} minutes without signing in")
    if code is None:
        return
    event(event="code")
    try:
        account = store.sign_in(code)
    except Failed as err:
        event(event="error", message=str(err))
        raise
    event(event="signed_in", account=account)


