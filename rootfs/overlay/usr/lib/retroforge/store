SIGN_IN_TIMEOUT = 15 * 60


def sign_in_display(args):
    """The X display `sign-in [--display :N]` names, else None (DISPLAY)."""
    if not args:
        return None
    if len(args) == 2 and args[0] == "--display" and re.fullmatch(r":[0-9]{1,3}", args[1]):
        return args[1]
