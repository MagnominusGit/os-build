#!/usr/bin/env python3
# steam-compat-tools — Proton-CachyOS's arm64 build as a Steam compatibility tool, kept on its newest
# release, with DXVK-Sarek on in it where the GPU needs it. Run by /usr/bin/retroforge-steam-cachyos (the
# player's Download / Update in Apps > Steam Client > "CachyOS Proton arm64"), by
# /usr/bin/retroforge-steam-proton (ARMv8.0 CPUs, below) and by the store's launcher.
#
#   steam-compat-tools install  install or update the tool, and DXVK-Sarek on or off in every tool of
#                               ours as the GPU needs it (below)
#
# WHICH GPUS NEED SAREK. The a6xx_gen1_low Adreno 610 (SM6115) and 613 (SM4450): no hardware
# multiview, so no multiViewport, which every upstream DXVK requires; Turnip fakes it only under
# TU_DEBUG=noconform (etc/retroforge/session.conf), which Mesa 26.3 removes. There DXVK-Sarek is not a
# choice: it is on in every tool of ours, and nothing offers to turn it off. Every other GPU runs
# upstream DXVK, and nothing of ours turns Sarek on there (a player can, per game, in Steam's launch
# options). The SoC class comes from device-env; RETROFORGE_STEAM_SAREK=on|off overrides it, for testing.
#
# PROGRESS. While a run downloads, ~/.local/share/retroforge/steam-compat-tools.progress holds its
# percentage (0-100), then `unpacking` while the tarball unpacks; it is removed when the run ends. The
# plugin's row reads it.
#
# Every upstream DXVK needs multiViewport. Turnip gives the Adreno 610 (SM6115) that only under
# TU_DEBUG=noconform (etc/retroforge/session.conf), and Mesa 26.3 removes noconform. DXVK-Sarek works
# without it, and Proton-CachyOS ships it (as ARM64EC in its arm64 build), turned on by
# PROTON_DXVK_SAREK=1. None of it is in the image (a ~356 MB download, ~2.2 GB unpacked), so `install`
# downloads it into the player's home.
#
# WHICH RELEASE. /usr/share/retroforge/steam/proton-cachyos-arm64.pin names a channel, not a version.
# Every `install` (each Download/Update, store launch, and on ARMv8.0 CPUs each `steam` start) makes
# ONE request to GitHub's API, which allows 60 an hour without a token, and takes the newest release that has the pin's arm64 tarball and
# its .sha512sum: the highest Proton version first, then the latest published, so the last release of
# an older line (cachyos-10.0-sunset-slr came out after cachyos-11.0-20260601-slr) is not taken for an
# update. Drafts, prereleases and assets still uploading are skipped. A `tag:` in the pin holds one
# release instead (and an optional `sha512:` its tarball); once that release is installed, nothing is
# asked at all. When GitHub cannot be asked or names nothing usable (offline, rate limit, an error),
# the installed tool is kept as it is.
#
# ONE NAME. Whatever the release, the tool is <Steam root>/compatibilitytools.d/<dir>/, and its
# compatibilitytool.vdf is rewritten so that its internal name is <dir> and its display_name the pin's.
# Steam keys a game's tool (CompatToolMapping in config.vdf) by that internal name, so a game set to
# the tool keeps it through updates.
#
# HOW. The tarball is checked against the release's .sha512sum (and against the sha256 GitHub's API
# lists for it, when it lists one), unpacked under a temporary name in the Steam root and made ready
# there, then put in place by two renames, the old tree out and the new one in: Steam never lists half
# a tool. A game running from the old tree would, after that, start wine processes and load DLLs from
# the new one by path (and wine refuses a wineserver of another build). So while a process of the
# player's runs from the tool (its program, working folder or a mapped file), the new tree waits,
# verified, in <Steam root>/.retroforge-compat-tools.next and goes in at a later `install` without being
# downloaded again. A running Steam keeps the tool's toolmanifest.vdf from its start until it restarts.
#
# The folder carries a .retroforge-pin (name, tag, asset, sha512, sha256). That is how this knows its
# own folders: one without it is the player's and is never touched, even under the pin's dir. Folders
# of the earlier scheme (one per release, named after it, with a .retroforge-pin of the same name) are
# removed once the one-name folder is in place, each when nothing runs from it. One `install` at a time: a
# second one exits at once.
#
# Sarek on = a user_settings.py with PROTON_DXVK_SAREK=1 in the tool's folder, which the tool applies to
# every game run with it, with the client or without it (nothing exports PROTON_DXVK_SAREK, which
# Valve's Proton ignores anyway). A user_settings.py that is not exactly one
# this writes (or wrote, LEGACY_SETTINGS) is the player's: never written over, carried into an update,
# never deleted. On a GPU that does not need Sarek, ours is deleted (left by the old DXVK-Sarek toggle).
#
# Steam is never told to use the tool (config.vdf is not edited). The player picks it per game
# (Properties > Compatibility) or as the Steam Play default (docs/steam-arm64.md).
#
# Exit 0 (the tool's folder on stdout, or nothing when another run holds the lock), also when
# GitHub cannot be asked and a tool is installed; 1 when the release could not be installed (nothing
# installed and GitHub unreachable, a checksum mismatch, a tarball without its folder); 2 for a bad
# invocation.
#
# ARMv8.0 CPUs (no `atomics` in /proc/cpuinfo, e.g. the SM6115) take proton-armv8.pin instead: Valve's
# Proton built for them, with DXVK-Sarek (sunshineinabox/proton-armv8). Proton-CachyOS's build needs the
# kernel's LSE emulation there, which costs ~0.3-0.5 us per atomic.
#
# TEST SEAMS (tests/test-steam-compat-tools.sh): RETROFORGE_STEAM_ROOT (also set by /usr/bin/steam),
# RETROFORGE_STEAM_COMPAT_PIN (whose releases: can point at a fake API), RETROFORGE_STEAM_PINS (the pins'
# folder), RETROFORGE_CPUINFO, RETROFORGE_DEVICE_ENV, RETROFORGE_STEAM_SAREK.
import fcntl
import fnmatch
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

DATA = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
STEAM_ROOT = os.environ.get("RETROFORGE_STEAM_ROOT") or os.path.join(DATA, "Steam")
PINS = os.environ.get("RETROFORGE_STEAM_PINS", "/usr/share/retroforge/steam")
CPUINFO = os.environ.get("RETROFORGE_CPUINFO", "/proc/cpuinfo")
PROGRESS = os.path.join(DATA, "retroforge", "steam-compat-tools.progress")
DEVICE_ENV = os.environ.get("RETROFORGE_DEVICE_ENV", "/usr/lib/retroforge/device-env")
SAREK_SOCS = ("SM6115", "SM4450")  # Adreno 610 and 613: see WHICH GPUS NEED SAREK


def needs_sarek():
    """Whether this GPU needs DXVK-Sarek (RETROFORGE_STEAM_SAREK=on|off decides instead, when set)."""
    forced = os.environ.get("RETROFORGE_STEAM_SAREK")
    if forced in ("on", "off"):
        return forced == "on"
    try:
        out = subprocess.run([DEVICE_ENV], capture_output=True, text=True, timeout=30).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    for line in out.splitlines():
        if line.startswith("RETROFORGE_SOC_CLASS="):
            value = shlex.split(line.split("=", 1)[1]) or [""]
            return value[0] in SAREK_SOCS
    return False


def lacks_atomics():
    """Whether a CPU here has no LSE atomics (ARMv8.0)."""
    try:
        with open(CPUINFO, encoding="utf-8", errors="replace") as f:
            feats = [line.split(":", 1)[1].split() for line in f if line.startswith("Features")]
    except OSError:
        return False
    return any("atomics" not in x for x in feats)


STEAM_CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                          "retroforge", "steam.conf")


def channel():
    """The player's ARMv8.0 Proton channel (retroforge-steam-proton): stable unless PROTON_CHANNEL=experimental."""
    value = ""
    try:
        with open(STEAM_CONF, encoding="utf-8", errors="replace") as f:
            for line in f:
                if line.startswith("PROTON_CHANNEL="):
                    value = line.strip().split("=", 1)[1]
    except OSError:
        pass
    return "experimental" if value == "experimental" else "stable"


ARMV8_PINS = {"stable": "proton-armv8.pin", "experimental": "proton-armv8-experimental.pin"}
PIN = os.environ.get("RETROFORGE_STEAM_COMPAT_PIN") or os.path.join(
    PINS, ARMV8_PINS[channel()] if lacks_atomics() else "proton-cachyos-arm64.pin")
TOOLS = os.path.join(STEAM_ROOT, "compatibilitytools.d")
LOCK = os.path.join(STEAM_ROOT, ".retroforge-compat-tools.lock")
TMP_PREFIX = ".retroforge-compat-tools-"
NEXT = os.path.join(STEAM_ROOT, ".retroforge-compat-tools.next")
MARKER = ".retroforge-pin"
SETTINGS = "user_settings.py"
VDF = "compatibilitytool.vdf"
# What Steam reads from a tool's folder, and the tool's entry point.
TOOL_FILES = (VDF, "toolmanifest.vdf", "proton")
# Releases looked at for the channel: the newest ones. Every release since 2026-02 has the arm64 build.
PER_PAGE = 20
AGENT = "retroforge-steam-compat-tools"
NAME_OK = re.compile(r"[\w+-][\w.+-]*")  # a tag, or an asset's name: no "/", no leading "."
ARCHIVES = (".tar.xz", ".tar.zst")


def stem(asset):
    """The asset's name without its archive extension: the tarball's top folder."""
    return next(asset[:-len(e)] for e in ARCHIVES if asset.endswith(e))


def sidecar_name(asset, pin):
    """The checksum file's name: the pin's suffix after the asset's name, else <stem>.sha512sum."""
    return asset + pin["sidecar"] if pin["sidecar"] else stem(asset) + ".sha512sum"

SAREK_SETTINGS = """\
# Written by /usr/lib/retroforge/steam-compat-tools: this GPU (Adreno 610/613) needs DXVK-Sarek, the one
# DXVK that runs without multiViewport. DXVK-Sarek instead of DXVK for every game run with this tool.
# Edit it and it is yours: RetroForge never writes over it or deletes it again.
user_settings = {
    "PROTON_DXVK_SAREK": "1",
}
"""
# What earlier releases wrote, still ours: replaced or deleted like SAREK_SETTINGS.
LEGACY_SETTINGS = ("""\
# Written by /usr/lib/retroforge/steam-compat-tools: the player's DXVK-Sarek setting is on
# (retroforge-steam-sarek, Settings > General). DXVK-Sarek instead of DXVK for every game run with this
# tool. A game's own environment wins: PROTON_DXVK_SAREK=0 %command% in its launch options turns it
# off for that game. Deleted when the setting is turned off, unless it was edited.
user_settings = {
    "PROTON_DXVK_SAREK": "1",
}
""",)


class Failed(Exception):
    pass


class Unresolved(Exception):
    """GitHub could not be asked, or named no release to install."""


def log(msg):
    print(f"steam-compat-tools: {msg}", file=sys.stderr, flush=True)


def fields(text, keys):
    found = {}
    for key in keys:
        m = re.search(rf"^{key}:[ \t]*(.*?)[ \t]*$", text, re.M)
        found[key] = m.group(1) if m and m.group(1) else None
    return found


def read_pin():
    try:
        with open(PIN, encoding="utf-8") as f:
            pin = fields(f.read(), ("name", "releases", "asset", "dir", "display_name", "tag", "sha512",
                                    "sidecar", "prereleases"))
    except (OSError, UnicodeDecodeError) as err:
        raise Failed(f"no pin: {err}")
    need = ("name", "releases", "asset", "dir", "display_name")
    if not all(pin[k] for k in need):
        raise Failed(f"{PIN}: needs {', '.join(need)}")
    if not pin["asset"].endswith(ARCHIVES) or "/" in pin["asset"]:
        raise Failed(f"{PIN}: asset must be a .tar.xz or .tar.zst name (a glob)")
    if pin["sidecar"] and not re.fullmatch(r"\.[\w.+-]+", pin["sidecar"]):
        raise Failed(f"{PIN}: sidecar must be a suffix such as .sha512")
    if pin["prereleases"] not in (None, "yes", "no"):
        raise Failed(f"{PIN}: prereleases is yes or no")
    if not NAME_OK.fullmatch(pin["dir"]):
        raise Failed(f"{PIN}: dir must be a plain folder name")
    if pin["tag"] and not NAME_OK.fullmatch(pin["tag"]):
        raise Failed(f"{PIN}: tag is not a release tag")
    if pin["sha512"] and not (pin["tag"] and re.fullmatch(r"[0-9a-fA-F]{128}", pin["sha512"])):
        raise Failed(f"{PIN}: sha512 goes with a tag, as 128 hex digits")
    pin["sha512"] = pin["sha512"] and pin["sha512"].lower()
    return pin


def marker(path):
    """The fields of the .retroforge-pin in a folder this installed, or None for anyone else's."""
    if os.path.islink(path) or not os.path.isdir(path):
        return None
    try:
        with open(os.path.join(path, MARKER), encoding="utf-8") as f:
            return fields(f.read(), ("name", "tag", "asset", "sha512", "sha256"))
    except (OSError, UnicodeDecodeError):
        return None


def ours(path, pin):
    """Whether path is a folder this installed for the pin's name."""
    m = marker(path)
    return m is not None and m["name"] == pin["name"]


def complete(path):
    return all(os.path.isfile(os.path.join(path, f)) for f in TOOL_FILES)


def earlier(pin):
    """Folders of the earlier scheme: this installed them for the pin's name, under another name."""
    try:
        names = sorted(os.listdir(TOOLS))
    except FileNotFoundError:
        return []
    return [os.path.join(TOOLS, n) for n in names if n != pin["dir"] and ours(os.path.join(TOOLS, n), pin)]


def holds(m, rel, pin):
    """Whether a folder's marker m is the release rel (as GitHub lists it) and, if the pin fixes a
    sha512, that tarball."""
    return (m["tag"] == rel["tag"] and (not rel["sha256"] or m["sha256"] == rel["sha256"])
            and (not pin["sha512"] or m["sha512"] == pin["sha512"]))


# ---- GitHub ----------------------------------------------------------------------------------------
def api(url):
    """GitHub's API at url, as JSON. Unresolved when it cannot be asked."""
    req = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json",
                                               "X-GitHub-Api-Version": "2022-11-28", "User-Agent": AGENT})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r)
    except urllib.error.HTTPError as err:
        if err.code in (403, 429) and err.headers.get("X-RateLimit-Remaining") == "0":
            reset = err.headers.get("X-RateLimit-Reset") or ""
            until = time.strftime("%H:%M", time.localtime(int(reset))) if reset.isdigit() else "later"
            raise Unresolved(f"GitHub's API allows no more requests from this network until {until}")
        raise Unresolved(f"GitHub's API answered {err.code} for {url}")
    except (OSError, ValueError) as err:
        raise Unresolved(f"could not ask GitHub's API ({url}): {err}")


def candidate(rel, pin):
    """What to download from a release (from the API's JSON): its tarball matching the pin's asset,
    with that tarball's .sha512sum, both uploaded. None when it has no such pair."""
    tag = rel.get("tag_name") if isinstance(rel, dict) else None
    if not isinstance(tag, str) or not NAME_OK.fullmatch(tag):
        return None
    assets = {}
    for a in rel.get("assets") or ():
        if (isinstance(a, dict) and isinstance(a.get("name"), str)
                and isinstance(a.get("browser_download_url"), str) and a.get("state", "uploaded") == "uploaded"):
            assets[a["name"]] = a
    for name in sorted(assets):
        if not fnmatch.fnmatchcase(name, pin["asset"]) or not NAME_OK.fullmatch(name):
            continue
        sidecar = assets.get(sidecar_name(name, pin))
        if sidecar is None:
            continue
        digest = assets[name].get("digest")
        digest = digest[7:].lower() if isinstance(digest, str) and digest.startswith("sha256:") else None
        return {"tag": tag, "asset": name, "url": assets[name]["browser_download_url"],
                "sidecar": sidecar["browser_download_url"], "sha256": digest,
                "published": rel.get("published_at") if isinstance(rel.get("published_at"), str) else ""}
    return None


def proton_version(tag):
    """cachyos-11.0-20261005-slr -> (11, 0); () when the tag has none."""
    m = re.search(r"(\d+)\.(\d+)", tag)
    return (int(m.group(1)), int(m.group(2))) if m else ()


def resolve(pin):
    """The release to install: the pin's tag, or the channel's newest."""
    if pin["tag"]:
        found = candidate(api(f"{pin['releases']}/tags/{urllib.parse.quote(pin['tag'], safe='')}"), pin)
        if found is None:
            raise Unresolved(f"release {pin['tag']} has no {pin['asset']} with its checksum")
        return found
    releases = api(f"{pin['releases']}?per_page={PER_PAGE}")
    if not isinstance(releases, list):
        raise Unresolved("GitHub's API did not answer with a list of releases")
    found = [c for c in (candidate(r, pin) for r in releases
                         if isinstance(r, dict) and not r.get("draft")
                         and (not r.get("prerelease") or pin["prereleases"] == "yes")) if c]
    if not found:
        raise Unresolved(f"none of the newest {len(releases)} releases has {pin['asset']} with its checksum")
    return max(found, key=lambda c: (proton_version(c["tag"]), c["published"]))


def sidecar_sha512(rel):
    """The sha512 in the release's .sha512sum, refused unless it names the tarball."""
    req = urllib.request.Request(rel["sidecar"], headers={"User-Agent": AGENT})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            text = r.read(4096).decode("utf-8", "replace")
    except (OSError, ValueError) as err:
        raise Failed(f"could not download {rel['sidecar']}: {err}")
    m = re.match(r"\s*([0-9a-fA-F]{128})(?:[ \t]+\*?(\S+))?", text)
    if not m or (m.group(2) and m.group(2) != rel["asset"]):
        raise Failed(f"{rel['sidecar']} is not a sha512sum of {rel['asset']}")
    return m.group(1).lower()


def download(rel, dest, sha512):
    """The release's tarball -> dest, refused unless its sha512 matches (and the sha256 GitHub lists,
    if it lists one). Logs every 10%. Returns the sha256."""
    h512, h256 = hashlib.sha512(), hashlib.sha256()
    req = urllib.request.Request(rel["url"], headers={"User-Agent": AGENT})
    try:
        with urllib.request.urlopen(req, timeout=60) as r, open(dest, "wb") as out:
            total = int(r.headers.get("Content-Length") or 0)
            done, next_pct, shown = 0, 10, 0
            progress(0)
            while chunk := r.read(1 << 20):
                h512.update(chunk)
                h256.update(chunk)
                out.write(chunk)
                done += len(chunk)
                if total and done * 100 // total > shown:
                    shown = min(99, done * 100 // total)
                    progress(shown)
                if total and done * 100 >= next_pct * total and next_pct < 100:
                    log(f"{next_pct}% ({done // 1000000} of {total // 1000000} MB)")
                    next_pct += 10
    except (OSError, ValueError) as err:
        raise Failed(f"could not download {rel['url']}: {err}")
    progress(100)
    if h512.hexdigest() != sha512:
        raise Failed(f"sha512 mismatch for {rel['url']}: got {h512.hexdigest()}, want {sha512}")
    if rel["sha256"] and h256.hexdigest() != rel["sha256"]:
        raise Failed(f"sha256 mismatch for {rel['url']}: got {h256.hexdigest()}, GitHub lists {rel['sha256']}")
    return h256.hexdigest()


# ---- compatibilitytool.vdf -------------------------------------------------------------------------
def vdf_tokens(text):
    """(kind, value, start, end) for each token of a VDF text: kind "str", "{" or "}". Comments are
    skipped. Only quoted strings: ValueError on anything else."""
    i = 0
    while i < len(text):
        c = text[i]
        if c.isspace():
            i += 1
        elif text.startswith("//", i):
            end = text.find("\n", i)
            i = len(text) if end < 0 else end
        elif c in "{}":
            yield c, c, i, i + 1
            i += 1
        elif c == '"':
            j, value = i + 1, []
            while j < len(text) and text[j] != '"':
                if text[j] == "\\" and j + 1 < len(text):
                    j += 1
                value.append(text[j])
                j += 1
            if j >= len(text):
                raise ValueError("a string is not closed")
            yield "str", "".join(value), i, j + 1
            i = j + 1
        else:
            raise ValueError(f"unexpected {c!r} at {i}")


def quote(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def rename_tool(text, name, display):
    """compatibilitytool.vdf's text with its one tool's internal name and display_name set. Comments
    and every other key stay. ValueError when it is not one tool with flat keys."""
    toks = list(vdf_tokens(text))
    if (len(toks) < 9 or [t[0] for t in toks[:6]] != ["str", "{", "str", "{", "str", "{"]
            or [t[0] for t in toks[-3:]] != ["}", "}", "}"]
            or toks[0][1].lower() != "compatibilitytools" or toks[2][1].lower() != "compat_tools"):
        raise ValueError("not one tool under compatibilitytools/compat_tools")
    body = toks[6:-3]
    if len(body) % 2 or any(t[0] != "str" for t in body):
        raise ValueError("the tool's keys are not flat")
    edits = [(toks[4][2], toks[4][3], quote(name))]
    for key, value in zip(body[::2], body[1::2]):
        if key[1].lower() == "display_name":
            edits.append((value[2], value[3], quote(display)))
            break
    else:
        edits.append((toks[5][3], toks[5][3], f"\n      \"display_name\" {quote(display)}"))
    for start, end, new in sorted(edits, reverse=True):
        text = text[:start] + new + text[end:]
    return text


# ---- the folders -----------------------------------------------------------------------------------
def write(path, text):
    with open(path + ".part", "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(path + ".part", path)


def progress(value):
    """What PROGRESS says: a percentage, or `unpacking`."""
    try:
        os.makedirs(os.path.dirname(PROGRESS), exist_ok=True)
        write(PROGRESS, f"{value}\n")
    except OSError:
        pass  # the row shows no percentage; the install goes on


def progress_done():
    try:
        os.unlink(PROGRESS)
    except OSError:
        pass


def our_settings(path):
    """Whether path is a user_settings.py this wrote (now or in an earlier release), unchanged."""
    try:
        with open(path, encoding="utf-8") as f:
            return f.read() in (SAREK_SETTINGS,) + LEGACY_SETTINGS
    except (OSError, UnicodeDecodeError):
        return False


def sarek_on(tool):
    """Writes the Sarek user_settings.py into tool, unless the player has one of their own there."""
    path = os.path.join(tool, SETTINGS)
    if os.path.lexists(path) and not our_settings(path):
        log(f"{path} is the player's own; not writing PROTON_DXVK_SAREK into it")
        return
    write(path, SAREK_SETTINGS)  # also over an earlier release's text


def our_tools():
    """Every complete folder this installed in compatibilitytools.d, under any pin."""
    try:
        names = sorted(os.listdir(TOOLS))
    except FileNotFoundError:
        return []
    return [os.path.join(TOOLS, n) for n in names
            if marker(os.path.join(TOOLS, n)) is not None and complete(os.path.join(TOOLS, n))]


def sarek(need):
    """Every tool of ours as the GPU needs it: Sarek on in each, or off in each (one the old
    DXVK-Sarek toggle left on)."""
    if need:
        for tool in our_tools():
            sarek_on(tool)
    else:
        sarek_off()


def sarek_off():
    """Deletes the Sarek user_settings.py from every folder this installed, under any pin (a
    Proton-CachyOS left on an ARMv8.0 device too). The tools stay."""
    try:
        names = sorted(os.listdir(TOOLS))
    except FileNotFoundError:
        return
    for name in names:
        tool = os.path.join(TOOLS, name)
        path = os.path.join(tool, SETTINGS)
        if marker(tool) is None or not os.path.lexists(path):
            continue
        if our_settings(path):
            os.unlink(path)
            log(f"DXVK-Sarek turned off in {name}")
        else:
            log(f"{path} is the player's own; leaving it (it may still turn DXVK-Sarek on)")


def settings_into(new, final, pin, need):
    """The user_settings.py for a tree about to go in: the player's own from the tool (or, before the
    first one-name install, from a folder of the earlier scheme), else the Sarek one when the GPU needs
    it."""
    for tool in [final] if ours(final, pin) else earlier(pin):
        path = os.path.join(tool, SETTINGS)
        if os.path.lexists(path) and not our_settings(path):
            shutil.copy2(path, os.path.join(new, SETTINGS), follow_symlinks=False)
            log(f"keeping the player's own {SETTINGS} (from {os.path.basename(tool)})")
            return
    if need:
        sarek_on(new)


def in_use(path):
    """Whether a process of the player's runs from path: its program, working folder or a mapped file
    there. Matched on the path's last two parts (compatibilitytools.d/<dir>/), which is also what a
    process in Steam's runtime container shows."""
    needle = f"/{os.path.basename(os.path.dirname(path))}/{os.path.basename(path)}/"
    try:
        pids = [p for p in os.listdir("/proc") if p.isdigit() and int(p) != os.getpid()]
    except OSError:
        return False
    for pid in pids:
        proc = f"/proc/{pid}"
        try:
            if os.stat(proc).st_uid != os.getuid():
                continue
            for link in ("exe", "cwd"):
                try:
                    if needle in os.readlink(f"{proc}/{link}") + "/":
                        return True
                except OSError:
                    pass
            with open(f"{proc}/maps", encoding="utf-8", errors="replace") as f:
                if any(needle in line for line in f):
                    return True
        except OSError:
            continue
    return False


def discard(path):
    """Takes path out of Steam's sight in one rename, then deletes it."""
    trash = tempfile.mkdtemp(dir=STEAM_ROOT, prefix=TMP_PREFIX)
    os.rename(path, os.path.join(trash, "old"))
    shutil.rmtree(trash, ignore_errors=True)


def retire(pin):
    """Removes folders of the earlier scheme, now that the one-name folder is in place. One that a
    process runs from stays until a later run."""
    for path in earlier(pin):
        name = os.path.basename(path)
        if in_use(path):
            log(f"keeping {name}, of the earlier per-release scheme, while something runs from it")
            continue
        log(f"removing {name}, of the earlier per-release scheme: a game set to it now needs "
            f"\"{pin['display_name']}\"")
        discard(path)


def sweep():
    """Temporary folders left by a run that was killed. With the lock held, none is in use."""
    for name in os.listdir(STEAM_ROOT):
        path = os.path.join(STEAM_ROOT, name)
        if name.startswith(TMP_PREFIX) and os.path.isdir(path) and not os.path.islink(path):
            shutil.rmtree(path, ignore_errors=True)


def staged(rel, pin):
    """NEXT, when it holds rel ready to go in. A stale one is removed."""
    if not os.path.lexists(NEXT):
        return None
    m = marker(NEXT)
    if m is not None and m["name"] == pin["name"] and holds(m, rel, pin) and complete(NEXT):
        log(f"{rel['tag']} was downloaded and checked before; putting it in")
        return NEXT
    discard(NEXT)
    return None


def prepare(rel, pin, tmp):
    """Downloads, checks and unpacks rel under tmp, ready to go in: the pin's name in its
    compatibilitytool.vdf, and its .retroforge-pin. Returns its folder."""
    sha512 = pin["sha512"] or sidecar_sha512(rel)
    log(f"downloading {rel['asset']} ({rel['tag']}) from {rel['url']}")
    top = stem(rel["asset"])
    archive = os.path.join(tmp, "tool" + rel["asset"][len(top):])
    sha256 = download(rel, archive, sha512)
    tree = os.path.join(tmp, "tree")
    os.mkdir(tree)
    progress("unpacking")
    # tar finds zstd by itself when reading (GNU tar and bsdtar both).
    unpack = "-xJf" if archive.endswith(".tar.xz") else "-xf"
    res = subprocess.run(["tar", "--no-same-owner", unpack, archive, "-C", tree],
                         stderr=subprocess.PIPE, text=True)
    os.unlink(archive)
    if res.returncode != 0:
        raise Failed(f"could not unpack {rel['url']}: {res.stderr.strip()}")
    new = os.path.join(tree, top)
    if os.path.islink(new) or not os.path.isdir(new) or not complete(new):
        raise Failed(f"{rel['url']} has no {top}/ with {', '.join(TOOL_FILES)}")
    vdf = os.path.join(new, VDF)
    try:
        with open(vdf, encoding="utf-8") as f:
            text = rename_tool(f.read(), pin["dir"], pin["display_name"])
    except (OSError, ValueError) as err:
        raise Failed(f"could not name {top}'s {VDF} {pin['dir']}: {err}")
    write(vdf, text)
    write(os.path.join(new, MARKER), f"name: {pin['name']}\ntag: {rel['tag']}\nasset: {rel['asset']}\n"
                                     f"sha512: {sha512}\nsha256: {sha256}\n")
    return new


def update(rel, pin, final, was, need):
    """Puts rel in as final: from NEXT when it is there, else downloaded. Waits in NEXT while a
    process runs from final."""
    started = time.monotonic()
    tmp = tempfile.mkdtemp(dir=STEAM_ROOT, prefix=TMP_PREFIX)
    try:
        new = staged(rel, pin) or prepare(rel, pin, tmp)
        if os.path.lexists(final) and in_use(final):
            if new != NEXT:
                os.rename(new, NEXT)
            log(f"a game runs from {final}: {rel['tag']} is ready and goes in at the next `steam` "
                f"start with nothing running from it")
            return
        settings_into(new, final, pin, need)
        if os.path.lexists(final):
            os.rename(final, os.path.join(tmp, "old"))
            try:
                os.rename(new, final)
            except OSError:
                os.rename(os.path.join(tmp, "old"), final)
                raise
        else:
            os.rename(new, final)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    took = f"in {time.monotonic() - started:.0f} s"
    if was:
        log(f"updated {final} from {was} to {rel['tag']} {took}")
    else:
        log(f"installed {rel['tag']} as {final} {took}. Steam lists it as \"{pin['display_name']}\" "
            f"from its next start.")


def install(pin, need):
    """The newest release in place, Sarek on in it when need. With the lock only: PROGRESS is the
    running one's."""
    os.makedirs(TOOLS, exist_ok=True)
    with open(LOCK, "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            log("another steam-compat-tools is already running; leaving it to that one")
            return None
        try:
            return locked_install(pin, need)
        finally:
            progress_done()


def locked_install(pin, need):
    sweep()
    final = os.path.join(TOOLS, pin["dir"])
    if os.path.lexists(final) and not ours(final, pin):
        log(f"{final} is already there and was not installed by RetroForge; leaving it alone")
        return final
    have = marker(final) if complete(final) else None
    if have and need:
        sarek_on(final)
    if have and pin["tag"] and have["tag"] == pin["tag"] and (not pin["sha512"] or have["sha512"] == pin["sha512"]):
        current = True  # the pin's own release is in: nothing to ask
    else:
        try:
            rel = resolve(pin)
        except Unresolved as err:
            if not have:
                raise Failed(f"{err}; no {pin['name']} is installed")
            log(f"{err}; keeping {have['tag'] or 'the installed release'}")
            current = None  # unknown: a release waiting in NEXT stays
        else:
            current = bool(have) and holds(have, rel, pin)
            if not current:
                update(rel, pin, final, have and have["tag"], need)
    if current and os.path.lexists(NEXT):
        discard(NEXT)  # a release that waited there and is no longer the one to install
    if marker(final) is not None and complete(final):
        retire(pin)
    return final


def main(argv):
    if argv[1:] != ["install"]:
        log("usage: steam-compat-tools install")
        return 2
    need = needs_sarek()
    rc, path = 0, None
    try:
        path = install(read_pin(), need)
    except (Failed, OSError) as err:
        log(str(err))
        rc = 1
    try:
        sarek(need)  # the tools already there, also when no release could be installed
    except OSError as err:
        log(f"could not turn DXVK-Sarek {'on' if need else 'off'} in the installed tools: {err}")
    if path is not None:
        print(path)
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv))
