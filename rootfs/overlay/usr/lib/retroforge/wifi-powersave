#!/bin/bash
# retroforge wifi-powersave — Wi-Fi power save as the board profile asks (RETROFORGE_WIFI_POWERSAVE).
#
# "off": a NetworkManager drop-in, [connection] wifi.powersave=2 (disable), under /run before
# NetworkManager reads its config (retroforge-wifi-powersave.service). Anything else: no drop-in, so
# NetworkManager keeps its default. Under /run (tmpfs), rebuilt each boot, nothing on the read-only
# root.
#
# Why (issue #27): the SM4450 boards' WLAN firmware dozes between beacons whatever power save is set
# to, and with it on as well replies waited longer still (RG 55G1: 129 ms on average, 582 ms at
# worst, against 70 / 205 ms off). See anbernic-rg55g1.conf.
#
# TEST SEAMS (tests/test-device-env.sh): RETROFORGE_DEVICE_ENV, RETROFORGE_NM_CONF_DIR, and
# device-env's own RETROFORGE_MODEL / RETROFORGE_DEVICE_DIR.
set -euo pipefail

eval "$("${RETROFORGE_DEVICE_ENV:-/usr/lib/retroforge/device-env}")"
dir=${RETROFORGE_NM_CONF_DIR:-/run/NetworkManager/conf.d}
dropin=$dir/50-retroforge-wifi-powersave.conf

if [[ "${RETROFORGE_WIFI_POWERSAVE:-}" != off ]]; then
    rm -f "$dropin"
    exit 0
fi
mkdir -p "$dir"
cat >"$dropin.part" <<CONF
# Generated by retroforge-wifi-powersave.service (/usr/lib/retroforge/wifi-powersave) for
# ${RETROFORGE_DEVICE_NAME:-this board}: its profile sets RETROFORGE_WIFI_POWERSAVE=off.
[connection]
wifi.powersave=2
CONF
mv "$dropin.part" "$dropin"
