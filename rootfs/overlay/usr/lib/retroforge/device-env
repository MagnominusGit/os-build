#!/bin/bash
# retroforge device-env — emit RETROFORGE_* per-board facts for userspace consumers.
#
# Single runtime source of truth for the unified image: resolves the devicetree
# model string to a profile conf layered over defaults.conf, then prints a fixed
# set of RETROFORGE_* assignments (shell-quoted) on stdout. Consumers eval it:
#     eval "$(/usr/lib/retroforge/device-env)"
#
# retroforge-session reads the panel/output block, incl. the RETROFORGE_SECONDARY_* block of dual-screen
# boards (gamescope's second output). RETROFORGE_SOC_CLASS is read by
# etc/retroforge/session.conf, which gives SM6115 --force-composition-rotation (the one
# SoC-class workaround since device-quirks went). Hardware truth still lives in the DTS — this only
# re-exports the subset userspace needs plus knobs with no DTS home (fake-output-mm,
# suspend mode). Panel orientation, rotation-shader and gamepad-quirk are
# deliberately NOT carried: retroforge uses upstream composite rotation (auto-engaged
# off the connector) and a fixed InputPlumber config.
set -euo pipefail

device_dir=${RETROFORGE_DEVICE_DIR:-/usr/lib/retroforge/devices}

source "$device_dir/defaults.conf"

model=${RETROFORGE_MODEL:-}
if [[ -z "$model" ]]; then
    model=$(tr -d '\0' </sys/firmware/devicetree/base/model 2>/dev/null || true)
fi
case "$model" in
    "AYANEO Pocket ACE")         profile=ayaneo-pocket-ace ;;
    "AYANEO Pocket DMG")         profile=ayaneo-pocket-dmg ;;
    "AYANEO Pocket DS")          profile=ayaneo-pocket-ds ;;
    "AYANEO Pocket EVO")         profile=ayaneo-pocket-evo ;;
    "AYANEO Pocket S 1K")        profile=ayaneo-pocket-s1k ;;
    "AYANEO Pocket S 2K")        profile=ayaneo-pocket-s2k ;;
    "AYANEO Pocket S2")          profile=ayaneo-pocket-s2 ;;
    "AYN Odin 2")                profile=ayn-odin-2 ;;
    "AYN Odin 2 Mini")           profile=ayn-odin-2-mini ;;
    "AYN Odin 2 Portal")         profile=ayn-odin-2-portal ;;
    "AYN Thor")                  profile=ayn-thor ;;
    "AYN Thor Lite")             profile=ayn-thor-lite ;;
    "KONKR Pocket FIT")          profile=konkr-pocket-fit ;;
    "MANGMI Air X MQ65")         profile=mangmi-air-x-mq65 ;;
    "MANGMI Air X MQ66")         profile=mangmi-air-x-mq66 ;;
    "MANGMI Air X MQ66B")        profile=mangmi-air-x-mq66b ;;
    "MANGMI Air Y")              profile=mangmi-air-y ;;
    "MANGMI Air Y Pro")          profile=mangmi-air-y-pro ;;
    "MANGMI Pocket Max")         profile=mangmi-pocket-max ;;
    "Retroid Pocket 5")          profile=retroid-pocket-5 ;;
    "Retroid Pocket 6")          profile=retroid-pocket-6 ;;
    "Retroid Pocket 6 TOP-DPAD") profile=retroid-pocket-6 ;;
    "Retroid Pocket Flip2")      profile=retroid-pocket-flip2 ;;
    "Retroid Pocket Mini")       profile=retroid-pocket-mini ;;
    "Retroid Pocket Mini V2")    profile=retroid-pocket-mini-v2 ;;
    "Retroid Pocket Nova")       profile=retroid-pocket-nova ;;
    *)                           profile= ;;
esac

if [[ -n "$profile" && -r "$device_dir/$profile.conf" ]]; then
    source "$device_dir/$profile.conf"
fi

vars=(
    RETROFORGE_DEVICE_ID
    RETROFORGE_DEVICE_NAME
    RETROFORGE_SOC_CLASS
    RETROFORGE_SUSPEND_MODE
    RETROFORGE_PRIMARY_CONNECTOR
    RETROFORGE_PANEL_TYPE
    RETROFORGE_PANEL_ORIENTATION
    RETROFORGE_PANEL_NATIVE_WIDTH
    RETROFORGE_PANEL_NATIVE_HEIGHT
    RETROFORGE_PANEL_REFRESH_RATES
    RETROFORGE_GAMESCOPE_FAKE_OUTPUT_MM
    RETROFORGE_HW_BATTERY
    RETROFORGE_HW_CHARGER
    RETROFORGE_HW_BACKLIGHT
    RETROFORGE_HW_THERMAL_CPU
    RETROFORGE_HW_THERMAL_GPU
    RETROFORGE_HW_THERMAL_BATTERY
    RETROFORGE_HW_THERMAL_SKIN
    RETROFORGE_HW_FAN
    RETROFORGE_HW_GPU_DEVFREQ
    RETROFORGE_HW_LED_GROUPS
    RETROFORGE_CPU_SCHEDULERS
    RETROFORGE_FAN_MIN_PWM
    RETROFORGE_FAN_OFF_BELOW
    RETROFORGE_UI_VIEWPORT_RENDER
    RETROFORGE_GAMESCOPE_NESTED_W
    RETROFORGE_GAMESCOPE_NESTED_H
    RETROFORGE_SECONDARY_CONNECTOR
    RETROFORGE_SECONDARY_TOUCHSCREEN
)

for var in "${vars[@]}"; do
    printf '%s=%q\n' "$var" "${!var:-}"
done
