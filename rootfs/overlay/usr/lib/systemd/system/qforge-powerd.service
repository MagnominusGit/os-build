[Unit]
Description=qforge power daemon (fan curve, boot CPU governor, sched_ext)
StartLimitIntervalSec=0

[Service]
Type=dbus
BusName=org.qforge.Power
NotifyAccess=main
ExecStart=/usr/bin/qforge-powerd
ExecStopPost=/usr/bin/qforge-powerd --fan-safe
Restart=always
RestartSec=1
WatchdogSec=15

[Install]
WantedBy=multi-user.target
