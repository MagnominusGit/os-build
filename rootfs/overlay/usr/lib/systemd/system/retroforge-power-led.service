[Unit]
Description=retroforge power-button LED (green while the system is up)
Documentation=file:///usr/lib/retroforge/power-led
# The LED's sysfs attributes are root:root 0644, so this has to be a system service rather than
# anything in the session. Nothing races it and nothing waits on it: it writes two sysfs files on a
# device the rest of the boot never touches, so ordinary dependencies are enough. After
# local-fs.target because the script sources /etc/retroforge/power-led.conf if the operator left one.
# Not ordered early: the LED is cosmetic. Lighting it a second later costs nothing; lighting it
# before /etc is mounted would silently ignore the operator's override.
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/retroforge/power-led

[Install]
WantedBy=multi-user.target
