[Unit]
Description=qforge power-key dispatcher
# Reads the power-key evdev (present from boot) and runs the configured short/long-press action
# (/etc/qforge/rest.conf): by default a logind Suspend(), intercepted into qforge-suspend, and a
# power-off. It does not require the session to be up.

[Service]
ExecStart=/usr/bin/qforge-powerbuttond
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
