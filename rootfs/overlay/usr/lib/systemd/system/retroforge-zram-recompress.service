# Recompresses the zram pages left idle since the last run with zram's second algorithm (zstd, after
# lz4: zram-generator.conf, /usr/lib/retroforge/zram-recompress). Started only by
# retroforge-zram-recompress.timer, hence no [Install]. At idle CPU and IO priority: it runs on a
# core nothing else wants, so a game never waits on it.
[Unit]
Description=Recompress idle zram pages
ConditionPathExists=/sys/block/zram0/recomp_algorithm

[Service]
Type=oneshot
ExecStart=/usr/lib/retroforge/zram-recompress
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
