[Unit]
Description=qforge watch for a live session, to confirm an A/B trial boot
Documentation=file:///usr/bin/qforge-bootctl
# Nothing to confirm on a boot that did not come through our initramfs at all.
#
# THIS DOES NOT COVER A DEGRADED CMDLINE-FALLBACK BOOT. image/initramfs/init writes
# /run/qforge/boot on EVERY path, including the one that resolved no slot (it records
# `slot=` + `source=cmdline`), so this condition passes there and mark-good runs with nothing to
# confirm. The earlier version of this comment claimed the opposite; HW 2026-07-28 measured
# mark-good failing every 30s for the whole uptime of a degraded boot as a result. The real guard
# is in qforge-bootctl mark-good, which returns 0 when the handoff names no slot -- see the
# comment there for why it must be 0 and not a failure.
ConditionPathExists=/run/qforge/boot

[Path]
# qforge-session creates this the instant gamescope completes its startup handshake, and its
# EXIT trap removes it. See qforge-boot-good.service for why that is the signal.
PathExists=/run/qforge/session/ready

[Install]
WantedBy=multi-user.target
