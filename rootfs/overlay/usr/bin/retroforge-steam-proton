#!/usr/bin/env python3
# retroforge-steam-proton — Steam's default Proton on ARMv8.0 CPUs (no LSE atomics, e.g. the SM6115):
# our ARMv8.0 build (sunshineinabox/proton-armv8), stable or experimental. On other CPUs it does nothing
# and Steam keeps its own default.
#
#   retroforge-steam-proton status                    stable, experimental, or steam (not ARMv8.0)
#   retroforge-steam-proton set stable|experimental   save the player's channel, then apply
#   retroforge-steam-proton apply                     /usr/bin/steam runs this before the client starts
#
# apply installs or updates the channel's build in the background (steam-compat-tools), and once it is
# installed and the client is not running, sets it as Steam's default compatibility tool: entry "0" of
# CompatToolMapping in config.vdf. The channel is PROTON_CHANNEL=stable|experimental in
# ~/.config/retroforge/steam.conf (the last such line counts).
#
# EACH WINDOWS GAME TOO. Steam picks a game's tool by priority: one set for the game (250), Valve's
# recommendation for it (85), the default (75). Valve recommends its own Proton for most Windows games,
# so the client ran them with Valve's build while the launches without the client ran ours, and each
# switch made the next launch redo Wine's prefix set-up (~45 s on the Air X: Hades, 2026-10-24). So each
# installed game appinfo.vdf lists for Windows and not Linux gets its own entry for our build, as the
# player would set it in its Properties; a game set to any other tool keeps it, one set to our other
# channel follows the channel. Native Linux games are left to Steam.
#
# TEST SEAMS (tests/test-steam-proton.sh): RETROFORGE_STEAM_ROOT, RETROFORGE_CPUINFO,
# RETROFORGE_STEAM_COMPAT_TOOLS (the helper), RETROFORGE_STEAM_PROTON_START (a command run with the
# helper and `install` as arguments instead of systemd-run), RETROFORGE_STEAM_LIBRARY (the steam-library
# whose readers this uses).
import importlib.machinery
import importlib.util
import os
import subprocess
import sys

DATA = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
STEAM_ROOT = os.environ.get("RETROFORGE_STEAM_ROOT") or os.path.join(DATA, "Steam")
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "retroforge", "steam.conf")
CPUINFO = os.environ.get("RETROFORGE_CPUINFO", "/proc/cpuinfo")
HELPER = os.environ.get("RETROFORGE_STEAM_COMPAT_TOOLS", "/usr/lib/retroforge/steam-compat-tools")
START = os.environ.get("RETROFORGE_STEAM_PROTON_START")
LOG = os.path.join(DATA, "retroforge", "steam-compat-tools.log")
DIRS = {"stable": "proton-armv8-retroforge", "experimental": "proton-armv8-experimental-retroforge"}
STEAM_LIBRARY = os.environ.get("RETROFORGE_STEAM_LIBRARY", "/usr/lib/retroforge/steam-library")
VDF = os.path.join(STEAM_ROOT, "config", "config.vdf")
MAPPING = ["InstallConfigStore", "Software", "Valve", "Steam", "CompatToolMapping"]
DEFAULT = MAPPING + ["0"]


def log(msg):
    print(f"retroforge-steam-proton: {msg}", file=sys.stderr, flush=True)


def lacks_atomics():
    try:
        with open(CPUINFO, encoding="utf-8", errors="replace") as f:
            feats = [line.split(":", 1)[1].split() for line in f if line.startswith("Features")]
    except OSError:
        return False
    return any("atomics" not in x for x in feats)


def channel():
    value = ""
    try:
        with open(CONF, encoding="utf-8", errors="replace") as f:
            for line in f:
                if line.startswith("PROTON_CHANNEL="):
                    value = line.strip().split("=", 1)[1]
    except OSError:
        pass
    return "experimental" if value == "experimental" else "stable"


def save(value):
    lines = []
    try:
        with open(CONF, encoding="utf-8", errors="replace") as f:
            lines = [l for l in f if not l.startswith("PROTON_CHANNEL=")]
    except OSError:
        lines = ["# Steam settings of the RetroForge shell. Safe to edit.\n"]
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF + ".part", "w", encoding="utf-8") as f:
        f.writelines(lines + [f"PROTON_CHANNEL={value}\n"])
    os.replace(CONF + ".part", CONF)


def installed(tool):
    return all(os.path.isfile(os.path.join(tool, f)) for f in (".retroforge-pin", "proton", "compatibilitytool.vdf"))


def client_running():
    client = os.path.join(STEAM_ROOT, "steamrtarm64", "steam")
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv0 = f.read().split(b"\0", 1)[0].decode("utf-8", "replace")
        except OSError:
            continue
        if argv0 == client or argv0.endswith("/steamrtarm64/steam"):
            return True
    return False


def start_install():
    """The channel's build installed or updated in the background, its log appended to LOG."""
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    out = open(LOG, "a")
    if START:
        subprocess.Popen([START, HELPER, "install"], stdout=out, stderr=out, start_new_session=True)
        return
    res = subprocess.run(["systemd-run", "--user", "--quiet", "--collect", "--unit=retroforge-steam-compat-tools",
                          f"--setenv=RETROFORGE_STEAM_ROOT={STEAM_ROOT}", f"-pStandardOutput=append:{LOG}",
                          f"-pStandardError=append:{LOG}", HELPER, "install"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if res.returncode != 0:  # no user manager, or another run is already going (its lock decides)
        subprocess.Popen([HELPER, "install"], stdout=out, stderr=out, start_new_session=True)


# ---- config.vdf: one entry changed, the rest of the text kept as it is -------------------------------
def tokens(text):
    """(kind, value, start, end) per token: "str", "{" or "}". ValueError on anything else."""
    i = 0
    while i < len(text):
        c = text[i]
        if c.isspace():
            i += 1
        elif text.startswith("//", i):
            end = text.find("\n", i)
            i = len(text) if end < 0 else end
        elif c in "{}":
            yield c, c, i, i + 1
            i += 1
        elif c == '"':
            j, value = i + 1, []
            while j < len(text) and text[j] != '"':
                if text[j] == "\\" and j + 1 < len(text):
                    j += 1
                value.append(text[j])
                j += 1
            if j >= len(text):
                raise ValueError("a string is not closed")
            yield "str", "".join(value), i, j + 1
            i = j + 1
        else:
            raise ValueError(f"unexpected {c!r} at {i}")


def closing(toks, i):
    depth = 0
    for j in range(i, len(toks)):
        depth += toks[j][0] == "{"
        depth -= toks[j][0] == "}"
        if depth == 0:
            return j
    raise ValueError("a section is not closed")


def find(toks, lo, hi, key):
    """(key index, value index) of key among the entries toks[lo:hi] (case-insensitive), or None."""
    i = lo
    while i < hi:
        if toks[i][0] != "str" or i + 1 >= hi:
            raise ValueError("not key/value pairs")
        j = i + 1
        if toks[i][1].lower() == key.lower():
            return i, j
        i = closing(toks, j) + 1 if toks[j][0] == "{" else j + 1
    return None


def quote(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def nest(keys, values, depth):
    pad = "\t" * depth
    if not keys:
        return "".join(f"{pad}{quote(k)}\t\t{quote(v)}\n" for k, v in values.items())
    return f"{pad}{quote(keys[0])}\n{pad}{{\n{nest(keys[1:], values, depth + 1)}{pad}}}\n"


def set_entry(text, path, values):
    """text with the section at path holding values (created when missing)."""
    toks = list(tokens(text))
    lo, hi, close, depth = 0, len(toks), None, 0
    line_of = lambda tok: text.rfind("\n", 0, tok[2]) + 1
    for n, key in enumerate(path):
        hit = find(toks, lo, hi, key)
        if hit is None:
            at = line_of(toks[close]) if close is not None else len(text)
            return text[:at] + nest(path[n:], values, depth) + text[at:]
        j = hit[1]
        if toks[j][0] != "{":
            raise ValueError(f"{key} is a value, not a section")
        close = closing(toks, j)
        lo, hi, depth = j + 1, close, depth + 1
    edits = []
    for key, value in values.items():
        hit = find(toks, lo, hi, key)
        if hit is None:
            at = line_of(toks[close])
            edits.append((at, at, "\t" * depth + f"{quote(key)}\t\t{quote(value)}\n"))
        elif toks[hit[1]][0] == "str":
            edits.append((toks[hit[1]][2], toks[hit[1]][3], quote(value)))
        else:
            raise ValueError(f"{key} is a section, not a value")
    for start, end, new in sorted(edits, reverse=True):
        text = text[:start] + new + text[end:]
    return text


def mappings(text):
    """{entry key: tool name} of CompatToolMapping in text ({} without one)."""
    toks = list(tokens(text))
    lo, hi = 0, len(toks)
    for key in MAPPING:
        hit = find(toks, lo, hi, key)
        if hit is None or toks[hit[1]][0] != "{":
            return {}
        lo, hi = hit[1] + 1, closing(toks, hit[1])
    out, i = {}, lo
    while i < hi:
        j = i + 1
        if toks[j][0] == "{":
            name = find(toks, j + 1, closing(toks, j), "name")
            out[toks[i][1]] = toks[name[1]][1] if name and toks[name[1]][0] == "str" else ""
            i = closing(toks, j) + 1
        else:
            i = j + 1
    return out


def steam_library():
    """/usr/lib/retroforge/steam-library as a module: its manifest and appinfo.vdf readers."""
    loader = importlib.machinery.SourceFileLoader("steam_library", STEAM_LIBRARY)
    spec = importlib.util.spec_from_loader("steam_library", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def windows_games():
    """{appid: name} of the installed games appinfo.vdf lists for Windows and not for Linux."""
    lib = steam_library()
    installed = lib.installed_apps(STEAM_ROOT)
    if not installed:
        return {}
    nodes = lib.read_app_nodes(os.path.join(STEAM_ROOT, "appcache", "appinfo.vdf"), set(installed))
    games = {}
    for appid, node in nodes.items():
        common = node.get("appinfo", node).get("common", {})
        oslist = str(common.get("oslist", "")).lower().split(",")
        if str(common.get("type", "")).lower() in ("game", "demo") and "windows" in oslist and "linux" not in oslist:
            games[appid] = installed[appid]["name"]
    return games


def set_tools(name):
    """Our build as Steam's default and as each Windows game's own tool (see EACH WINDOWS GAME TOO)."""
    try:
        with open(VDF, encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        log("Steam has no config.vdf yet; the default is set at a later start")
        return
    new = set_entry(text, DEFAULT, {"name": name, "config": "", "priority": "75"})
    try:
        games = windows_games()
    except Exception as err:  # appinfo.vdf unreadable: the default alone
        log(f"could not read the installed games' platforms: {err}")
        games = {}
    tools, added = mappings(new), []
    for appid, game in sorted(games.items()):
        have = tools.get(str(appid))
        if have == name or (have is not None and have not in DIRS.values()):
            continue
        new = set_entry(new, MAPPING + [str(appid)], {"name": name, "config": "", "priority": "250"})
        added.append(game)
    if added:
        log(f"{name} is now the tool of {', '.join(added)}")
    if new == text:
        return
    backup = VDF + ".before-retroforge-proton"
    if not os.path.exists(backup):
        with open(backup, "w", encoding="utf-8") as f:
            f.write(text)
    with open(VDF + ".part", "w", encoding="utf-8") as f:
        f.write(new)
    os.replace(VDF + ".part", VDF)
    if mappings(text).get("0") != name:
        log(f"Steam's default compatibility tool is now {name}")


def apply():
    if not lacks_atomics():
        return "steam"
    ch = channel()
    tool = os.path.join(STEAM_ROOT, "compatibilitytools.d", DIRS[ch])
    start_install()
    if not installed(tool):
        log(f"{DIRS[ch]} is not installed yet (it downloads in the background); Steam keeps its default for now")
    elif client_running():
        log("the Steam client is running; its default tool is set at its next start")
    else:
        try:
            set_tools(DIRS[ch])
        except (OSError, ValueError) as err:
            log(f"could not set Steam's default tool in {VDF}: {err}")
    return ch


def main(argv):
    if argv[1:] == ["status"]:
        print(channel() if lacks_atomics() else "steam")
        return 0
    if argv[1:] == ["apply"]:
        print(apply())
        return 0
    if len(argv) == 3 and argv[1] == "set" and argv[2] in DIRS:
        if not lacks_atomics():
            log("this CPU has LSE atomics: Steam's own default stays")
            print("steam")
            return 0
        try:
            save(argv[2])
        except OSError as err:
            log(f"could not save PROTON_CHANNEL={argv[2]} in {CONF}: {err}")
            return 1
        print(apply())
        return 0
    log("usage: retroforge-steam-proton status|apply|set stable|experimental")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
