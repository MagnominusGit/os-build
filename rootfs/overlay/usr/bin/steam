#!/usr/bin/env bash
# steam — Valve's arm64 Steam client, started the way the OpenGamepadUI Steam plugin asks for it:
#   steam -gamepadui -steamos3 -steampal -steamdeck -silent steam://rungameid/<appid>
#
# The image ships no Steam (Holo's aarch64 repo has none). The player installs it from Main menu >
# Emulators > Steam Client (/usr/lib/retroforge/steam-install, which shows the download's progress).
# This:
#   1. has /usr/lib/retroforge/steam-bootstrap check that the client is there. When it is not, the
#      bootstrap says where to install it and exits 10, and so does this, with nothing downloaded.
#      The client channel (/usr/share/retroforge/steam/steam.pin) is a steamdeck_ line because the
#      plugin passes -steamdeck: the client repoints a line that does not match its flag, at the cost
#      of a ~631 MB download;
#   2. points ~/.steam/steam and ~/.steam/root at the client ("Steam data link does not exist,
#      client is misconfigured" otherwise), and the other ~/.steam links Valve's steam.sh makes;
#   3. drops a D-Bus session address that belongs to another user, because bwrap fails on it (seen
#      with root's, over SSH), and the STEAM_RUNTIME variables Valve's steam.sh also unsets;
#   4. runs steamrtarm64/steam RAW ON THE HOST, as Nova-Deck does: no Steam Runtime container. Steam
#      runs every game in Steam Linux Runtime 4.0's own container (pressure-vessel), and that cannot
#      start nested inside a container the client runs in ("bwrap: execvp true: No such file or
#      directory": Hades, KONKR Pocket FIT, 2026-10-19). steamui.so's gtk2, steamwebhelper's libibus
#      and the lsof the client checks its UI's websocket with come from the image
#      (rootfs/customize-base.sh); the client's own media libs (libav*, libvpx) come from steamrtarm64
#      and steamrtarm64/video, put first on LD_LIBRARY_PATH;
#   5. starts it again when it exits 42, which it does after installing an update ("Update
#      complete, launching Steam..."). That is the same exit code Valve's steam.sh and steamcmd.sh
#      restart on.
# A second `steam steam://...` while the client runs goes through the same path, and the client hands
# the URI to the running instance itself.
#
# Stopping: when the game's windows are gone, OGUI SIGTERMs the launch's process NAMED steam
# (RunningApp.find_steam). That is the client: this script runs as `bash`, because env re-execs it.
# A TERM/INT/HUP sent to this script is passed on to the client, so it is never left running
# without its wrapper.
# Unless the player keeps Steam running in the background (Settings > Steam, on by default): then the
# client runs as a user unit, minimal, and outlives the launch, and this script hands launches to it
# ("Kept running in the background" below). And a game Steam has started here before starts without
# the client, beside the kept one (Settings > Steam, on by default: "Without the client" below), so
# Steam's full client comes up only when the player opens Steam.
#
# First start: on 2026-10-15 the client updated itself from Valve's manifest (667 MB download) to
# ~3 GB, because the linuxarm64 manifest also carries the x86 client and runtimes. steam-install runs
# that update when Steam Client is installed.
#
# ARMv8.0 (SM6115): Valve builds the client with unguarded LSE atomics, so on a CPU without them it
# dies of SIGILL unless the kernel emulates them (kernel/patches/0025). See docs/steam-arm64.md.
#
# TEST SEAMS (tests/test-steam.sh): RETROFORGE_STEAM_BOOTSTRAP, RETROFORGE_STEAM_ROOT, RETROFORGE_CPUINFO.
set -u

: "${RETROFORGE_STEAM_BOOTSTRAP:=/usr/lib/retroforge/steam-bootstrap}"
export RETROFORGE_STEAM_ROOT="${RETROFORGE_STEAM_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/Steam}"
MAGIC_RESTART_EXITCODE=42

log() { echo "steam: $*" >&2; }

client="$("$RETROFORGE_STEAM_BOOTSTRAP")"; rc=$?
# 10: the client is not installed, and the bootstrap has said where to install it.
[ "$rc" -eq 10 ] && exit 1
if [ "$rc" -ne 0 ] || [ ! -x "$client" ]; then
  log "Valve's arm64 Steam client could not be set up (see above)"
  exit 1
fi

mkdir -p "$HOME/.steam"
for link in steam root; do
  # A real directory there is not ours to replace.
  if [ -d "$HOME/.steam/$link" ] && [ ! -L "$HOME/.steam/$link" ]; then
    log "$HOME/.steam/$link is a directory, not a link; leaving it alone"
  else
    ln -sfn "$RETROFORGE_STEAM_ROOT" "$HOME/.steam/$link"
  fi
done

# ---- Without the client (Settings > Steam; on by default) -------------------------------------------
# A game launch (steam://rungameid/<appid>) can start without the Steam client, which holds ~1 GB
# beside the game: on the MANGMI Air X (3.5 GB) earlyoom killed Hades in its first room with the
# client running, and Hades played without it (2026-10-22). /usr/bin/retroforge-steam-direct decides
# (`check`: the player's setting, no client running but the kept one, a launch of this game that Steam
# has run on this device before and that needs nothing only the client sets up) and replays that
# launch (`run`). Then the client's own set-up below is skipped (the x86 guest, our ARMv8.0 Proton and
# FEX), but not the D-Bus check and DXVK-Sarek, and this script becomes the helper. With "Keep Steam
# running" on, the kept client runs beside the game, minimal ("Beside a game started without it"
# below). Anything else (Steam's UI, an install, a game's first launch, an x86 game) starts the
# client as before.
# TEST SEAM (tests/test-steam-direct.sh): RETROFORGE_STEAM_DIRECT_CLI.
direct_cli="${RETROFORGE_STEAM_DIRECT_CLI:-/usr/bin/retroforge-steam-direct}"
direct=""
if [ -z "${RETROFORGE_STEAM_KEPT:-}" ] && [ -x "$direct_cli" ]; then
  for arg in "$@"; do
    case "$arg" in steam://rungameid/*) direct="${arg#steam://rungameid/}" ;; esac
  done
  case "$direct" in *[!0-9]*) direct="" ;; esac
  if [ -n "$direct" ] && ! "$direct_cli" check "$direct"; then direct=""; fi
fi
# ----------------------------------------------------------------------------------------------------

# ---- Kept running in the background (Settings > Steam, on by default) ------------------------------
# Off, the client lives as long as this launch: OGUI SIGTERMs it once the game's windows are gone, and
# every game starts Steam cold (~18 s of a ~30 s launch: KONKR Pocket FIT, Hades, 2026-10-21). On
# (/usr/bin/retroforge-steam-keep, the default), the client runs as the user unit
# retroforge-steam.service instead, outside OGUI's process tree, where neither OGUI's "stop Steam" nor
# its reaper reach it. In the background it is minimal: signed in, with its UI's web helper frozen
# (~240 MB instead of ~1.2 GB; retroforge-steam-keep says how). A launch that needs Steam's UI holds
# it full (`full $$`): Steam's own UI for as long as it is open, a game until it has run
# RETROFORGE_STEAM_MINIMAL_DELAY s (15; Steam's launch dialogs, install scripts and shader prompt come
# before). And this launch:
#   - starts the unit when it is not running: this script again, with this launch's arguments and
#     environment, which runs the rest of it inside the unit (RETROFORGE_STEAM_KEPT=1). Else it hands
#     its arguments to the running client: a second client process passes them over Steam's own
#     pipe (~/.steam/steam.pipe) and exits;
#   - for a game (steam://rungameid/<appid>), stays until Steam's launch of it has created the
#     game's process (retroforge-steam-keep launch: Steam's log) and then for as long as the game's
#     reaper runs (retroforge-steam-keep games), so OGUI keeps the game as running and shows its
#     menu again when it ends. Not the first reaper: the game's install scripts run under one of
#     their own before it, and OGUI went back to its menu between the two (Hades, KONKR Pocket FIT,
#     2026-10-22). OGUI finds the game's windows by the app id gamescope reads from that reaper,
#     and Steam's own windows for the launch ("Launching...", an error) by the same app id, which
#     Steam gives them. It gives up when Steam has not picked the launch up within
#     RETROFORGE_STEAM_LAUNCH_WAIT s (300), when Steam refuses it, or when the unit stops first;
#   - for Steam's own UI (no game), stays until OGUI stops it or the unit stops;
#   - on TERM (Exit in OGUI's menu) ends the game's launch, not Steam.
# The unit's processes carry OGUI_ID=Steam. OGUI tells which app a process belongs to by that
# variable, and "Steam" is the name of every launch of Steam's own UI (Main menu > Emulators > Steam
# Client, an install from the library, the desktop Steam entry), so those find a kept client's
# windows.
# A kept client also takes this path while the setting is off (it was turned off during a game), and
# is stopped once that launch ends. Without a user manager (systemd-run fails), Steam runs with this
# launch, as with the setting off.
# TEST SEAMS (tests/test-steam.sh): RETROFORGE_STEAM_KEEP_CLI, RETROFORGE_STEAM_LAUNCH_WAIT,
# RETROFORGE_STEAM_MINIMAL_DELAY, RETROFORGE_STEAM_SIGNIN_WAIT, RETROFORGE_PROC, and systemd-run and
# systemctl from PATH.
keep_cli="${RETROFORGE_STEAM_KEEP_CLI:-/usr/bin/retroforge-steam-keep}"
KEPT_UNIT=retroforge-steam
kept_active() { systemctl --user is-active --quiet "$KEPT_UNIT.service" 2>/dev/null; }
kept_start() {
  local name self
  local -a env=()
  self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  for name in $(compgen -e); do
    case "$name" in
      OGUI_ID|INVOCATION_ID|JOURNAL_STREAM|SYSTEMD_EXEC_PID|MANAGERPID|NOTIFY_SOCKET|LISTEN_*|WATCHDOG_*|PWD|OLDPWD|SHLVL|_) continue ;;
    esac
    [[ "${!name}" == *$'\n'* ]] || env+=(--setenv="$name=${!name}")
  done
  systemd-run --user --quiet --collect --unit="$KEPT_UNIT" -p TasksMax=infinity --working-directory="$HOME" \
    "${env[@]}" --setenv=OGUI_ID=Steam --setenv=RETROFORGE_STEAM_KEPT=1 "$self" "$@" >/dev/null
}
kept_stop() {  # TERM, INT or HUP: end the game this launch started, not Steam
  [ -n "$appid" ] && "$keep_cli" end "$appid"
  "$keep_cli" minimal $$
  [ "$("$keep_cli" status 2>/dev/null)" = on ] || "$keep_cli" stop-idle
  exit 143
}
kept_launch() {
  local arg pid pids="" alive deadline stage=wait step="" ran=0 light="" since proc="${RETROFORGE_PROC:-/proc}"
  appid=""
  since="$(date '+%F %T')"
  for arg in "$@"; do
    case "$arg" in steam://rungameid/*) appid="${arg#steam://rungameid/}" ;; esac
  done
  case "$appid" in *[!0-9]*) appid="" ;; esac
  if kept_active; then
    "$keep_cli" full $$
    log "handing this launch to the kept Steam ($KEPT_UNIT.service)"
    ( cd "$RETROFORGE_STEAM_ROOT/steamrtarm64" &&
      LD_LIBRARY_PATH="$RETROFORGE_STEAM_ROOT/steamrtarm64:$RETROFORGE_STEAM_ROOT/steamrtarm64/video${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
        exec "$client" "$@" )
  elif [ "$("$keep_cli" status 2>/dev/null)" != on ]; then
    return 0
  elif ! kept_start "$@"; then
    log "could not start Steam as the user unit $KEPT_UNIT.service: it runs with this launch only"
    return 0
  else
    "$keep_cli" full $$
  fi
  trap kept_stop TERM INT HUP
  deadline=$((SECONDS + ${RETROFORGE_STEAM_LAUNCH_WAIT:-300}))
  while :; do
    if [ -z "$appid" ]; then
      kept_active || break
      sleep 1 & wait $!
      continue
    fi
    # wait: until Steam's launch has created the game's process (its install scripts run first,
    # under a reaper of their own). run: until the game's reaper has exited.
    if [ "$stage" = wait ]; then
      step="$("$keep_cli" launch "$appid" "$since")"
      case "$step" in
        Completed) stage=run ;;
        Failed)
          # AppError_16, the game already runs (launched again from OGUI): follow that one.
          [ -n "$("$keep_cli" games "$appid")" ] || {
            log "Steam could not start app $appid (see $RETROFORGE_STEAM_ROOT/logs/console_log.txt)"
            exit 1
          }
          stage=run ;;
        unknown)   # no Steam log to read: the first reaper seen is taken for the game's
          [ -z "$("$keep_cli" games "$appid")" ] || stage=run ;;
      esac
      ran=$SECONDS
    fi
    if [ "$stage" = run ]; then
      alive=""
      for pid in $pids; do [ -e "$proc/$pid" ] && alive="$alive $pid"; done
      [ -n "$alive" ] || alive="$("$keep_cli" games "$appid" | tr '\n' ' ')"
      if [ -n "${alive// /}" ]; then
        pids=$alive
        if [ -z "$light" ] && [ $((SECONDS - ran)) -ge "${RETROFORGE_STEAM_MINIMAL_DELAY:-15}" ]; then
          light=1
          "$keep_cli" minimal $$ &
        fi
      elif [ -n "$pids" ] || [ $((SECONDS - ran)) -ge 5 ]; then
        break   # the game has ended (or died before it was seen)
      fi
    elif [ -z "${step#unknown}" ] && [ "$SECONDS" -ge "$deadline" ]; then
      log "Steam did not start app $appid within ${RETROFORGE_STEAM_LAUNCH_WAIT:-300} s (open Steam from Main menu > Emulators > Steam Client to see why)"
      exit 1
    elif ! kept_active; then
      log "the kept Steam stopped before it started app $appid"
      exit 1
    fi
    sleep 1 & wait $!
  done
  "$keep_cli" minimal $$
  [ "$("$keep_cli" status 2>/dev/null)" = on ] || "$keep_cli" stop-idle
  exit 0
}
if [ -z "$direct" ] && [ -z "${RETROFORGE_STEAM_KEPT:-}" ] && [ -x "$keep_cli" ]; then
  kept_launch "$@"
fi
# Beside a game started without it: with the setting on, the kept client runs beside the game,
# minimal. The game's Steam API connects to it: achievements, stats, playtime, Steam Input, and the
# Cloud upload when the game ends, but not the Cloud download before it, which only Steam's own launch
# makes. Hades on the MANGMI Air X peaked at 5810 MB of RAM+swap with it, 5735 MB alone (2026-10-25).
# A client started for this signs in first (~20 s; RETROFORGE_STEAM_SIGNIN_WAIT s at most, 45): a game's
# SteamAPI_Init does not wait for it. Not when Steam has no remembered sign-in (loginusers.vdf).
kept_beside() {
  local arg log="$RETROFORGE_STEAM_ROOT/logs/connection_log.txt" seen=0 node="" deadline
  local -a args=()
  [ -x "$keep_cli" ] && [ "$("$keep_cli" status 2>/dev/null)" = on ] || return 0
  if kept_active; then
    "$keep_cli" minimal
    return 0
  fi
  grep -Eqs '"RememberPassword"[[:space:]]+"1"' "$RETROFORGE_STEAM_ROOT/config/loginusers.vdf" || return 0
  for arg in "$@"; do
    case "$arg" in steam://*) ;; *) args+=("$arg") ;; esac   # the client itself does not start the game
  done
  [ -r "$log" ] && { seen=$(wc -l <"$log"); node=$(stat -c %i "$log"); }
  "$direct_cli" remember
  if ! kept_start "${args[@]}"; then
    log "could not start Steam as the user unit $KEPT_UNIT.service: app $direct runs without it"
    return 0
  fi
  deadline=$((SECONDS + ${RETROFORGE_STEAM_SIGNIN_WAIT:-45}))
  while kept_active; do
    if [ -r "$log" ] && [ "$(stat -c %i "$log")" != "$node" ]; then seen=0; node=$(stat -c %i "$log"); fi
    if tail -n +$((seen + 1)) "$log" 2>/dev/null | grep -q 'Logged On.*processing complete'; then
      "$keep_cli" minimal
      return 0
    fi
    if [ "$SECONDS" -ge "$deadline" ]; then
      log "Steam did not sign in within ${RETROFORGE_STEAM_SIGNIN_WAIT:-45} s: app $direct starts without it"
      "$keep_cli" minimal
      return 0
    fi
    sleep 1
  done
}
# ----------------------------------------------------------------------------------------------------

# ---- x86 games: the FEX guest ----------------------------------------------------------------------
# Valve's FEX tool runs x86 games and x86 Protons, but needs an x86_64 + i386 graphics provider (ld.so,
# glibc, x86 Mesa, graphics_provider.json at its root), and the image ships none.
# /usr/lib/retroforge/steam-x86-guest keeps FEX's ArchLinux RootFS (1.4 GB) in the player's home and
# mounts it with squashfuse on $RETROFORGE_STEAM_X86_GUEST_DIR/root. x86-guest.pin names a channel
# (FEX's RootFS_links.json): whatever FEX publishes now, not a fixed version. `start`:
#   - mounts the installed image when nothing is mounted yet (never twice; a dead mount is replaced);
#   - starts a fetch DETACHED in the background, logging to this stderr, and returns: this `steam`
#     never waits for the network. The fetch checks the channel and downloads a newer image; it
#     becomes the installed one only once complete and checked. If nothing was mounted, it is mounted
#     right then and the next game has it; an older image a game may be using stays until Steam exits;
#   - leaves a holder outside this process tree that waits for this script's PID ($$) to exit, however
#     it ends, and then releases the mount unless another `steam` still runs.
# STEAM_COMPAT_GRAPHICS_PROVIDER is set only once graphics_provider.json is there, i.e. the guest is
# mounted. pressure-vessel reads it for every container it starts, and a path that does not exist yet
# aborts that container ("opendir(...graphics_provider.json): No such file or directory"): when the
# client still ran in a container of its own, a client started during the first download never
# started at all (Air X, 2026-10-18). The client's environment is fixed when it starts, so after a
# first download x86 games get the guest from the next start of Steam. Proton under FEX also needs
# ~/.steam/sdk32 and sdk64.
# RETROFORGE_STEAM_X86_GUEST=0: no download, no mount, no provider.
# TEST SEAMS (tests/test-steam-x86-guest.sh): RETROFORGE_STEAM_X86_GUEST_HELPER, RETROFORGE_STEAM_X86_GUEST_DIR.
# bin32/bin64 are where games look for the Steam overlay's preload libraries (Nova-Deck links them
# the same way). sdkarm64 is where the arm64 client runs EVERY game and install script from
# (~/.steam/sdkarm64/steam-launch-wrapper, in <Steam>/linuxarm64): without it a launch ends in the
# second it starts, and so does the game's install script (Hades, KONKR Pocket FIT, 2026-10-19).
# Valve's steam.sh makes these links; this wrapper stands in for it.
for pair in "sdk32 linux32" "sdk64 linux64" "bin32 ubuntu12_32" "bin64 ubuntu12_64" "sdkarm64 linuxarm64"; do
  link="${pair% *}"; target="${pair#* }"   # not `set --`: "$@" is the client's arguments
  if [ -d "$HOME/.steam/$link" ] && [ ! -L "$HOME/.steam/$link" ]; then
    log "$HOME/.steam/$link is a directory, not a link; leaving it alone"
  else
    ln -sfn "$RETROFORGE_STEAM_ROOT/$target" "$HOME/.steam/$link"
  fi
done
if [ -z "$direct" ] && [ "${RETROFORGE_STEAM_X86_GUEST:-1}" != 0 ]; then
  export RETROFORGE_STEAM_X86_GUEST_DIR="${RETROFORGE_STEAM_X86_GUEST_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/retroforge/fex-guest}"
  "${RETROFORGE_STEAM_X86_GUEST_HELPER:-/usr/lib/retroforge/steam-x86-guest}" start "$$"
  provider="$RETROFORGE_STEAM_X86_GUEST_DIR/root/graphics_provider.json"
  if [ -f "$provider" ]; then
    export STEAM_COMPAT_GRAPHICS_PROVIDER="$provider"
  else
    log "the x86 guest is not in place yet (it downloads in the background); x86 games get it from the next start of Steam"
  fi
fi
# ----------------------------------------------------------------------------------------------------

case "${DBUS_SESSION_BUS_ADDRESS-}" in
  unix:path=*)
    bus="${DBUS_SESSION_BUS_ADDRESS#unix:path=}"
    bus="${bus%%,*}"
    [ -O "$bus" ] || { log "ignoring a D-Bus session bus that is not ours: $bus"; unset DBUS_SESSION_BUS_ADDRESS; }
    ;;
esac
unset STEAM_RUNTIME STEAM_RUNTIME_LIBRARY_PATH

# ARMv8.0 CPUs: our ARMv8.0 Proton as Steam's default tool, set while the client is not running
# (retroforge-steam-proton; nothing elsewhere). TEST SEAM: RETROFORGE_STEAM_PROTON_CLI.
# ARMv8.0 CPUs: our ARMv8.0 FEX for x86 Linux games, as a tool of its own and in Valve's FEX tool while
# the versions match (retroforge-steam-fex; nothing elsewhere). TEST SEAM: RETROFORGE_STEAM_FEX_CLI.
# Both only when the client starts: what they set is the client's, and each also starts an update in
# the background, which a launch without the client would have competing with the game's start.
proton_cli="${RETROFORGE_STEAM_PROTON_CLI:-/usr/bin/retroforge-steam-proton}"
fex_cli="${RETROFORGE_STEAM_FEX_CLI:-/usr/bin/retroforge-steam-fex}"
if [ -z "$direct" ]; then
  [ -x "$proton_cli" ] && "$proton_cli" apply >/dev/null
  [ -x "$fex_cli" ] && "$fex_cli" apply >/dev/null
fi

# DXVK-Sarek, the player's setting (Settings > Steam, on by default on the SM6115's Adreno 610,
# where upstream DXVK stops working with Mesa 26.3). retroforge-steam-sarek applies it: when it is on,
# Proton-CachyOS's arm64 build is installed or updated in the background, and PROTON_DXVK_SAREK=1 is
# its switch for Sarek (Valve's Proton ignores it); when off, Sarek is turned off in an installed one.
# docs/steam-arm64.md. TEST SEAM (tests/test-steam-compat-tools.sh): RETROFORGE_STEAM_SAREK_CLI.
sarek_cli="${RETROFORGE_STEAM_SAREK_CLI:-/usr/bin/retroforge-steam-sarek}"
if [ -x "$sarek_cli" ] && [ "$("$sarek_cli" apply)" = on ]; then
  export PROTON_DXVK_SAREK="${PROTON_DXVK_SAREK:-1}"
fi

# Without the client (above): the game, as Steam last started it, beside the kept client. Else the
# client starts, and it may rotate its log, which holds how it last started each game: the helper
# keeps those first.
[ -n "$direct" ] && kept_beside "$@"
[ -n "$direct" ] && exec "$direct_cli" run "$direct"
[ -x "$direct_cli" ] && "$direct_cli" remember

# No STEAM_MULTIPLE_XWAYLANDS, unlike SteamOS and Nova-Deck where Steam is the shell on :0: it makes
# the client put games on the Xwayland after its own, and OGUI already starts it on :1 (games' own
# display), so games got DISPLAY=:2, which gamescope does not run ("nodrv_CreateWindow", HW 2026-10-17).
export LD_LIBRARY_PATH="$RETROFORGE_STEAM_ROOT/steamrtarm64:$RETROFORGE_STEAM_ROOT/steamrtarm64/video${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# Nova-Deck starts it from steamrtarm64, and that is what has run on hardware.
cd "$RETROFORGE_STEAM_ROOT/steamrtarm64" || exit 1
child=""; stopping=""
trap 'stopping=1; [ -n "$child" ] && kill -TERM "$child" 2>/dev/null' TERM INT HUP
while :; do
  "$client" "$@" &
  child=$!
  # A trapped signal ends `wait` early; keep waiting until the client has really exited.
  while :; do
    wait "$child"; status=$?
    kill -0 "$child" 2>/dev/null || break
  done
  [ -n "$stopping" ] && exit "$status"
  if [ "$status" -eq "$MAGIC_RESTART_EXITCODE" ]; then
    log "restarting the client by request"
    continue
  fi
  if [ "$status" -eq 132 ] && ! grep -qw atomics "${RETROFORGE_CPUINFO:-/proc/cpuinfo}" 2>/dev/null; then
    log "the client died of SIGILL on a CPU without LSE atomics: the kernel needs kernel/patches/0025"
  fi
  # Never fail silently.
  [ "$status" -eq 0 ] || log "the client exited with status $status"
  exit "$status"
done
