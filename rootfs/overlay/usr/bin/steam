#!/usr/bin/env bash
# steam — Valve's arm64 Steam client, started the way the OpenGamepadUI Steam plugin asks for it:
#   steam -gamepadui -steamos3 -steampal -steamdeck -silent steam://rungameid/<appid>
#
# The image ships no Steam (Holo's aarch64 repo has none, and the client is ~560 MB with its runtime),
# so this:
#   1. has /usr/lib/retroforge/steam-bootstrap download Valve's arm64 client and Steam Runtime into
#      the player's home the first time, and get the runtime's `run`. Both come from the CHANNELS
#      /usr/share/retroforge/steam/steam.pin names, not from pinned versions. The client channel is
#      a steamdeck_ line because the plugin passes -steamdeck: the client repoints a line that does
#      not match its flag, at the cost of a ~631 MB download (steam.pin). On every later start the
#      bootstrap checks the runtime channel (one small GET) and installs a new snapshot before Steam
#      starts when the channel moved (~52 MB); offline it uses the installed one;
#   2. points ~/.steam/steam and ~/.steam/root at the client ("Steam data link does not exist,
#      client is misconfigured" otherwise);
#   3. drops a D-Bus session address that belongs to another user, because pressure-vessel's bwrap
#      fails on it (seen with root's, over SSH), and the STEAM_RUNTIME variables Valve's steam.sh also
#      unsets;
#   4. runs steamrtarm64/steam inside the runtime's container. The client strips LD_LIBRARY_PATH, and
#      steamui.so needs the runtime's GTK2 and the rest;
#   5. starts it again when it exits 42, which it does after installing an update ("Update
#      complete, launching Steam..."). That is the same exit code Valve's steam.sh and steamcmd.sh
#      restart on.
# A second `steam steam://...` while the client runs goes through the same path, and the client hands
# the URI to the running instance itself.
#
# Stopping: when the game's windows are gone, OGUI SIGTERMs the launch's process NAMED steam
# (RunningApp.find_steam). That is the client: this script runs as `bash`, because env re-execs it.
# A TERM/INT/HUP sent to this script is passed on to the client, so it is never left running
# without its wrapper.
#
# While this script runs, it holds a shared lock (flock) on the folder of the runtime snapshot the
# client runs in, and the client inherits it. A second `steam` whose bootstrap finds the runtime
# channel moved installs the new snapshot, but cannot remove this one from under the running client;
# a later start does.
#
# First start, measured in a linux/arm64 container: the bootstrap took 6 s (2026-10-16; runtime
# 222 MB, client binaries 325 MB unpacked). On 2026-10-15 the client then updated itself from Valve's
# manifest (667 MB download) to ~3 GB, because the linuxarm64 manifest also carries the x86 client
# and runtimes.
#
# ARMv8.0 (SM6115): Valve builds the client with unguarded LSE atomics, so on a CPU without them it
# dies of SIGILL unless the kernel emulates them (kernel/patches/0025). See docs/steam-arm64.md.
#
# TEST SEAMS (tests/test-steam.sh): RETROFORGE_STEAM_BOOTSTRAP, RETROFORGE_STEAM_ROOT, RETROFORGE_CPUINFO.
set -u

: "${RETROFORGE_STEAM_BOOTSTRAP:=/usr/lib/retroforge/steam-bootstrap}"
export RETROFORGE_STEAM_ROOT="${RETROFORGE_STEAM_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/Steam}"
MAGIC_RESTART_EXITCODE=42

log() { echo "steam: $*" >&2; }

run="$("$RETROFORGE_STEAM_BOOTSTRAP")"
if [ $? -ne 0 ] || [ ! -x "$run" ]; then
  log "Valve's arm64 Steam client could not be set up (see above)"
  exit 1
fi
# <runtime home>/<snapshot>/<dir>/run -> <runtime home>/<snapshot>. Not fatal if it fails: the lock
# only keeps a runtime update from removing the snapshot early.
snapshot="${run%/*/run}"
exec {held}<"$snapshot" && flock -s "$held" || log "could not lock $snapshot"
# Gone between the bootstrap and the lock: another `steam` moved to a newer snapshot just then.
[ -x "$run" ] || { log "the Steam Runtime changed while starting; start steam again"; exit 1; }

mkdir -p "$HOME/.steam"
for link in steam root; do
  # A real directory there is not ours to replace.
  if [ -d "$HOME/.steam/$link" ] && [ ! -L "$HOME/.steam/$link" ]; then
    log "$HOME/.steam/$link is a directory, not a link; leaving it alone"
  else
    ln -sfn "$RETROFORGE_STEAM_ROOT" "$HOME/.steam/$link"
  fi
done

# ---- x86 games: the FEX guest ----------------------------------------------------------------------
# Valve's FEX tool runs x86 games and x86 Protons, but needs an x86_64 + i386 graphics provider (ld.so,
# glibc, x86 Mesa, graphics_provider.json at its root), and the image ships none.
# /usr/lib/retroforge/steam-x86-guest keeps FEX's ArchLinux RootFS (1.4 GB) in the player's home and
# mounts it with squashfuse on $RETROFORGE_STEAM_X86_GUEST_DIR/root. x86-guest.pin names a channel
# (FEX's RootFS_links.json): whatever FEX publishes now, not a fixed version. `start`:
#   - mounts the installed image when nothing is mounted yet (never twice; a dead mount is replaced);
#   - starts a fetch DETACHED in the background, logging to this stderr, and returns: this `steam`
#     never waits for the network. The fetch checks the channel and downloads a newer image; it
#     becomes the installed one only once complete and checked. If nothing was mounted, it is mounted
#     right then and the next game has it; an older image a game may be using stays until Steam exits;
#   - leaves a holder outside this process tree that waits for this script's PID ($$) to exit, however
#     it ends, and then releases the mount unless another `steam` still runs.
# STEAM_COMPAT_GRAPHICS_PROVIDER is set only once graphics_provider.json is there, i.e. the guest is
# mounted. pressure-vessel reads it for the client's OWN container as well, and a path that does not
# exist yet aborts that container ("opendir(...graphics_provider.json): No such file or directory"),
# so a client started during the first download never started at all (Air X, 2026-10-18). The
# client's environment is fixed when it starts, so after a first download x86 games get the guest
# from the next start of Steam. Proton under FEX also needs ~/.steam/sdk32 and sdk64.
# RETROFORGE_STEAM_X86_GUEST=0: no download, no mount, no provider.
# TEST SEAMS (tests/test-steam-x86-guest.sh): RETROFORGE_STEAM_X86_GUEST_HELPER, RETROFORGE_STEAM_X86_GUEST_DIR.
for b in 32 64; do
  if [ -d "$HOME/.steam/sdk$b" ] && [ ! -L "$HOME/.steam/sdk$b" ]; then
    log "$HOME/.steam/sdk$b is a directory, not a link; leaving it alone"
  else
    ln -sfn "$RETROFORGE_STEAM_ROOT/linux$b" "$HOME/.steam/sdk$b"
  fi
done
if [ "${RETROFORGE_STEAM_X86_GUEST:-1}" != 0 ]; then
  export RETROFORGE_STEAM_X86_GUEST_DIR="${RETROFORGE_STEAM_X86_GUEST_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/retroforge/fex-guest}"
  "${RETROFORGE_STEAM_X86_GUEST_HELPER:-/usr/lib/retroforge/steam-x86-guest}" start "$$"
  provider="$RETROFORGE_STEAM_X86_GUEST_DIR/root/graphics_provider.json"
  if [ -f "$provider" ]; then
    export STEAM_COMPAT_GRAPHICS_PROVIDER="$provider"
  else
    log "the x86 guest is not in place yet (it downloads in the background); x86 games get it from the next start of Steam"
  fi
fi
# ----------------------------------------------------------------------------------------------------

case "${DBUS_SESSION_BUS_ADDRESS-}" in
  unix:path=*)
    bus="${DBUS_SESSION_BUS_ADDRESS#unix:path=}"
    bus="${bus%%,*}"
    [ -O "$bus" ] || { log "ignoring a D-Bus session bus that is not ours: $bus"; unset DBUS_SESSION_BUS_ADDRESS; }
    ;;
esac
unset STEAM_RUNTIME STEAM_RUNTIME_LIBRARY_PATH

# DXVK-Sarek, the player's setting (Settings > General, on by default on the SM6115's Adreno 610,
# where upstream DXVK stops working with Mesa 26.3). retroforge-steam-sarek applies it: when it is on,
# Proton-CachyOS's arm64 build is installed or updated in the background, and PROTON_DXVK_SAREK=1 is
# its switch for Sarek (Valve's Proton ignores it); when off, Sarek is turned off in an installed one.
# docs/steam-arm64.md. TEST SEAM (tests/test-steam-compat-tools.sh): RETROFORGE_STEAM_SAREK_CLI.
sarek_cli="${RETROFORGE_STEAM_SAREK_CLI:-/usr/bin/retroforge-steam-sarek}"
if [ -x "$sarek_cli" ] && [ "$("$sarek_cli" apply)" = on ]; then
  export PROTON_DXVK_SAREK="${PROTON_DXVK_SAREK:-1}"
fi

cd "$RETROFORGE_STEAM_ROOT" || exit 1
child=""; stopping=""
trap 'stopping=1; [ -n "$child" ] && kill -TERM "$child" 2>/dev/null' TERM INT HUP
while :; do
  "$run" -- "$RETROFORGE_STEAM_ROOT/steamrtarm64/steam" "$@" &
  child=$!
  # A trapped signal ends `wait` early; keep waiting until the client has really exited.
  while :; do
    wait "$child"; status=$?
    kill -0 "$child" 2>/dev/null || break
  done
  [ -n "$stopping" ] && exit "$status"
  if [ "$status" -eq "$MAGIC_RESTART_EXITCODE" ]; then
    log "restarting the client by request"
    continue
  fi
  if [ "$status" -eq 132 ] && ! grep -qw atomics "${RETROFORGE_CPUINFO:-/proc/cpuinfo}" 2>/dev/null; then
    log "the client died of SIGILL on a CPU without LSE atomics: the kernel needs kernel/patches/0025"
  fi
  # Never fail silently: pressure-vessel writes its own errors straight to the journal (as
  # pressure-vessel-wrap) when stderr is the journal, so nothing of them shows up next to ours.
  [ "$status" -eq 0 ] || log "the client exited with status $status (runtime errors: journalctl -t pressure-vessel-wrap)"
  exit "$status"
done
