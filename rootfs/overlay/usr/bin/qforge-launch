#!/bin/bash
# qforge-launch — start a ROM in its system's emulator, from an OpenGamepadUI library card.
#
#   qforge-launch [--cpus big|all] <system> <rom>
#   qforge-launch [--cpus big|all] --gui <emulator>
#
# --gui starts the emulator's own UI with no ROM: the plugin store's Open, for the settings OGUI
# does not expose. It runs exactly like a ROM (mount, seed, setsid, exit handling below), with the
# emulator conf's GUI_ARGS in place of ARGS + ROM.
#
# Emulators are not in the image: the QForge OGUI plugin downloads each one as an upstream AppImage
# into /home/player/emulators/<emulator>/ and points `current` at the version to run (plan Phase
# 3/4). This script is what every ROM card runs. /etc/qforge/launch.conf maps a system to its
# emulator; /etc/qforge/emulators/<emulator>.conf says which binary inside the AppImage to run,
# with what arguments (ARGS before a ROM, GUI_ARGS for --gui), and which first-run settings to seed.
#
# CPU pinning (--cpus big): the emulator is started on the device's fast cores,
# so its threads stay off the little cluster and do not migrate across clusters; background work
# (audio, input, Wi-Fi) keeps the little cores. "Fast" is every ONLINE CPU whose cpu_capacity is
# above the smallest online one — never a CPU number (Qualcomm numbers slowest-first, other SoCs do
# not), and never only the top tier (one prime core is no home for a multi-threaded emulator).
# PowerStation's core-count slider is the POWER control and offlines the fast cores first, so with
# none of them online, or on a homogeneous SoC, nothing is pinned. sched_ext schedulers (scx_lavd)
# honour the affinity mask (HW 2026-10-03). It is the PLAYER's choice, per game: the QForge plugin
# offers it and puts --cpus on that game's command line; nothing ships pinned (default all).
#
# First-run settings (SEED) live in the image, /usr/share/qforge/emulators/<emulator>/, and are
# copied into $HOME before the emulator's first start — never over an existing file, so whatever the
# player changes in the emulator is kept. One set per emulator serves every device: InputPlumber
# presents each handheld's joypad as the same virtual pad (SDL-0 to the emulators).
#
# The AppImage is mounted and its real binary run; every rule below was found on hardware
# (DuckStation, MANGMI Pocket Max, 2026-10-03) and each one cost a crash:
#
#   - Never exec the AppImage or its AppRun. The runtime starts AppRun, a symlink to the binary; Qt
#     takes applicationDirPath from that path, misses usr/bin/qt.conf, finds no platform plugin and
#     aborts. Desktops hide this with a system Qt; QForge has none.
#   - OGUI stops a game with Reaper.reap(): every PID in the tree, leaves inward, gets
#     `kill -TERM -- -PID` and then `kill -TERM PID`, each a separate command. The emulator runs
#     under setsid so it leads its own process group: its two signals arrive back to back and
#     coalesce into one, as when OGUI launches it directly. Inside our group it got a second,
#     later SIGTERM through `-<our pid>`, which DuckStation takes as "Ctrl+C again: force quit"
#     and abort()s — a core dump and a 14 s exit.
#   - We never forward a signal to the emulator, for the same reason: it already has OGUI's.
#   - The mount runtime is in the tree too. It starts with SIGTERM ignored, or OGUI's Exit pulls the
#     files out from under an emulator that is still shutting down. After the emulator exits it is
#     released with SIGHUP (the runtime holds the mount busy until it exits) and fusermount3 -u.
#   - Exit pressed twice is SIGKILL for everything, which leaves a dead mount: sweep ours first.
#
# Exit status: the emulator's, or 2 for a bad invocation, 3 when the emulator is not installed or
# its AppImage does not mount. OGUI runs games through its reaper and never sees this status, so an
# exit 3 is also written to $QFORGE_LAUNCH_STATUS (`not-installed <emulator>` or
# `mount-failed <emulator>`), cleared at every start: the QForge plugin's EXIT hook reads it and
# tells the player to download the emulator from the store.

set -uo pipefail

CONF=${QFORGE_LAUNCH_CONF:-/etc/qforge/launch.conf}
EMU_CONF_DIR=${QFORGE_EMU_CONF_DIR:-/etc/qforge/emulators}
EMU_DIR=${QFORGE_EMU_DIR:-/home/player/emulators}
SEED_DIR=${QFORGE_EMU_SEED_DIR:-/usr/share/qforge/emulators}
MOUNTS=${QFORGE_MOUNTS:-/proc/mounts}
CPU_ROOT=${QFORGE_CPU_ROOT:-/sys/devices/system/cpu}
UNMOUNT_TRIES=50   # x 0.1 s for the runtime to let go of the mount after SIGHUP
MOUNT_TIMEOUT=30   # s for the AppImage runtime to print its mount point
STATUS=${QFORGE_LAUNCH_STATUS:-${XDG_RUNTIME_DIR:-/tmp}/qforge-launch.status}

die() { echo "qforge-launch: $2" >&2; exit "$1"; }
# fail <reason>: an exit-3 failure the plugin reports to the player.
fail() { echo "$1 $emulator" > "$STATUS" 2>/dev/null; die 3 "$2"; }
rm -f "$STATUS"

usage="usage: qforge-launch [--cpus big|all] <system> <rom> | [--cpus big|all] --gui <emulator>"
CPUS=all
if [ "${1-}" = --cpus ]; then
  [ $# -ge 2 ] || die 2 "$usage"
  CPUS=$2; shift 2
fi
case $CPUS in big|all) ;; *) die 2 "--cpus must be 'big' or 'all', not '$CPUS'" ;; esac
[ $# -eq 2 ] || die 2 "$usage"
if [ "$1" = --gui ]; then
  system= rom= emulator=$2
  [[ $emulator =~ ^[a-z0-9_-]+$ ]] || die 2 "bad emulator name '$emulator'"
else
  system=$1 rom=$2
  [[ $system =~ ^[a-z0-9_]+$ ]] || die 2 "bad system name '$system'"
  [ -f "$rom" ] || die 2 "no such ROM: $rom"
  emulator=$(sed -n "s/^$system=\([a-z0-9_-]*\)[[:space:]]*$/\1/p" "$CONF" 2>/dev/null | tail -1)
  [ -n "$emulator" ] || die 2 "no emulator for system '$system' in $CONF"
fi
emu_conf="$EMU_CONF_DIR/$emulator.conf"
[ -f "$emu_conf" ] || die 2 "missing $emu_conf"

BINARY= ARGS=() GUI_ARGS=() SEED=()
# shellcheck source=/dev/null
. "$emu_conf"
[ -n "$BINARY" ] || die 2 "$emu_conf sets no BINARY"
if [ -n "$rom" ]; then run_args=("${ARGS[@]}" "$rom"); else run_args=("${GUI_ARGS[@]}"); fi

img="$EMU_DIR/$emulator/current"
[ -x "$img" ] || fail not-installed "$emulator is not installed ($img missing or not executable)"

for entry in "${SEED[@]}"; do
  src="$SEED_DIR/$emulator/${entry%%:*}" dst=${entry#*:}
  [[ $entry == *:* && -n $dst && $dst != /* && /$dst/ != */../* ]] \
    || die 2 "$emu_conf: bad SEED entry '$entry' (want <file>:<path under \$HOME>)"
  [ -e "$HOME/$dst" ] && continue
  [ -f "$src" ] || die 2 "$emu_conf seeds $src, which the image does not have"
  mkdir -p "$(dirname "$HOME/$dst")" && cp "$src" "$HOME/$dst" \
    || die 2 "could not seed $HOME/$dst"
  echo "qforge-launch: first run of $emulator: seeded $HOME/$dst" >&2
done

# Online CPUs above the smallest online capacity, as a taskset list; empty when there are none.
fast_cpus() {
  local online c cap min= list=() caps=()
  online=$(cat "$CPU_ROOT/online" 2>/dev/null) || return 0
  for c in $(echo "$online" | tr ',' '\n' | awk -F- '{for (i = $1; i <= ($2 == "" ? $1 : $2); i++) print i}'); do
    cap=$(cat "$CPU_ROOT/cpu$c/cpu_capacity" 2>/dev/null) || continue
    [[ $cap =~ ^[0-9]+$ ]] || continue
    caps+=("$c:$cap")
    [ -z "$min" ] || [ "$cap" -lt "$min" ] && min=$cap
  done
  for c in "${caps[@]}"; do [ "${c#*:}" -gt "$min" ] && list+=("${c%%:*}"); done
  (IFS=,; echo "${list[*]}")
}
pin=()
if [ "$CPUS" = big ]; then
  cpus=$(fast_cpus)
  if [ -n "$cpus" ]; then
    pin=(taskset -c "$cpus")
    echo "qforge-launch: pinning $emulator to fast cores $cpus" >&2
  else
    echo "qforge-launch: no fast core online (core-count limit, or one core type): not pinning" >&2
  fi
fi

# The runtime names its FUSE filesystem after the AppImage file `current` points at.
fstype="fuse.$(basename "$(readlink -f "$img")")"
awk -v t="$fstype" '$3 == t {print $2}' "$MOUNTS" | while read -r stale; do
  echo "qforge-launch: releasing stale mount $stale" >&2
  fusermount3 -uz "$stale"
done

trap '' TERM
exec {mount_fd}< <(exec "$img" --appimage-mount)
mount_pid=$!
if ! read -r -t "$MOUNT_TIMEOUT" -u "$mount_fd" mnt || [ ! -d "$mnt" ]; then
  kill -KILL "$mount_pid" 2>/dev/null
  fail mount-failed "$img did not mount"
fi
trap : TERM INT HUP

echo "qforge-launch: ${system:-gui} -> $emulator: $mnt/$BINARY ${run_args[*]}" >&2
# setsid and taskset both exec, so the emulator keeps this PID and leads its own session.
setsid "${pin[@]}" "$mnt/$BINARY" "${run_args[@]}" &
emu_pid=$!
# wait returns early when a trapped signal arrives; keep waiting until the emulator is gone.
while kill -0 "$emu_pid" 2>/dev/null; do wait "$emu_pid"; done
wait "$emu_pid"; rc=$?

kill -HUP "$mount_pid" 2>/dev/null
mounted() { awk -v m="$mnt" '$2 == m {found=1} END {exit !found}' "$MOUNTS"; }
for _ in $(seq "$UNMOUNT_TRIES"); do
  mounted || break
  fusermount3 -u "$mnt" 2>/dev/null && break
  sleep 0.1
done
mounted && echo "qforge-launch: $mnt still busy; the next launch sweeps it" >&2
exit "$rc"
