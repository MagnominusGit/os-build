USAGE = "usage: retroforge-launch <system> <rom> | --gui <emulator> | --psn-install"
PSN_SYSTEM = "ps3"
PSN_INBOX = os.path.join(HOME, "roms", "ps3", "psn")
PSN_STUB_DIR = os.path.join(HOME, "roms", "ps3")
PSN_LICENCES = (".rap", ".edat")
RPCS3_USER = "00000001"  # RPCS3's default (and only RetroForge) user: exdata lives under it
SFO_MAX = 1 << 20  # a PARAM.SFO is a few KB; one bigger than this is not one
STUB_NAME_BYTES = 180  # a stub name's TITLE part, in UTF-8 BYTES: name + suffixes must fit NAME_MAX
PSN_LOCK = ENV.get("RETROFORGE_PSN_LOCK",
                   os.path.join(ENV.get("XDG_RUNTIME_DIR") or "/tmp", "retroforge-psn-install.lock"))
# retroforge-scrape's media folder (same env knob): a new card's box art is seeded here.
MEDIA_DIR = ENV.get("RETROFORGE_MEDIA_DIR", os.path.join(HOME, ".local/share/retroforge/media"))
SYSTEM_ID = re.compile(r"[a-z0-9_]+")
EMU_ID = re.compile(r"[a-z0-9_-]+")
DEFINITION_KEYS = {"format", "root", "binary", "args", "gui_args", "system_args", "system_settings", "env",
                   "seed", "sync", "install", "setup_args", "stub", "core_dumps", "exit_resend",
                   "gamepad_profile", "notes"}
# InputPlumber's bus name and composite-device interface (gamepad_profile, below). The daemon is
# system-bus; busctl comes from PATH so the offline tests can stand in for it.
IP_BUS_NAME = "org.shadowblip.InputPlumber"
IP_DEVICE_IFACE = "org.shadowblip.Input.CompositeDevice"
IP_DEVICE_PATH = re.compile(r"/org/shadowblip/InputPlumber/CompositeDevice\d+")
IP_DEFAULT_PROFILE = "/usr/share/inputplumber/profiles/default.yaml"
IP_TIMEOUT = 10  # s per busctl call: input must never hold a launch hostage
EXIT_RESEND_MAX = 30  # s: an exit_resend longer than this is a typo, not a plan
SCRIPT_SHELL = "/bin/bash"  # what a scripts-format game card's script runs with
ROM = "{rom}"
FILE = "{file}"
SYSTEM = "{system}"
TEXT = "{text}"  # in a stub template: the stub file's first line
# A stub's game id: strictly ASCII letters, digits and underscore (PSN title ids are [A-Z]{4}[0-9]{5}),
# so an id can never carry a path (/, ..), an option (-x) or control characters into the command line.
STUB_ID = re.compile(r"[A-Za-z0-9_]{1,64}")


class Exit(Exception):
    """Stop with this status and message (stderr)."""

    def __init__(self, code, msg):
        super().__init__(msg)
        self.code = code


def log(msg):
    print(f"retroforge-launch: {msg}", file=sys.stderr, flush=True)


# ---------------------------------------------------------------------------------- invocation --

def parse_args(argv):
    """-> (system or None, rom or None, emulator or None)."""
    if len(argv) != 2:
        raise Exit(2, USAGE)
    if argv[0] == "--gui":
        if not EMU_ID.fullmatch(argv[1]):
            raise Exit(2, f"bad emulator name '{argv[1]}'")
        return None, None, argv[1]
    system, rom = argv
    if not SYSTEM_ID.fullmatch(system):
        raise Exit(2, f"bad system name '{system}'")
    if not (os.path.isfile(rom) or os.path.isdir(rom)):  # a folder: a PS3 disc dump
        raise Exit(2, f"no such ROM: {rom}")
    return system, rom, None


def launch_map():
    """launch.conf as {system: emulator}; the last `<system>=<emulator>` line of a system wins."""
    found = {}
    try:
        with open(LAUNCH_CONF, errors="replace") as f:
            for line in f:
                m = re.fullmatch(r"([a-z0-9_]+)=([a-z0-9_-]*)\s*", line.rstrip("\n"))
                if m:
                    found[m.group(1)] = m.group(2)
    except OSError:
        pass
    return found


def emulator_for(system):
    found = launch_map().get(system)
    if not found:
        raise Exit(2, f"no emulator for system '{system}' in {LAUNCH_CONF}")
    return found


def systems_of(emulator):
    """The systems launch.conf gives an emulator, sorted (its "{system}" settings folders)."""
    return sorted(s for s, e in launch_map().items() if e == emulator)


# ---------------------------------------------------------------------------------- definition --

def clean_str(value):
    """A string a command line or environment can carry (no NUL, encodable)."""
    if not isinstance(value, str) or "\0" in value:
        return False
    try:
        value.encode()
    except UnicodeEncodeError:
        return False
    return True


def safe_relative(path):
    """A file path under some root: relative, normalised (no '..', '.', '//' or trailing '/')."""
    return (clean_str(path) and path not in ("", ".") and not path.startswith("/")
            and os.path.normpath(path) == path and ".." not in path.split("/"))


def str_list(value):
    return isinstance(value, list) and all(clean_str(v) for v in value)


def load_definition(emulator):
    path = os.path.join(EMU_DATA_DIR, emulator, "emulator.json")
    try:
        with open(path) as f:
            d = json.load(f)
    except FileNotFoundError:
        raise Exit(2, f"missing {path}") from None
    except (OSError, ValueError) as err:
        raise Exit(2, f"{path} is not readable JSON: {err}") from None

    def bad(why):
        return Exit(2, f"{path}: {why}")

    if not isinstance(d, dict):
        raise bad("not a JSON object")
    unknown = set(d) - DEFINITION_KEYS
    if unknown:
        raise bad(f"unknown keys {sorted(unknown)} (a definition is data; new behaviour is a format)")
    if not isinstance(d.get("format"), str) or d["format"] not in FORMATS:
        raise bad(f"format {d.get('format')!r} is not one of {sorted(FORMATS)}")
    if (d["format"] == "scripts") != ("root" in d) or ("root" in d and not safe_relative(d["root"])):
        raise bad("root (a relative folder under $HOME, without '..') is required for the scripts "
                  "format and only for it")
    if not safe_relative(d.get("binary")):
        raise bad("binary must be a relative path inside the download, without '..'")
    if d["format"] == "binary" and d["binary"] != "current":
        # The download IS the program, and the not-installed check looks at `current`: any other
        # name would pass that check and then fail to start.
        raise bad('a binary definition runs the download itself: binary must be "current"')
    args = d.get("args")
    if not str_list(args) or args.count(ROM) != 1:
        raise bad(f'args must be a list of strings holding "{ROM}" exactly once')
    gui_args = d.get("gui_args", [])
    if not str_list(gui_args) or ROM in gui_args or any(SYSTEM in a for a in gui_args):
        raise bad(f'gui_args must be a list of strings without "{ROM}" or "{SYSTEM}" (no game, no system)')
    system_args = d.get("system_args", {})
    if not (isinstance(system_args, dict)
            and all(isinstance(k, str) and SYSTEM_ID.fullmatch(k) and str_list(v) and ROM not in v
                    for k, v in system_args.items())):
        raise bad(f'system_args must map system names to lists of strings without "{ROM}"')
    system_settings = d.get("system_settings", [])
    if not (isinstance(system_settings, list) and all(system_settings_entry_ok(s) for s in system_settings)):
        raise bad('system_settings entries must be {"file": <path under $HOME>, "format": <one of '
                  f'{", ".join(emuopts.FORMATS)}>[, "separator": "=" with optional spaces, ini/toml only], '
                  '"set": [{"section", "key", "value": one-line strings, key not empty}, ...]}, '
                  f'without "{ROM}"')
    env = d.get("env", {})
    if not (isinstance(env, dict)
            and all(isinstance(k, str) and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", k)
                    and clean_str(v) for k, v in env.items())):
        raise bad("env must map variable names to strings")
    seed, sync = d.get("seed", []), d.get("sync", [])
    for key, entries in (("seed", seed), ("sync", sync)):
        # A seed may name another file for dual-screen boards (device-env declares a second panel).
        allowed = ({"file", "to"}, {"file", "to", "dual_screen_file"}) if key == "seed" else ({"file", "to"},)
        if not (isinstance(entries, list)
                and all(isinstance(s, dict) and set(s) in allowed
                        and safe_relative(s["file"]) and safe_relative(s["to"])
                        and safe_relative(s.get("dual_screen_file", "x")) for s in entries)):
            raise bad(f'{key} entries must be {{"file": <in the image>, "to": <path under $HOME>}}'
                      + (', optionally "dual_screen_file": <in the image>' if key == "seed" else "")
                      + ", all relative without '..'")
    install = d.get("install", [])
    if not (isinstance(install, list)
            and all(isinstance(i, dict) and set(i) == {"from", "unless", "args"}
                    and safe_relative(i["from"]) and safe_relative(i["unless"])
                    and not re.search(r"\s", i["from"] + i["unless"])
                    and str_list(i["args"]) and i["args"].count(FILE) == 1 and ROM not in i["args"]
                    and not any(SYSTEM in a for a in i["args"])
                    for i in install)):
        # No whitespace: `from` goes into the space-separated status line the plugin splits.
        raise bad('install entries must be {"from": <path under $HOME>, "unless": <path under $HOME>, '
                  f'"args": [... "{FILE}" once, no "{ROM}" or "{SYSTEM}" ...]}}, paths relative, '
                  "without '..' or whitespace")
    setup_args = d.get("setup_args", [])
    if not str_list(setup_args) or any(p in setup_args for p in (ROM, FILE)) \
            or any(SYSTEM in a for a in setup_args):
        raise bad(f'setup_args must be a list of strings without "{ROM}", "{FILE}" or "{SYSTEM}" '
                  "(a setup run has no game)")
    stub = d.get("stub", {})
    if not (isinstance(stub, dict)
            and all(isinstance(k, str) and re.fullmatch(r"[a-z0-9]+", k)
                    and clean_str(v) and v.count(TEXT) == 1 and ROM not in v and SYSTEM not in v
                    for k, v in stub.items())):
        raise bad(f'stub must map ROM extensions (lowercase, no dot) to strings holding "{TEXT}" '
                  f'exactly once, without "{ROM}" or "{SYSTEM}"')
    if stub and d["format"] == "scripts":
        raise bad("stub is for emulators, not the scripts format (a scripts ROM is run, not passed)")
    core_dumps = d.get("core_dumps", True)
    if not isinstance(core_dumps, bool):
        raise bad("core_dumps must be true or false")
    gamepad_profile = d.get("gamepad_profile")
    if gamepad_profile is not None and not safe_relative(gamepad_profile):
        raise bad("gamepad_profile must be a relative path next to this file, without '..'")
    exit_resend = d.get("exit_resend")
    if exit_resend is not None and not (isinstance(exit_resend, (int, float)) and not isinstance(exit_resend, bool)
                                        and 0 < exit_resend <= EXIT_RESEND_MAX):
        raise bad(f"exit_resend must be a number of seconds, more than 0 and at most {EXIT_RESEND_MAX}")
    return {"format": d["format"], "root": d.get("root"), "binary": d["binary"], "args": args, "gui_args": gui_args,
            "system_args": system_args, "system_settings": system_settings, "env": env, "seed": seed,
            "sync": sync, "install": install, "setup_args": setup_args, "stub": stub, "core_dumps": core_dumps,
            "exit_resend": exit_resend, "gamepad_profile": gamepad_profile}


def system_settings_entry_ok(s):
    """One system_settings entry: a file under $HOME in a format emuopts patches, and the one-line
    settings to write there. No "{rom}": a ROM path belongs on the command line only."""
    if not (isinstance(s, dict) and {"file", "format", "set"} <= set(s) <= {"file", "format", "separator", "set"}):
        return False
    if not (safe_relative(s["file"]) and s["format"] in emuopts.FORMATS and isinstance(s["set"], list) and s["set"]):
        return False
    if "separator" in s and not (s["format"] in emuopts.LINE_FORMATS and clean_str(s["separator"])
                                 and "\n" not in s["separator"] and s["separator"].strip() == "="):
        return False
    return all(isinstance(a, dict) and set(a) == {"section", "key", "value"}
               and all(clean_str(a[k]) and "\n" not in a[k] and ROM not in a[k] for k in a)
               and a["key"].strip() for a in s["set"])


def apply_system_settings(emulator, entries, system):
    """Write each entry's settings for this game's system ("{system}" in the file and the values)."""
    for s in entries:
        path = os.path.join(HOME, s["file"].replace(SYSTEM, system))
        edits = [(a["section"], a["key"], a["value"].replace(SYSTEM, system)) for a in s["set"]]
        try:
            emuopts.patch_file(path, s["format"], edits, s.get("separator", "="))
        except emuopts.FILE_ERRORS as err:
            log(f"warning: {emulator}: could not write {system}'s settings to {path}: {err}")


def device_field(name):
    """One of device-env's RETROFORGE_* fields, unquoted; "" when unset or device-env cannot run."""
    try:
        out = subprocess.run([DEVICE_ENV], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return ""
    m = re.search(rf"^{name}=(.*)$", out, re.M)
    return m.group(1).strip("'\"") if m else ""


def dual_screen():
    """Whether the board has a second panel: device-env's RETROFORGE_SECONDARY_CONNECTOR is set."""
    return bool(device_field("RETROFORGE_SECONDARY_CONNECTOR"))


def gpu_priority_env():
    """The emulator's GPU priority environment (header: GPU priority)."""
    if device_field("RETROFORGE_SOC_CLASS") not in PREEMPTING_SOCS:
        return {}
    return {"RETROFORGE_GAME_LOWPRIO": "1", "TU_AUTOTUNE_FLAGS": "preempt_optimize"}


def turnip_heap_mib():
    """Turnip's own heap in MiB (15/16 of MemTotal); None when /proc/meminfo cannot say."""
    try:
        with open(MEMINFO) as f:
            m = re.search(r"^MemTotal:\s+(\d+) kB$", f.read(), re.M)
    except OSError:
        return None
    return int(m.group(1)) / 1024 * TURNIP_HEAP_SHARE if m else None


def vram_limit_env():
    """The emulator's VRAM report limit environment (header: VRAM report limit)."""
    heap = turnip_heap_mib()
    if heap is None or heap <= VRAM_REPORT_LIMIT_MIB:
        return {}
    device_id = device_field("RETROFORGE_GPU_CHIP_ID")
    if not device_id:
        return {}
    return {"ENABLE_MESA_VRAM_REPORT_LIMIT": "1", "VK_VRAM_REPORT_LIMIT_HEAP_SIZE": str(VRAM_REPORT_LIMIT_MIB),
            "VK_VRAM_REPORT_LIMIT_DEVICE_ID": device_id}


def seed_first_run(emulator, seed):
    # Ask device-env only when a seed has a dual-screen variant.
    variants = [s for s in seed if "dual_screen_file" in s]
    board = ("dual" if dual_screen() else "single") if variants else None
    seeded = set()
    for s in seed:
        dst = os.path.join(HOME, s["to"])
        if os.path.lexists(dst):
            continue
        dual = board == "dual" and "dual_screen_file" in s
        src = os.path.join(EMU_DATA_DIR, emulator, s["dual_screen_file"] if dual else s["file"])
        if not os.path.isfile(src):
            raise Exit(2, f"{emulator}'s emulator.json seeds {src}, which the image does not have")
        try:
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copyfile(src, dst)
        except OSError as err:
            raise Exit(2, f"could not seed {dst}: {err}") from None
        seeded.add(s["to"])
        log(f"first run of {emulator}: seeded {dst}{' (dual-screen board)' if dual else ''}")
    if variants:
        follow_board(emulator, [s for s in variants if s["to"] not in seeded], board)


def follow_board(emulator, entries, board):
    """A home seeded on a board with the other panel count (the card moved): this board's layout."""
    marker = os.path.join(SEED_BOARD_DIR, emulator)
    try:
        with open(marker) as f:
            recorded = f.read().strip()
    except OSError:
        recorded = None
    for s in entries:
        dst = os.path.join(HOME, s["to"])
        if os.path.islink(dst) or not os.path.isfile(dst):
            continue
        try:
            layout = layout_settings(os.path.join(EMU_DATA_DIR, emulator, s["file"]),
                                     os.path.join(EMU_DATA_DIR, emulator, s["dual_screen_file"]))
            was = recorded if recorded in ("single", "dual") else seeded_board(dst, layout)
            if was in (None, board):
                continue
            emuopts.write_atomic(dst, switch_layout(dst, layout, board).encode())
        except (OSError, UnicodeError) as err:
            log(f"warning: {emulator}: could not switch {dst} to the {board}-screen layout: {err}")
            continue
        log(f"{emulator}: {dst} was set up on a {was}-screen board: {board}-screen layout")
    if recorded != board:
        try:
            emuopts.write_atomic(marker, f"{board}\n".encode())
        except OSError as err:
            log(f"warning: {emulator}: could not record the {board}-screen seed in {marker}: {err}")


# INI and melonDS's TOML alike: "[section]" headers, "key = value" lines (spaces optional).
SECTION_LINE = re.compile(r"\s*\[([^\]]+)\]\s*$")
SETTING_LINE = re.compile(r"\s*([^\s=#;\[][^=]*?)\s*=\s*(.*?)\s*$")


def settings(path):
    """{(section, key): (value, line)} of a settings file; the first of a repeated key."""
    found, section = {}, ""
    with open(path, encoding="utf-8") as f:
        for line in f.read().splitlines():
            if m := SECTION_LINE.match(line):
                section = m.group(1).strip()
            elif m := SETTING_LINE.match(line):
                found.setdefault((section, m.group(1)), (m.group(2), line))
    return found


def layout_settings(single_file, dual_file):
    """{(section, key): {"single": line | None, "dual": line | None}} for every setting the two
    seed variants disagree on (missing from one: None, the emulator's default)."""
    single, dual = settings(single_file), settings(dual_file)
    return {k: {"single": single[k][1] if k in single else None, "dual": dual[k][1] if k in dual else None}
            for k in single.keys() | dual.keys()
            if (single.get(k) or (None,))[0] != (dual.get(k) or (None,))[0]}


def seeded_board(path, layout):
    """Which variant's layout the file holds, or None (neither: the player's own). A setting a
    variant leaves out matches anything: the emulator may have written its default back."""
    have = {k: v[0] for k, v in settings(path).items()}
    for board in ("single", "dual"):
        if all(v[board] is None or have.get(k) == SETTING_LINE.match(v[board]).group(2)
               for k, v in layout.items()):
            return board
    return None


def switch_layout(path, layout, board):
    """The file's text with each layout setting as the board's seed has it: replaced in place,
    added at the end of its section (a new section at the end), or removed (None)."""
    with open(path, encoding="utf-8") as f:
        lines = f.read().splitlines()
    out, ends, done, section = [], {}, set(), ""
    for line in lines:
        if m := SECTION_LINE.match(line):
            section = m.group(1).strip()
        elif (m := SETTING_LINE.match(line)) and (k := (section, m.group(1))) in layout:
            if k not in done and layout[k][board] is not None:
                out.append(layout[k][board])
            done.add(k)
            ends[section] = len(out)
            continue
        out.append(line)
        if line.strip():
            ends[section] = len(out)
    missing = {}
    for k, v in sorted(layout.items()):
        if k not in done and v[board] is not None:
            missing.setdefault(k[0], []).append(v[board])
    # Insert from the bottom up so the recorded section ends stay valid.
    for sec in sorted((s for s in missing if s in ends), key=ends.get, reverse=True):
        out[ends[sec]:ends[sec]] = missing[sec]
    for sec in (s for s in missing if s not in ends):
        out += ([""] if out and out[-1].strip() else []) + [f"[{sec}]"] + missing[sec]
    return "\n".join(out) + "\n"


def sync_files(emulator, sync):
    """RetroForge's own files (sync above): the image's copy, whenever the one under $HOME differs."""
    for s in sync:
        src = os.path.join(EMU_DATA_DIR, emulator, s["file"])
        dst = os.path.join(HOME, s["to"])
        try:
            with open(src, "rb") as f:
                want = f.read()
            try:
                with open(dst, "rb") as f:
                    if f.read() == want:
                        continue
            except OSError:
                pass
            emuopts.write_atomic(dst, want)
            log(f"{emulator}: updated {dst}")
        except OSError as err:
            log(f"warning: {emulator}: could not place {dst}: {err}")


# -------------------------------------------------------------------------------------- CPUs --

def read_text(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return None


def fast_cpus():
    """Online CPUs above the smallest online capacity, as a taskset list; "" when there are none."""
    online = read_text(os.path.join(CPU_ROOT, "online"))
    if not online:
        return ""
    cpus = []
    for part in online.split(","):
        lo, _, hi = part.partition("-")
        if lo.isdigit() and (hi == "" or hi.isdigit()):
            cpus.extend(range(int(lo), int(hi or lo) + 1))
    caps = {}
    for c in cpus:
        cap = read_text(os.path.join(CPU_ROOT, f"cpu{c}", "cpu_capacity"))
        if cap and cap.isdigit():
            caps[c] = int(cap)
    if not caps:
        return ""
    low = min(caps.values())
    return ",".join(str(c) for c in sorted(caps) if caps[c] > low)


# ----------------------------------------------------------------------------------- formats --

def fusermount(*args):
    """fusermount3 <args>: True when it succeeded. A missing or failing helper never stops us."""
    try:
        return subprocess.run(["fusermount3", *args], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, check=False).returncode == 0
    except OSError as err:
        log(f"fusermount3 {' '.join(args)}: {err}")
        return False


def read_line(fd, timeout):
    """The first line written to fd within timeout s ("" on timeout or EOF). Raw reads: a
    buffered readline() would block past the deadline on a partial line."""
    deadline, data = time.monotonic() + timeout, b""
    while b"\n" not in data:
        left = deadline - time.monotonic()
        if left <= 0 or not select.select([fd], [], [], left)[0]:
            return ""
        chunk = os.read(fd, 4096)
        if not chunk:
            break
        data += chunk
    return data.split(b"\n", 1)[0].decode(errors="replace").strip()


def mount_table():
    try:
        with open(MOUNTS) as f:
            return [line.split() for line in f]
    except OSError:
        return []


class AppImage:
    """An AppImage, mounted for the run (`<image> --appimage-mount`), its binary run from the mount."""

    def __init__(self, emulator, image):
        self.emulator, self.image = emulator, image
        self.runtime = None
        self.mnt = None

    def sweep_stale(self):
        # A mount of OUR AppImage: the classic runtime names its FUSE filesystem after the file
        # `current` points at (type fuse.<file>); pkgforge-dev's runtime serves it with a separate
        # dwarfs process (type fuse.dwarfs, source = the AppImage's path), which outlives a killed
        # launcher and runtime and keeps the mount (HW 2026-10-05).
        real = os.path.realpath(self.image)
        fstype = "fuse." + os.path.basename(real)
        for fields in mount_table():
            if len(fields) > 2 and (fields[2] == fstype or fields[0] == real):
                log(f"releasing stale mount {fields[1]}")
                fusermount("-uz", fields[1])

    def prepare(self):
        """Mount; -> the root the definition's binary is relative to. Exit(3) when it fails."""
        self.sweep_stale()
        # The runtime must start with SIGTERM ignored (it keeps that disposition across exec);
        # the launcher's own no-op handler goes back right after, so it never dies of one either.
        handler = signal.signal(signal.SIGTERM, signal.SIG_IGN)
        try:
            self.runtime = subprocess.Popen([self.image, "--appimage-mount"],
                                            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE)
        except OSError as err:
            raise Exit(3, f"{self.image} did not mount: {err}") from None
        finally:
            signal.signal(signal.SIGTERM, handler)
        deadline = time.monotonic() + MOUNT_TIMEOUT
        line = read_line(self.runtime.stdout.fileno(), MOUNT_TIMEOUT)
        if not line:
            raise Exit(3, f"{self.image} did not mount")
        self.mnt = line
        # RPCS3's runtime (DwarFS) prints the mount point before its filesystem is up: wait for the
        # mount itself, not just the line (it failed 9 ms in otherwise, HW 2026-10-07 Pocket FIT).
        while not (self.mounted() and os.path.isdir(line)):
            if time.monotonic() > deadline or self.runtime.poll() is not None:
                raise Exit(3, f"{self.image} did not mount at {line}")
            time.sleep(0.05)
        return self.mnt

    def env(self):
        return {}

    def mounted(self):
        return any(len(fields) > 1 and fields[1] == self.mnt for fields in mount_table())

    def release(self):
        """Undo prepare(), however far it got. Never raises: the emulator's status must survive."""
        if not self.runtime:
            return
        if self.mnt is None:  # the mount never came up
            self.runtime.kill()
            return
        try:
            self.runtime.send_signal(signal.SIGHUP)
        except ProcessLookupError:
            pass
        for _ in range(UNMOUNT_TRIES):
            if not self.mounted() or fusermount("-u", self.mnt):
                break
            time.sleep(0.1)
        if self.mounted():
            log(f"{self.mnt} still busy; the next launch sweeps it")


class SharunAppImage(AppImage):
    """pkgforge-dev's "anylinux" AppImages (Dolphin, Snes9x, Azahar, ...; PPSSPP's official one is
    built with the same tooling): a sharun bundle with its own loader, libraries and Mesa. Two
    things its AppRun would do, which we never run (one of its hooks is a self-updater that would
    replace the pinned AppImage):

    - Paths the program hardcodes (Dolphin's data dir, holding Sys: fonts, per-game settings) are
      rewritten to random /tmp/<name> paths that bin/01-path-mapping-hardcoded.hook links to the
      mounted bin, lib or share. We make the same links, reading the hook as data: only
      `_tmp_<dir>=<letters>` lines. Without them Dolphin 2609 ran with no Sys folder ("Trying to
      access Windows-1252 fonts", HW 2026-10-05).
    - Vulkan: sharun points the loader at the bundled drivers unless SHARUN_ALLOW_SYS_VKICD=1. Every
      emulator runs on the image's Turnip (Dolphin 2609 bundles an older Mesa).

    The self-updater hook never runs here (only AppRun sources hooks, and it also needs $APPIMAGE,
    which only the runtime sets for AppRun); DISABLE_AUTO_UPDATES=1, the hook's own off switch,
    keeps it off should a later build run its hooks some other way: RetroForge pins every version.
    """

    # The hook's name depends on the build tooling's age: PPSSPP's own anylinux build ships it as a
    # .src.hook (sourced by AppRun), pkgforge-dev's repackagings as a plain .hook. Same content.
    HOOKS = ("bin/01-path-mapping-hardcoded.hook", "bin/01-path-mapping-hardcoded.src.hook")
    HOOK_LINE = re.compile(r'_tmp_(bin|lib|share)="?([A-Za-z0-9]+)"?')

    def __init__(self, emulator, image):
        super().__init__(emulator, image)
        self.links = []

    def prepare(self):
        root = super().prepare()
        self.link_hardcoded_paths(root)
        return root

    def link_hardcoded_paths(self, root):
        lines = []
        for hook in self.HOOKS:
            try:
                with open(os.path.join(root, hook), errors="replace") as f:
                    lines = f.read().splitlines()
                break
            except OSError:
                continue
        for line in lines:
            m = self.HOOK_LINE.fullmatch(line)
            if m:
                self.link(os.path.join(TMP_LINK_DIR, m.group(2)), os.path.join(root, m.group(1)))

    def link(self, link, target):
        # /tmp is shared: only ever replace an entry of our own, and only a symlink.
        try:
            st = os.lstat(link)
        except FileNotFoundError:
            st = None
        except OSError as err:
            log(f"cannot check {link}: {err}")
            return
        if st is not None and (not os.path.islink(link) or st.st_uid != os.getuid()):
            log(f"{link} exists and is not a link of ours: {self.emulator} runs without "
                f"{os.path.basename(target)} files from its download")
            return
        tmp = f"{link}.retroforge-{secrets.token_hex(8)}"
        try:
            os.symlink(target, tmp)
            os.replace(tmp, link)
            self.links.append((link, target))
        except OSError as err:
            log(f"could not link {link} to {target}: {err}")
            try:
                os.unlink(tmp)
            except OSError:
                pass

    def release(self):
        for link, target in self.links:  # ours, if no later launch took it over
            try:
                if os.readlink(link) == target:
                    os.unlink(link)
            except OSError:
                pass
        super().release()

    def env(self):
        return {"SHARUN_ALLOW_SYS_VKICD": "1", "VK_DRIVER_FILES": SYSTEM_VULKAN_ICD,
                "DISABLE_AUTO_UPDATES": "1"}


class Scripts:
    """A folder of scripts retroforge-emu unpacked under $HOME (PortMaster): nothing to mount; a game is
    a script of its own (see the scripts format above)."""

    runs_rom = True

    def __init__(self, emulator, root):
        self.emulator, self.root = emulator, root

    def prepare(self):
        return self.root

    def env(self):
        return {}

    def release(self):
        """Release every runtime mount the port `mount` stand-in recorded (see above). Never raises."""
        try:
            with open(PM_MOUNTS) as f:
                entries = [line.rstrip("\n").split("\t", 1)[0] for line in f if line.strip()]
        except OSError:
            return
        live = {fields[1].replace("\\040", " ") for fields in mount_table() if len(fields) > 1}
        for dst in dict.fromkeys(entries):
            if dst in live:
                log(f"releasing {dst}, left mounted by the port")
                try:
                    subprocess.run(["fusermount", "-u", "-z", dst], stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL, check=False)
                except OSError as err:
                    log(f"fusermount -u {dst}: {err}")
        try:
            open(PM_MOUNTS, "w").close()
        except OSError:
            pass


class Binary:
    """A download that is one plain executable (gopher64, until RMG replaced it): retroforge-emu names it <tag>.AppImage
    all the same, `current` points at it, and it runs in place. Nothing to mount or release: the
    definition's binary is `current` itself, relative to the emulator's folder."""

    runs_rom = False

    def __init__(self, emulator, image):
        self.emulator, self.image = emulator, image

    def prepare(self):
        return os.path.dirname(self.image)

    def env(self):
        return {}

    def release(self):
        pass


AppImage.runs_rom = False
FORMATS = {"appimage": AppImage, "appimage-sharun": SharunAppImage, "scripts": Scripts,
           "binary": Binary}


# ---------------------------------------------------------------------------------------- run --

def fail(reason, emulator, msg, detail=None):
    """An exit-3 failure the plugin reports to the player."""
    try:
        with open(STATUS, "w") as f:
            f.write(f"{reason} {emulator}{' ' + detail if detail else ''}\n")
    except OSError:
        pass
    raise Exit(3, msg)


def stub_boot_target(emulator, rom, stub):
    """A stub ROM's boot target (definition "stub", header): the stub's extension names a template,
    and the file's first line replaces "{text}" in it. Any other ROM is its own target. Only the
    emulator's command line gets the result: the stub path stays the game's identity (card name,
    per-game conf)."""
    template = stub.get(os.path.splitext(rom)[1][1:].lower()) if os.path.isfile(rom) else None
    if template is None:
        return rom
    try:
        # Strict UTF-8: a binary file (a stray .pkg, say) must be bad-stub, never mojibake RPCS3
        # is then started with. readline's cap bounds the read; a line past it fails STUB_ID.
        with open(rom, encoding="utf-8") as f:
            game_id = f.readline(128).strip()
    except (OSError, UnicodeDecodeError) as err:
        fail("bad-stub", emulator, f"cannot read the stub {rom}: {err}")
    if not STUB_ID.fullmatch(game_id):
        fail("bad-stub", emulator, f"{rom} must hold one game id on its first line")
    return template.replace(TEXT, game_id)


def missing_installs(emulator, install, is_game):
    """The install steps still to run; a game launch whose provided file is absent fails here."""
    todo = []
    for step in install:
        if os.path.exists(os.path.join(HOME, step["unless"])):
            continue
        if not os.path.isfile(os.path.join(HOME, step["from"])):
            if is_game:
                fail("missing-file", emulator, f"{emulator} needs ~/{step['from']} (not found)",
                     step["from"])
            log(f"{emulator}: ~/{step['from']} not found, skipping its install")
            continue
        todo.append(step)
    return todo


def run_installs(emulator, binary, env, todo, interrupted):
    for step in todo:
        src = os.path.join(HOME, step["from"])
        args = [src if a == FILE else a for a in step["args"]]
        log(f"{emulator}: installing ~/{step['from']}: {binary} {' '.join(args)}")
        try:
            # No core file: a one-time helper run, and RPCS3's installer aborts in a destructor
            # after a successful install; dumping its address space held the launch ~1 min
            # (HW 2026-10-07, Pocket FIT).
            rc = subprocess.run([binary] + args, env=env, start_new_session=True,
                                preexec_fn=no_core_dumps).returncode
        except (OSError, ValueError) as err:
            fail("install-failed", emulator, f"could not run {binary}: {err}")
        # OGUI's Exit reached the install (and us): the player left. Never start the game after
        # that, and leave no status: there is nothing to tell them. reap() signals leaves first, so
        # an install that ends on SIGTERM returns BEFORE our own signal arrives: give it a moment
        # (once per emulator, ever). How the installer itself ended says nothing about that: it
        # may crash on its way out after a good install, so only our own signals mean "Exit".
        deadline = time.monotonic() + INSTALL_SETTLE
        while not interrupted and time.monotonic() < deadline:
            time.sleep(0.05)
        if interrupted:
            raise Exit(128 + interrupted[0],
                       f"{emulator}: install of ~/{step['from']} interrupted; not starting the game")
        if not os.path.exists(os.path.join(HOME, step["unless"])):
            fail("install-failed", emulator,
                 f"installing ~/{step['from']} failed (exit {rc}, no ~/{step['unless']})")
        if rc != 0:
            log(f"{emulator}: the install of ~/{step['from']} ended with {rc}, but "
                f"~/{step['unless']} is there: installed")


def run_setup(emulator, binary, env, setup_args, interrupted):
    """The definition's setup run (setup_args above): the emulator's binary, before every start,
    waited for. A failure is a warning, never a blocked game: the emulator starts at worst as it
    would have without the step."""
    if not setup_args:
        return
    log(f"{emulator}: setup: {binary} {' '.join(setup_args)}")
    try:
        rc = subprocess.run([binary] + setup_args, env=env, start_new_session=True,
                            preexec_fn=no_core_dumps, timeout=SETUP_TIMEOUT).returncode
    except subprocess.TimeoutExpired:
        log(f"warning: {emulator}: the setup run did not finish in {SETUP_TIMEOUT} s")
    except (OSError, ValueError) as err:
        log(f"warning: {emulator}: could not run the setup: {err}")
    else:
        if rc != 0:
            log(f"warning: {emulator}: the setup run ended with {rc}")
    # OGUI's Exit reached the setup run (and us): the player left; never start the game after that.
    if interrupted:
        raise Exit(128 + interrupted[0], f"{emulator}: interrupted during setup; not starting")


def no_core_dumps():
    """In the emulator's child, before exec: no core file (core_dumps false)."""
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))


# ------------------------------------------------------------ gamepad profile (gamepad_profile) --
# The definition's InputPlumber device profile (the Guide-modifier hotkey layer), loaded into
# every composite device for the run and put back afterwards. ALL OF IT IS BEST-EFFORT: no
# InputPlumber (offline tests, a dev box), no busctl, a refused profile — the game still starts,
# only without hotkeys, and one line says so. OpenGamepadUI's own per-game profile machinery
# (settings_manager "gamepad_profile") is not used: it expects OGUI-made JSON profiles, and its
# reset-to-global on focus change has never been seen to fire on these boards.

def busctl(*args):
    """busctl --system <args>: stdout on success, None on any failure (and a log line)."""
    try:
        out = subprocess.run(["busctl", "--system", *args],
                             capture_output=True, text=True, timeout=IP_TIMEOUT)
    except (OSError, subprocess.SubprocessError) as err:
        log(f"gamepad profile: busctl {args[0]} failed: {err}")
        return None
    if out.returncode != 0:
        log(f"gamepad profile: busctl {' '.join(args)}: {out.stderr.strip() or out.returncode}")
        return None
    return out.stdout


def composite_devices():
    """InputPlumber's composite devices (DBus object paths); [] when the daemon is not there."""
    out = busctl("tree", "--list", IP_BUS_NAME)
    if out is None:
        return []
    return [line for line in map(str.strip, out.splitlines()) if IP_DEVICE_PATH.fullmatch(line)]


def device_profile(device):
    """The profile path a composite device has loaded ('' for none), or None when unreadable."""
    out = busctl("get-property", IP_BUS_NAME, device, IP_DEVICE_IFACE, "ProfilePath")
    if out is None:
        return None
    found = re.fullmatch(r'\s*s\s+"(.*)"\s*', out)
    return found.group(1) if found else None


def apply_gamepad_profile(emulator, name):
    """Load the definition's profile everywhere. Returns what the restore must put back:
    (device, previous profile) pairs — the device's own previous profile, except when that is
    already OURS (a launcher killed between load and restore left it behind): then the shipped
    default, or restoring would make the leftover permanent."""
    if name is None:
        return []
    profile = os.path.join(EMU_DATA_DIR, emulator, name)
    if not os.path.isfile(profile):
        log(f"gamepad profile: {profile} is not in the image; no hotkeys")
        return []
    restore = []
    for device in composite_devices():
        previous = device_profile(device)
        if not previous or os.path.realpath(previous) == os.path.realpath(profile):
            previous = IP_DEFAULT_PROFILE
        if busctl("call", IP_BUS_NAME, device, IP_DEVICE_IFACE,
                  "LoadProfilePath", "s", profile) is not None:
            restore.append((device, previous))
    if restore:
        log(f"gamepad profile {name}: loaded on {len(restore)} composite device(s)")
    return restore


def restore_gamepad_profiles(restore):
    for device, previous in restore:
        busctl("call", IP_BUS_NAME, device, IP_DEVICE_IFACE, "LoadProfilePath", "s", previous)


# --------------------------------------------------------------------- PSN inbox (--psn-install) --

def try_psn_lock():
    """The one-RPCS3-at-a-time lock (header): taken by --psn-install AND by a ps3 game launch —
    they share one dev_hdd0, and two RPCS3s do not fit in a handheld's RAM. Returns the lock file
    HELD (the caller keeps it referenced and hands its fd to the RPCS3 it starts via pass_fds, so
    the flock — owned by the open file description — survives even a SIGKILLed launcher for as
    long as either process lives), or None when the other side has it. A broken lock PATH raises
    the OSError instead: that is a system problem, not contention, and each caller words it
    honestly (a launch proceeds unguarded, the installer refuses)."""
    lock = open(PSN_LOCK, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as err:
        lock.close()
        if err.errno == errno.EWOULDBLOCK:
            return None
        raise
    return lock


def pkg_title_id(path):
    """The title id from a retail .pkg header (magic \\x7fPKG, the content id at 0x30, the title id
    its chars 7..15: UP0001-NPUB30024_00-... -> NPUB30024), or None when the file is no package."""
    try:
        with open(path, "rb") as f:
            header = f.read(0x60)
    except OSError:
        return None
    if len(header) < 0x60 or header[:4] != b"\x7fPKG":
        return None
    title_id = header[0x37:0x40].decode("ascii", "replace")
    return title_id if re.fullmatch(r"[A-Z0-9]{9}", title_id) else None


def sfo_values(path):
    """PARAM.SFO's string entries as {key: value}, {} when it is unreadable or no SFO. The format
    is a small binary key/value table: index entries of (key offset, format, length, max, data
    offset) after a 20-byte header; format 0x0204 is a NUL-terminated UTF-8 string."""
    try:
        with open(path, "rb") as f:
            data = f.read(SFO_MAX)
        if data[:4] != b"\0PSF":
            return {}
        key_start, data_start, count = struct.unpack_from("<III", data, 8)
        values = {}
        for i in range(count):
            key_off, fmt, length, _, data_off = struct.unpack_from("<HHIII", data, 20 + 16 * i)
            # The NUL search is capped: a crafted file must not cost a megabyte scan per entry.
            key_end = data.index(b"\0", key_start + key_off, key_start + key_off + 64)
            key = data[key_start + key_off:key_end].decode("utf-8", "replace")
            if fmt == 0x0204:
                raw = data[data_start + data_off:data_start + data_off + length]
                values[key] = raw.split(b"\0", 1)[0].decode("utf-8", "replace")
        return values
    except (OSError, ValueError, struct.error):
        return {}


def dev_hdd0_dir():
    """Where RPCS3 keeps the PS3's internal drive: vfs.yml's /dev_hdd0/ row (RetroForge's seed puts
    it in ~/saves/ps3/dev_hdd0; RPCS3 may rewrite the file with quotes or its $(EmulatorDir)
    placeholder, its own config folder), else RPCS3's default under that folder."""
    rpcs3_dir = os.path.join(CONFIG_HOME, "rpcs3")
    try:
        with open(os.path.join(rpcs3_dir, "vfs.yml"), errors="replace") as f:
            for line in f:
                if not line.startswith("/dev_hdd0/:"):
                    continue
                value = line.split(":", 1)[1].strip().strip("\"'")
                value = value.replace("$(EmulatorDir)", rpcs3_dir + "/")
                if value.startswith("/"):
                    return os.path.normpath(value)
    except OSError:
        pass
    return os.path.join(rpcs3_dir, "dev_hdd0")


def psn_stub_title(title, title_id):
    """PARAM.SFO's TITLE as a stub file name: no /, \\ or control characters, whitespace collapsed,
    no leading/trailing dots (a hidden file), truncated by UTF-8 BYTES so name + " (<id>)" +
    ".psn" (and write_atomic's temp suffix) stays under NAME_MAX; the title id when nothing usable
    is left."""
    name = re.sub(r"[\x00-\x1f\x7f/\\]", " ", title)
    name = re.sub(r"\s+", " ", name).strip(" .")
    name = name.encode()[:STUB_NAME_BYTES].decode("utf-8", "ignore")
    return name.rstrip(" .") or title_id


def psn_stub_for(title_id):
    """The .psn stub already holding this id (never rewritten), or None."""
    try:
        names = os.listdir(PSN_STUB_DIR)
    except OSError:
        return None
    for name in sorted(names):
        path = os.path.join(PSN_STUB_DIR, name)
        if not name.lower().endswith(".psn") or not os.path.isfile(path):  # isfile: a FIFO would hang
            continue
        try:
            with open(path, encoding="utf-8") as f:
                if f.readline(128).strip() == title_id:
                    return name
        except (OSError, UnicodeDecodeError):
            continue
    return None


def psn_write_stub(title_id, title):
    """A new stub for an installed game: ~/roms/ps3/<TITLE>.psn holding the id, " (<id>)" appended
    when another game took the name. -> the stub's file name."""
    base = psn_stub_title(title, title_id)
    for name in (f"{base}.psn", f"{base} ({title_id}).psn"):
        path = os.path.join(PSN_STUB_DIR, name)
        if os.path.lexists(path):
            continue  # another id's stub (this id's was looked up before): disambiguate
        emuopts.write_atomic(path, f"{title_id}\n".encode())
        return name
    # Both names taken and neither is this id's stub (psn_stub_for ran first): never report a
    # stranger's file as this game's card.
    raise OSError(f"{base} ({title_id}).psn exists and is not this game's stub")


PSN_ICON_MAX = 1 << 20  # an ICON0.PNG is tens of KB; bigger is not one
PSN_ICON_DIM = 2048  # sane pixel bound for a seeded box (IHDR claims beyond it are hostile)


def psn_seed_box(stub, game_dir):
    """The card's box art, seeded from the installed game's own ICON0.PNG (Sony mandates one; it
    is what the PS3's XMB shows). Digital-only titles often have no box scan on ScreenScraper,
    which left the card blank (RCR DX on the ACE, 2026-10-20). Only when no box exists yet: a
    fresh stub is still scraped in full (it has no scrape-cache entry), and a real box download
    then overwrites this seed. The icon comes out of a player-supplied pkg, so it is checked —
    size-capped, PNG signature, sane IHDR dimensions (the scraper treats any existing box as art,
    so a junk seed would silence a real one forever) — and landed with os.link, which never
    replaces an existing name: art racing in from the scraper wins. Art is COSMETIC: any failure
    is a log line, never a result line, never a failed install."""
    folder = os.path.join(MEDIA_DIR, PSN_SYSTEM)
    dest = os.path.join(folder, f"{stub}-box.png")
    try:
        if any(os.path.exists(os.path.join(folder, f"{stub}-box.{ext}")) for ext in ("png", "jpg")):
            return
        icon = os.path.join(game_dir, "ICON0.PNG")
        if not os.path.isfile(icon):
            return  # no icon: the scraper may still find a box
        if os.path.getsize(icon) > PSN_ICON_MAX:
            raise ValueError("bigger than an icon can be")
        with open(icon, "rb") as f:
            data = f.read(PSN_ICON_MAX)
        if data[:8] != b"\x89PNG\r\n\x1a\n" or len(data) < 24:
            raise ValueError("not a PNG")
        width, height = struct.unpack_from(">II", data, 16)
        if not (0 < width <= PSN_ICON_DIM and 0 < height <= PSN_ICON_DIM):
            raise ValueError(f"unreasonable dimensions {width}x{height}")
        os.makedirs(folder, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=folder, prefix=".box.")
        try:
            with os.fdopen(fd, "wb") as f:
                f.write(data)
            os.link(tmp, dest)
        finally:
            os.unlink(tmp)
        log(f"psn-install: {stub}: card art seeded from the game's ICON0.PNG")
    except FileExistsError:
        pass  # someone else's art landed between the check and the link: it wins
    except Exception as err:  # noqa: BLE001 — cosmetic by contract, whatever goes wrong
        log(f"psn-install: {stub}: could not seed card art from ICON0.PNG: {err}")


def fs_now_ns(dir_path):
    """The filesystem's idea of "now": a probe file's fresh mtime. File timestamps come from the
    kernel's coarse clock, which can lag time.time_ns() by milliseconds — a run-start stamp taken
    from the same clock keeps tree_changed from missing a file written right after the start."""
    try:
        fd, path = tempfile.mkstemp(dir=dir_path)
    except OSError:
        return time.time_ns()
    try:
        return os.fstat(fd).st_mtime_ns
    finally:
        os.close(fd)
        os.unlink(path)


def tree_changed(path, since_ns):
    """Whether anything under path (the dir itself, a subfolder, a file) is as new as since_ns:
    did THIS run's install touch the game dir? A stale install from an earlier run must never
    verify a re-dropped broken package."""
    for base, _dirs, files in os.walk(path):
        for entry in [base] + [os.path.join(base, f) for f in files]:
            try:
                if os.stat(entry).st_mtime_ns >= since_ns:
                    return True
            except OSError:
                continue
    return False


def result_safe(name):
    """A file name the tab-separated result lines (and the plugin's line split) can carry."""
    try:
        name.encode()
    except UnicodeEncodeError:  # undecodable bytes (surrogates): print would raise
        return False
    return name.isprintable()  # no tabs, newlines, \r, or other control/separator characters


def same_file_content(a, b):
    try:
        with open(a, "rb") as fa, open(b, "rb") as fb:
            return fa.read(SFO_MAX) == fb.read(SFO_MAX)  # licences are tiny
    except OSError:
        return False


def psn_install():
    """--psn-install (header): one headless `--installpkg <inbox>` run installs every package and
    licence the player dropped into ~/roms/ps3/psn/, then each file is verified on disk, a base
    game gets its .psn stub, and what succeeded is deleted — the inbox is consumed. One result line
    per file on stdout for the plugin; 0 when everything succeeded, 3 otherwise."""
    emulator = emulator_for(PSN_SYSTEM)
    definition = load_definition(emulator)
    if definition["root"] is not None:
        raise Exit(2, f"{emulator}: --psn-install needs an emulator, not the scripts format")
    image = installed = os.path.join(EMU_DIR, emulator, "current")
    if not os.access(installed, os.X_OK):
        raise Exit(3, f"{emulator} is not installed ({installed} missing or not executable)")
    # One RPCS3 at a time: two writing the same dev_hdd0 corrupt it, and two do not fit in RAM.
    # A running ps3 GAME holds this lock too (run()); the plugin also guards, but a double start
    # must be safe here. Held until this process exits (and by the RPCS3 below, via its fd).
    try:
        lock = try_psn_lock()
    except OSError as err:
        raise Exit(3, f"cannot take the PSN install lock: {err}") from None
    if lock is None:
        raise Exit(3, "a PSN install or a PlayStation 3 game is already running")
    try:
        names = sorted(os.listdir(PSN_INBOX))
    except OSError:
        names = []
    # A name the result lines cannot carry (control characters, undecodable bytes) is left alone.
    names = [n for n in names if result_safe(n) and os.path.isfile(os.path.join(PSN_INBOX, n))]
    pkgs = [n for n in names if n.lower().endswith(".pkg")]
    licences = [n for n in names if n.lower().endswith(PSN_LICENCES)]
    if not pkgs and not licences:
        print("nothing-to-do")
        return 0

    # The seed first: a first install must land dev_hdd0 where RetroForge's vfs.yml puts it.
    seed_first_run(emulator, definition["seed"])
    started_ns = fs_now_ns(PSN_INBOX)
    package = FORMATS[definition["format"]](emulator, image)
    try:
        try:
            root = package.prepare()
        except Exit as err:
            raise Exit(3, f"{emulator} could not start: {err}") from None
        binary = os.path.join(root, definition["binary"])
        inherited = {k: v for k, v in ENV.items() if k not in VRAM_REPORT_LIMIT_VARS}
        env = {**inherited, **package.env(), **definition["env"]}
        log(f"psn-install: {binary} --headless --installpkg {PSN_INBOX}")
        try:
            # No timeout: extracting a multi-GB package on the card takes minutes. RPCS3 exits 0
            # even on failure (like --installfw), so success is per file, on disk, below. Its own
            # output goes to the log, never onto the result lines the plugin parses.
            # The installer RPCS3 inherits the lock's fd (flock follows the open file
            # description): a SIGKILLed launcher then cannot free a game launch mid-extract.
            subprocess.run([binary, "--headless", "--installpkg", PSN_INBOX],
                           env=env, start_new_session=True, preexec_fn=no_core_dumps,
                           pass_fds=(lock.fileno(),),
                           stdin=subprocess.DEVNULL, stdout=sys.stderr)
        except (OSError, ValueError) as err:
            raise Exit(3, f"could not run {binary}: {err}") from None
    finally:
        package.release()

    hdd0 = dev_hdd0_dir()
    log(f"psn-install: dev_hdd0 at {hdd0}")
    failed = 0

    def consume(name):
        try:
            os.unlink(os.path.join(PSN_INBOX, name))
        except OSError as err:
            log(f"psn-install: could not consume {name}: {err}")

    for name in pkgs:
        title_id = pkg_title_id(os.path.join(PSN_INBOX, name))
        if title_id is None:
            log(f"psn-install: {name}: not a PSN package (no title id in its header)")
            print(f"failed\t{name}\t-\t-")
            failed += 1
            continue
        game_dir = os.path.join(hdd0, "game", title_id)
        sfo = sfo_values(os.path.join(game_dir, "PARAM.SFO"))
        # Installed = the game dir's PARAM.SFO is there and THIS run touched the dir (header: an
        # update or DLC may bring no EBOOT.BIN, and one id's packages verify collectively); only a
        # base game (HG) with its boot file makes a card.
        if not sfo or not tree_changed(game_dir, started_ns):
            log(f"psn-install: {name}: {game_dir} "
                + ("was not touched by this install" if sfo else "has no PARAM.SFO"))
            print(f"failed\t{name}\t{title_id}\t-")
            failed += 1
            continue
        stub = "-"
        if sfo.get("CATEGORY") == "HG" \
                and os.path.isfile(os.path.join(game_dir, "USRDIR", "EBOOT.BIN")):
            try:
                stub = psn_stub_for(title_id) or psn_write_stub(title_id, sfo.get("TITLE", ""))
            except OSError as err:
                log(f"psn-install: {name}: could not write the stub: {err}")
                print(f"failed\t{name}\t{title_id}\t-")
                failed += 1
                continue
            psn_seed_box(stub, game_dir)
        consume(name)
        print(f"ok\t{name}\t{title_id}\t{stub}")

    exdata = os.path.join(hdd0, "home", RPCS3_USER, "exdata")
    for name in licences:
        stem, ext = os.path.splitext(name)
        copy = os.path.join(exdata, stem + ext.lower())  # RPCS3 lowercases the extension
        if same_file_content(os.path.join(PSN_INBOX, name), copy):
            consume(name)
            print(f"ok\t{name}\t-\t-")
        else:
            log(f"psn-install: {name}: no identical copy in {exdata} after the install")
            print(f"failed\t{name}\t-\t-")
            failed += 1
    return 3 if failed else 0


def cpus_for(emulator_conf, game_conf):
    """The run's CPUS: the game's, else the emulator's, else all. A value that is neither big nor all
    is reported and skipped."""
    for name, conf in (("game", game_conf), ("emulator", emulator_conf)):
        if conf.get("CPUS", "big") not in emuopts.CPUS_VALUES:
            log(f"{name} conf: ignoring CPUS={conf['CPUS']} (want big or all)")
    return emuopts.cpus_choice(emulator_conf, game_conf)


def pinning(emulator, cpus):
    """`taskset -c <fast cpus>` when this run goes on the fast cores (cpus "big"), else []."""
    if cpus != "big":
        return []
    fast = fast_cpus()
    if not fast:
        log("no fast core online (core-count limit, or one core type): not pinning")
        return []
    log(f"pinning {emulator} to fast cores {fast}")
    return ["taskset", "-c", fast]


def player_confs(emulator, system, rom):
    """(the emulator's conf, the game's conf) as {key: value}; the game's is {} for --gui."""
    game = emuopts.read_conf(emuopts.game_conf_path(GAME_CONF_DIR, system, rom)) if rom is not None else {}
    return emuopts.read_conf(os.path.join(PLAYER_CONF_DIR, f"{emulator}.conf")), game


def load_options(emulator, definition):
    try:
        options = emuopts.load_options(EMU_DATA_DIR, emulator)
    except emuopts.OptionsError as err:
        raise Exit(2, str(err)) from None
    if options is not None and definition["format"] == "scripts":
        raise Exit(2, f"{emulator}: options.json is for emulators, not the scripts format")
    return options


def options_warning(emulator):
    return lambda msg: log(f"warning: {emulator}: {msg}")


def apply_options(emulator, options, confs, system):
    """Restore a journal a killed run left, then apply this run's choices: -> (args, env).
    `system` is None for --gui."""
    emuopts.restore(HOME, STATE_DIR, emulator, options_warning(emulator))
    if options is None:
        return [], {}
    return emuopts.apply(options, HOME, STATE_DIR, emulator, *confs, options_warning(emulator),
                         systems=systems_of(emulator), system=system)


def run(argv):
    if argv == ["--psn-install"]:
        return psn_install()
    system, rom, emulator = parse_args(argv)
    if emulator is None:
        emulator = emulator_for(system)
    definition = load_definition(emulator)
    if definition["root"] is not None:  # the scripts format: the unpacked folder itself
        image = os.path.join(HOME, definition["root"])
        installed = os.path.join(image, definition["binary"])
    else:
        image = installed = os.path.join(EMU_DIR, emulator, "current")
    if not os.access(installed, os.X_OK):
        fail("not-installed", emulator, f"{emulator} is not installed ({installed} missing or not executable)")
    # One RPCS3 at a time (header): a ps3 launch takes the installer's lock and HOLDS it until the
    # game exits, so --psn-install mid-game is refused and a launch mid-install fails readably
    # instead of two RPCS3s sharing dev_hdd0 and running the 8 GiB ACE out of memory. Do not drop
    # the psn_lock reference: the variable IS the lock's lifetime (plus the game's own, below).
    psn_lock = None
    if system == PSN_SYSTEM:
        try:
            psn_lock = try_psn_lock()
        except OSError as err:
            # A broken lock path must not brick every ps3 launch: the guard is best-effort here.
            log(f"cannot take the PSN lock ({err}): launching unguarded")
        else:
            if psn_lock is None:
                fail("psn-installing", emulator,
                     "a PSN install is running; launch again when it finishes")
    # One emulator can serve several systems (ClownMDEmu: md, segacd; armGBA: gb, gbc, gba) with
    # per-system folders, on its command line or in its settings file.
    # A stub ROM boots what its first line names (after the not-installed check: that message wins).
    boot = stub_boot_target(emulator, rom, definition["stub"]) if rom is not None else None
    args = ([boot if a == ROM else a.replace(SYSTEM, system)
             for a in definition["system_args"].get(system, []) + definition["args"]]
            if rom is not None else definition["gui_args"])
    seed_first_run(emulator, definition["seed"])
    sync_files(emulator, definition["sync"])
    if rom is not None:
        apply_system_settings(emulator, definition["system_settings"], system)
    todo = missing_installs(emulator, definition["install"], rom is not None)
    options = load_options(emulator, definition)
    confs = player_confs(emulator, system, rom)
    pin = pinning(emulator, cpus_for(*confs))

    # From here on, survive our own signals (OGUI's Exit reaches us too) and wait: never forward
    # them. Caught signals go back to default in the emulator at exec.
    interrupted = []  # signals seen: only the one-time install step acts on them
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, lambda signum, _: interrupted.append(signum))
    package = FORMATS[definition["format"]](emulator, image)
    profile_restore = []
    try:
        # Before the mount: the restore in `finally` must cover every way out from here on.
        opt_args, opt_env = apply_options(emulator, options, confs, system)
        args = opt_args + args
        try:
            root = package.prepare()
        except Exit as err:
            fail("mount-failed", emulator, str(err))
        binary = os.path.join(root, definition["binary"])
        inherited = {k: v for k, v in ENV.items() if k not in VRAM_REPORT_LIMIT_VARS}
        env = {**inherited, **gpu_priority_env(), **vram_limit_env(), **package.env(), **definition["env"],
               **opt_env}
        run_installs(emulator, binary, env, todo, interrupted)
        run_setup(emulator, binary, env, definition["setup_args"], interrupted)
        # Last before the start: nothing below but the start itself can fail, so the hotkey
        # layer is never left loaded over a launch that said no.
        profile_restore = apply_gamepad_profile(emulator, definition["gamepad_profile"])
        program = SCRIPT_SHELL if package.runs_rom and rom is not None else binary
        log(f"{system or 'gui'} -> {emulator}: {program} {' '.join(args)}")
        try:
            # Its own session; taskset execs, so the emulator keeps this PID and leads it. A ps3
            # game inherits the PSN lock's fd: flock follows the open file description, so the
            # lock outlives even a SIGKILLed launcher for as long as the game runs.
            emu = subprocess.Popen(pin + [program] + args, env=env, start_new_session=True,
                                   pass_fds=() if psn_lock is None else (psn_lock.fileno(),),
                                   preexec_fn=None if definition["core_dumps"] else no_core_dumps)
        except (OSError, ValueError) as err:
            fail("mount-failed", emulator, f"could not start {binary}: {err}")
        rc = wait_emulator(emu, definition["exit_resend"], interrupted)
        return 128 - rc if rc < 0 else rc
    finally:
        restore_gamepad_profiles(profile_restore)
        package.release()
        emuopts.restore(HOME, STATE_DIR, emulator, options_warning(emulator))


def wait_emulator(emu, resend_after, interrupted):
    """The emulator's exit status. With exit_resend: once a stop signal reached us (OGUI's Exit
    signals the whole tree) and the emulator still runs resend_after seconds later, it gets ONE
    more SIGTERM, and SIGKILL resend_after seconds after that; we stay to release the mount."""
    if not resend_after:
        return emu.wait()
    seen, since, escalation = len(interrupted), None, [(signal.SIGTERM, "one more SIGTERM"),
                                                       (signal.SIGKILL, "SIGKILL")]
    while True:
        try:
            return emu.wait(timeout=0.1)
        except subprocess.TimeoutExpired:
            pass
        if since is None:
            if len(interrupted) > seen:
                since = time.monotonic()
        elif escalation and time.monotonic() - since >= resend_after:
            sig, what = escalation.pop(0)
            log(f"the emulator still runs {resend_after} s after the stop: {what} (exit_resend)")
            try:
                emu.send_signal(sig)
            except ProcessLookupError:
                pass
            since = time.monotonic()


def main():
    try:
        os.unlink(STATUS)
    except OSError:
        pass
    try:
        return run(sys.argv[1:])
    except Exit as err:
        log(str(err))
        return err.code
    except Exception as err:  # a bug here must still end with a message, not a silent hang
        log(f"internal error: {type(err).__name__}: {err}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
