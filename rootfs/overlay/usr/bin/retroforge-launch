#!/usr/bin/env python3
# retroforge-launch — start a ROM in its system's emulator, from an OpenGamepadUI library card.
#
#   retroforge-launch <system> <rom>
#   retroforge-launch --gui <emulator>
#   retroforge-launch --psn-install
#
# --gui starts the emulator's own UI with no ROM: Main menu > Emulators > Open, for the settings OGUI
# does not expose. It runs exactly like a ROM (prepare, seed, own session, exit handling below),
# with the definition's gui_args in place of args.
#
# Emulators are not in the image: the RetroForge OGUI plugin downloads each one (retroforge-emu) into
# /home/player/emulators/<emulator>/ and points `current` at the version to run. This is what every
# ROM card runs. /etc/retroforge/launch.conf maps a system to its emulator (last `<system>=<emulator>`
# line wins); /usr/share/retroforge/emulators/<emulator>/emulator.json says how to run it -- DATA ONLY:
#
#   {"format": "appimage" | "appimage-sharun" | "scripts" | "binary",   how the download is
#                                                  packaged (FORMATS below)
#    "root": "roms/ports/PortMaster",              scripts only: the folder under $HOME retroforge-emu
#                                                  unpacked the download into
#    "binary": "usr/bin/x",                        the program inside it (relative, no '..')
#    "args": ["-batch", "--", "{rom}"],            a game's command line; "{rom}" exactly once,
#                                                  "{system}" (the card's system) anywhere in an arg
#    "gui_args": ["-bigpicture"],                  --gui's command line (no "{rom}")
#    "system_args": {"md": ["--system", "Mega Drive"]},  put before args when the card's system has
#                                                  an entry (one emulator, several systems it must
#                                                  be told about); "{system}" allowed
#    "system_settings": [{"file": ".config/x/x.cfg",  settings written into the emulator's own file
#                         "format": "ini", "separator": " = ",   before every GAME, "{system}" in the
#                         "set": [{"section": "", "key": "save_folder",   file and the values = the
#                                  "value": "/home/player/saves/{system}"}]}],  card's system (below)
#    "env": {"NAME": "value"},                     added to the emulator's environment
#    "gamepad_profile": "guide-hotkeys.yaml",      an InputPlumber device profile next to this
#                                                  file, loaded into every composite device for
#                                                  the run; whatever was loaded before is put
#                                                  back on exit (below)
#    "core_dumps": false,                          no core file when it crashes (default true; below)
#    "seed": [{"file": "x.ini", "to": ".config/x/x.ini"}],   first-run settings (below)
#    "sync": [{"file": "x.txt", "to": "roms/x/x.txt"}],      RetroForge's own files, kept current (below)
#    "install": [{"from": "bios/fw.bin",            a one-time step with the emulator's own binary
#                 "unless": ".config/x/fw/ok",       (below); paths under $HOME
#                 "args": ["--installfw", "{file}"]}],
#    "setup_args": ["--assign-controller", "1"],   run the emulator's binary with these arguments
#                                                  before EVERY start, game and --gui (below)
#    "stub": {"psn": "%RPCS3_GAMEID%:{text}"},     a ROM with this extension is a stub: a text file
#                                                  whose first line replaces "{text}", and the
#                                                  result replaces "{rom}" (below)
#    "notes": ["..."]}                             why, for people; ignored here
#
# Anything else in it, or a format this script does not know, is refused (exit 2): a definition that
# needs code is a new FORMAT here, never shell in the definition (plan Phase 4b, launcher redesign).
#
# CPU pinning (CPUS=big): the emulator is started on the device's fast cores, so its threads stay
# off the little cluster and do not migrate across clusters; background work (audio, input, Wi-Fi)
# keeps the little cores. "Fast" is every ONLINE CPU whose cpu_capacity is above the smallest online
# one — never a CPU number (Qualcomm numbers slowest-first, other SoCs do not), and never only the top
# tier (one prime core is no home for a multi-threaded emulator). PowerStation's core-count slider is
# the POWER control and offlines the fast cores first, so with none of them online, or on a
# homogeneous SoC, nothing is pinned. sched_ext schedulers (scx_lavd) honour the affinity mask (HW
# 2026-10-03). It is the PLAYER's choice, never the image's: a default per emulator (Settings >
# Emulators -> ~/.config/retroforge/emulators/<emulator>.conf, CPUS=big|all, also used by --gui) and an
# override per game (Game settings > RetroForge -> ~/.config/retroforge/games/<system>/<rom file>.conf,
# the same CPUS line). Nothing ships pinned: with neither, all cores.
#
# Per-emulator options (renderer, resolution, aspect...): /usr/share/retroforge/emulators/<emulator>/
# options.json says what each value does (command-line arguments, environment, settings in the
# emulator's own files); the player's choices are lines of the same two confs, the game's winning.
# emuopts (/usr/lib/retroforge/python) applies them before the start: an emulator-level value stays
# in the emulator's settings, a game-level one is put back when the emulator exits (and at the next
# launch, after a double Exit). Its header has the details.
#
# First-run settings (seed) live in the image next to emulator.json and are copied into $HOME before
# the emulator's first start — never over an existing file, so whatever the player changes in the
# emulator is kept. One set per emulator serves every device: InputPlumber presents each handheld's
# joypad as the same virtual pad. A seed with a dual_screen_file (melonDS, Azahar: the bottom screen
# in its own window, for the second panel) is the exception: /home is on the card, and a card moves
# between boards. Which variant was seeded is kept in ~/.config/retroforge/seed-board/<emulator>
# (single|dual); on a board of the other kind, only the settings the two variants disagree on are
# rewritten to this board's, the player's other changes kept. A home seeded before that record
# existed is judged by those settings: one variant's exactly, or left alone (the player's own).
#
# Per-system settings (system_settings): one emulator serving several systems that has ONE save or
# state folder, set only in its config file -- no flag, no -C (armGBA: gb, gbc, gba). Before every
# game, each entry's settings are written into its file (emuopts' patchers: ini/toml/yaml/xml/json,
# a missing file is created) with "{system}" in the file path and the values replaced by the card's
# system, so saves land in ~/saves/<system> as the shared layout says. Never for --gui (Open has no
# system): the file keeps the last game's values, or the seed's. A setting the player changes in the
# emulator's own menu is put back at the next game -- these are RetroForge's, as system_args are. A
# file that cannot be written is a warning, not a blocked game (as with sync).
#
# Kept current (sync): files that are RetroForge's, not the player's, placed into the download's world --
# PortMaster's mod_RetroForge.txt and libgl_RetroForge.txt, which every port sources from PortMaster's
# folder. Copied from the image at every launch when missing or different (an image update must
# reach an existing install, which a seed never would), atomically. A failed copy is a warning: the
# emulator still starts.
#
# One-time installs (install): a file the PLAYER provides that the emulator must import before any
# game runs (RPCS3's PS3 firmware). When `unless` is missing under $HOME, the emulator's binary is run
# with `args` ("{file}" = $HOME/<from>) from the mounted download, before the game, and waited for;
# `unless` must exist afterwards. A ROM launch whose `from` file is missing does not start the
# emulator (it would wait on its own error dialog): it ends with exit 3 and `missing-file <emulator>
# <from>` in the status file, so the plugin can tell the player where to put it. --gui still opens
# without it.
#
# Setup runs (setup_args): the emulator's own binary, run with these arguments and waited for before
# EVERY start, game and --gui, windowless. For a setting that must follow the device, so no file can
# seed it: gopher64 (since replaced by RMG) stored the assigned pad's /dev/input/eventN path, which
# no board or boot guarantees -- `--assign-controller 1 --port 1` at every launch made gopher64
# itself look up InputPlumber's virtual pad (the one SDL joystick on a RetroForge session) and write
# its current path (HW 2026-10-20, Pocket ACE: fresh config = every port unassigned = no controls).
# A setup run that fails is a warning, never a blocked game: the emulator still starts, at worst as
# it would have without the step.
#
# PSN inbox (--psn-install, plan psn-pkg): the player drops PSN .pkg files (base game, updates,
# DLC) and their .rap/.edat licences into ~/roms/ps3/psn/, and the RetroForge plugin runs this verb
# (threaded, with progress; never at library load). It runs ps3's emulator once, headless, on the
# whole folder — `--headless --installpkg <inbox>` copies every licence into dev_hdd0's exdata and
# extracts every .pkg; RPCS3 processes raps before pkgs itself, and the order never matters (the
# licence is only read at boot). RPCS3's exit code is 0 even on failure, so success is verified on
# disk per file: a pkg's title id comes from its own header (content id at 0x30, title id chars
# 7..15), and the install must have produced dev_hdd0/game/<id>/PARAM.SFO *in this run* (something
# under game/<id> is newer than the run's start — a stale install from an earlier run never
# verifies a re-dropped broken pkg; dev_hdd0 as ~/.config/rpcs3/vfs.yml places it, and the
# emulator's seed runs first, so a first install still lands where RetroForge puts dev_hdd0).
# Several pkgs of one game (base, update, DLC) share a title id and are verified COLLECTIVELY: when
# one of them installs, the batch's others count as installed too. A verified base game (PARAM.SFO
# CATEGORY "HG" with USRDIR/EBOOT.BIN; updates and DLC make no card) gets a stub
# ~/roms/ps3/<TITLE>.psn — PARAM.SFO's TITLE, sanitized, the title id when it is missing, " (<id>)"
# appended on a collision; an id that already has a stub keeps it. The
# INBOX IS CONSUMED: a verified pkg and a copied licence are deleted; failures stay, visible and
# retryable, and nothing outside the inbox is ever deleted. A new card's box art is seeded from
# the game's own ICON0.PNG into the scraper's media folder when no box exists yet (digital-only
# titles often have no box scan on ScreenScraper; a later real box download overwrites the seed). Results go to stdout for the plugin,
# one tab-separated line per file: `ok|failed <TAB> <file> <TAB> <title id or -> <TAB> <stub name
# or ->` (`nothing-to-do` for an empty inbox); other files (the folder's README) are ignored
# silently. Exit 0 when everything succeeded, 3 otherwise (also when ps3's emulator is not
# installed or does not start). No status file: the plugin reads this run directly, and no OGUI
# EXIT hook fires. ONE RPCS3 AT A TIME: the installer and a ps3 game launch take the same lock
# (PSN_LOCK, held for the process's life) — they share dev_hdd0, and two RPCS3s do not fit in a
# handheld's RAM (earlyoom killed the game on the 8 GiB ACE, 2026-10-20). A ps3 launch while an
# install runs fails with `psn-installing`; an install while a game runs is refused (the plugin
# also refuses earlier, with the friendlier message). A --gui session is not guarded.
#
# Stub ROMs (stub): a card for a game that lives inside the emulator's own data, not in ~/roms — a
# PSN game RPCS3 installed into dev_hdd0 (plan psn-pkg). The card's file is a stub the installer
# wrote: its first line is a game id, and the definition maps the stub's extension to what the
# emulator boots in its place ("{text}" = that id; RPCS3's "%RPCS3_GAMEID%:NPUB30024" resolves the
# installed game through its own VFS). Only the emulator's command line gets the target: the stub
# file stays the game's identity everywhere else (the card's name is its filename, the per-game
# conf is keyed on it). The installer writes the stub as UTF-8, the id ASCII letters, digits and
# underscore (STUB_ID): anything else on the first line — or a binary, empty or unreadable file —
# ends the launch (exit 3, `bad-stub <emulator>`), and the plugin's popup (plan psn-pkg phase 3)
# tells the player to reinstall the package.
#
# The scripts format (PortMaster) is a folder retroforge-emu unpacked under $HOME, never mounted: --gui
# runs <root>/<binary> in place, and a game card's ROM is ITSELF a script -- a port's own launch
# script, which PortMaster installed beside its folder -- run with bash (args, "{rom}" = the
# script), never with exec: its mode is whatever the port's zip carried. Not installed (exit 3,
# `not-installed`) when <root>/<binary> is not executable, for a game too: every port script sources
# PortMaster's control files. When the run ends, every runtime a port left mounted is released: the
# mounts RetroForge's port `mount` stand-in (/usr/lib/retroforge/portmaster/bin/mount) records in
# $RETROFORGE_PM_MOUNTS (default $XDG_RUNTIME_DIR/retroforge-portmaster-mounts), whose squashfuse daemons
# outlive the port's session when OGUI's Exit skips the port's own umount.
#
# The binary format (gopher64 shipped this way until RMG replaced it) is a download that is ONE
# plain executable: retroforge-emu names it
# <tag>.AppImage all the same (the name is only a name; nothing checks the file is an AppImage) and
# points `current` at it. It runs in place, nothing to mount: the definition's binary is `current`
# itself, relative to the emulator's folder.
#
# Every AppImage format mounts the AppImage and runs its real binary; every rule below was found on
# hardware (DuckStation, MANGMI Pocket Max, 2026-10-03) and each one cost a crash:
#
#   - Never exec the AppImage or its AppRun. The runtime starts AppRun, a symlink to the binary; Qt
#     takes applicationDirPath from that path, misses usr/bin/qt.conf, finds no platform plugin and
#     aborts. Desktops hide this with a system Qt; RetroForge has none.
#   - OGUI stops a game with Reaper.reap(): every PID in the tree, leaves inward, gets
#     `kill -TERM -- -PID` and then `kill -TERM PID`, each a separate command. The emulator runs in
#     its own session, so it leads its own process group: its two signals arrive back to back and
#     coalesce into one, as when OGUI launches it directly. Inside our group it got a second, later
#     SIGTERM through `-<our pid>`, which DuckStation takes as "Ctrl+C again: force quit" and
#     abort()s — a core dump and a 14 s exit.
#   - We never forward a signal to the emulator, for the same reason: it already has OGUI's. We
#     only survive ours (TERM, INT, HUP) and wait for it. The one exception is opt-in per
#     definition: "exit_resend": N sends ONE more SIGTERM when the emulator is still running N s
#     after a stop signal reached us, and SIGKILL to the emulator alone N s after that. It is for
#     an emulator that SIGTERM does not end: OGUI's second Exit would SIGKILL the whole tree, us
#     included, leaving a dead mount. (melonDS and Azahar used it first; their real cause was SDL
#     catching SIGTERM, fixed with SDL_NO_SIGNAL_HANDLERS in their definitions.) Killing only the emulator, we still release the mount.
#   - The mount runtime is in the tree too. It starts with SIGTERM ignored, or OGUI's Exit pulls the
#     files out from under an emulator that is still shutting down. After the emulator exits it is
#     released with SIGHUP (the runtime holds the mount busy until it exits) and fusermount3 -u.
#   - Exit pressed twice is SIGKILL for everything, which leaves a dead mount: sweep ours first.
#
# GPU priority: on the A7xx boards (SM8550, SM8650) every emulator (game or --gui) starts with
# RETROFORGE_GAME_LOWPRIO=1, which turns on the implicit Vulkan layer VK_LAYER_RETROFORGE_game_priority
# (packages/retroforge-gpu-priority): its queues run at LOW global priority, so OGUI's overlay,
# Xwayland and mangoapp -- which never get the variable -- preempt it instead of waiting behind its
# frames; and TU_AUTOTUNE_FLAGS=preempt_optimize: smaller tiles reach a preemption point sooner.
# Neither on the single-ring A650/A610 (SM8250, SM6115) nor an unknown board: they do not preempt,
# so the layer would only be one more thing in the process; there kernel/patches/0270 keeps the UI
# ahead. The SoC class comes from device-env (the session does not export it). A definition's "env"
# overrides both, e.g. {"DISABLE_RETROFORGE_GAME_LOWPRIO": "1"} for an emulator that misbehaves.
#
# VRAM report limit, as Valve sets it for the Steam Frame's games: every emulator starts with mesa's
# vram-report-limit layer (implicit, gated on ENABLE_MESA_VRAM_REPORT_LIMIT; packages/mesa) reporting
# a 4096 MiB heap, which engines that size their budgets from VRAM plan around, while Turnip's own
# heap is 15/16 of RAM (drirc.d/01-retroforge-turnip.conf). The layer applies to ONE exact
# vendorID:deviceID: device-env's RETROFORGE_GPU_CHIP_ID, derived from the GPU node's compatible
# string. No Adreno node, no limit: the layer stays off. Nor when 15/16 of RAM is not above
# 4096 MiB: the layer does not clamp, it REPORTS 4096 MiB and scales the budget up to match, so on a
# small board an emulator would plan around memory the device does not have. Turnip's real heap is
# already the smaller one there. The shell's own report (retroforge-session) is never passed on:
# the layer's variables are dropped from what we inherit. A definition's "env" overrides it.
#
# core_dumps false: the emulator starts with RLIMIT_CORE 0, so systemd-coredump logs a crash in the
# journal but stores no core. For an emulator known to crash on a normal exit (Snes9x 1.63 did, until
# the sigdefer shim moved its exit out of its SIGTERM handler): ~14 MB per Exit otherwise.
#
# Exit status: the emulator's (128 + N when signal N ended it), or 2 for a bad invocation or
# definition, 3 when the emulator is not installed or does not start (its AppImage does not mount),
# or a one-time install cannot run or fails. OGUI runs games through its reaper and never sees this
# status, so an exit 3 is also written to $RETROFORGE_LAUNCH_STATUS (`not-installed <emulator>`,
# `mount-failed <emulator>`, `missing-file <emulator> <path under $HOME>`, `install-failed
# <emulator>`, `bad-stub <emulator>` or `psn-installing <emulator>`), cleared at every start: the
# RetroForge plugin's EXIT hook reads it and tells the player what to do.

import errno
import json
import secrets
import os
import re
import fcntl
import resource
import select
import shutil
import signal
import struct
import subprocess
import sys
import tempfile
import time

# emuopts (per-emulator options, the player confs) ships beside us: /usr/lib/retroforge/python in the
# image, the same place under rootfs/overlay when the offline tests run this file from the repo (no
# bytecode: /usr is read-only on the device, and in the repo it would land inside rootfs/overlay).
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "retroforge", "python"))
