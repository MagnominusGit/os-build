#!/usr/bin/bash
# retroforge-format-sdcard — format "the SD card". The shell's storage settings call this (no device
# argument); its sibling retroforge-format-device is the form that names a device.
#
# A REAL PRIVILEGE BOUNDARY: it repartitions a disk, so it pkexecs into the privileged script and
# the polkit action is what decides whether the caller may. See
# usr/share/polkit-1/actions/org.retroforge.policykit.storage.policy: allow_active only, so the seat
# session may format a card and an SSH session may not.
#
# NO DEVICE ARGUMENT, deliberately: the answer to "which card" is knowable only on the device — a
# removable SD we did not boot from, and exactly one of them. Letting the caller name a disk here
# would make the caller's idea of "the" card authoritative over ours, and it cannot see which disk
# this system is running from.
# See the sibling retroforge-format-device for why this is logged here rather than left to pkexec.
logger -t retroforge-format-sdcard -p user.notice -- "invoked: $*"

# RESOLVING WHICH CARD HAPPENS HERE, and that placement is the point. Upstream's equivalent is one
# line — `format-device.sh --device /dev/mmcblk0` — because on a Deck the SD slot always is
# mmcblk0. It is not here: eMMC enumerates as mmcblk too, and a device can be RUNNING FROM a card,
# so a hardcoded mmcblk0 would sometimes name the disk we booted from. storage_target_sd answers
# "the removable SD we are not running from", and yields nothing when there is more than one.
#
# This lives in the wrapper, not as a flag inside format-device.sh, so that helper's option set stays
# exactly upstream's — diffable against the file it was ported from in one glance.
#
# The privileged script re-checks anyway (removable SD, not the system disk), so this is about
# naming the RIGHT card, not about being the thing that stops the wrong one being erased.
. /usr/lib/retroforge/storage/lib-storage.sh
device="$(storage_target_sd)"
[ -n "$device" ] || {
    echo "retroforge-format-sdcard: no eligible SD card (none present, it is the boot disk, or there is more than one)" >&2
    logger -t retroforge-format-sdcard -p user.notice -- "no eligible SD card to format"
    exit 19  # ENODEV, the same code the privileged script uses for "no such device"
}
exec /usr/bin/pkexec /usr/lib/retroforge/storage/format-device.sh --device "$device" "$@"
