#!/usr/bin/env bash
# retroforge-steam-sarek — the player's DXVK-Sarek setting for Steam's Windows games.
#
#   retroforge-steam-sarek status    print on or off (and on stderr, where that comes from)
#   retroforge-steam-sarek on|off    save the player's choice and apply it; print the result
#   retroforge-steam-sarek apply     apply the setting and print on or off (/usr/bin/steam runs this)
#
# DXVK-Sarek is the DXVK for GPUs that upstream DXVK leaves out. Every upstream DXVK needs
# multiViewport, which Turnip gives the Adreno 610 (SM6115) only under TU_DEBUG=noconform
# (etc/retroforge/session.conf), and Mesa 26.3 removes that. Proton-CachyOS ships Sarek, and this is
# the one switch for it:
#   on:  Proton-CachyOS's arm64 build is installed, or updated to its newest release, in the
#        BACKGROUND (/usr/lib/retroforge/steam-compat-tools on: one GitHub API request, and a ~356 MB
#        download the first time and for each new release), with Sarek on in it, and /usr/bin/steam
#        exports PROTON_DXVK_SAREK=1. The download runs as a user unit:
#        nothing waits for it, and it is not under OGUI's reaper, which stops everything under a game
#        when the game ends. Without a user manager it falls back to setsid. Log:
#        ~/.local/share/retroforge/steam-compat-tools.log.
#   off: nothing is downloaded or exported. An installed Proton-CachyOS stays, with Sarek turned off
#        in it (steam-compat-tools off, before the client starts). `off` also stops a download in
#        progress.
# Steam lists a newly installed tool from its next start, and the player selects it per game or as
# the Steam Play default: nothing edits Steam's config (docs/steam-arm64.md).
#
# The setting is DXVK_SAREK=on|off in ~/.config/retroforge/steam.conf (the last such line counts;
# saving rewrites that line and keeps the others). The RetroForge plugin's Settings > General toggle
# "Steam: DXVK-Sarek (low-end GPUs)" runs this. Never set, it is on for SoC class SM6115 (device-env)
# and off everywhere else, so a card moved to another board follows that board until the player
# chooses. RETROFORGE_STEAM_SAREK=on|off overrides both, for testing and debugging.
#
# Exit 0, 1 when the setting could not be saved, 2 for a bad invocation.
#
# TEST SEAMS (tests/test-steam-compat-tools.sh): RETROFORGE_DEVICE_ENV, RETROFORGE_STEAM_COMPAT_TOOLS,
# RETROFORGE_STEAM_ROOT (also set by /usr/bin/steam).
set -u

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/retroforge/steam.conf"
export RETROFORGE_STEAM_ROOT="${RETROFORGE_STEAM_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/Steam}"
STEAM_ROOT=$RETROFORGE_STEAM_ROOT
HELPER="${RETROFORGE_STEAM_COMPAT_TOOLS:-/usr/lib/retroforge/steam-compat-tools}"
LOG="${XDG_DATA_HOME:-$HOME/.local/share}/retroforge/steam-compat-tools.log"
UNIT=retroforge-steam-compat-tools

log() { echo "retroforge-steam-sarek: $*" >&2; }

saved() {  # the player's choice: on, off, or nothing when there is none
  local line value=""
  [ -r "$CONF" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in DXVK_SAREK=*) value="${line#DXVK_SAREK=}" ;; esac
  done <"$CONF"
  case "$value" in on|off) echo "$value" ;; esac
}

state() {  # sets STATE (on|off) and FROM (where it comes from)
  case "${RETROFORGE_STEAM_SAREK:-}" in
    on|off) STATE=$RETROFORGE_STEAM_SAREK; FROM="RETROFORGE_STEAM_SAREK"; return ;;
  esac
  STATE="$(saved)"
  if [ -n "$STATE" ]; then FROM="$CONF"; return; fi
  local soc
  soc="$(eval "$("${RETROFORGE_DEVICE_ENV:-/usr/lib/retroforge/device-env}" 2>/dev/null)"; echo "${RETROFORGE_SOC_CLASS:-}")"
  if [ "$soc" = SM6115 ]; then STATE=on; else STATE=off; fi
  FROM="the default on ${soc:-an unknown board}"
}

save() {  # save on|off: through a temporary file and a rename
  local line tmp="$CONF.part"
  mkdir -p "${CONF%/*}" || return 1
  {
    if [ -r "$CONF" ]; then
      while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in DXVK_SAREK=*) ;; *) printf '%s\n' "$line" ;; esac
      done <"$CONF"
    else
      echo "# Steam settings of the RetroForge shell (retroforge-steam-sarek). Safe to edit."
    fi
    echo "DXVK_SAREK=$1"
  } >"$tmp" && mv -f "$tmp" "$CONF"
}

sarek_in_tools() {  # a folder steam-compat-tools installed still has a user_settings.py
  local d
  for d in "$STEAM_ROOT"/compatibilitytools.d/*/; do
    [ -e "${d}.retroforge-pin" ] && [ -e "${d}user_settings.py" ] && return 0
  done
  return 1
}

apply() {
  state
  if [ "$STATE" = on ]; then
    mkdir -p "${LOG%/*}"
    systemd-run --user --quiet --collect --unit="$UNIT" \
        --setenv=RETROFORGE_STEAM_ROOT="$STEAM_ROOT" \
        -p StandardOutput="append:$LOG" -p StandardError="append:$LOG" \
        "$HELPER" on >/dev/null 2>&1 \
      || setsid -f "$HELPER" on </dev/null >>"$LOG" 2>&1
  elif sarek_in_tools; then
    "$HELPER" off >&2   # in the foreground: before the client can start a game. stdout is our answer.
  fi
}

case "${1-}:$#" in
  status:1)
    state
    log "DXVK-Sarek is $STATE ($FROM)"
    echo "$STATE"
    ;;
  on:1|off:1)
    save "$1" || { log "could not save DXVK_SAREK=$1 in $CONF"; exit 1; }
    [ "$1" = off ] && systemctl --user stop "$UNIT.service" >/dev/null 2>&1
    apply
    if [ "$STATE" != "$1" ]; then
      log "saved $1, but $FROM says $STATE"
    elif [ "$STATE" = on ]; then
      log "on: its Proton is installed or updated in the background (log: $LOG). Select it in Steam."
    fi
    echo "$STATE"
    ;;
  apply:1)
    apply
    echo "$STATE"
    ;;
  *)
    log "usage: retroforge-steam-sarek status|on|off|apply"
    exit 2
    ;;
esac
