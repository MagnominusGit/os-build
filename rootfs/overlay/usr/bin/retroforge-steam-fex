#!/usr/bin/env python3
# retroforge-steam-fex — on ARMv8.0 CPUs (no LSE atomics, e.g. the SM6115), our ARMv8.0 build of Valve's FEX
# tool (sunshineinabox/proton-armv8, release fex-armv8-<version>) for the native x86 Linux games Steam runs
# through FEX. On other CPUs it does nothing.
#
#   retroforge-steam-fex status    ours, valve or none: whose binaries Valve's FEX tool runs (steam: not ARMv8.0)
#   retroforge-steam-fex apply     /usr/bin/steam runs this before the client starts
#   retroforge-steam-fex install   update our tool, then the two steps below (apply starts it in the background)
#
# WHY. Valve builds its FEX tool (Steam app 3127680, steamapps/common/FEX-Emu) for ARMv8.1+: ~390 inline LSE
# atomics, which kernel patch 0025 emulates on the SM6115. SuperTux's menu through it on the Air X: ~3,000
# emulations a second from the game; through ours, none (2026-10-23).
#
# TWO WAYS IN. Our tool, compatibilitytools.d/fex-armv8-retroforge ("FEX ARMv8.0 (RetroForge)"), which
# steam-compat-tools installs and keeps on the newest release (fex-armv8.pin), is one a game can be set to.
# And the FEX Steam adds to every x86 Steam Linux Runtime runs our binaries too: while Valve's VERSIONS.txt
# names the version ours were built from, ours replace its usr/bin/* and FEXCompatTool, each by a rename, so
# a FEX running from it keeps its file. Steam puts Valve's back when it updates or checks the tool, and
# apply swaps them in again at the next start; another version stays Valve's.
# Our tool's manifest runs Valve's fex-compat-tool (with its unshare.py), which is not FEX's and is not in
# our release: both are copied in from Valve's tool, and again whenever Valve's change. So nothing is done
# until Steam has installed its FEX tool, which it does when an x86 game first needs it.
#
# TEST SEAMS (tests/test-steam-fex.sh): RETROFORGE_STEAM_ROOT, RETROFORGE_CPUINFO, RETROFORGE_STEAM_PINS,
# RETROFORGE_STEAM_COMPAT_TOOLS (the helper), RETROFORGE_STEAM_FEX_START (a command run with this script
# and `install` as arguments instead of systemd-run).
import hashlib
import os
import re
import shutil
import subprocess
import sys

DATA = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
STEAM_ROOT = os.environ.get("RETROFORGE_STEAM_ROOT") or os.path.join(DATA, "Steam")
CPUINFO = os.environ.get("RETROFORGE_CPUINFO", "/proc/cpuinfo")
PINS = os.environ.get("RETROFORGE_STEAM_PINS", "/usr/share/retroforge/steam")
HELPER = os.environ.get("RETROFORGE_STEAM_COMPAT_TOOLS", "/usr/lib/retroforge/steam-compat-tools")
START = os.environ.get("RETROFORGE_STEAM_FEX_START")
LOG = os.path.join(DATA, "retroforge", "steam-fex.log")
OURS = os.path.join(STEAM_ROOT, "compatibilitytools.d", "fex-armv8-retroforge")
VALVE_APP = 3127680
BINARIES = ("usr/bin/FEX", "usr/bin/FEXServer", "usr/bin/FEXOfflineCompiler", "usr/bin/FEXGetConfig",
            "usr/bin/FEXBash", "usr/bin/FEXpidof", "usr/bin/FEXServerManager", "FEXCompatTool")
VALVE_SCRIPTS = ("fex-compat-tool", "unshare.py")


def log(msg):
    print(f"retroforge-steam-fex: {msg}", file=sys.stderr, flush=True)


def lacks_atomics():
    try:
        with open(CPUINFO, encoding="utf-8", errors="replace") as f:
            feats = [line.split(":", 1)[1].split() for line in f if line.startswith("Features")]
    except OSError:
        return False
    return any("atomics" not in x for x in feats)


def valve_tool():
    """Valve's FEX tool folder (its app manifest, in any Steam library), else None."""
    libs = [STEAM_ROOT]
    try:
        with open(os.path.join(STEAM_ROOT, "steamapps", "libraryfolders.vdf"), encoding="utf-8", errors="replace") as f:
            libs += re.findall(r'"path"\s+"([^"]+)"', f.read())
    except OSError:
        pass
    for lib in dict.fromkeys(libs):
        try:
            with open(os.path.join(lib, "steamapps", f"appmanifest_{VALVE_APP}.acf"), encoding="utf-8",
                      errors="replace") as f:
                m = re.search(r'"installdir"\s+"([^"]+)"', f.read())
        except OSError:
            continue
        path = os.path.join(lib, "steamapps", "common", m.group(1)) if m else ""
        if path and os.path.isdir(path):
            return path
    return None


def ours():
    """Our tool, once steam-compat-tools has installed it (its .retroforge-pin) with every binary, else None."""
    whole = all(os.path.isfile(os.path.join(OURS, f)) for f in (".retroforge-pin",) + BINARIES)
    return OURS if whole else None


def version(tool):
    """The "FEX describe" line of a FEX tool's VERSIONS.txt, else ""."""
    try:
        with open(os.path.join(tool, "VERSIONS.txt"), encoding="utf-8", errors="replace") as f:
            for line in f:
                key, _, value = line.rstrip("\n").partition("\t")
                if key == "FEX describe":
                    return value.strip()
    except OSError:
        pass
    return ""


def digest(path):
    try:
        with open(path, "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()
    except OSError:
        return None


def put(src, dest):
    """dest as a copy of src, by a rename: a process running dest keeps its file."""
    tmp = os.path.join(os.path.dirname(dest), f".{os.path.basename(dest)}.retroforge")
    shutil.copy2(src, tmp)
    os.replace(tmp, dest)


def refresh(mine, valve):
    """Valve's fex-compat-tool and unshare.py in our tool, as Valve's tool has them now."""
    for name in VALVE_SCRIPTS:
        src = os.path.join(valve, name)
        if os.path.isfile(src) and digest(src) != digest(os.path.join(mine, name)):
            put(src, os.path.join(mine, name))
            log(f"took Valve's {name} into {os.path.basename(mine)}")


def swap(mine, valve):
    """Our binaries in Valve's tool while both are the same version."""
    want, have = version(mine), version(valve)
    if not want or want != have:
        log(f"Valve's FEX is {have or 'of no version'}, ours {want or 'of none'}: Valve's binaries stay")
        return
    changed = [rel for rel in BINARIES if digest(os.path.join(mine, rel)) != digest(os.path.join(valve, rel))]
    for rel in changed:
        put(os.path.join(mine, rel), os.path.join(valve, rel))
    if changed:
        log(f"Valve's FEX {have} runs our ARMv8.0 binaries ({len(changed)} put in)")


def settle():
    """Both steps with what is installed now."""
    valve, mine = valve_tool(), ours()
    if valve and mine:
        try:
            refresh(mine, valve)
            swap(mine, valve)
        except OSError as err:
            log(f"could not update {valve} or {mine}: {err}")


def status():
    if not lacks_atomics():
        return "steam"
    valve, mine = valve_tool(), ours()
    if valve is None:
        return "none"
    same = mine is not None and all(digest(os.path.join(mine, r)) == digest(os.path.join(valve, r)) for r in BINARIES)
    return "ours" if same else "valve"


def start_install():
    """install in the background, its log appended to LOG."""
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    out = open(LOG, "a")
    me = os.path.abspath(__file__)
    if START:
        subprocess.Popen([START, me, "install"], stdout=out, stderr=out, start_new_session=True)
        return
    res = subprocess.run(["systemd-run", "--user", "--quiet", "--collect", "--unit=retroforge-steam-fex",
                          f"--setenv=RETROFORGE_STEAM_ROOT={STEAM_ROOT}", f"-pStandardOutput=append:{LOG}",
                          f"-pStandardError=append:{LOG}", me, "install"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if res.returncode != 0:  # no user manager, or the last one still runs
        subprocess.Popen([me, "install"], stdout=out, stderr=out, start_new_session=True)


def apply():
    if not lacks_atomics():
        return "steam"
    if valve_tool() is None:
        log("Steam has not installed its FEX tool yet (it does when an x86 game first needs it)")
        return "none"
    settle()
    start_install()
    return status()


def install():
    env = dict(os.environ, RETROFORGE_STEAM_COMPAT_PIN=os.path.join(PINS, "fex-armv8.pin"))
    res = subprocess.run([HELPER, "on"], env=env, stdout=subprocess.DEVNULL)
    settle()
    return 0 if res.returncode == 0 else 1


def main(argv):
    if argv[1:] == ["status"]:
        print(status())
        return 0
    if argv[1:] == ["apply"]:
        print(apply())
        return 0
    if argv[1:] == ["install"]:
        if not lacks_atomics() or valve_tool() is None:
            return 0
        return install()
    log("usage: retroforge-steam-fex status|apply|install")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
