#!/usr/bin/env bash
# retroforge-steam-cachyos — Proton-CachyOS's arm64 build, downloaded when the player asks for it:
# Apps > Steam Client > "CachyOS Proton arm64" (the RetroForge plugin) runs this.
#
#   retroforge-steam-cachyos status    armv8 (this CPU takes our ARMv8.0 Proton instead: no row),
#                                      missing, or installed <release tag>
#   retroforge-steam-cachyos install   install it, or update it to its newest release, and wait for
#                                      the end
#
# install runs /usr/lib/retroforge/steam-compat-tools install as the user unit
# retroforge-steam-compat-tools (it goes on if the shell restarts; without a user manager, in the
# foreground), and waits for it. A run of that unit already going is waited for first. Its progress
# is in ~/.local/share/retroforge/steam-compat-tools.progress, its log in
# ~/.local/share/retroforge/steam-compat-tools.log, whose last line goes to stderr when it fails.
#
# This only puts the tool in compatibilitytools.d: nothing selects it. DXVK-Sarek is on in it only
# where the GPU needs it (steam-compat-tools). Steam lists it from its next start; the player selects
# it per game (Properties > Compatibility). docs/steam-arm64.md.
#
# Exit 0, 1 when the tool could not be installed, 2 for a bad invocation or an ARMv8.0 CPU.
#
# TEST SEAMS (tests/test-steam-compat-tools.sh): RETROFORGE_STEAM_ROOT, RETROFORGE_CPUINFO,
# RETROFORGE_STEAM_COMPAT_TOOLS (the helper), RETROFORGE_STEAM_PINS (the pins' folder).
set -u

DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
STEAM_ROOT="${RETROFORGE_STEAM_ROOT:-$DATA/Steam}"
HELPER="${RETROFORGE_STEAM_COMPAT_TOOLS:-/usr/lib/retroforge/steam-compat-tools}"
PIN="${RETROFORGE_STEAM_PINS:-/usr/share/retroforge/steam}/proton-cachyos-arm64.pin"
CPUINFO="${RETROFORGE_CPUINFO:-/proc/cpuinfo}"
LOG="$DATA/retroforge/steam-compat-tools.log"
UNIT=retroforge-steam-compat-tools

log() { echo "retroforge-steam-cachyos: $*" >&2; }

lacks_atomics() {  # a CPU here without LSE atomics (ARMv8.0): steam-compat-tools takes another pin
  local line
  while IFS= read -r line; do
    case "$line" in
      Features*) case " ${line#*:} " in *" atomics "*) ;; *) return 0 ;; esac ;;
    esac
  done <"$CPUINFO" 2>/dev/null
  return 1
}

status() {
  if lacks_atomics; then echo armv8; return; fi
  local dir tool tag
  dir="$(sed -n 's/^dir:[ \t]*//p' "$PIN" 2>/dev/null | tail -1)"
  tool="$STEAM_ROOT/compatibilitytools.d/$dir"
  tag="$(sed -n 's/^tag:[ \t]*//p' "$tool/.retroforge-pin" 2>/dev/null | tail -1)"
  if [ -n "$dir" ] && [ -f "$tool/proton" ] && [ -n "$tag" ] \
     && grep -qx 'name: proton-cachyos-arm64' "$tool/.retroforge-pin"; then
    echo "installed $tag"
  else
    echo missing
  fi
}

install() {
  local rc
  mkdir -p "${LOG%/*}"
  if systemctl --user show-environment >/dev/null 2>&1; then
    while systemctl --user is-active --quiet "$UNIT.service"; do sleep 1; done
    systemd-run --user --wait --quiet --collect --unit="$UNIT" \
        --setenv=RETROFORGE_STEAM_ROOT="$STEAM_ROOT" \
        -p StandardOutput="append:$LOG" -p StandardError="append:$LOG" \
        "$HELPER" install
    rc=$?
  else
    RETROFORGE_STEAM_ROOT="$STEAM_ROOT" "$HELPER" install >>"$LOG" 2>&1
    rc=$?
  fi
  if [ "$rc" = 0 ] && [ "$(status)" = missing ]; then
    log "steam-compat-tools ended without installing it (another run held its lock?)"
    rc=1
  fi
  if [ "$rc" != 0 ]; then
    grep '^steam-compat-tools:' "$LOG" 2>/dev/null | tail -1 >&2
    return 1
  fi
  return 0
}

case "${1-}:$#" in
  status:1)
    status
    ;;
  install:1)
    if lacks_atomics; then
      log "this CPU has no LSE atomics: Steam uses our ARMv8.0 Proton (retroforge-steam-proton) instead"
      exit 2
    fi
    install
    ;;
  *)
    log "usage: retroforge-steam-cachyos status|install"
    exit 2
    ;;
esac
