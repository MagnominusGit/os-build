#!/usr/bin/env bash
# retroforge-proton — the Proton RetroForge keeps for Windows games (Steam, GOG and Epic): Apps > Proton
# (the RetroForge plugin) runs this.
#
#   retroforge-proton status    print (JSON) the tool this device takes and what is installed of it
#                               (steam-compat-tools status: Proton-CachyOS arm64, or on an ARMv8.0 CPU
#                               our ARMv8.0 build in the player's channel)
#   retroforge-proton install   install it, or update it to its newest release, and wait for the end
#
# install runs /usr/lib/retroforge/steam-compat-tools install as the user unit
# retroforge-steam-compat-tools (it goes on if the shell restarts; without a user manager, in the
# foreground), and waits for it. A run of that unit already going (retroforge-steam-proton's, at a
# `steam` start, or a channel switch) is waited for first. Its progress is in
# ~/.local/share/retroforge/steam-compat-tools.progress, its log in
# ~/.local/share/retroforge/steam-compat-tools.log, whose last line goes to stderr when it fails.
# DXVK-Sarek is on in the tool only where the GPU needs it (steam-compat-tools). Nothing here selects
# a tool in Steam: on an ARMv8.0 CPU retroforge-steam-proton makes ours Steam's default when the
# client starts; elsewhere the player selects Proton-CachyOS per game (Properties > Compatibility).
# The store's launcher runs every GOG and Epic game with it unless the game has a Proton of its own.
# docs/steam-arm64.md.
#
# Exit 0, 1 when the tool could not be installed (or status could not be read), 2 for a bad
# invocation.
#
# TEST SEAMS (tests/test-steam-compat-tools.sh): RETROFORGE_STEAM_ROOT, RETROFORGE_STEAM_COMPAT_TOOLS
# (the helper), and the helper's own.
set -u

DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
STEAM_ROOT="${RETROFORGE_STEAM_ROOT:-$DATA/Steam}"
HELPER="${RETROFORGE_STEAM_COMPAT_TOOLS:-/usr/lib/retroforge/steam-compat-tools}"
LOG="$DATA/retroforge/steam-compat-tools.log"
UNIT=retroforge-steam-compat-tools

log() { echo "retroforge-proton: $*" >&2; }

install() {
  local rc
  mkdir -p "${LOG%/*}"
  if systemctl --user show-environment >/dev/null 2>&1; then
    while systemctl --user is-active --quiet "$UNIT.service"; do sleep 1; done
    systemd-run --user --wait --quiet --collect --unit="$UNIT" \
        --setenv=RETROFORGE_STEAM_ROOT="$STEAM_ROOT" \
        -p StandardOutput="append:$LOG" -p StandardError="append:$LOG" \
        "$HELPER" install
    rc=$?
  else
    RETROFORGE_STEAM_ROOT="$STEAM_ROOT" "$HELPER" install >>"$LOG" 2>&1
    rc=$?
  fi
  if [ "$rc" = 0 ] && RETROFORGE_STEAM_ROOT="$STEAM_ROOT" "$HELPER" status 2>/dev/null | grep -q '"installed": null'; then
    log "steam-compat-tools ended without installing it (another run held its lock?)"
    rc=1
  fi
  if [ "$rc" != 0 ]; then
    grep '^steam-compat-tools:' "$LOG" 2>/dev/null | tail -1 >&2
    return 1
  fi
  return 0
}

case "${1-}:$#" in
  status:1)
    RETROFORGE_STEAM_ROOT="$STEAM_ROOT" exec "$HELPER" status
    ;;
  install:1)
    install
    ;;
  *)
    log "usage: retroforge-proton status|install"
    exit 2
    ;;
esac
