#!/usr/bin/env bash
# retroforge-bootctl — the boot-health confirmation, plus a by-hand view of RAUC's slot state.
#
# RAUC owns the slot state: /etc/rauc/system.conf says bootloader=grub, so ORDER, A_OK/A_TRY and
# B_OK/B_TRY live in the ESP's grubenv and RAUC writes them with grub-editenv. The ESP GRUB reads
# them to pick the slot (boot/gen-esp-cfg.sh). This tool never writes them itself; it asks RAUC.
#
#   mark-good [--require-marker] [--wait SECONDS]
#                    confirm THIS boot (retroforge-boot-good.service): rauc status mark-good booted,
#                    which ends the trial (TRY=0, OK=1), and record the board as confirmed
#                    (rf_board_ok) so its retries skip the stage-2 menu. Then finish the ESP from the running root
#                    where an older root's update hook could not (parts.env, OpenABL's \dtbs\qcom).
#        --require-marker  re-test the session marker before confirming; without it, exit 1
#        --wait SECONDS    hold that long first, and exit 0 WITHOUT a verdict if signalled
#                          during the wait (a shutdown is not evidence of a bad boot)
#   set-state <self|A|B> <good|bad>
#                    rauc status mark-good|mark-bad. retroforge-boot-bad.service demotes the booted
#                    slot with `set-state self bad`; the next boot goes to the other one.
#   set-primary <self|A|B>
#                    rauc status mark-active: boot that slot next (this starts its trial).
#   get-current      the slot this system booted (A|B), from the initramfs handoff.
#   get-primary      the slot the ESP GRUB picks next, by RAUC's rule over the grubenv.
#   get-state <self|A|B>
#                    good|bad, by RAUC's rule: good iff <slot>_OK=1 and <slot>_TRY=0.
#   status           the grubenv's slot state and board choice.
#
# THE CONTRACT IS THE EXIT STATUS, as it was when this was RAUC's backend: a unit that runs it reads
# non-zero as failure, so every legal call exits 0 -- including no-ops. tests/test-bootctl.sh
# executes THIS file (not a copy) against a stubbed rauc and grub-editenv.
#
# Who decides what:
#   * "Is this slot OK?" is the OS's call. The boot service confirms (mark-good); a failed health
#     check demotes (retroforge-boot-bad.service -> set-state self bad). The bootloader never does.
#   * "Did a slot fail to come up?" is the ESP GRUB's TRY count: three tries without a mark-good and
#     it boots the other slot.
set -euo pipefail

# TEST SEAMS. BOOTINFO is the initramfs handoff (image/initramfs/init writes it on every boot,
# including degraded ones); mark-good uses it to tell a slot boot from a cmdline-fallback boot.
# SESSION_MARKER is the ready marker retroforge-boot-good.path watches. RAUC and EDITENV are the
# two external tools; GRUBENV is RAUC's grubenv (system.conf `grubenv=`). ESP, EFI and BOOTDIR are
# where mark-good finishes the ESP from: the shared ESP, the booted slot's efi partition (mounted
# by the initramfs), and this root's boot payload.
BOOTINFO=${BOOTINFO:-/run/retroforge/boot}
SESSION_MARKER=${SESSION_MARKER:-/run/retroforge/session/ready}
RAUC=${RAUC:-rauc}
EDITENV=${EDITENV:-grub-editenv}
ESP=${ESP:-/esp}
EFI=${EFI:-/efi}
GRUBENV=${GRUBENV:-$ESP/EFI/steamos/grubenv}
BOOTDIR=${BOOTDIR:-/usr/lib/retroforge/boot}

PROG=${0##*/}
die()  { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
warn() { printf '%s: WARNING: %s\n' "$PROG" "$*" >&2; }
log()  { printf '%s: %s\n' "$PROG" "$*"; }

# The ESP writers are shared with the update hook and the installer, resolved relative to this
# file because rootfs/overlay mirrors the device layout (/usr/bin/../lib/retroforge/install).
SLOTWRITE="$(cd "$(dirname "$0")" && pwd)/../lib/retroforge/install/lib-slotwrite.sh"

booted_slot() {  # -> A|B, or "" when this boot did not come from a slot
  sed -n 's/^slot=//p' "$BOOTINFO" 2>/dev/null || true
}

rauc_slot() {  # <self|A|B> -> RAUC's name for it (booted, rootfs.0, rootfs.1)
  case ${1:-} in
    self) echo booted ;;
    A)    echo rootfs.0 ;;
    B)    echo rootfs.1 ;;
    *)    die "invalid slot '${1:-}' (expected A, B or self)" ;;
  esac
}

resolve_slot() {  # <self|A|B> -> A|B
  case ${1:-} in
    self)
      local s; s=$(booted_slot)
      case $s in A|B) echo "$s" ;; *) die "this boot did not come from a slot (no slot= in $BOOTINFO)" ;; esac ;;
    A|B) echo "$1" ;;
    *) die "invalid slot '${1:-}' (expected A, B or self)" ;;
  esac
}

env_get() {  # <name> -> its value in the grubenv, or "" when unset
  "$EDITENV" "$GRUBENV" list 2>/dev/null | sed -n "s/^$1=//p" | head -1
}

# --- slot state, through RAUC -------------------------------------------------------------------

get_current() {
  local s; s=$(booted_slot)
  case $s in
    A|B) echo "$s" ;;
    *) die "this boot did not come from a slot (no slot= in $BOOTINFO)" ;;
  esac
}

slot_good() {  # <A|B> -> 0 iff RAUC calls it good: <slot>_OK=1 and <slot>_TRY=0
  [ "$(env_get "${1}_OK")" = 1 ] && [ "$(env_get "${1}_TRY")" = 0 ]
}

get_primary() {
  local order s
  order=$(env_get ORDER)
  [ -n "$order" ] || die "no ORDER in $GRUBENV"
  for s in $order; do
    case $s in A|B) slot_good "$s" && { echo "$s"; return 0; } ;; esac
  done
  die "no slot in ORDER '$order' is good"
}

get_state() {  # <self|A|B>
  local s; s=$(resolve_slot "${1:-}")
  if slot_good "$s"; then echo good; else echo bad; fi
}

set_state() {  # <self|A|B> <good|bad>
  local slot; slot=$(rauc_slot "${1:-}")
  case ${2:-} in
    good) "$RAUC" status mark-good "$slot" ;;
    bad)  "$RAUC" status mark-bad "$slot" ;;
    *) die "bad slot state value '${2:-}' (expected good or bad)" ;;
  esac
  sync -f "$GRUBENV" 2>/dev/null || sync
}

set_primary() {  # <self|A|B>
  local slot; slot=$(rauc_slot "${1:-}")
  "$RAUC" status mark-active "$slot"
  sync -f "$GRUBENV" 2>/dev/null || sync
}

# --- boot health --------------------------------------------------------------------------------

# Confirm this boot, called by retroforge-boot-good.service after the session handshake plus a
# --wait re-check. Exiting 0 here is load-bearing on a degraded boot: retroforge-boot-good.service is
# RemainAfterExit=yes so it fires once per boot, and a non-zero exit re-arms the level-triggered
# .path into a failing mark-good every 30s for the rest of the device's uptime (measured on
# hardware in 2026-07, before the handoff guard existed). The handoff names no slot on a
# cmdline-fallback boot, so that is the guard: nothing to confirm -> 0.
#
# --wait OWNS THE RE-CHECK DELAY, and it is here rather than in the unit because being interrupted
# mid-wait must not be a verdict: a SIGTERM'd ExecStartPre sleep is scored `Failed with result
# 'signal'` and fires OnFailure=retroforge-boot-bad.service (HW-observed 2026-08-10). Trapping the
# signal turns "the system went down before we could judge" into no verdict: nothing is confirmed,
# nothing is demoted, and the next boot runs the whole check again.
mark_good() {
  local require_marker=0 wait_secs=0
  while [ $# -gt 0 ]; do
    case $1 in
      --require-marker) require_marker=1 ;;
      --wait) shift; wait_secs=${1:-} ;;
      *) die "mark-good: unknown option '$1'" ;;
    esac
    shift
  done
  case $wait_secs in
    ''|*[!0-9]*) die "mark-good: --wait needs a whole number of seconds, got '${wait_secs}'" ;;
  esac

  local bs src
  bs=$(booted_slot)
  src=$(sed -n 's/^source=//p' "$BOOTINFO" 2>/dev/null || true)
  if [ -z "$bs" ]; then
    echo "this boot did not come from a slot (source=${src:-unknown}) -- nothing to confirm"
    return 0
  fi

  # `sleep` is backgrounded and waited on because bash defers a trap until the current FOREGROUND
  # command returns -- a foreground sleep would swallow the signal for the rest of the window.
  if [ "$wait_secs" -gt 0 ]; then
    local interrupted=0
    trap 'interrupted=1' TERM INT
    sleep "$wait_secs" & wait $! || true
    trap - TERM INT
    if [ "$interrupted" = 1 ]; then
      echo "interrupted during the ${wait_secs}s re-check -- not confirming, not demoting"
      return 0
    fi
  fi

  if [ "$require_marker" = 1 ] && [ ! -e "$SESSION_MARKER" ]; then
    die "no session marker at $SESSION_MARKER -- refusing to confirm this boot"
  fi

  "$RAUC" status mark-good booted || die "rauc status mark-good booted failed"
  echo "boot confirmed good (slot $bs)"

  # The board this boot came up on (the stage-2 config saved it as saved_entry) is now known good:
  # its retries no longer show the stage-2 menu (rf_board_ok, ours, beside RAUC's variables).
  local board
  board=$(env_get saved_entry)
  if [ -n "$board" ] && [ "$(env_get rf_board_ok)" != "$board" ]; then
    "$EDITENV" "$GRUBENV" set "rf_board_ok=$board" || warn "could not record $board as a confirmed board"
  fi
  sync -f "$GRUBENV" 2>/dev/null || sync

  # Only after the verdict, and never able to take it back: what an older root's hook did not write
  # when it installed this root (it knows neither file). A failure here is a warning; the ESP GRUB
  # has a fall-back for both.
  if [ -r "$SLOTWRITE" ]; then
    # shellcheck source=../lib/retroforge/install/lib-slotwrite.sh
    if ( . "$SLOTWRITE" && refresh_esp_extras "$ESP" "$EFI" "$BOOTDIR" ); then
      true
    else
      warn "could not finish the ESP (parts.env, \\dtbs\\qcom) -- the ESP GRUB falls back without them"
    fi
  else
    warn "cannot read $SLOTWRITE -- the ESP is left as it is"
  fi
}

# --- diagnostics --------------------------------------------------------------------------------

status() {
  local list
  echo "booted slot: $(booted_slot || true)"
  if list=$("$EDITENV" "$GRUBENV" list 2>/dev/null); then
    echo "grubenv ($GRUBENV):"
    printf '%s\n' "$list" | grep -E '^(ORDER|[AB]_OK|[AB]_TRY|saved_entry|rf_bcsync)=' | sed 's/^/  /' || true
  else
    echo "grubenv: cannot read $GRUBENV (is the ESP mounted at $ESP?)"
  fi
  echo "next boot:   $(get_primary 2>/dev/null || echo '<undetermined>')"
}

usage() {
  # The header comment IS the usage text, printed to wherever it ends.
  awk 'NR == 1 { next }                      # shebang
       /^#/    { sub(/^# ?/, ""); print; next }
               { exit }' "$0"
  exit 2
}

case "${1:-}" in
  get-current) shift; get_current ;;
  get-primary) shift; get_primary ;;
  set-primary) shift; set_primary "$@" ;;
  get-state)   shift; get_state "$@" ;;
  set-state)   shift; set_state "$@" ;;
  mark-good)   shift; mark_good "$@" ;;
  status)      shift; status ;;
  ''|-h|--help|help) usage ;;
  *) die "unknown command: $1 (try --help)" ;;
esac
