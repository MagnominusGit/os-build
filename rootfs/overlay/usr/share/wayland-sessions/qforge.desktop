[Desktop Entry]
Name=qforge
Comment=qforge gamescope Deck shell
# SDDM autologins the player user into this session (see /etc/sddm.conf.d/zz-qforge-autologin.conf).
# Exec is our existing gamescope launcher — SDDM runs it via sddm-helper-start-wayland inside a real
# PAM/logind session on seat0, which is what makes the session ACTIVE for polkit. The launcher itself
# is unchanged (still opens the seat through the root seatd; player is in the `seat` group).
Exec=/usr/bin/qforge-session
Type=Application
DesktopNames=gamescope
