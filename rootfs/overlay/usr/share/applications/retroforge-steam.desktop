[Desktop Entry]
# The "Steam" card in OpenGamepadUI's library: Steam's own Big Picture, for the store, the library and
# Remote Play (a PC's games show a Stream button there). OGUI's desktop library (core/systems/library/
# library_desktop.gd, v0.46.1) lists /usr/share/applications entries in the Game category and runs
# Exec split on spaces, so Exec has no field codes or quotes.
# It opens steam://open/bigpicture, NOT steam://rungameid/: OGUI treats a rungameid launch as one game
# and SIGTERMs Steam once only Steam's windows are left (running_app.gd), which would end a Remote Play
# stream. As a plain app, Big Picture stays until the player leaves it. The flags are the OGUI Steam
# plugin's; never -steamframe or -deckard (Frame-only paths). /usr/bin/steam downloads the client the
# first time (docs/steam-arm64.md).
Type=Application
Name=Steam
Comment=Steam Big Picture: store, library and Remote Play from your PC
Exec=steam -gamepadui -steamos3 -steampal -steamdeck steam://open/bigpicture
Icon=steam
Categories=Game;
Keywords=steam;remote play;stream;
