# proton-armv8.pin's experimental channel: Valve's experimental-11.0-* tags, published as prereleases.
# steam-compat-tools takes it on ARMv8.0 CPUs when the player's Proton is "experimental"
# (PROTON_CHANNEL=experimental in ~/.config/retroforge/steam.conf, retroforge-steam-proton).
name: proton-armv8-experimental
releases: https://api.github.com/repos/sunshineinabox/proton-armv8/releases
asset: proton-armv8-experimental-*.tar.zst
sidecar: .sha512
prereleases: yes
dir: proton-armv8-experimental-retroforge
display_name: Proton ARMv8.0 Experimental (RetroForge)
