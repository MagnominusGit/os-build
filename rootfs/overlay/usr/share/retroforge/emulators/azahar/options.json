    {
      "id": "renderer",
      "label": "Graphics backend",
      "description": "How Azahar draws the game. Vulkan is the fast one; Software is far too slow to play and is only for checking graphics bugs.",
      "choices": [
        {
          "value": "vulkan",
          "label": "Vulkan",
          "set": [
            {
              "file": "main",
              "section": "Renderer",
              "key": "graphics_api",
              "value": "2"
            },
            {
              "file": "main",
              "section": "Renderer",
              "key": "graphics_api\\default",
              "value": "false"
            }
          ]
        },
        {
          "value": "software",
          "label": "Software",
          "set": [
            {
              "file": "main",
              "section": "Renderer",
