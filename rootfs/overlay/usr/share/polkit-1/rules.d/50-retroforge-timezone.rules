// Let the shell (player user) set the system timezone during first-boot setup without an auth prompt.
//
// Everything else player needs is now covered by STOCK polkit: since the shell boots through retroforge-session.service
// autologin it is a real ACTIVE seat0 logind session, so NetworkManager's OOBE Wi-Fi connect
// (org.freedesktop.NetworkManager.settings.modify.system, allow_active=yes) is authorized with no
// rule at all. Timezone is the one exception — org.freedesktop.timedate1.set-timezone defaults to
// auth_admin_keep even for an active session — so grant it here, gated on active session + wheel
// (player is in wheel).
//
// No "no-active" bypass is needed: the shell boots through retroforge-session.service, so subject.active holds.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.timedate1.set-timezone" &&
        subject.active && subject.isInGroup("wheel"))
        return polkit.Result.YES;
});
