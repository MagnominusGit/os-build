// Let the shell (player user) start and stop the key-pairing daemon: Settings > General > Remote
// access (the RetroForge plugin's retroforge_os.gd) runs `systemctl start|stop retroforge-pairingd`.
//
// Pairing is off at every boot (the unit has no [Install]). org.freedesktop.systemd1.manage-units
// defaults to auth_admin_keep even for an active session, so without this rule the switch would do
// nothing.
//
// Exactly start and stop, of this one unit, for the active LOCAL session (the seat0 autologin of
// retroforge-session.service, not an ssh login) and wheel. Not restart, not enable
// (manage-unit-files), not any other unit. tests/test-pairingd.sh evaluates this rule.
//
// What this does NOT prove is that a human pressed the switch: any process of `player` in that
// session (a game, an emulator) can start the unit too. That grants nothing new -- the same process
// can already write player's authorized_keys -- and it is strictly narrower than before the switch,
// when pairing listened from boot.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "retroforge-pairingd.service" &&
        (action.lookup("verb") == "start" || action.lookup("verb") == "stop") &&
        subject.active && subject.local && subject.isInGroup("wheel"))
        return polkit.Result.YES;
});
